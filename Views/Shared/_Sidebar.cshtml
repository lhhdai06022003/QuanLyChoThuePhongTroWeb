@using QuanLyChoThuePhongTroWeb.Models.ModelsOther
@model List<MenuItem>

<aside class="navbar navbar-vertical navbar-expand-lg">
    <div class="container-fluid">
        <!-- Toggle button for mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Logo -->
        <h1 class="navbar-brand navbar-brand-autodark py-2">
            <a href="/Home/Index" class="d-flex align-items-center justify-content-center text-decoration-none">
                <img src="~/Theme/images/logo-hcmute.png" alt="HCMUTE Logo" class="navbar-brand-image" style="max-height: 2rem;">
                <span class="brand-text ms-2 font-weight-bold text-primary" style="font-size: 1.05rem; letter-spacing: 0.5px;">SYSTEM RENTAL</span>
            </a>
        </h1>

        <!-- Sidebar Menu -->
        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                @foreach (var item in Model)
                {
                    @await Html.PartialAsync("_MenuItem", item)
                }
            </ul>
        </div>
    </div>
</aside>