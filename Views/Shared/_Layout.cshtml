@using QuanLyChoThuePhongTroWeb.Services

@{
    var menus = MenuService.GetMenu();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Theme/adminlte3/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/Theme/adminlte3/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/Theme/adminlte3/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css" />
    <link rel="stylesheet" href="~/Theme/adminlte3/plugins/select2-bootstrap4-theme/select2-bootstrap4.css" />
    <link rel="stylesheet" href="~/Theme/adminlte3/plugins/daterangepicker/daterangepicker.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
</head>

<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        @Html.Partial("_Header")
        @Html.Partial("_Sidebar", menus)

        <div class="content-wrapper">

            @* <section class="content-header">
                <div class="container-fluid">
                    <h1>@ViewBag.Title</h1>
                </div>
            </section> *@

            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>

        </div>

        @Html.Partial("_Footer")

    </div>

    <!-- JS -->
    <script src="~/Theme/adminlte3/plugins/jquery/jquery.min.js"></script>
    <script src="~/Theme/adminlte3/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Theme/adminlte3/dist/js/adminlte.min.js"></script>
    <script src="~/Theme/adminlte3/plugins/daterangepicker/daterangepicker.js"></script>
    @* <script src="~/Theme/adminlte3/plugins/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.min.js"></script> *@

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>