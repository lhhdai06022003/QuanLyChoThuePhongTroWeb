@using QuanLyChoThuePhongTroWeb.Models.ModelsOther
@model MenuItem

@{
    var hasChild = Model.Children != null && Model.Children.Any();
    var currentPath = Context.Request.Path.Value ?? "";

    // Kiểm tra xem menu item hiện tại có trùng khớp với URL đang truy cập hay không
    bool IsActiveUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        
        // Exact match
        if (currentPath.Equals(url, StringComparison.OrdinalIgnoreCase)) return true;
        
        // Match parent route paths (ví dụ: /QuanLyNhaTro/HopDong/Detail sẽ active menu /QuanLyNhaTro/HopDong)
        if (url != "/" && url != "#" && currentPath.StartsWith(url + "/", StringComparison.OrdinalIgnoreCase)) return true;

        return false;
    }

    var isAnyChildActive = hasChild && Model.Children.Any(child => IsActiveUrl(child.Url));
    var isParentActive = !hasChild && IsActiveUrl(Model.Url);
}

@if (hasChild)
{
    <li class="nav-item dropdown @(isAnyChildActive ? "active" : "")">
        <a class="nav-link dropdown-toggle" href="#navbar-menu-@Model.Name.GetHashCode()" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="@(isAnyChildActive ? "true" : "false")">
            <span class="nav-link-icon d-md-none d-lg-inline-block">
                <i class="@(string.IsNullOrEmpty(Model.Icon) ? "far fa-circle" : Model.Icon)"></i>
            </span>
            <span class="nav-link-title">
                @Model.Name
            </span>
        </a>
        <div class="dropdown-menu @(isAnyChildActive ? "show" : "")" data-bs-popper="@(isAnyChildActive ? "static" : "")">
            <div class="dropdown-menu-columns">
                <div class="dropdown-menu-column">
                    @foreach (var child in Model.Children)
                    {
                        var isChildActive = IsActiveUrl(child.Url);
                        <a class="dropdown-item py-2 @(isChildActive ? "active" : "")" href="@child.Url">
                            @if (!string.IsNullOrEmpty(child.Icon))
                            {
                                <i class="@child.Icon me-2" style="font-size: 0.85rem;"></i>
                            }
                            @child.Name
                        </a>
                    }
                </div>
            </div>
        </div>
    </li>
}
else
{
    <li class="nav-item @(isParentActive ? "active" : "")">
        <a class="nav-link" href="@(string.IsNullOrEmpty(Model.Url) ? "#" : Model.Url)">
            <span class="nav-link-icon d-md-none d-lg-inline-block">
                <i class="@(string.IsNullOrEmpty(Model.Icon) ? "far fa-circle" : Model.Icon)"></i>
            </span>
            <span class="nav-link-title">
                @Model.Name
            </span>
        </a>
    </li>
}