# Mẫu biến môi trường cho Docker (docker compose). Sao chép thành .env rồi tự điền giá trị thật.
# .env đã bị .gitignore bỏ qua: không đưa giá trị thật vào file này, vào README hay vào commit.

# --- PostgreSQL (dịch vụ trosync-db) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Kết nối của Web tới cơ sở dữ liệu (host trong mạng compose là trosync-db, cổng 5432) ---
ConnectionStrings__DefaultConnection=

# --- Cloudinary (lưu ảnh đồng hồ, minh chứng) ---
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# --- Gemini (chỉ cho trợ lý AI; đọc ảnh đồng hồ dùng model ONNX cục bộ) ---
Gemini__ApiKey=
Gemini__Model=

# --- Gửi email ---
EmailSettings__SenderEmail=
EmailSettings__Password=

# --- Tài khoản nhận tiền VietQR ---
VietQRSettings__BankId=
VietQRSettings__AccountNumber=
VietQRSettings__AccountName=

# --- Tài khoản admin lần đầu ---
# Chỉ cần khi DB chưa có tài khoản admin, tối thiểu 8 ký tự, không dùng admin.
AdminSeed__Password=

# Các khóa dưới đây không bắt buộc: thiếu thì dùng giá trị mặc định trong code (ghi ở chú thích).
# Khóa kiểu số, true/false hoặc enum để dạng chú thích: bỏ dấu # khi cần đổi, không để trống (giá trị rỗng không đổi được kiểu và làm app lỗi khi khởi động).

# Ghi chú luôn nằm trên dòng riêng, không viết sau giá trị.

# --- Nhắc nhở và cảnh báo ---
# Nhắc hóa đơn quá hạn: mặc định false (tắt), quá hạn 5 ngày.
# AutoReminderSettings__Enabled=true
# AutoReminderSettings__OverdueDays=5
ContractAlertSettings__AdminEmail=
# Ngày cảnh báo trước khi hợp đồng hết hạn: mặc định 30 và 15.
# ContractAlertSettings__AlertDays__0=30
# ContractAlertSettings__AlertDays__1=15
# Ngày nhắc chốt điện nước trên Dashboard: mặc định 5.
# DashboardSettings__ChotDienNuocDay=3

# --- Hóa đơn tự động ---
# Ngưỡng độ tin cậy của ảnh: mặc định 0.90.
# AutoInvoiceOptions__NguongDoTinCay=0.75
# Tự xác nhận số AI đọc: mặc định false (AI chỉ gợi ý, nhân viên xác nhận).
# AutoInvoiceOptions__TuXacNhanAnhAi=false

# --- Thanh toán trực tuyến ---
# URL công khai (ngrok...) trỏ vào cổng 5009 để nhận webhook/IPN.
OnlinePayment__PublicBaseUrl=
# Thanh toán giữ chỗ trực tuyến: mặc định false.
# OnlinePayment__ReservationEnabled=true

# --- SePay ---
# Mặc định tắt. Bật thì phải có WebhookSecret (Hmac) hoặc WebhookApiKey (ApiKey).
# SePay__Enabled=true
# Hmac hoặc ApiKey; mặc định Hmac.
# SePay__WebhookAuthMode=Hmac
SePay__WebhookSecret=
SePay__WebhookApiKey=
SePay__ApiToken=

# --- VNPay ---
# Mặc định tắt. Bật thì phải có TmnCode và HashSecret; PaymentUrl mặc định là sandbox.
# VnPay__Enabled=true
VnPay__TmnCode=
VnPay__HashSecret=

# --- Telegram ---
# Mặc định tắt. Bật thì phải có BotToken và DefaultChatId.
# Telegram__Enabled=true
Telegram__BotToken=
Telegram__DefaultChatId=

# --- Giới hạn đăng nhập sai ---
# Mặc định 5 lần sai theo tên đăng nhập, 20 lần theo IP (0 = tắt), cửa sổ và thời gian khóa 15 phút.
# LoginThrottle__MaxFailuresPerUsername=5
# LoginThrottle__MaxFailuresPerClient=20
# LoginThrottle__WindowMinutes=15
# LoginThrottle__LockMinutes=15
