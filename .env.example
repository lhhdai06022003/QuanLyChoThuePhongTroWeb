# Mẫu biến môi trường cho Docker (docker compose). Sao chép thành .env rồi tự điền giá trị thật.
# .env đã bị .gitignore bỏ qua: không đưa giá trị thật vào file này, vào README hay vào commit.

# --- PostgreSQL (dịch vụ trosync-db) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Kết nối của Web tới cơ sở dữ liệu (host trong mạng compose là trosync-db, cổng 5432) ---
ConnectionStrings__DefaultConnection=

# --- Cloudinary (lưu ảnh đồng hồ, minh chứng) ---
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# --- Gemini (chỉ cho trợ lý AI; đọc ảnh đồng hồ dùng model ONNX cục bộ) ---
Gemini__ApiKey=
Gemini__Model=

# --- Gửi email ---
EmailSettings__SenderEmail=
EmailSettings__Password=

# --- Tài khoản nhận tiền VietQR ---
VietQRSettings__BankId=
VietQRSettings__AccountNumber=
VietQRSettings__AccountName=
