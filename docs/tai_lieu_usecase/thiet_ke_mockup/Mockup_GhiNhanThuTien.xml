import json
import re

log_path = r"C:\Users\HaiDaiPC\.gemini\antigravity-ide\brain\ca0e5d36-8776-491a-bab9-eeb8f0ce880d\.system_generated\logs\transcript.jsonl"

def restore_file(target_filename, output_path):
    print(f"Searching for {target_filename}...")
    original_lines = []
    found = False
    
    with open(log_path, 'r', encoding='utf-8') as f:
        for line in f:
            try:
                data = json.loads(line)
                # Check if this is a view_file output
                content = ""
                if data.get('type') == 'VIEW_FILE':
                    content = data.get('content', '')
                elif 'tool_calls' in data:
                    content = data.get('content', '')
                
                # Check for output results in case of nested structure
                if not content and 'output' in data:
                    content = data.get('output', '')
                
                if target_filename in content and 'Total Lines:' in content:
                    # Nếu đã tìm thấy một bản ghi cũ hơn rồi thì không ghi đè nữa
                    if found:
                        continue
                    lines = content.split('\n')
                    file_lines = []
                    for l in lines:
                        m = re.match(r'^\s*(\d+):\s(.*)$', l)
                        if m:
                            file_lines.append(m.group(2))
                    if file_lines:
                        original_lines = file_lines
                        found = True
                        print(f"Found a candidate in logs for {target_filename}")
            except Exception as e:
                pass
                
    if found and original_lines:
        with open(output_path, 'w', encoding='utf-8') as out:
            out.write('\n'.join(original_lines) + '\n')
        print(f"Successfully restored {target_filename} to {output_path}")
    else:
        print(f"Could not find original content for {target_filename}")

