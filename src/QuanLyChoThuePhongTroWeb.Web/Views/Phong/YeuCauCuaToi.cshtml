@model QuanLyChoThuePhongTroWeb.ViewModels.PublicRooms.GuestRequestsPageModel
@{
    Layout = "_PublicRoomLayout";
    ViewData["Title"] = "Lịch xem và đặt phòng";
}

<div class="guest-container guest-form-page guest-reservation-page">
    <a class="guest-back" href="/phong">← Tiếp tục xem phòng</a>
    <p class="guest-kicker">Tài khoản của bạn</p>
    <h1>Lịch xem và đặt phòng</h1>
    <p>Theo dõi lịch hẹn, yêu cầu giữ chỗ, hạn chuyển tiền và các khoản hoàn.</p>
    @if (TempData["GuestViewingMessage"] is string message)
    {
        <div class="guest-preview-notice" role="status">@message</div>
    }
    @if (TempData["GuestReservationMessage"] is string reservationMessage)
    {
        <div class="guest-preview-notice" role="status">@reservationMessage</div>
    }
    <div class="guest-preview-grid">
        <section class="guest-preview-panel" id="lich-xem">
            <h2>Lịch xem phòng</h2>
            @if (Model.Viewings.Count == 0)
            {
                <p>Bạn chưa có lịch hẹn xem phòng.</p>
            }
            else
            {
                @foreach (var viewing in Model.Viewings)
                {
                    var dueUtc = viewing.ConfirmedTimeUtc ?? viewing.DesiredTimeUtc;
                    var due = new DateTimeOffset(dueUtc, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7));
                    var status = viewing.Status switch
                    {
                        "ChoNhanVienXuLy" => "Chờ nhân viên xác nhận",
                        "DaXacNhanLich" => "Đã xác nhận lịch",
                        "DaXemPhong" => "Đã xem phòng",
                        "TuChoi" => "Đã từ chối",
                        "DaHuy" => "Đã hủy",
                        _ => "Đang xử lý"
                    };
                    <div class="guest-cancel-preview">
                        <strong>Phòng @viewing.RoomNumber · @status</strong>
                        <p>@due.ToString("dd/MM/yyyy HH:mm")</p>
                        @if (viewing.CanCancel)
                        {
                            <p>Bạn có thể hủy trước giờ hẹn bắt đầu.</p>
                            <form method="post" action="/tai-khoan/yeu-cau-phong/lich-xem/@viewing.Id/huy">
                                @Html.AntiForgeryToken()
                                <button class="guest-button guest-button-outline" type="submit">Hủy lịch xem</button>
                            </form>
                        }
                        @if (viewing.Status is "DaXacNhanLich" or "DaXemPhong")
                        {
                            <a class="guest-section-link" href="/phong/@viewing.RoomId/giu-cho?viewingId=@viewing.Id">Giữ chỗ từ lịch xem này</a>
                        }
                    </div>
                }
            }
            <a class="guest-section-link" href="/phong">Chọn phòng để hẹn xem</a>
        </section>
        <section class="guest-preview-panel" id="dat-phong">
            <h2>Đặt phòng và đặt cọc</h2>
            @if (Model.Reservations.Count == 0)
            {
                <p>Bạn chưa có yêu cầu giữ chỗ.</p>
            }
            else
            {
                @foreach (var reservation in Model.Reservations)
                {
                    var reservationStatus = reservation.Status switch
                    {
                        "MoiTao" => "Chờ nhân viên duyệt",
                        "ChoThanhToan" => "Chờ chuyển tiền",
                        "ChoXacNhanTien" => "Chờ đối soát tiền",
                        "DangGiuCho" => "Đang giữ chỗ",
                        "DaChuyenHopDong" => "Đã ký hợp đồng",
                        "DaHuy" => "Đã hủy",
                        "HetHan" => "Đã hết hạn",
                        "TuChoi" => "Đã từ chối",
                        _ => reservation.Status
                    };
                    <div class="guest-cancel-preview">
                        <strong>Phòng @reservation.RoomNumber · @reservationStatus</strong>
                        @if (reservation.HoldAmount.HasValue)
                        {
                            <p>Số tiền giữ chỗ: @reservation.HoldAmount.Value.ToString("N0") ₫</p>
                        }
                        @if (reservation.PaymentDeadlineUtc.HasValue)
                        {
                            var deadline = new DateTimeOffset(reservation.PaymentDeadlineUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7));
                            <p>Hạn chuyển: @deadline.ToString("dd/MM/yyyy HH:mm")</p>
                        }
                        @if (reservation.ContractDeadlineUtc.HasValue)
                        {
                            var contractDeadline = new DateTimeOffset(reservation.ContractDeadlineUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7));
                            <p>Hạn ký hợp đồng: @contractDeadline.ToString("dd/MM/yyyy HH:mm")</p>
                        }
                        <p>Tiền đã xác nhận: @reservation.ConfirmedAmount.ToString("N0") ₫</p>
                        @if (Model.Settlements.FirstOrDefault(s => s.ReservationId == reservation.Id) is { } settlement)
                        {
                            @if (settlement.AppliedToContractDeposit > 0)
                            {
                                <p>Đã trừ vào cọc hợp đồng #@settlement.ContractId: @settlement.AppliedToContractDeposit.ToString("N0") ₫</p>
                            }
                            @if (settlement.ApprovedRefundAmount.HasValue)
                            {
                                <p>Hoàn đã duyệt: @settlement.ApprovedRefundAmount.Value.ToString("N0") ₫ · Đã hoàn thực tế: @settlement.RefundedAmount.ToString("N0") ₫</p>
                            }
                            @if (settlement.MandatoryRefundAmount > 0)
                            {
                                <p>Phần cần hoàn tối thiểu: @settlement.MandatoryRefundAmount.ToString("N0") ₫</p>
                            }
                        }
                        @if (reservation.PaymentRequestId.HasValue)
                        {
                            <p>Nội dung chuyển khoản: <strong>@reservation.PaymentCode</strong></p>
                            <p>Trạng thái thanh toán: @(reservation.PaymentStatus switch
                                {
                                    "ChoThanhToan" => "Chờ chuyển tiền",
                                    "DaBaoChuyen" => "Đã báo chuyển, chờ đối soát",
                                    "DangDoiChieu" => "Đang đối soát",
                                    "DaHoanTat" => "Đã nhận đủ",
                                    "HetHan" => "Đã hết hạn",
                                    "DaHuy" => "Đã hủy",
                                    _ => reservation.PaymentStatus ?? "Chưa có"
                                })</p>
                            @if (reservation.Status is "ChoThanhToan" or "ChoXacNhanTien")
                            {
                                @if (Model.Bank is { } bank)
                                {
                                    <p>Chuyển khoản tới @bank.BankId · <strong>@bank.AccountNumber</strong> · @bank.AccountName. Ghi đúng nội dung <strong>@reservation.PaymentCode</strong>.</p>
                                }
                                else
                                {
                                    <p>Chưa cấu hình tài khoản nhận. Vui lòng liên hệ nhân viên trước khi chuyển tiền.</p>
                                }
                            }
                            @foreach (var evidence in Model.Evidence.Where(e => e.PaymentRequestId == reservation.PaymentRequestId))
                            {
                                <p>Minh chứng #@evidence.Id · @evidence.ClaimedAmount.ToString("N0") ₫ · @(evidence.Status switch
                                    {
                                        "ChoXacNhan" => "Chờ nhân viên xác nhận",
                                        "DaXacNhan" => "Đã đối soát",
                                        "TuChoi" => "Đã từ chối",
                                        _ => evidence.Status
                                    })
                                    <a href="/tai-khoan/yeu-cau-phong/minh-chung/@evidence.Id" target="_blank" rel="noopener">Xem ảnh</a>
                                </p>
                            }
                        }
                        <a class="guest-button guest-button-primary guest-deposit-link" href="/tai-khoan/yeu-cau-phong/giu-cho/@reservation.Id/dat-coc">@(reservation.Status is "ChoThanhToan" or "ChoXacNhanTien" ? "Đặt cọc / gửi minh chứng" : "Xem chi tiết đặt phòng")</a>
                        @if (reservation.CanCancel)
                        {
                            <form method="post" action="/tai-khoan/yeu-cau-phong/giu-cho/@reservation.Id/huy">
                                @Html.AntiForgeryToken()
                                <button class="guest-button guest-button-outline" type="submit">Hủy yêu cầu giữ chỗ</button>
                            </form>
                        }
                    </div>
                }
            }
            <a class="guest-section-link" href="/phong">Xem phòng đang công khai</a>
        </section>
    </div>
</div>
