@model QuanLyChoThuePhongTroWeb.ViewModels.PublicRooms.ViewingPageModel
@{
    Layout = "_PublicRoomLayout";
    ViewData["Title"] = $"Hẹn xem phòng {Model.Room.Room.SoPhong}";
    var room = Model.Room.Room;
}

<div class="guest-container guest-form-page">
    <a class="guest-back" href="/phong/@room.PhongTroId">← Về thông tin phòng</a>
    <div class="guest-form-grid">
        <div>
            <p class="guest-kicker">Hẹn xem phòng</p>
            <h1>Chọn ngày đến<br />xem phòng.</h1>
            <p class="guest-form-lead">Bạn sẽ chọn khung giờ còn chỗ hoặc đề xuất thời gian khác. Email là bắt buộc để nhận thông báo nếu phòng được thuê trước ngày hẹn.</p>
            <div class="guest-form-room">
                <span>Phòng bạn muốn xem</span>
                <strong>Phòng @room.SoPhong</strong>
                <small>@room.TenChiNhanh · @room.DiaChi</small>
            </div>
        </div>
        <form class="guest-viewing-form" method="post" aria-label="Thông tin hẹn xem phòng">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <h2>Thông tin lịch xem</h2>
            <label asp-for="SlotId">Khung giờ có sẵn</label>
            <select asp-for="SlotId">
                <option value="">Chọn khung giờ hoặc nhập thời gian bên dưới</option>
                @foreach (var slot in Model.Slots)
                {
                    var start = new DateTimeOffset(slot.StartUtc, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7));
                    var end = new DateTimeOffset(slot.EndUtc, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7));
                    <option value="@slot.Id">@start.ToString("dd/MM/yyyy HH:mm") – @end.ToString("HH:mm") · còn @slot.RemainingPlaces chỗ</option>
                }
            </select>
            <label asp-for="PreferredTimeLocal">Thời gian mong muốn khác</label>
            <input asp-for="PreferredTimeLocal" type="datetime-local" />
            <p class="guest-field-hint">Chỉ chọn một trong hai cách. Giờ tự đề xuất sẽ chờ nhân viên xác nhận.</p>
            <div class="guest-form-divider"></div>
            <h2>Thông tin liên hệ</h2>
            <label asp-for="FullName">Họ và tên <span>*</span></label>
            <input asp-for="FullName" type="text" autocomplete="name" placeholder="Nguyễn Văn A" required />
            <span asp-validation-for="FullName" class="text-danger"></span>
            <label asp-for="Phone">Số điện thoại <span>*</span></label>
            <input asp-for="Phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="09..." required />
            <span asp-validation-for="Phone" class="text-danger"></span>
            <label asp-for="Email">Email nhận thông báo <span>*</span></label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="ban@example.com" required />
            <span asp-validation-for="Email" class="text-danger"></span>
            <p class="guest-field-hint">Nếu phòng được thuê trước lịch hẹn, thông báo hủy lịch sẽ gửi đến địa chỉ này.</p>
            <label asp-for="Note">Ghi chú cho nhân viên</label>
            <textarea asp-for="Note" rows="3" placeholder="Bạn muốn hỏi thêm điều gì?"></textarea>
            <button class="guest-button guest-button-primary" type="submit">Gửi yêu cầu xem phòng</button>
            <p class="guest-form-footnote">Bạn có thể hủy lịch trước giờ hẹn bắt đầu.</p>
        </form>
    </div>
</div>
