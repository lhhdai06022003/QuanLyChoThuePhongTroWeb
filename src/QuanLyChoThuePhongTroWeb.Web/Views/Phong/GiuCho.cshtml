@model QuanLyChoThuePhongTroWeb.ViewModels.PublicRooms.ReservationPageModel
@{
    Layout = "_PublicRoomLayout";
    ViewData["Title"] = $"Giữ chỗ phòng {Model.Room.Room.SoPhong}";
    var room = Model.Room.Room;
}

<div class="guest-container guest-form-page guest-reservation-page">
    <a class="guest-back" href="/phong/@room.PhongTroId">← Về thông tin phòng</a>
    <p class="guest-kicker">Giữ chỗ và đặt cọc</p>
    <h1>Gửi yêu cầu giữ chỗ <em>phòng @room.SoPhong</em></h1>
    <p>Nhân viên sẽ xem xét yêu cầu, quyết định số tiền giữ chỗ, hạn thanh toán và hạn ký hợp đồng. Bạn chỉ chuyển tiền sau khi yêu cầu được duyệt.</p>
    <div class="guest-form-room">
        <span>Phòng bạn chọn</span>
        <strong>Phòng @room.SoPhong</strong>
        <small>@room.TenChiNhanh · @room.GiaThue.ToString("N0") ₫ / tháng</small>
    </div>
    @if (Model.ViewingId.HasValue)
    {
        <p>Yêu cầu này sẽ gắn với lịch xem #@Model.ViewingId.Value. Hệ thống kiểm tra lịch xem thuộc tài khoản và đúng phòng.</p>
    }
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <form method="post" action="/phong/@room.PhongTroId/giu-cho" class="guest-reservation-actions">
        @Html.AntiForgeryToken()
        @if (Model.ViewingId.HasValue)
        {
            <input type="hidden" name="viewingId" value="@Model.ViewingId.Value" />
        }
        <button class="guest-button guest-button-primary" type="submit">Gửi yêu cầu giữ chỗ</button>
    </form>
    <div class="guest-preview-notice" role="status">Số tiền chính thức do nhân viên duyệt. Ảnh chuyển khoản chỉ là thông báo; tiền được ghi nhận sau khi nhân viên đối soát.</div>
</div>
