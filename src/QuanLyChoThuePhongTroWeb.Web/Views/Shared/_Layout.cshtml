@using QuanLyChoThuePhongTroWeb.Services

@{
    var menus = MenuService.GetMenu();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(string.IsNullOrEmpty(ViewBag.Title?.ToString()) ? "TroSync - Quản lý phòng trọ đa chi nhánh" : ViewBag.Title + " | TroSync")</title>

    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    
    <!-- Tabler Icons CDN -->
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler-icons.min.css" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler-vendors.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    @* CSS của flatpickr, Select2 chỉ nạp ở trang dùng, đầu @section Styles của trang (site.css và trosync-tokens.css
       không có quy tắc nào chạm phần tử của hai thư viện này nên thứ tự mới không đổi giao diện). *@
    <link rel="manifest" href="~/manifest.json" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/trosync-tokens.css" asp-append-version="true" />

    <style>
        /* Standardized SweetAlert2 custom popup */
        .swal2-popup.swal2-custom-popup {
            border-radius: 12px !important;
            font-family: inherit !important;
        }
        .swal2-custom-popup .swal2-title {
            font-weight: 600 !important;
        }
        .swal2-custom-popup .swal2-actions button {
            border-radius: 6px !important;
            font-weight: 500 !important;
            padding: 8px 20px !important;
        }
        
        /* SweetAlert2 Dark Mode Sync */
        [data-bs-theme="dark"] .swal2-popup {
            background-color: var(--tblr-bg-surface) !important;
            color: var(--tblr-body-color) !important;
        }
        [data-bs-theme="dark"] .swal2-title,
        [data-bs-theme="dark"] .swal2-html-container {
            color: var(--tblr-body-color) !important;
        }
    </style>

    <script>
        // Set theme immediately to avoid flashing
        const savedTheme = localStorage.getItem('tablerTheme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    @await RenderSectionAsync("Styles", required: false)
    @* CSS widget trợ lý AI (_AiChatWidget) đặt sau mọi CSS khác như khi còn nằm trong body. *@
    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
    {
        <link rel="stylesheet" href="~/css/ai-chat-widget.css" asp-append-version="true" />
    }
</head>

<body class="layout-fluid">
    @Html.AntiForgeryToken()
    <div class="page">
        <!-- Sidebar -->
        <partial name="_Sidebar" model="menus" />

        <div class="page-wrapper">
            <!-- Header (Navbar) -->
            <partial name="_Header" />

            <main class="page-body m-0 pt-3" role="main">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <partial name="_Footer" />
        </div>
    </div>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Cấu hình AJAX toàn cục để tự động gửi Token chống giả mạo yêu cầu (CSRF)
        $.ajaxSetup({
            beforeSend: function (xhr, settings) {
                if (!/^(GET|HEAD|OPTIONS|TRACE)$/i.test(settings.type)) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    if (token) {
                        xhr.setRequestHeader("RequestVerificationToken", token);
                    }
                }
            }
        });
    </script>
    <script src="~/Theme/tabler/dist/js/tabler.min.js"></script>
    <script>
        window.bootstrap = window.tabler;
    </script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        // Cảnh báo lỗi mặc định của DataTables là tiếng Anh ("DataTables warning: ..."); đổi sang thông báo tiếng Việt, chi tiết kỹ thuật ghi ra console.
        if ($.fn.dataTable) {
            $.fn.dataTable.ext.errMode = function (settings, techNote, message) {
                console.error(message);
                if (typeof window.showError === 'function') {
                    window.showError('Không tải được dữ liệu bảng. Vui lòng tải lại trang.');
                }
            };
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Đồng bộ giao diện SweetAlert2 toàn hệ thống
        if (typeof Swal !== 'undefined') {
            const originalFire = Swal.fire;
            // Chữ nút mặc định của SweetAlert2 là OK / Cancel; hộp thoại nào tự đặt chữ nút thì giữ nguyên.
            const nutMacDinh = { confirmButtonText: 'Đóng', cancelButtonText: 'Hủy bỏ' };
            Swal.fire = function(...args) {
                if (typeof args[0] === 'string') {
                    // Dạng rút gọn Swal.fire(tiêu đề, nội dung, biểu tượng): đổi sang object để đặt chữ nút, giữ nguyên giao diện.
                    return originalFire.call(this, Object.assign({}, nutMacDinh, { title: args[0], text: args[1], icon: args[2] }));
                }
                if (args.length === 1 && typeof args[0] === 'object') {
                    let options = args[0] = Object.assign({}, nutMacDinh, args[0]);
                    options.customClass = options.customClass || {};
                    options.customClass.popup = (options.customClass.popup || '') + ' swal2-custom-popup';
                    
                    // Thiết lập màu sắc nút bấm đồng bộ
                    if (!options.confirmButtonColor) {
                        options.confirmButtonColor = (options.icon === 'error' || options.icon === 'warning') ? '#d33' : '#3085d6';
                    }
                    if (!options.cancelButtonColor) {
                        options.cancelButtonColor = '#6c757d';
                    }
                }
                return originalFire.apply(this, args);
            };
            
            // Định nghĩa các hàm thông báo toàn cục để dùng trong các view
            window.showSuccess = function(msg) {
                return Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: msg,
                    confirmButtonColor: '#3085d6'
                });
            };
            window.showError = function(msg) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: msg,
                    confirmButtonColor: '#3085d6'
                });
            };
            window.showWarning = function(msg) {
                return Swal.fire({
                    icon: 'warning',
                    title: 'Thông báo',
                    text: msg,
                    confirmButtonColor: '#3085d6'
                });
            };
        }
    </script>
    @* flatpickr, Select2, Chart.js chỉ nạp ở trang dùng (partial _FlatpickrJs, _Select2Js, _ChartJs), trước cấu hình
       tiếng Việt của Select2 bên dưới và trước script của trang. *@
    @await RenderSectionAsync("ThuVienScripts", required: false)
    <script>
        // Thông báo mặc định của Select2 là tiếng Anh; đặt tiếng Việt cho mọi ô chọn.
        if ($.fn.select2) {
            $.fn.select2.defaults.set('language', {
                noResults: function () { return 'Không tìm thấy kết quả'; },
                searching: function () { return 'Đang tìm kiếm…'; },
                loadingMore: function () { return 'Đang tải thêm kết quả…'; },
                errorLoading: function () { return 'Không tải được kết quả'; },
                inputTooShort: function (args) { return 'Vui lòng nhập thêm ' + (args.minimum - args.input.length) + ' ký tự'; },
                inputTooLong: function (args) { return 'Vui lòng xóa bớt ' + (args.input.length - args.maximum) + ' ký tự'; },
                maximumSelected: function (args) { return 'Chỉ được chọn tối đa ' + args.maximum + ' mục'; }
            });
        }
    </script>
    @* Hub thông báo yêu cầu đăng nhập: trang dùng layout này khi ẩn danh (Privacy, trang lỗi) không nối hub. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/thongbao.js" asp-append-version="true"></script>
    }
    @* Đang bị ép đổi mật khẩu thì API việc cần làm trả 403, không nạp badge để tránh lỗi console. *@
    @if ((User.IsInRole("Admin") || User.IsInRole("NhanVien")) && !QuanLyChoThuePhongTroWeb.Web.Helpers.ForcedPasswordChange.IsRequired(User))
    {
        @* Trang đã tính sẵn số việc cần làm (Bảng điều khiển không lọc chi nhánh) thì in ra để huy hiệu không gọi lại TomTat. *@
        @if (ViewData[QuanLyChoThuePhongTroWeb.Web.Helpers.ViecCanLamBadge.ViewDataKey] is QuanLyChoThuePhongTroWeb.Application.Features.ViecCanLam.DTOs.ViecCanLamTongHopDto tomTat)
        {
            <script>window.viecCanLamTomTat = @Json.Serialize(QuanLyChoThuePhongTroWeb.Web.Helpers.ViecCanLamBadge.Payload(tomTat));</script>
        }
        <script src="~/js/viec-can-lam-badge.js" asp-append-version="true"></script>
    }

    @{ ViewData["AiChatPortal"] = "QuanLyNhaTro"; }
    <partial name="_AiChatWidget" />
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function (err) {
                    console.warn('ServiceWorker registration error:', err);
                });
            });
        }
    </script>
</body>
</html>