@using QuanLyChoThuePhongTroWeb.Models.ModelsOther
@model List<MenuItem>

<aside class="navbar navbar-vertical navbar-expand-lg">
    <div class="container-fluid">
        <!-- Toggle button for mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Logo & Brand -->
        <h1 class="navbar-brand navbar-brand-autodark px-3 py-2 m-0">
            <a href="/Home/Index" class="d-flex align-items-center text-decoration-none">
                <svg class="brand-logo-icon flex-shrink-0" width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="troSyncBg" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#2563eb" />
                            <stop offset="100%" stop-color="#1d4ed8" />
                        </linearGradient>
                    </defs>
                    <rect width="36" height="36" rx="9" fill="url(#troSyncBg)" />
                    <!-- Khối kiến trúc đa chi nhánh & đồng bộ -->
                    <path d="M8 25V17L14.5 12V25H8Z" fill="#ffffff" fill-opacity="0.4" />
                    <path d="M13.5 25V14L20.5 8.5L27.5 14V25H22.5V17.5H18.5V25H13.5Z" fill="#ffffff" />
                    <circle cx="20.5" cy="8.5" r="2.2" fill="#38bdf8" />
                    <circle cx="20.5" cy="8.5" r="0.9" fill="#ffffff" />
                </svg>
                <div class="brand-text-wrapper ms-2 d-flex flex-column text-start">
                    <span class="brand-title lh-1">Tro<span class="text-primary font-weight-bold">Sync</span></span>
                    <span class="brand-subtitle mt-1">Quản lý trọ đa chi nhánh</span>
                </div>
            </a>
        </h1>

        <!-- Mobile top user control -->
        <div class="navbar-nav flex-row d-lg-none">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                        <span class="avatar avatar-sm rounded-circle bg-blue-lt"><i class="ti ti-user-circle fa-lg text-blue"></i></span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                        <form action="/QuanLyNhaTro/DangXuat" method="post" class="d-none" id="mobileLogoutForm">
                            @Html.AntiForgeryToken()
                        </form>
                        <a href="javascript:void(0);" onclick="document.getElementById('mobileLogoutForm').submit();" class="dropdown-item text-danger py-2">
                            <i class="ti ti-logout me-2"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Menu -->
        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                @foreach (var item in Model)
                {
                    if (item.IsVisibleFor(User))
                    {
                        @await Html.PartialAsync("_MenuItem", item)
                    }
                }
            </ul>
        </div>
    </div>
</aside>