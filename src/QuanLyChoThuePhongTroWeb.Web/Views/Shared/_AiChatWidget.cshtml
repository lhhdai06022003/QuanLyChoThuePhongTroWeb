@using System.Security.Claims
@using QuanLyChoThuePhongTroWeb.Application.Features.AiAssistants.Tools
@{
    // Chỉ hiển thị widget cho đúng cổng và đúng vai trò; mỗi người dùng có khóa lịch sử riêng.
    var aiUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var aiPortal = ViewData["AiChatPortal"] as string;
    var aiIsTenant = aiPortal == "KhachThue" && User.IsInRole("KhachThue");
    var aiIsManager = aiPortal == "QuanLyNhaTro" && (User.IsInRole("Admin") || User.IsInRole("NhanVien"));
    if (string.IsNullOrEmpty(aiUserId) || !(aiIsTenant || aiIsManager))
    {
        return;
    }

    var aiEndpoint = aiIsTenant ? "/KhachThue/AiAssistant/Chat" : "/QuanLyNhaTro/AiAssistant/Chat";
    var aiStorageKey = "ai_chat_history_" + aiUserId;
    var aiSuggestions = AiPrompts.Suggestions(aiIsTenant ? AiCallerRole.KhachThue : AiCallerRole.NhanVien);
}
<div class="ai-chat-wrapper" id="aiChatWidget" data-endpoint="@aiEndpoint" data-storage-key="@aiStorageKey">
    <!-- Floating Action Button (FAB) -->
    <button type="button" class="btn-ai-fab shadow-lg" id="btnAiOpenChat" title="Trò chuyện với Trợ lý AI">
        <i class="fa-solid fa-robot"></i>
        <span class="ai-badge-pulse"></span>
    </button>

    <!-- Chat Box Window -->
    <div class="ai-chat-box shadow-2xl" id="aiChatBox">
        <!-- Chat Header -->
        <div class="ai-chat-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="ai-header-avatar">
                    <i class="fa-solid fa-brain"></i>
                </div>
                <div>
                    <h4 class="m-0 text-white fw-bold" style="font-size: 14px;">Trợ lý AI Vận Hành</h4>
                    <small class="text-white-50" style="font-size: 10px;"><i class="fa-solid fa-circle text-success me-1"></i>Trực tuyến</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn-ai-header" id="btnAiReset" title="Xóa lịch sử trò chuyện">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
                <button type="button" class="btn-ai-header" id="btnAiClose" title="Thu nhỏ">
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
            </div>
        </div>

        <!-- Chat Body -->
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-message ai-message-model">
                <div class="ai-msg-bubble">
                    Xin chào! Tôi là <strong>Trợ lý AI Vận Hành</strong>.<br/><br/>Tôi có thể hỗ trợ gì cho bạn hôm nay?
                </div>
            </div>
            <div id="aiSuggestions" class="d-flex flex-wrap gap-1">
                @foreach (var suggestion in aiSuggestions)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary btn-ai-suggest" data-prompt="@suggestion">@suggestion</button>
                }
            </div>
        </div>

        <!-- Typing Indicator -->
        <div class="ai-typing-indicator d-none" id="aiTypingIndicator">
            <div class="ai-msg-avatar">
                <i class="fa-solid fa-robot"></i>
            </div>
            <div class="ai-typing-bubbles">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
        <!-- Chat Footer (Input) -->
        <div class="ai-chat-footer p-2 border-top border-light-subtle bg-body">
            <form id="frmAiChat" class="d-flex align-items-center gap-1.5 m-0">
                <input type="text" id="txtAiMessage" class="form-control ai-input" placeholder="Hỏi tôi bất cứ điều gì..." autocomplete="off" maxlength="1000" required />
                <button type="submit" class="btn btn-primary btn-icon ai-btn-send" id="btnAiSend" title="Gửi">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@* CSS của widget nạp ở <head> của _Layout và _LayoutKhachThue (~/css/ai-chat-widget.css). *@
<script src="~/js/ai-chat-widget.js" asp-append-version="true"></script>
