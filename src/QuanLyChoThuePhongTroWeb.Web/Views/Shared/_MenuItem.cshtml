@using QuanLyChoThuePhongTroWeb.Models.ModelsOther
@model MenuItem

@{
    var visibleChildren = Model.Children?.Where(c => c.IsVisibleFor(User)).ToList();
    var hasChild = visibleChildren != null && visibleChildren.Any();
    var currentPath = Context.Request.Path.Value ?? "";

    // Kiểm tra xem menu item hiện tại có trùng khớp với URL đang truy cập hay không
    bool IsActiveUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        
        // Exact match
        if (currentPath.Equals(url, StringComparison.OrdinalIgnoreCase)) return true;
        
        // Match parent route paths (ví dụ: /QuanLyNhaTro/HopDong/Detail sẽ active menu /QuanLyNhaTro/HopDong)
        if (url != "/" && url != "#" && currentPath.StartsWith(url + "/", StringComparison.OrdinalIgnoreCase)) return true;

        return false;
    }

    bool IsActive(MenuItem item)
    {
        if (item == null) return false;
        if (IsActiveUrl(item.Url)) return true;
        if (item.ActivePrefixes != null)
        {
            foreach (var prefix in item.ActivePrefixes)
            {
                if (IsActiveUrl(prefix)) return true;
            }
        }
        return false;
    }

    var isAnyChildActive = hasChild && visibleChildren!.Any(child => IsActive(child));
    var isParentActive = !hasChild && IsActive(Model);
    var hasOriginalChildren = Model.Children != null && Model.Children.Any();
    var isVisible = Model.IsVisibleFor(User) && !(hasOriginalChildren && !hasChild);
}

@if (isVisible)
{
    if (hasChild)
    {
        <li class="ts-nav-group" aria-hidden="true"><span class="ts-nav-group-label">@Model.Name</span></li>
        foreach (var child in visibleChildren!)
        {
            @await Html.PartialAsync("_MenuItem", child)
        }
    }
    else
    {
        <li class="nav-item @(isParentActive ? "active" : "")">
            <a class="nav-link @(isParentActive ? "active" : "")" href="@(string.IsNullOrEmpty(Model.Url) ? "#" : Model.Url)" aria-current="@(isParentActive ? "page" : null)">
                <span class="nav-link-icon d-md-none d-lg-inline-block">
                    <i class="@(string.IsNullOrEmpty(Model.Icon) ? "ti ti-point" : Model.Icon)"></i>
                </span>
                <span class="nav-link-title">
                    @Model.Name
                </span>
                @if (!string.IsNullOrEmpty(Model.BadgeId))
                {
                    <span id="@Model.BadgeId" class="badge ms-auto d-none"></span>
                }
            </a>
        </li>
    }
}