@using QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.Responses
@using QuanLyChoThuePhongTroWeb.Application.Common.Formatting
@model DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var viec = Model.ViecCanLam;
    var viecRong = viec.TongSo == 0;
    var laAdmin = Model.CoXemDoanhThu;
    var ky = $"T{Model.SelectedMonth}/{Model.SelectedYear}";
}

<div class="container-xl mt-3 dashboard-page">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary fw-bold d-flex align-items-center">
                    <i class="ti ti-chart-line me-2"></i> Bảng điều khiển hệ thống
                </h2>
            </div>
            <div class="col-12 col-md-auto ms-md-auto mt-2 mt-md-0 d-print-none">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <label class="visually-hidden" for="branchSelect">Chi nhánh</label>
                    <select id="branchSelect" asp-items="Model.Branches" class="form-select w-auto">
                        <option value="">-- Tất cả chi nhánh --</option>
                    </select>

                    <label class="visually-hidden" for="monthSelect">Tháng</label>
                    <select id="monthSelect" asp-items="Model.Months" class="form-select w-auto">
                    </select>

                    <label class="visually-hidden" for="yearSelect">Năm</label>
                    <select id="yearSelect" asp-items="Model.Years" class="form-select w-auto">
                    </select>

                    <span id="dashboardLoading" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-label="Đang tải"></span>
                </div>
            </div>
        </div>
    </div>

    @if (laAdmin && Model.ChoDuyet != null)
    {
        <!-- Admin: chờ bạn duyệt -->
        <div class="card mb-3" id="choDuyetCard">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-user-check me-2 text-primary"></i>Chờ bạn duyệt <span id="choDuyetTongSo" class="text-secondary fw-normal ms-1">(@Model.ChoDuyet.SoLuong)</span></h3>
            </div>
            <div class="list-group list-group-flush">
                <div id="choDuyetHd2">
                    @if (Model.ChoDuyet.SoLuong > 0)
                    {
                        <a href="@Model.ChoDuyet.Link" class="list-group-item list-group-item-action">
                            <div class="d-flex align-items-center gap-2">
                                <span class="status-dot status-orange" aria-hidden="true"></span>
                                <div class="dashboard-viec-text flex-fill fw-medium">@Model.ChoDuyet.TieuDe</div>
                                <span class="fw-bold ms-2">@Model.ChoDuyet.SoLuong</span>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="list-group-item text-secondary">Không có việc chờ duyệt</div>
                    }
                </div>
                <a href="/QuanLyNhaTro/GiaoDichSePay" class="list-group-item list-group-item-action">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-arrows-exchange text-primary" aria-hidden="true"></i>
                        <div class="flex-fill fw-medium">Đối soát giao dịch SePay</div>
                        <i class="ti ti-chevron-right text-secondary" aria-hidden="true"></i>
                    </div>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Nhân viên: việc cần làm đứng đầu trang -->
        <div class="card mb-3 dashboard-viec">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-checklist me-2 text-primary"></i>Việc cần làm <span id="viecTongSo" class="text-secondary fw-normal ms-1">(@viec.TongSo)</span></h3>
            </div>
            <div class="card-body">
                <div id="viecCanLamChips" class="d-flex flex-wrap gap-2 mb-2 @(viecRong ? "d-none" : "")">
                    <span id="viecSoKhan" class="badge bg-red text-red-fg">Khẩn @viec.SoKhan</span>
                    <span id="viecSoCanLam" class="badge bg-orange text-orange-fg">Cần làm @viec.SoCanLam</span>
                    <span id="viecSoTheoDoi" class="badge bg-blue text-blue-fg">Theo dõi @viec.SoTheoDoi</span>
                </div>
                <div id="viecCanLamList">
                    @if (viecRong)
                    {
                        <div class="text-center text-secondary py-4">
                            <i class="ti ti-circle-check text-success fs-1 d-block mb-2"></i>
                            Không có việc cần xử lý
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in viec.Items)
                            {
                                <a href="@item.Link" class="list-group-item list-group-item-action px-0">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="status-dot status-@item.MauUuTien" aria-hidden="true"></span>
                                        <span class="visually-hidden">@item.TenMucUuTien</span>
                                        <div class="dashboard-viec-text flex-fill">
                                            <div class="fw-medium">@item.TieuDe</div>
                                            <div class="small text-secondary text-truncate" title="@item.MoTa">@item.MoTa</div>
                                        </div>
                                        <span class="fw-bold ms-2">@item.SoLuong</span>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
            <div id="viecCanLamFooter" class="card-footer text-end @(viecRong ? "d-none" : "")">
                <a id="viecXemTatCa" href="@Url.Action("Index", "ViecCanLam", new { area = "QuanLyNhaTro", chiNhanhId = Model.SelectedBranchId })">Xem tất cả @viec.TongSo việc →</a>
            </div>
        </div>
    }

    <!-- Hàng số liệu: mỗi ô bấm được sang màn chi tiết -->
    <div class="row row-cards mb-3 dashboard-kpi">
        @if (laAdmin)
        {
            <div class="col-6 col-lg-3">
                <a id="cardDaThu" href="@Model.LinkDaThuKy" aria-label="Mở báo cáo doanh thu của kỳ @ky" class="card card-sm card-link h-100 text-white bg-success">
                    <div class="card-body">
                        <div class="subheader text-white text-opacity-75" id="kpiDaThuTitle">Đã thu kỳ @ky</div>
                        <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statDoanhThu">@TienTe.DinhDang(Model.DoanhThuThangNay ?? 0)</div>
                        <div class="small text-white text-opacity-75">Theo kỳ hóa đơn, gồm cấn trừ cọc</div>
                    </div>
                </a>
            </div>
        }

        <div class="col-6 col-lg-3">
            <a id="cardQuaHan" href="@Model.LinkQuaHan" aria-label="Mở danh sách hóa đơn quá hạn" class="card card-sm card-link h-100 text-white bg-danger">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Quá hạn</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statQuaHan">@TienTe.DinhDang(Model.TienQuaHan)</div>
                    <div class="small text-white text-opacity-75"><span id="statSoHoaDonQuaHan">@Model.SoHoaDonQuaHan hóa đơn</span>. Tính tới hôm nay</div>
                </div>
            </a>
        </div>

        <div class="col-6 col-lg-3">
            <a id="cardChoThu" href="@Model.LinkChoThu" aria-label="Mở danh sách hóa đơn chưa thu đủ của kỳ @ky" class="card card-sm card-link h-100 text-white bg-warning">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75" id="kpiChoThuTitle">Chờ thu kỳ @ky</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statChoThu">@TienTe.DinhDang(Model.TongTienChoThu)</div>
                    <div class="small text-white text-opacity-75">Hóa đơn đã gửi, chưa thu đủ</div>
                </div>
            </a>
        </div>

        @if (!laAdmin)
        {
            <div class="col-6 col-lg-3">
                <a id="cardTienMat" href="@Model.LinkTienMatCuaToi" aria-label="Mở lịch sử thanh toán tiền mặt bạn đã thu trong kỳ @ky" class="card card-sm card-link h-100 text-white bg-teal">
                    <div class="card-body">
                        <div class="subheader text-white text-opacity-75" id="kpiTienMatTitle">Tiền mặt bạn đã thu @ky</div>
                        <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statTienMat">@TienTe.DinhDang(Model.TienMatCuaToi.TongTien)</div>
                        <div class="small text-white text-opacity-75" id="statTienMatChuThich">Tháng @Model.SelectedMonth/@Model.SelectedYear, chưa gồm tiền giữ chỗ</div>
                    </div>
                </a>
            </div>
        }

        <div class="col-6 col-lg-3">
            <a id="cardPhongDangNo" href="@Model.LinkPhongDangNo" aria-label="Mở danh sách hóa đơn của các phòng đang nợ" class="card card-sm card-link h-100 text-white bg-pink">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Phòng đang nợ</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statChuaThanhToan">@Model.SoPhongChuaThanhToan</div>
                    <div class="small text-white text-opacity-75">Từ trước tới nay</div>
                </div>
            </a>
        </div>
    </div>

    @if (laAdmin)
    {
        <!-- Admin: tiền mặt nhân viên đang giữ -->
        <div class="card mb-3" id="tienMatCard">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-cash me-2 text-primary"></i>Tiền mặt nhân viên đang giữ <span id="tienMatKy" class="text-secondary fw-normal ms-1">@ky</span></h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table" id="tienMatBang">
                    <thead>
                        <tr>
                            <th>Người thu</th>
                            <th class="text-end">Số khoản</th>
                            <th class="text-end">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody id="tienMatBody">
                        @if (Model.TienMatNhanVien == null || Model.TienMatNhanVien.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-secondary py-3">Tháng này chưa có khoản tiền mặt nào</td></tr>
                        }
                        else
                        {
                            @foreach (var n in Model.TienMatNhanVien)
                            {
                                <tr>
                                    <td><a href="@n.Link" class="text-reset d-block fw-medium">@n.Ten</a></td>
                                    <td class="text-end num-tabular"><a href="@n.Link" class="text-reset d-block">@n.SoKhoan</a></td>
                                    <td class="text-end num-tabular"><a href="@n.Link" class="text-reset d-block">@TienTe.DinhDang(n.TongTien)</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot id="tienMatFoot" class="@(Model.TienMatNhanVien == null || Model.TienMatNhanVien.Count == 0 ? "d-none" : "")">
                        <tr class="fw-bold">
                            <td>Tổng</td>
                            <td class="text-end num-tabular" id="tienMatTongKhoan">@Model.TienMatNhanVienTongKhoan</td>
                            <td class="text-end num-tabular" id="tienMatTongTien">@TienTe.DinhDang(Model.TienMatNhanVienTongTien)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    <!-- Biểu đồ -->
    <div class="row row-cards @(laAdmin ? "mb-3" : "mb-5")">
        @if (laAdmin)
        {
            <div class="col-12 col-lg-8">
                <div class="card h-100 dashboard-chart">
                    <div class="card-body">
                        <h3 class="card-title mb-3"><i class="ti ti-chart-bar me-2 text-primary"></i>Xu hướng doanh thu (Năm <span id="chartYearText">@Model.SelectedYear</span>)<a id="linkBaoCaoNam" href="@Model.LinkBaoCaoNam" aria-label="Mở báo cáo doanh thu năm @Model.SelectedYear" class="btn btn-sm btn-outline-primary ms-2">Xem báo cáo chi tiết</a></h3>
                        <div style="height: 320px; position: relative;">
                            <canvas id="revenueBarChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12 @(laAdmin ? "col-lg-4" : "col-lg-5")">
            <div class="card h-100 dashboard-phong">
                <div class="card-body">
                    <h3 class="card-title mb-3"><i class="ti ti-chart-pie me-2 text-primary"></i>Tình trạng phòng</h3>
                    <div class="d-flex justify-content-center align-items-center" style="height: 260px; position: relative;">
                        <canvas id="roomStatusChart"></canvas>
                    </div>
                    <div class="row text-center mt-3">
                        <div class="col-6">
                            <div class="subheader">Hợp đồng hoạt động</div>
                            <div class="h3 mb-0 fw-bold" id="statHopDong">@Model.TongSoHopDongHoatDong</div>
                        </div>
                        <div class="col-6">
                            <div class="subheader">Tỷ lệ lấp đầy</div>
                            <div class="h3 mb-0 fw-bold" id="statTyLeLapDay">@Model.TyLeLapDayText</div>
                            <div class="small text-secondary" id="statPhongLapDay">@Model.SoPhongDaThue/@Model.TongSoPhong phòng</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!laAdmin)
        {
            <div class="col-12 col-lg-7">
                <div class="card h-100 dashboard-hoatdong">
                    <div class="card-header">
                        <h3 class="card-title mb-0"><i class="ti ti-history text-primary me-2"></i>Hoạt động gần đây</h3>
                    </div>
                    <div class="card-body" id="activitiesContainer">
                        @await Html.PartialAsync("_HoatDongGanDay", Model.RecentActivities)
                    </div>
                </div>
            </div>
        }
    </div>

    @if (laAdmin)
    {
        <!-- Admin: việc cần làm của nhân viên, thu gọn -->
        <div class="card mb-3 dashboard-viec">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-checklist me-2 text-primary"></i>Việc cần làm của nhân viên <span id="viecTongSo" class="text-secondary fw-normal ms-1">(@viec.TongSo)</span></h3>
                <div class="card-actions">
                    <button type="button" class="btn btn-sm btn-ghost-secondary" id="viecToggle" data-bs-toggle="collapse" data-bs-target="#viecCanLamBody" aria-expanded="false" aria-controls="viecCanLamBody">Xem chi tiết</button>
                </div>
            </div>
            <div id="viecCanLamBody" class="collapse">
                <div class="card-body">
                    <div id="viecCanLamChips" class="d-flex flex-wrap gap-2 mb-2 @(viecRong ? "d-none" : "")">
                        <span id="viecSoKhan" class="badge bg-red text-red-fg">Khẩn @viec.SoKhan</span>
                        <span id="viecSoCanLam" class="badge bg-orange text-orange-fg">Cần làm @viec.SoCanLam</span>
                        <span id="viecSoTheoDoi" class="badge bg-blue text-blue-fg">Theo dõi @viec.SoTheoDoi</span>
                    </div>
                    <div id="viecCanLamList">
                        @if (viecRong)
                        {
                            <div class="text-center text-secondary py-4">
                                <i class="ti ti-circle-check text-success fs-1 d-block mb-2"></i>
                                Không có việc cần xử lý
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in viec.Items)
                                {
                                    <a href="@item.Link" class="list-group-item list-group-item-action px-0">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="status-dot status-@item.MauUuTien" aria-hidden="true"></span>
                                            <span class="visually-hidden">@item.TenMucUuTien</span>
                                            <div class="dashboard-viec-text flex-fill">
                                                <div class="fw-medium">@item.TieuDe</div>
                                                <div class="small text-secondary text-truncate" title="@item.MoTa">@item.MoTa</div>
                                            </div>
                                            <span class="fw-bold ms-2">@item.SoLuong</span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div id="viecCanLamFooter" class="card-footer text-end @(viecRong ? "d-none" : "")">
                    <a id="viecXemTatCa" href="@Url.Action("Index", "ViecCanLam", new { area = "QuanLyNhaTro", chiNhanhId = Model.SelectedBranchId })">Xem tất cả @viec.TongSo việc →</a>
                </div>
            </div>
        </div>

        <div class="card mb-5 dashboard-hoatdong">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="ti ti-history text-primary me-2"></i>Hoạt động gần đây</h3>
            </div>
            <div class="card-body" id="activitiesContainer">
                @await Html.PartialAsync("_HoatDongGanDay", Model.RecentActivities)
            </div>
        </div>
    }
</div>

@section ThuVienScripts {
    <partial name="_ChartJs" />
}

@section Scripts {
    <script>window.dashboardConfig = {
        coXemDoanhThu: @Html.Raw(Json.Serialize(Model.CoXemDoanhThu)),
        chartLabels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
        chartData: @Html.Raw(Json.Serialize(Model.ChartData)),
        chartDataChoThu: @Html.Raw(Json.Serialize(Model.ChartDataChoThu)),
        roomLabels: @Html.Raw(Json.Serialize(Model.RoomStatusLabels)),
        roomData: @Html.Raw(Json.Serialize(Model.RoomStatusData)),
        urlAjax: @Html.Raw(Json.Serialize(Url.Action("GetAjaxData", "Dashboard", new { area = "QuanLyNhaTro" }))),
        urlViecCanLam: @Html.Raw(Json.Serialize(Url.Action("Index", "ViecCanLam", new { area = "QuanLyNhaTro" })))
    };</script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
