@using QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.Responses
@using QuanLyChoThuePhongTroWeb.Application.Common.Formatting
@model DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var viec = Model.ViecCanLam;
    var viecRong = viec.TongSo == 0;
}

<div class="container-xl mt-3">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold d-flex align-items-center">
                    <i class="ti ti-chart-line me-2"></i> Bảng Điều Khiển Hệ Thống
                </h2>
            </div>
            <div class="col-12 col-md-auto ms-md-auto mt-2 mt-md-0 d-print-none">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <label class="visually-hidden" for="branchSelect">Chi nhánh</label>
                    <select id="branchSelect" asp-items="Model.Branches" class="form-select w-auto">
                        <option value="">-- Tất cả chi nhánh --</option>
                    </select>

                    <label class="visually-hidden" for="monthSelect">Tháng</label>
                    <select id="monthSelect" asp-items="Model.Months" class="form-select w-auto">
                    </select>

                    <label class="visually-hidden" for="yearSelect">Năm</label>
                    <select id="yearSelect" asp-items="Model.Years" class="form-select w-auto">
                    </select>

                    <span id="dashboardLoading" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-label="Đang tải"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng KPI -->
    <div class="row row-cards mb-3 dashboard-kpi">
        <div class="col-6 col-md-4 col-xxl-2">
            <div class="card card-sm h-100 text-white bg-success">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75" id="kpiDaThuTitle">Đã thu T@(Model.SelectedMonth)/@(Model.SelectedYear)</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statDoanhThu">@TienTe.DinhDang(Model.DoanhThuThangNay)</div>
                    <div class="small text-white text-opacity-75">theo sổ thanh toán</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xxl-2">
            <div class="card card-sm h-100 text-white bg-warning">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Chờ thu</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statChoThu">@TienTe.DinhDang(Model.TongTienChoThu)</div>
                    <div class="small text-white text-opacity-75">hóa đơn đã gửi khách</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xxl-2">
            <div class="card card-sm h-100 text-white bg-danger">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Quá hạn</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statQuaHan">@TienTe.DinhDang(Model.TienQuaHan)</div>
                    <div class="small text-white text-opacity-75" id="statSoHoaDonQuaHan">@Model.SoHoaDonQuaHan hóa đơn</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xxl-2">
            <div class="card card-sm h-100 text-white bg-pink">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Phòng đang nợ</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statChuaThanhToan">@Model.SoPhongChuaThanhToan</div>
                    <div class="small text-white text-opacity-75">từ trước tới nay</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xxl-2">
            <div class="card card-sm h-100 text-white bg-primary">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Hợp đồng hoạt động</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statHopDong">@Model.TongSoHopDongHoatDong</div>
                    <div class="small text-white text-opacity-75">&nbsp;</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xxl-2">
            <div class="card card-sm h-100 text-white bg-cyan">
                <div class="card-body">
                    <div class="subheader text-white text-opacity-75">Tỷ lệ lấp đầy</div>
                    <div class="h2 mb-0 fw-bold dashboard-kpi-value" id="statTyLeLapDay">@Model.TyLeLapDayText</div>
                    <div class="small text-white text-opacity-75" id="statPhongLapDay">@Model.SoPhongDaThue/@Model.TongSoPhong phòng</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vùng chính -->
    <div class="dashboard-layout mb-5">
        <div class="card dashboard-chart">
            <div class="card-body">
                <h3 class="card-title mb-3"><i class="ti ti-chart-bar me-2 text-primary"></i>Xu hướng doanh thu (Năm <span id="chartYearText">@Model.SelectedYear</span>)</h3>
                <div style="height: 320px; position: relative;">
                    <canvas id="revenueBarChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card dashboard-phong">
            <div class="card-body">
                <h3 class="card-title mb-3"><i class="ti ti-chart-pie me-2 text-primary"></i>Tình trạng phòng</h3>
                <div class="d-flex justify-content-center align-items-center" style="height: 260px; position: relative;">
                    <canvas id="roomStatusChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card dashboard-hoatdong">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="ti ti-history text-primary me-2"></i>Hoạt động gần đây</h3>
            </div>
            <div class="card-body" id="activitiesContainer">
                @if (Model.RecentActivities.Count == 0)
                {
                    <div class="text-center text-secondary py-4">
                        <i class="ti ti-info-circle fs-1 d-block mb-2"></i>
                        <div>Chưa ghi nhận hoạt động vận hành nào gần đây.</div>
                    </div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var act in Model.RecentActivities)
                        {
                            <div class="timeline-item">
                                <div class="timeline-badge @act.ColorClass">
                                    <i class="@act.Icon"></i>
                                </div>
                                <div class="ms-2">
                                    <div class="fw-bold fs-4">@act.Title</div>
                                    <div class="text-secondary small">@act.Description</div>
                                    <span class="badge bg-light-lt text-secondary mt-1">
                                        <i class="ti ti-clock me-1"></i>@act.TimeText
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card dashboard-viec">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-checklist me-2 text-primary"></i>Việc cần làm <span id="viecTongSo" class="text-secondary fw-normal ms-1">(@viec.TongSo)</span></h3>
            </div>
            <div class="card-body">
                <div id="viecCanLamChips" class="d-flex flex-wrap gap-2 mb-2 @(viecRong ? "d-none" : "")">
                    <span id="viecSoKhan" class="badge bg-red text-red-fg">Khẩn @viec.SoKhan</span>
                    <span id="viecSoCanLam" class="badge bg-orange text-orange-fg">Cần làm @viec.SoCanLam</span>
                    <span id="viecSoTheoDoi" class="badge bg-blue text-blue-fg">Theo dõi @viec.SoTheoDoi</span>
                </div>
                <div id="viecCanLamList">
                    @if (viecRong)
                    {
                        <div class="text-center text-secondary py-4">
                            <i class="ti ti-circle-check text-success fs-1 d-block mb-2"></i>
                            Không có việc cần xử lý
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in viec.Items)
                            {
                                <a href="@item.Link" class="list-group-item list-group-item-action px-0">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="status-dot status-@item.MauUuTien" aria-hidden="true"></span>
                                        <span class="visually-hidden">@item.TenMucUuTien</span>
                                        <div class="dashboard-viec-text flex-fill">
                                            <div class="fw-medium">@item.TieuDe</div>
                                            <div class="small text-secondary text-truncate" title="@item.MoTa">@item.MoTa</div>
                                        </div>
                                        <span class="fw-bold ms-2">@item.SoLuong</span>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
            <div id="viecCanLamFooter" class="card-footer text-end @(viecRong ? "d-none" : "")">
                <a id="viecXemTatCa" href="@Url.Action("Index", "ViecCanLam", new { area = "QuanLyNhaTro", chiNhanhId = Model.SelectedBranchId })">Xem tất cả @viec.TongSo việc →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.dashboardConfig = {
        chartLabels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
        chartData: @Html.Raw(Json.Serialize(Model.ChartData)),
        chartDataChoThu: @Html.Raw(Json.Serialize(Model.ChartDataChoThu)),
        roomLabels: @Html.Raw(Json.Serialize(Model.RoomStatusLabels)),
        roomData: @Html.Raw(Json.Serialize(Model.RoomStatusData)),
        urlAjax: @Html.Raw(Json.Serialize(Url.Action("GetAjaxData", "Dashboard", new { area = "QuanLyNhaTro" }))),
        urlViecCanLam: @Html.Raw(Json.Serialize(Url.Action("Index", "ViecCanLam", new { area = "QuanLyNhaTro" })))
    };</script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
