<div class="card shadow-none border-0 mb-0 bg-transparent">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent p-0 mb-3 border-0">
        <h3 class="card-title m-0">Danh sách thành viên trong phòng</h3>
        <button type="button" class="btn btn-sm btn-primary ms-auto" id="btnOpenAddMemberModal">
            <i class="ti ti-user-plus me-1"></i> Thêm thành viên
        </button>
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter table-hover w-100 ts-bang-the" id="thanhVienTable">
            <thead>
                <tr>
                    <th class="w-1 text-center">STT</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>CCCD</th>
                    <th>Ngày vào</th>
                    <th>Ngày rời</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody id="thanhVienTbody">
                <tr>
                    <td colspan="8" class="text-center text-muted">Vui lòng tải dữ liệu...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Thành Viên -->
<div class="modal modal-blur fade" id="addMemberModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitleMember">Thêm thành viên ở ghép</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body py-3">
                <form id="formAddMember">
                    <!-- Input ẩn lưu NguoiThueId khi chọn từ danh sách autocomplete -->
                    <input type="hidden" id="addMember_NguoiThueId" value="" />

                    <!-- Khu vực tìm kiếm khách hàng cũ -->
                    <div class="bg-surface-secondary p-3 rounded-3 border mb-3">
                        <label class="form-label fw-bold text-secondary mb-2">
                            <i class="ti ti-search me-1"></i> Tìm khách thuê có sẵn (Gõ tên, SĐT hoặc CCCD)
                        </label>
                        <div class="row g-2">
                            <div class="col">
                                <select class="form-select" id="addMember_SearchNguoiThue" style="width:100%">
                                    <option value="">-- Gõ để tìm kiếm --</option>
                                </select>
                                <div id="addMember_NoCuWarning"></div>
                            </div>
                            <div class="col-auto">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        id="btnToggleNewMember"
                                        title="Nhập mới hoàn toàn">
                                    <i class="ti ti-user-plus me-1"></i> Nhập mới
                                </button>
                            </div>
                        </div>
                        <small class="form-text text-muted d-block mt-2">
                            <i class="ti ti-info-circle me-1"></i> Tìm khách cũ để tránh nhập trùng dữ liệu. Nếu chưa có, chọn "Nhập mới".
                        </small>
                    </div>

                    <div class="hr-text text-uppercase text-muted my-3 fs-5 fw-bold">Thông tin thành viên</div>

                    <div id="newMemberFields">
                        <div class="mb-3">
                            <label class="form-label required fw-bold" for="addMember_HoVaTen">Họ và Tên <span class="text-danger">*</span></label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-user text-muted"></i>
                                </span>
                                <input type="text" class="form-control" id="addMember_HoVaTen" placeholder="Nhập họ tên..." disabled>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label required fw-bold" for="addMember_SoDienThoai">Số điện thoại <span class="text-danger">*</span></label>
                                    <div class="input-icon">
                                        <span class="input-icon-addon">
                                            <i class="ti ti-phone text-muted"></i>
                                        </span>
                                        <input type="text" class="form-control" id="addMember_SoDienThoai" placeholder="Nhập số ĐT..." disabled>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label required fw-bold" for="addMember_CCCD">CCCD/CMND <span class="text-danger">*</span></label>
                                    <div class="input-icon">
                                        <span class="input-icon-addon">
                                            <i class="ti ti-id text-muted"></i>
                                        </span>
                                        <input type="text" class="form-control" id="addMember_CCCD" placeholder="Nhập CCCD..." disabled>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required fw-bold" for="addMember_NgayVao">Ngày bắt đầu ở <span class="text-danger">*</span></label>
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-calendar text-muted"></i>
                            </span>
                            <input type="text" class="form-control" id="addMember_NgayVao" placeholder="Chọn ngày...">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveMember">
                    <i class="ti ti-plus me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>
