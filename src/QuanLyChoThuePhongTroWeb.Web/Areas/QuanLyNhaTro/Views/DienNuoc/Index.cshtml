@{
    ViewData["Title"] = "Chỉ số điện nước";
}

<link rel="stylesheet" href="~/css/diennuoc.css" asp-append-version="true" />


<div class="page-body dn-page">
    <div class="container-xl">
        <div class="page-header d-print-none mb-3">
            <div class="row align-items-center">
                <div class="col">
                    <div class="page-pretitle">Chốt kỳ hàng tháng</div>
                    <h2 class="page-title">Chỉ số điện nước</h2>
                </div>
                <div class="col-auto ms-auto" id="saveActionArea" style="display: none;">
                    <button type="button" class="btn btn-primary" id="btnSaveData">
                        <i class="ti ti-device-floppy me-1"></i> Lưu chỉ số
                    </button>
                </div>
            </div>
        </div>

        <partial name="_ChuaPhanCongBanner" />

        <div class="card">
            <div class="card-header dn-filters">
                <div class="row g-2 w-100 align-items-end">
                    <div class="col-12 col-md-5">
                        <label for="filterChiNhanh" class="form-label required">Chi nhánh</label>
                        <select id="filterChiNhanh" class="form-select">
                            <option value="">Chọn chi nhánh</option>
                            @if (ViewBag.ListChiNhanh != null)
                            {
                                foreach (var cn in ViewBag.ListChiNhanh)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="filterThang" class="form-label required">Tháng</label>
                        <select id="filterThang" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (i == DateTime.Now.Month)
                                {
                                    <option value="@i" selected>Tháng @i</option>
                                }
                                else
                                {
                                    <option value="@i">Tháng @i</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="filterNam" class="form-label required">Năm</label>
                        <input type="number" id="filterNam" class="form-control" value="@DateTime.Now.Year" min="2000">
                    </div>
                </div>
            </div>

            <div id="dnSummary" class="dn-summary" style="display: none;">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <span id="dnSummaryText">Đã chốt 0/0 phòng</span>
                    <div class="progress progress-sm flex-grow-1 dn-progress">
                        <div class="progress-bar" id="dnSummaryBar" style="width: 0%" role="progressbar" aria-label="Tiến độ chốt chỉ số"></div>
                    </div>
                </div>
            </div>

            <div id="emptyState" class="empty py-5">
                <div class="empty-icon"><i class="ti ti-building"></i></div>
                <p class="empty-title">Chọn chi nhánh để bắt đầu</p>
                <p class="empty-subtitle text-secondary">Danh sách phòng đang thuê và chỉ số kỳ trước sẽ hiện ở đây.</p>
            </div>

            <div id="tableContainer" style="display: none;">
                <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap w-100 dn-table" id="dienNuocTable">
                        <thead>
                            <tr>
                                <th class="text-center" width="4%">STT</th>
                                <th>Phòng</th>
                                <th>Người đại diện</th>
                                <th class="text-center dn-col-dien" width="11%"><i class="ti ti-bolt me-1"></i>Điện cũ</th>
                                <th class="text-center dn-col-dien" width="13%"><i class="ti ti-bolt me-1"></i>Điện mới</th>
                                <th class="text-center dn-col-nuoc" width="11%"><i class="ti ti-droplet me-1"></i>Nước cũ</th>
                                <th class="text-center dn-col-nuoc" width="13%"><i class="ti ti-droplet me-1"></i>Nước mới</th>
                                <th class="text-center" width="13%">Ảnh đồng hồ</th>
                                <th class="text-center" width="10%">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDienNuoc">
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-secondary small">
                    Nhập chỉ số mới rồi bấm <kbd>Enter</kbd> hoặc <kbd>↑</kbd> <kbd>↓</kbd> để chuyển phòng, <kbd>←</kbd> <kbd>→</kbd> để đổi giữa điện và nước.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="dn-savebar d-print-none" id="stickyActionBar">
    <div class="container-xl d-flex align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="status-dot status-dot-animated bg-orange"></span>
            <span>Có chỉ số mới chưa lưu.</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-ghost-secondary" id="btnCancelChanges">Bỏ thay đổi</button>
            <button type="button" class="btn btn-primary" id="btnSaveDataSticky">
                <i class="ti ti-device-floppy me-1"></i> Lưu chỉ số
            </button>
        </div>
    </div>
</div>

<partial name="_AnhChiSoModal" />

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentData = [];
            let table = null;

            // Đọc query params (nếu có, VD click từ Dashboard qua)
            const urlParams = new URLSearchParams(window.location.search);
            let hasQueryParams = false;
            
            if (urlParams.has('chiNhanhId')) {
                $('#filterChiNhanh').val(urlParams.get('chiNhanhId'));
                hasQueryParams = true;
            }
            if (urlParams.has('thang')) {
                $('#filterThang').val(urlParams.get('thang'));
                hasQueryParams = true;
            }
            if (urlParams.has('nam')) {
                $('#filterNam').val(urlParams.get('nam'));
                hasQueryParams = true;
            }

            // Nếu có param thì tự động load data luôn
            if (hasQueryParams) {
                setTimeout(function() {
                    loadData();
                }, 100);
            }

            // Auto-tab navigation between input fields using Enter and Arrow keys
            $('#tbodyDienNuoc').on('keydown', '.in-dien-moi, .in-nuoc-moi', function (e) {
                const key = e.key;
                const isDien = $(this).hasClass('in-dien-moi');
                const targetClass = isDien ? '.in-dien-moi' : '.in-nuoc-moi';
                const tr = $(this).closest('tr');
                let targetTr = null;

                if (key === 'Enter' || key === 'ArrowDown') {
                    e.preventDefault();
                    // Find the next available unlocked row
                    let nextRows = tr.nextAll('tr');
                    for (let i = 0; i < nextRows.length; i++) {
                        let nextTr = $(nextRows[i]);
                        if (!nextTr.hasClass('row-locked')) {
                            targetTr = nextTr;
                            break;
                        }
                    }
                } else if (key === 'ArrowUp') {
                    e.preventDefault();
                    // Find the previous available unlocked row
                    let prevRows = tr.prevAll('tr');
                    for (let i = 0; i < prevRows.length; i++) {
                        let prevTr = $(prevRows[i]);
                        if (!prevTr.hasClass('row-locked')) {
                            targetTr = prevTr;
                            break;
                        }
                    }
                } else if (key === 'ArrowRight' && isDien) {
                    e.preventDefault();
                    tr.find('.in-nuoc-moi').focus().select();
                } else if (key === 'ArrowLeft' && !isDien) {
                    e.preventDefault();
                    tr.find('.in-dien-moi').focus().select();
                }

                if (targetTr) {
                    targetTr.find(targetClass).focus().select();
                }
            });

            // Auto-load trigger when filters change
            $('#filterChiNhanh, #filterThang, #filterNam').on('change', function () {
                loadData();
            });

            function loadData() {
                let chiNhanhId = $('#filterChiNhanh').val();
                let thang = $('#filterThang').val();
                let nam = $('#filterNam').val();

                if (!chiNhanhId) {
                    $('#emptyState').show();
                    $('#tableContainer').hide();
                    $('#saveActionArea').hide();
                    $('#dnSummary').hide();
                    hideStickyBar();
                    return;
                }

                $('#emptyState').hide();
                $('#tableContainer').show();
                $('#tbodyDienNuoc').html('<tr><td colspan="9" class="text-center text-secondary py-5"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Đang tải danh sách phòng</td></tr>');
                hideStickyBar();

                $.ajax({
                    url: '/DienNuoc/GetDanhSachPhongs',
                    type: 'GET',
                    data: { chiNhanhId: chiNhanhId, thang: thang, nam: nam },
                    success: function (res) {
                        currentData = res;
                        renderTable(res);
                        $('#saveActionArea').show();
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi tải dữ liệu',
                            text: xhr.responseJSON?.message || 'Có lỗi xảy ra khi tải dữ liệu.'
                        });
                        $('#tableContainer').hide();
                        $('#emptyState').show();
                        $('#saveActionArea').hide();
                    }
                });
            }

            const STATUS_LABELS = {
                0: 'Mới tải lên',
                1: 'Đang nhận diện',
                2: 'Đọc được',
                3: 'Lỗi',
                4: 'Không đọc được',
                5: 'Cần chụp lại',
                6: 'Đã xác nhận',
                7: 'Đã thay thế'
            };

            function getTrangThaiAnhLabel(status) {
                if (status === null || status === undefined) return 'Chưa có';
                return STATUS_LABELS[status] || 'Có ảnh';
            }

            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function deltaText(cu, moi, unit) {
                const d = (parseFloat(moi) || 0) - (parseFloat(cu) || 0);
                if (d < 0) return '';
                if (d === 0) return 'Chưa dùng';
                return '+' + new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 3 }).format(d) + ' ' + unit;
            }

            function updateSummary(data) {
                const total = data.length;
                const done = data.filter(x => x.isDaChot).length;
                $('#dnSummaryText').text(`Đã chốt ${done}/${total} phòng`);
                $('#dnSummaryBar').css('width', (total ? Math.round(done * 100 / total) : 0) + '%');
                $('#dnSummary').toggle(total > 0);
            }

            function renderRow(item, index) {
                let statusBadge = '';
                let rowClass = '';
                let disabledAttr = '';

                if (item.isLocked) {
                    statusBadge = '<span class="status status-red"><span class="status-dot"></span>Đã khóa</span>'
                        + (item.lyDoKhoa ? `<div class="dn-lock-reason">${escapeHtml(item.lyDoKhoa)}</div>` : '');
                    rowClass = 'row-locked';
                    disabledAttr = 'disabled';
                } else if (item.isDaChot) {
                    statusBadge = '<span class="status status-green"><span class="status-dot"></span>Đã chốt</span>';
                } else {
                    statusBadge = '<span class="status status-secondary"><span class="status-dot"></span>Chưa chốt</span>';
                }

                let defaultDienMoi = (item.chiSoDienMoi === 0 && !item.isDaChot) ? item.chiSoDienCu : item.chiSoDienMoi;
                let defaultNuocMoi = (item.chiSoNuocMoi === 0 && !item.isDaChot) ? item.chiSoNuocCu : item.chiSoNuocMoi;

                let isOfficialDien = item.coAnhDienChinhThuc && (item.giaTriDienXacNhanTuAnh != null ? defaultDienMoi === item.giaTriDienXacNhanTuAnh : defaultDienMoi === item.chiSoDienCu);
                let isOfficialNuoc = item.coAnhNuocChinhThuc && (item.giaTriNuocXacNhanTuAnh != null ? defaultNuocMoi === item.giaTriNuocXacNhanTuAnh : defaultNuocMoi === item.chiSoNuocCu);

                let anhDienSummary = item.soAnhDien > 0 ? `${item.soAnhDien} ảnh, ${getTrangThaiAnhLabel(item.trangThaiAnhDien).toLowerCase()}` : 'Chưa có ảnh';
                let anhNuocSummary = item.soAnhNuoc > 0 ? `${item.soAnhNuoc} ảnh, ${getTrangThaiAnhLabel(item.trangThaiAnhNuoc).toLowerCase()}` : 'Chưa có ảnh';

                let btnContent = '';
                if ((!item.soAnhDien || item.soAnhDien === 0) && (!item.soAnhNuoc || item.soAnhNuoc === 0)) {
                    btnContent = '<span class="text-secondary"><i class="ti ti-camera me-1"></i>Chưa có ảnh</span>';
                } else {
                    btnContent = `
                        <div class="text-start small lh-sm">
                            <div><i class="ti ti-bolt me-1 text-yellow"></i>${escapeHtml(anhDienSummary)}</div>
                            <div class="mt-1"><i class="ti ti-droplet me-1 text-azure"></i>${escapeHtml(anhNuocSummary)}</div>
                        </div>
                    `;
                }

                let anhBtn = `
                    <button type="button" class="btn btn-sm btn-ghost-secondary btn-anh-chi-so" data-phong-tro-id="${item.phongTroId}" data-index="${index}" title="Xem và thao tác ảnh chỉ số">
                        ${btnContent}
                    </button>
                `;

                return `
                    <tr data-index="${index}" class="${rowClass}">
                        <td class="text-center align-middle">${index + 1}</td>
                        <td class="align-middle fw-medium">${escapeHtml(item.tenPhong)}</td>
                        <td class="align-middle">${escapeHtml(item.tenNguoiDaiDien)}</td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center dn-old in-dien-cu" tabindex="-1" value="${item.chiSoDienCu}" readonly>
                        </td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center in-dien-moi" value="${defaultDienMoi}" min="0" ${disabledAttr}>
                            <div class="dn-delta">${deltaText(item.chiSoDienCu, defaultDienMoi, 'kWh')}</div>
                            <div class="invalid-feedback text-center small" style="display: none;">Mới phải ≥ cũ</div>
                            <div class="wrap-lydo-dien mt-1" style="${isOfficialDien ? 'display: none;' : ''}">
                                <input type="text" class="form-control form-control-sm in-lydo-dien" name="lyDoDien" placeholder="Lý do nhập tay" value="" ${disabledAttr}>
                            </div>
                        </td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center dn-old in-nuoc-cu" tabindex="-1" value="${item.chiSoNuocCu}" readonly>
                        </td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center in-nuoc-moi" value="${defaultNuocMoi}" min="0" ${disabledAttr}>
                            <div class="dn-delta">${deltaText(item.chiSoNuocCu, defaultNuocMoi, 'm³')}</div>
                            <div class="invalid-feedback text-center small" style="display: none;">Mới phải ≥ cũ</div>
                            <div class="wrap-lydo-nuoc mt-1" style="${isOfficialNuoc ? 'display: none;' : ''}">
                                <input type="text" class="form-control form-control-sm in-lydo-nuoc" name="lyDoNuoc" placeholder="Lý do nhập tay" value="" ${disabledAttr}>
                            </div>
                        </td>
                        <td class="text-center align-middle">${anhBtn}</td>
                        <td class="text-center align-middle">${statusBadge}</td>
                    </tr>
                `;
            }

            function renderTable(data) {
                // Hủy DataTable nếu đang có để vẽ lại
                if ($.fn.DataTable.isDataTable('#dienNuocTable')) {
                    $('#dienNuocTable').DataTable().destroy();
                }

                let html = '';
                if (data.length === 0) {
                    html = '<tr><td colspan="9" class="text-center text-secondary py-5">Chi nhánh này chưa có phòng đang thuê.</td></tr>';
                } else {
                    data.forEach((item, index) => {
                        html += renderRow(item, index);
                    });
                }
                
                $('#tbodyDienNuoc').html(html);
                updateSummary(data);

                // Khởi tạo lại DataTable (Giữ cuộn dọc, chỉ tìm kiếm và sắp xếp)
                if (data.length > 0) {
                    table = $('#dienNuocTable').DataTable({
                        "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                        "paging": false,
                        "ordering": true,
                        "searching": true,
                        "info": false,
                        "autoWidth": false,
                        "columnDefs": [
                            { "orderable": false, "targets": [0, 3, 4, 5, 6, 7, 8] } // Không sort trên STT, các cột chỉ số, ảnh và trạng thái
                        ]
                    });
                    
                    // Tự động căn chỉnh lại độ rộng cột của header sau khi vẽ để thẳng hàng tuyệt đối với body
                    setTimeout(function() {
                        if (table) {
                            table.columns.adjust().draw();
                        }
                    }, 50);
                }
            }

            // Real-time validation viền đỏ khi nhập sai chỉ số điện mới và toggle lý do nhập tay
            $('#tbodyDienNuoc').on('input change', '.in-dien-moi', function () {
                let tr = $(this).closest('tr');
                let index = tr.data('index');
                let rowData = currentData ? currentData[index] : null;
                let cu = parseFloat(tr.find('.in-dien-cu').val()) || 0;
                let moi = parseFloat($(this).val()) || 0;

                if (moi < cu || moi < 0) {
                    $(this).addClass('is-invalid');
                    tr.find('.in-dien-moi').siblings('.invalid-feedback').show();
                } else {
                    $(this).removeClass('is-invalid');
                    tr.find('.in-dien-moi').siblings('.invalid-feedback').hide();
                }

                if (rowData) {
                    let isOfficial = rowData.coAnhDienChinhThuc && (rowData.giaTriDienXacNhanTuAnh != null ? moi === rowData.giaTriDienXacNhanTuAnh : moi === cu);
                    if (isOfficial) {
                        tr.find('.wrap-lydo-dien').hide();
                        tr.find('.in-lydo-dien').removeClass('is-invalid');
                    } else {
                        tr.find('.wrap-lydo-dien').show();
                    }
                }
            });

            // Real-time validation viền đỏ khi nhập sai chỉ số nước mới và toggle lý do nhập tay
            $('#tbodyDienNuoc').on('input change', '.in-nuoc-moi', function () {
                let tr = $(this).closest('tr');
                let index = tr.data('index');
                let rowData = currentData ? currentData[index] : null;
                let cu = parseFloat(tr.find('.in-nuoc-cu').val()) || 0;
                let moi = parseFloat($(this).val()) || 0;

                if (moi < cu || moi < 0) {
                    $(this).addClass('is-invalid');
                    tr.find('.in-nuoc-moi').siblings('.invalid-feedback').show();
                } else {
                    $(this).removeClass('is-invalid');
                    tr.find('.in-nuoc-moi').siblings('.invalid-feedback').hide();
                }

                if (rowData) {
                    let isOfficial = rowData.coAnhNuocChinhThuc && (rowData.giaTriNuocXacNhanTuAnh != null ? moi === rowData.giaTriNuocXacNhanTuAnh : moi === cu);
                    if (isOfficial) {
                        tr.find('.wrap-lydo-nuoc').hide();
                        tr.find('.in-lydo-nuoc').removeClass('is-invalid');
                    } else {
                        tr.find('.wrap-lydo-nuoc').show();
                    }
                }
            });

            $('#tbodyDienNuoc').on('input change', '.in-dien-moi, .in-nuoc-moi', function () {
                const isDien = $(this).hasClass('in-dien-moi');
                const tr = $(this).closest('tr');
                const cu = tr.find(isDien ? '.in-dien-cu' : '.in-nuoc-cu').val();
                $(this).siblings('.dn-delta').text(deltaText(cu, $(this).val(), isDien ? 'kWh' : 'm³'));
            });

            $('#tbodyDienNuoc').on('input change', '.in-lydo-dien, .in-lydo-nuoc', function () {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid');
                }
            });

            // Detect changes in inputs to toggle sticky bottom bar
            function checkForChanges() {
                let hasChanges = false;
                $('#tbodyDienNuoc tr').not('.row-locked').each(function () {
                    let index = $(this).data('index');
                    if (index !== undefined) {
                        let rowData = currentData[index];
                        let defaultDienMoi = (rowData.chiSoDienMoi === 0 && !rowData.isDaChot) ? rowData.chiSoDienCu : rowData.chiSoDienMoi;
                        let defaultNuocMoi = (rowData.chiSoNuocMoi === 0 && !rowData.isDaChot) ? rowData.chiSoNuocCu : rowData.chiSoNuocMoi;

                        let currentDienMoi = parseFloat($(this).find('.in-dien-moi').val()) || 0;
                        let currentNuocMoi = parseFloat($(this).find('.in-nuoc-moi').val()) || 0;

                        if (currentDienMoi !== defaultDienMoi || currentNuocMoi !== defaultNuocMoi) {
                            hasChanges = true;
                            return false; // break loop
                        }
                    }
                });

                if (hasChanges) {
                    showStickyBar();
                } else {
                    hideStickyBar();
                }
            }

            function showStickyBar() {
                $('#stickyActionBar').addClass('show-bar');
            }

            function hideStickyBar() {
                $('#stickyActionBar').removeClass('show-bar');
            }

            $('#tbodyDienNuoc').on('input change', '.in-dien-moi, .in-nuoc-moi', function () {
                checkForChanges();
            });

            // Click open modal ảnh chỉ số
            $('#tbodyDienNuoc').on('click', '.btn-anh-chi-so', function () {
                let phongTroId = $(this).data('phong-tro-id');
                let index = $(this).data('index');
                let item = currentData ? currentData[index] : null;
                let thang = parseInt($('#filterThang').val());
                let nam = parseInt($('#filterNam').val());
                let tenPhong = item ? item.tenPhong : '';
                if (window.openAnhChiSoModal) {
                    window.openAnhChiSoModal(phongTroId, thang, nam, tenPhong);
                }
            });

            // Hàm làm mới duy nhất 1 dòng sau khi thao tác ảnh chỉ số thành công
            window.refreshDienNuocRow = function (phongTroId) {
                let chiNhanhId = $('#filterChiNhanh').val();
                let thang = $('#filterThang').val();
                let nam = $('#filterNam').val();
                if (!chiNhanhId) return;

                $.ajax({
                    url: '/DienNuoc/GetDanhSachPhongs',
                    type: 'GET',
                    data: { chiNhanhId: chiNhanhId, thang: thang, nam: nam },
                    success: function (res) {
                        if (!res || !Array.isArray(res)) return;
                        let updatedItem = res.find(x => x.phongTroId === phongTroId);
                        if (!updatedItem) return;

                        let idx = currentData.findIndex(x => x.phongTroId === phongTroId);
                        if (idx === -1) return;

                        currentData[idx] = updatedItem;

                        let $tr = $(`#tbodyDienNuoc tr[data-index="${idx}"]`);
                        if ($tr.length > 0) {
                            let $newTr = $(renderRow(updatedItem, idx));
                            $tr.attr('class', $newTr.attr('class') || '');
                            $tr.html($newTr.html());
                            if (table) {
                                table.row($tr[0]).invalidate('dom');
                            }
                        }
                    }
                });
            };

            // Reset changes
            $('#btnCancelChanges').on('click', function () {
                renderTable(currentData);
                hideStickyBar();
            });

            // Save Data
            $('#btnSaveData, #btnSaveDataSticky').on('click', function () {
                saveAllData();
            });

            function saveAllData() {
                if (currentData.length === 0) return;

                let chiNhanhId = $('#filterChiNhanh').val();
                let thang = $('#filterThang').val();
                let nam = $('#filterNam').val();

                let danhSachPhong = [];
                let hasError = false;

                // Lấy tất cả hàng trong DataTable (kể cả những hàng đang bị ẩn do search)
                let rows = table ? table.rows().nodes().to$() : $('#tbodyDienNuoc tr');

                rows.each(function () {
                    let index = $(this).data('index');
                    if (index !== undefined) {
                        let rowData = currentData[index];
                        
                        // Bỏ qua nếu dòng này đã bị khóa
                        if (rowData.isLocked) return;

                        let dienCu = parseFloat($(this).find('.in-dien-cu').val()) || 0;
                        let dienMoi = parseFloat($(this).find('.in-dien-moi').val()) || 0;
                        let nuocCu = parseFloat($(this).find('.in-nuoc-cu').val()) || 0;
                        let nuocMoi = parseFloat($(this).find('.in-nuoc-moi').val()) || 0;

                        if (dienMoi < 0 || nuocMoi < 0) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Chỉ số không hợp lệ',
                                text: `Phòng ${rowData.tenPhong}: Chỉ số điện/nước mới không được âm.`
                            });
                            hasError = true;
                            return false; // break each
                        }

                        if (dienMoi < dienCu) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Chỉ số điện sai lệch',
                                text: `Phòng ${rowData.tenPhong}: Chỉ số điện mới (${dienMoi}) không được nhỏ hơn chỉ số điện cũ (${dienCu}).`
                            });
                            hasError = true;
                            $(this).find('.in-dien-moi').addClass('is-invalid');
                            return false; // break each
                        }

                        if (nuocMoi < nuocCu) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Chỉ số nước sai lệch',
                                text: `Phòng ${rowData.tenPhong}: Chỉ số nước mới (${nuocMoi}) không được nhỏ hơn chỉ số nước cũ (${nuocCu}).`
                            });
                            hasError = true;
                            $(this).find('.in-nuoc-moi').addClass('is-invalid');
                            return false; // break each
                        }

                        let isOfficialDien = rowData.coAnhDienChinhThuc && (rowData.giaTriDienXacNhanTuAnh != null ? dienMoi === rowData.giaTriDienXacNhanTuAnh : dienMoi === dienCu);
                        let isOfficialNuoc = rowData.coAnhNuocChinhThuc && (rowData.giaTriNuocXacNhanTuAnh != null ? nuocMoi === rowData.giaTriNuocXacNhanTuAnh : nuocMoi === nuocCu);

                        let lyDoDien = $(this).find('.in-lydo-dien').val()?.trim() || null;
                        let lyDoNuoc = $(this).find('.in-lydo-nuoc').val()?.trim() || null;

                        if (!isOfficialDien && !lyDoDien) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Thiếu lý do nhập tay điện',
                                text: `Phòng ${rowData.tenPhong}: Vui lòng nhập lý do điều chỉnh chỉ số điện thủ công.`
                            });
                            hasError = true;
                            $(this).find('.in-lydo-dien').addClass('is-invalid').focus();
                            return false;
                        }

                        if (!isOfficialNuoc && !lyDoNuoc) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Thiếu lý do nhập tay nước',
                                text: `Phòng ${rowData.tenPhong}: Vui lòng nhập lý do điều chỉnh chỉ số nước thủ công.`
                            });
                            hasError = true;
                            $(this).find('.in-lydo-nuoc').addClass('is-invalid').focus();
                            return false;
                        }

                        danhSachPhong.push({
                            dichVuDienNuocCuaPhongId: rowData.dichVuDienNuocCuaPhongId,
                            phongTroId: rowData.phongTroId,
                            dienMode: isOfficialDien ? 1 : 2,
                            nuocMode: isOfficialNuoc ? 1 : 2,
                            chiSoDienCu: dienCu,
                            chiSoDienMoi: dienMoi,
                            chiSoNuocCu: nuocCu,
                            chiSoNuocMoi: nuocMoi,
                            lyDoNhapThuCongDien: isOfficialDien ? null : lyDoDien,
                            lyDoNhapThuCongNuoc: isOfficialNuoc ? null : lyDoNuoc
                        });
                    }
                });

                if (hasError) return;

                if (danhSachPhong.length === 0) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Thông báo',
                        text: 'Tất cả các phòng trong danh sách đã bị khóa hoặc không có chỉ số mới cần lưu.'
                    });
                    return;
                }

                let payload = {
                    chiNhanhId: parseInt(chiNhanhId),
                    thang: parseInt(thang),
                    nam: parseInt(nam),
                    danhSachPhong: danhSachPhong
                };

                let $btn = $('#btnSaveData');
                let $btnSticky = $('#btnSaveDataSticky');
                let originalHtml = $btn.html();
                let originalStickyHtml = $btnSticky.html();

                Swal.fire({
                    title: 'Xác nhận chốt chỉ số?',
                    text: `Bạn có chắc chắn muốn chốt và lưu chỉ số điện/nước cho các phòng của tháng ${thang}/${nam}?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang lưu');
                        $btnSticky.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang lưu');

                        $.ajax({
                            url: '/DienNuoc/SaveChotDienNuoc',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: function (res) {
                                showSuccess(res.message).then(() => {
                                    loadData();
                                });
                            },
                            error: function (xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu chỉ số.');
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html(originalHtml);
                                $btnSticky.prop('disabled', false).html(originalStickyHtml);
                            }
                        });
                    }
                });
            }
        });
    </script>
}
