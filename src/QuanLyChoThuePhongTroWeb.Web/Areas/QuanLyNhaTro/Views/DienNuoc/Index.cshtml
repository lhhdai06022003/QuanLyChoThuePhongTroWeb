@{
    ViewData["Title"] = "Chỉ số điện nước";
}

<link rel="stylesheet" href="~/css/diennuoc.css" asp-append-version="true" />


<div class="page-body dn-page">
    <div class="container-xl">
        <div class="page-header d-print-none mb-3">
            <div class="row align-items-center">
                <div class="col">
                    <div class="page-pretitle">Chốt kỳ hàng tháng</div>
                    <h2 class="page-title">Chỉ số điện nước</h2>
                </div>
                <div class="col-auto ms-auto" id="saveActionArea" style="display: none;">
                    <button type="button" class="btn btn-primary" id="btnSaveData" title="Chốt mọi phòng đã có chỉ số mới. Phòng chưa nhập sẽ được bỏ qua.">
                        <i class="ti ti-checks me-1"></i> Chốt tất cả
                    </button>
                </div>
            </div>
        </div>

        <partial name="_ChuaPhanCongBanner" />

        <div class="card">
            <div class="card-header dn-filters">
                <div class="row g-2 w-100 align-items-end">
                    <div class="col-12 col-md-5">
                        <label for="filterChiNhanh" class="form-label required">Chi nhánh</label>
                        <select id="filterChiNhanh" class="form-select">
                            <option value="">Chọn chi nhánh</option>
                            @if (ViewBag.ListChiNhanh != null)
                            {
                                foreach (var cn in ViewBag.ListChiNhanh)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="filterThang" class="form-label required">Tháng</label>
                        <select id="filterThang" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (i == DateTime.UtcNow.AddHours(7).Month)
                                {
                                    <option value="@i" selected>Tháng @i</option>
                                }
                                else
                                {
                                    <option value="@i">Tháng @i</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="filterNam" class="form-label required">Năm</label>
                        <input type="number" id="filterNam" class="form-control" value="@DateTime.UtcNow.AddHours(7).Year" min="2000">
                    </div>
                </div>
            </div>

            <div id="dnSummary" class="dn-summary" style="display: none;">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <span id="dnSummaryText">Đã chốt 0/0 phòng</span>
                    <div class="progress progress-sm flex-grow-1 dn-progress">
                        <div class="progress-bar" id="dnSummaryBar" style="width: 0%" role="progressbar" aria-label="Tiến độ chốt chỉ số"></div>
                    </div>
                </div>
            </div>

            <div id="emptyState" class="empty py-5">
                <div class="empty-icon"><i class="ti ti-building"></i></div>
                <p class="empty-title">Chọn chi nhánh để bắt đầu</p>
                <p class="empty-subtitle text-secondary">Danh sách phòng đang thuê và chỉ số kỳ trước sẽ hiện ở đây.</p>
            </div>

            <div id="tableContainer" style="display: none;">
                <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap w-100 dn-table" id="dienNuocTable">
                        <thead>
                            <tr>
                                <th class="text-center dn-col-check">
                                    <input type="checkbox" class="form-check-input m-0" id="dnSelectAll" aria-label="Chọn tất cả phòng chưa khóa">
                                </th>
                                <th class="text-center" width="4%">STT</th>
                                <th>Phòng</th>
                                <th>Người đại diện</th>
                                <th class="text-center dn-col-dien" width="11%"><i class="ti ti-bolt me-1"></i>Điện cũ</th>
                                <th class="text-center dn-col-dien" width="13%"><i class="ti ti-bolt me-1"></i>Điện mới</th>
                                <th class="text-center dn-col-nuoc" width="11%"><i class="ti ti-droplet me-1"></i>Nước cũ</th>
                                <th class="text-center dn-col-nuoc" width="13%"><i class="ti ti-droplet me-1"></i>Nước mới</th>
                                <th class="text-center" width="13%">Ảnh đồng hồ</th>
                                <th class="text-center" width="10%">Trạng thái</th>
                                <th class="text-center dn-col-action">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDienNuoc">
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-secondary small">
                    Nhập chỉ số mới rồi bấm <kbd>Enter</kbd> hoặc <kbd>↑</kbd> <kbd>↓</kbd> để chuyển phòng, <kbd>←</kbd> <kbd>→</kbd> để đổi giữa điện và nước.
                    Bấm <strong>Chốt phòng</strong> ở từng dòng, hoặc tick nhiều phòng rồi chốt cùng lúc.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="dn-savebar d-print-none" id="stickyActionBar" role="region" aria-label="Thao tác chốt chỉ số">
    <div class="container-xl d-flex align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2 dn-bar-info">
            <span class="status-dot status-dot-animated bg-orange flex-shrink-0"></span>
            <div class="dn-bar-text" aria-live="polite">
                <div class="fw-medium" id="dnBarTitle"></div>
                <div class="small text-secondary dn-bar-hint" id="dnBarHint"></div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0 dn-bar-actions">
            <button type="button" class="btn btn-ghost-secondary" id="btnCancelChanges">Bỏ thay đổi</button>
            <button type="button" class="btn btn-primary" id="btnSaveDataSticky">
                <i class="ti ti-lock-check me-1"></i><span id="dnBarSaveLabel">Chốt</span>
            </button>
        </div>
    </div>
</div>

<partial name="_AnhChiSoModal" />

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentData = [];
            let table = null;

            // Đọc query params (nếu có, VD click từ Dashboard qua)
            const urlParams = new URLSearchParams(window.location.search);
            let hasQueryParams = false;
            
            if (urlParams.has('chiNhanhId')) {
                $('#filterChiNhanh').val(urlParams.get('chiNhanhId'));
                hasQueryParams = true;
            }
            if (urlParams.has('thang')) {
                $('#filterThang').val(urlParams.get('thang'));
                hasQueryParams = true;
            }
            if (urlParams.has('nam')) {
                $('#filterNam').val(urlParams.get('nam'));
                hasQueryParams = true;
            }

            // Nếu có param thì tự động load data luôn
            if (hasQueryParams) {
                setTimeout(function() {
                    loadData();
                }, 100);
            }

            // Auto-tab navigation between input fields using Enter and Arrow keys
            $('#tbodyDienNuoc').on('keydown', '.in-dien-moi, .in-nuoc-moi', function (e) {
                const key = e.key;
                const isDien = $(this).hasClass('in-dien-moi');
                const targetClass = isDien ? '.in-dien-moi' : '.in-nuoc-moi';
                const tr = $(this).closest('tr');
                let targetTr = null;

                if (key === 'Enter' || key === 'ArrowDown') {
                    e.preventDefault();
                    // Find the next available unlocked row
                    let nextRows = tr.nextAll('tr');
                    for (let i = 0; i < nextRows.length; i++) {
                        let nextTr = $(nextRows[i]);
                        if (!nextTr.hasClass('row-locked')) {
                            targetTr = nextTr;
                            break;
                        }
                    }
                } else if (key === 'ArrowUp') {
                    e.preventDefault();
                    // Find the previous available unlocked row
                    let prevRows = tr.prevAll('tr');
                    for (let i = 0; i < prevRows.length; i++) {
                        let prevTr = $(prevRows[i]);
                        if (!prevTr.hasClass('row-locked')) {
                            targetTr = prevTr;
                            break;
                        }
                    }
                } else if (key === 'ArrowRight' && isDien) {
                    e.preventDefault();
                    tr.find('.in-nuoc-moi').focus().select();
                } else if (key === 'ArrowLeft' && !isDien) {
                    e.preventDefault();
                    tr.find('.in-dien-moi').focus().select();
                }

                if (targetTr) {
                    targetTr.find(targetClass).focus().select();
                }
            });

            // Auto-load trigger when filters change
            $('#filterChiNhanh, #filterThang, #filterNam').on('change', function () {
                loadData();
            });

            function loadData() {
                let chiNhanhId = $('#filterChiNhanh').val();
                let thang = $('#filterThang').val();
                let nam = $('#filterNam').val();

                if (!chiNhanhId) {
                    $('#emptyState').show();
                    $('#tableContainer').hide();
                    $('#saveActionArea').hide();
                    $('#dnSummary').hide();
                    hideStickyBar();
                    return;
                }

                $('#emptyState').hide();
                $('#tableContainer').show();
                $('#tbodyDienNuoc').html('<tr><td colspan="11" class="text-center text-secondary py-5"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Đang tải danh sách phòng</td></tr>');
                hideStickyBar();

                $.ajax({
                    url: '/DienNuoc/GetDanhSachPhongs',
                    type: 'GET',
                    data: { chiNhanhId: chiNhanhId, thang: thang, nam: nam },
                    success: function (res) {
                        currentData = res;
                        renderTable(res);
                        $('#saveActionArea').show();
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi tải dữ liệu',
                            text: xhr.responseJSON?.message || 'Có lỗi xảy ra khi tải dữ liệu.'
                        });
                        $('#tableContainer').hide();
                        $('#emptyState').show();
                        $('#saveActionArea').hide();
                    }
                });
            }

            const STATUS_LABELS = {
                0: 'Mới tải lên',
                1: 'Đang nhận diện',
                2: 'Đọc được',
                3: 'Lỗi',
                4: 'Không đọc được',
                5: 'Cần chụp lại',
                6: 'Đã xác nhận',
                7: 'Đã thay thế'
            };

            function getTrangThaiAnhLabel(status) {
                if (status === null || status === undefined) return 'Chưa có';
                return STATUS_LABELS[status] || 'Có ảnh';
            }

            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function deltaText(cu, moi, unit) {
                const d = (parseFloat(moi) || 0) - (parseFloat(cu) || 0);
                if (d < 0) return '';
                if (d === 0) return 'Chưa dùng';
                return '+' + new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 3 }).format(d) + ' ' + unit;
            }

            function updateSummary(data) {
                const total = data.length;
                const done = data.filter(x => x.isDaChot).length;
                $('#dnSummaryText').text(`Đã chốt ${done}/${total} phòng`);
                $('#dnSummaryBar').css('width', (total ? Math.round(done * 100 / total) : 0) + '%');
                $('#dnSummary').toggle(total > 0);
            }

            function renderRow(item, index) {
                let statusBadge = '';
                let rowClass = '';
                let disabledAttr = '';

                if (item.isLocked) {
                    statusBadge = '<span class="status status-red"><span class="status-dot"></span>Đã khóa</span>'
                        + (item.lyDoKhoa ? `<div class="dn-lock-reason">${escapeHtml(item.lyDoKhoa)}</div>` : '');
                    rowClass = 'row-locked';
                    disabledAttr = 'disabled';
                } else if (item.isDaChot) {
                    statusBadge = '<span class="status status-green"><span class="status-dot"></span>Đã chốt</span>';
                } else {
                    statusBadge = '<span class="status status-secondary"><span class="status-dot"></span>Chưa chốt</span>';
                }

                let defaultDienMoi = (item.chiSoDienMoi === 0 && !item.isDaChot) ? item.chiSoDienCu : item.chiSoDienMoi;
                let defaultNuocMoi = (item.chiSoNuocMoi === 0 && !item.isDaChot) ? item.chiSoNuocCu : item.chiSoNuocMoi;

                let isOfficialDien = item.coAnhDienChinhThuc && (item.giaTriDienXacNhanTuAnh != null ? defaultDienMoi === item.giaTriDienXacNhanTuAnh : defaultDienMoi === item.chiSoDienCu);
                let isOfficialNuoc = item.coAnhNuocChinhThuc && (item.giaTriNuocXacNhanTuAnh != null ? defaultNuocMoi === item.giaTriNuocXacNhanTuAnh : defaultNuocMoi === item.chiSoNuocCu);

                let anhDienSummary = item.soAnhDien > 0 ? `${item.soAnhDien} ảnh, ${getTrangThaiAnhLabel(item.trangThaiAnhDien).toLowerCase()}` : 'Chưa có ảnh';
                let anhNuocSummary = item.soAnhNuoc > 0 ? `${item.soAnhNuoc} ảnh, ${getTrangThaiAnhLabel(item.trangThaiAnhNuoc).toLowerCase()}` : 'Chưa có ảnh';

                let btnContent = '';
                if ((!item.soAnhDien || item.soAnhDien === 0) && (!item.soAnhNuoc || item.soAnhNuoc === 0)) {
                    btnContent = '<span class="text-secondary"><i class="ti ti-camera me-1"></i>Chưa có ảnh</span>';
                } else {
                    btnContent = `
                        <div class="text-start small lh-sm">
                            <div><i class="ti ti-bolt me-1 text-yellow"></i>${escapeHtml(anhDienSummary)}</div>
                            <div class="mt-1"><i class="ti ti-droplet me-1 text-azure"></i>${escapeHtml(anhNuocSummary)}</div>
                        </div>
                    `;
                }

                let anhBtn = `
                    <button type="button" class="btn btn-sm btn-ghost-secondary btn-anh-chi-so" data-phong-tro-id="${item.phongTroId}" data-index="${index}" title="Xem và thao tác ảnh chỉ số">
                        ${btnContent}
                    </button>
                `;

                const actionCell = item.isLocked
                    ? '<span class="text-secondary">—</span>'
                    : `<button type="button" class="btn btn-sm ${item.isDaChot ? 'btn-ghost-primary' : 'btn-outline-primary'} btn-chot-phong" title="Chốt riêng phòng ${escapeHtml(item.tenPhong)}">
                            <i class="ti ti-lock-check me-1"></i>${item.isDaChot ? 'Chốt lại' : 'Chốt phòng'}
                       </button>`;

                return `
                    <tr data-index="${index}" class="${rowClass}">
                        <td class="text-center align-middle dn-col-check">
                            <input type="checkbox" class="form-check-input m-0 dn-select" aria-label="Chọn phòng ${escapeHtml(item.tenPhong)}" ${disabledAttr}>
                        </td>
                        <td class="text-center align-middle">${index + 1}</td>
                        <td class="align-middle fw-medium">${escapeHtml(item.tenPhong)}</td>
                        <td class="align-middle">${escapeHtml(item.tenNguoiDaiDien)}</td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center dn-old in-dien-cu" tabindex="-1" value="${item.chiSoDienCu}" readonly>
                        </td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center in-dien-moi" value="${defaultDienMoi}" min="0" ${disabledAttr}>
                            <div class="dn-delta">${deltaText(item.chiSoDienCu, defaultDienMoi, 'kWh')}</div>
                            <div class="invalid-feedback text-center small" style="display: none;">Mới phải ≥ cũ</div>
                            <div class="wrap-lydo-dien mt-1" style="${isOfficialDien ? 'display: none;' : ''}">
                                <input type="text" class="form-control form-control-sm in-lydo-dien" name="lyDoDien" placeholder="Lý do nhập tay" value="" ${disabledAttr}>
                            </div>
                        </td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center dn-old in-nuoc-cu" tabindex="-1" value="${item.chiSoNuocCu}" readonly>
                        </td>
                        <td class="text-center align-middle diennuoc-input-td">
                            <input type="number" class="form-control text-center in-nuoc-moi" value="${defaultNuocMoi}" min="0" ${disabledAttr}>
                            <div class="dn-delta">${deltaText(item.chiSoNuocCu, defaultNuocMoi, 'm³')}</div>
                            <div class="invalid-feedback text-center small" style="display: none;">Mới phải ≥ cũ</div>
                            <div class="wrap-lydo-nuoc mt-1" style="${isOfficialNuoc ? 'display: none;' : ''}">
                                <input type="text" class="form-control form-control-sm in-lydo-nuoc" name="lyDoNuoc" placeholder="Lý do nhập tay" value="" ${disabledAttr}>
                            </div>
                        </td>
                        <td class="text-center align-middle">${anhBtn}</td>
                        <td class="text-center align-middle">${statusBadge}</td>
                        <td class="text-center align-middle dn-col-action">${actionCell}</td>
                    </tr>
                `;
            }

            function renderTable(data) {
                // Hủy DataTable nếu đang có để vẽ lại
                if ($.fn.DataTable.isDataTable('#dienNuocTable')) {
                    $('#dienNuocTable').DataTable().destroy();
                }

                let html = '';
                if (data.length === 0) {
                    html = '<tr><td colspan="11" class="text-center text-secondary py-5">Chi nhánh này chưa có phòng đang thuê.</td></tr>';
                } else {
                    data.forEach((item, index) => {
                        html += renderRow(item, index);
                    });
                }
                
                $('#tbodyDienNuoc').html(html);
                $('#dnSelectAll').prop('checked', false).prop('indeterminate', false);
                updateSummary(data);

                // Khởi tạo lại DataTable (Giữ cuộn dọc, chỉ tìm kiếm và sắp xếp)
                if (data.length > 0) {
                    table = $('#dienNuocTable').DataTable({
                        "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                        "paging": false,
                        "ordering": true,
                        "searching": true,
                        "info": false,
                        "autoWidth": false,
                        "columnDefs": [
                            { "orderable": false, "targets": [0, 1, 4, 5, 6, 7, 8, 9, 10] } // Không sort trên ô chọn, STT, các cột chỉ số, ảnh, trạng thái và thao tác
                        ]
                    });
                    
                    // Tự động căn chỉnh lại độ rộng cột của header sau khi vẽ để thẳng hàng tuyệt đối với body
                    setTimeout(function() {
                        if (table) {
                            table.columns.adjust().draw();
                        }
                    }, 50);
                }
            }

            // Real-time validation viền đỏ khi nhập sai chỉ số điện mới và toggle lý do nhập tay
            $('#tbodyDienNuoc').on('input change', '.in-dien-moi', function () {
                let tr = $(this).closest('tr');
                let index = tr.data('index');
                let rowData = currentData ? currentData[index] : null;
                let cu = parseFloat(tr.find('.in-dien-cu').val()) || 0;
                let moi = parseFloat($(this).val()) || 0;

                if (moi < cu || moi < 0) {
                    $(this).addClass('is-invalid');
                    tr.find('.in-dien-moi').siblings('.invalid-feedback').show();
                } else {
                    $(this).removeClass('is-invalid');
                    tr.find('.in-dien-moi').siblings('.invalid-feedback').hide();
                }

                if (rowData) {
                    let isOfficial = rowData.coAnhDienChinhThuc && (rowData.giaTriDienXacNhanTuAnh != null ? moi === rowData.giaTriDienXacNhanTuAnh : moi === cu);
                    if (isOfficial) {
                        tr.find('.wrap-lydo-dien').hide();
                        tr.find('.in-lydo-dien').removeClass('is-invalid');
                    } else {
                        tr.find('.wrap-lydo-dien').show();
                    }
                }
            });

            // Real-time validation viền đỏ khi nhập sai chỉ số nước mới và toggle lý do nhập tay
            $('#tbodyDienNuoc').on('input change', '.in-nuoc-moi', function () {
                let tr = $(this).closest('tr');
                let index = tr.data('index');
                let rowData = currentData ? currentData[index] : null;
                let cu = parseFloat(tr.find('.in-nuoc-cu').val()) || 0;
                let moi = parseFloat($(this).val()) || 0;

                if (moi < cu || moi < 0) {
                    $(this).addClass('is-invalid');
                    tr.find('.in-nuoc-moi').siblings('.invalid-feedback').show();
                } else {
                    $(this).removeClass('is-invalid');
                    tr.find('.in-nuoc-moi').siblings('.invalid-feedback').hide();
                }

                if (rowData) {
                    let isOfficial = rowData.coAnhNuocChinhThuc && (rowData.giaTriNuocXacNhanTuAnh != null ? moi === rowData.giaTriNuocXacNhanTuAnh : moi === cu);
                    if (isOfficial) {
                        tr.find('.wrap-lydo-nuoc').hide();
                        tr.find('.in-lydo-nuoc').removeClass('is-invalid');
                    } else {
                        tr.find('.wrap-lydo-nuoc').show();
                    }
                }
            });

            $('#tbodyDienNuoc').on('input change', '.in-dien-moi, .in-nuoc-moi', function () {
                const isDien = $(this).hasClass('in-dien-moi');
                const tr = $(this).closest('tr');
                const cu = tr.find(isDien ? '.in-dien-cu' : '.in-nuoc-cu').val();
                $(this).siblings('.dn-delta').text(deltaText(cu, $(this).val(), isDien ? 'kWh' : 'm³'));
            });

            $('#tbodyDienNuoc').on('input change', '.in-lydo-dien, .in-lydo-nuoc', function () {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid');
                }
            });

            // ===== Chọn phòng, đếm thay đổi và thanh thao tác =====
            function allRowNodes() {
                return table ? table.rows().nodes().to$() : $('#tbodyDienNuoc tr');
            }

            function defaultsOf(rowData) {
                return {
                    dien: (rowData.chiSoDienMoi === 0 && !rowData.isDaChot) ? rowData.chiSoDienCu : rowData.chiSoDienMoi,
                    nuoc: (rowData.chiSoNuocMoi === 0 && !rowData.isDaChot) ? rowData.chiSoNuocCu : rowData.chiSoNuocMoi
                };
            }

            function rowHasChanges($tr) {
                const rowData = currentData[$tr.data('index')];
                if (!rowData || rowData.isLocked) return false;
                const d = defaultsOf(rowData);
                return (parseFloat($tr.find('.in-dien-moi').val()) || 0) !== d.dien
                    || (parseFloat($tr.find('.in-nuoc-moi').val()) || 0) !== d.nuoc;
            }

            function changedRows() {
                return allRowNodes().filter(function () { return rowHasChanges($(this)); });
            }

            function selectedRows() {
                return allRowNodes().filter(function () { return $(this).find('.dn-select').is(':checked'); });
            }

            function roomNames($rows) {
                return $rows.map(function () {
                    const rowData = currentData[$(this).data('index')];
                    return rowData ? rowData.tenPhong : null;
                }).get();
            }

            function syncSelectAll() {
                const $boxes = allRowNodes().find('.dn-select:not(:disabled)');
                const checked = $boxes.filter(':checked').length;
                $('#dnSelectAll')
                    .prop('checked', $boxes.length > 0 && checked === $boxes.length)
                    .prop('indeterminate', checked > 0 && checked < $boxes.length);
            }

            function updateBar() {
                const $selected = selectedRows();
                const $changed = changedRows();
                const $bar = $('#stickyActionBar');

                if ($selected.length > 0) {
                    $('#dnBarTitle').text(`Đã chọn ${$selected.length} phòng`);
                    $('#dnBarHint').text(`${roomNames($selected).join(', ')}. Chốt cùng lúc: một phòng lỗi thì cả nhóm không được chốt.`);
                    $('#dnBarSaveLabel').text(`Chốt ${$selected.length} phòng`);
                    $('#btnCancelChanges').text('Bỏ chọn');
                    $bar.attr('data-mode', 'selection').addClass('show-bar');
                } else if ($changed.length > 0) {
                    $('#dnBarTitle').text(`${$changed.length} phòng có chỉ số mới chưa chốt`);
                    $('#dnBarHint').text(roomNames($changed).join(', '));
                    $('#dnBarSaveLabel').text(`Chốt ${$changed.length} phòng`);
                    $('#btnCancelChanges').text('Bỏ thay đổi');
                    $bar.attr('data-mode', 'changes').addClass('show-bar');
                } else {
                    $bar.removeClass('show-bar');
                }
            }

            function hideStickyBar() {
                $('#stickyActionBar').removeClass('show-bar');
            }

            $('#tbodyDienNuoc').on('input change', '.in-dien-moi, .in-nuoc-moi', function () {
                updateBar();
            });

            $('#tbodyDienNuoc').on('change', '.dn-select', function () {
                $(this).closest('tr').toggleClass('dn-selected', this.checked);
                syncSelectAll();
                updateBar();
            });

            $('#dnSelectAll').on('change', function () {
                const on = this.checked;
                allRowNodes().each(function () {
                    const $box = $(this).find('.dn-select:not(:disabled)');
                    $box.prop('checked', on);
                    $(this).toggleClass('dn-selected', on && $box.length > 0);
                });
                updateBar();
            });

            // Click open modal ảnh chỉ số
            $('#tbodyDienNuoc').on('click', '.btn-anh-chi-so', function () {
                let phongTroId = $(this).data('phong-tro-id');
                let index = $(this).data('index');
                let item = currentData ? currentData[index] : null;
                let thang = parseInt($('#filterThang').val());
                let nam = parseInt($('#filterNam').val());
                let tenPhong = item ? item.tenPhong : '';
                if (window.openAnhChiSoModal) {
                    window.openAnhChiSoModal(phongTroId, thang, nam, tenPhong);
                }
            });

            // Làm mới đúng các phòng đã đổi (sau khi chốt hoặc thao tác ảnh); số đang gõ dở ở phòng khác được giữ nguyên
            function refreshRooms(phongTroIds) {
                const chiNhanhId = $('#filterChiNhanh').val();
                const thang = $('#filterThang').val();
                const nam = $('#filterNam').val();
                if (!chiNhanhId || !phongTroIds.length) return;

                $.ajax({
                    url: '/DienNuoc/GetDanhSachPhongs',
                    type: 'GET',
                    data: { chiNhanhId: chiNhanhId, thang: thang, nam: nam },
                    success: function (res) {
                        if (!res || !Array.isArray(res)) return;

                        phongTroIds.forEach(function (phongTroId) {
                            const updatedItem = res.find(x => x.phongTroId === phongTroId);
                            const idx = currentData.findIndex(x => x.phongTroId === phongTroId);
                            if (!updatedItem || idx === -1) return;

                            currentData[idx] = updatedItem;

                            // Hàng đang bị DataTables ẩn do tìm kiếm không nằm trong DOM nên lấy qua danh sách node của bảng
                            const $tr = allRowNodes().filter(function () { return $(this).data('index') === idx; });
                            if ($tr.length > 0) {
                                const $newTr = $(renderRow(updatedItem, idx));
                                $tr.attr('class', $newTr.attr('class') || '');
                                $tr.html($newTr.html());
                                if (table) {
                                    table.row($tr[0]).invalidate('dom');
                                }
                            }
                        });

                        updateSummary(currentData);
                        syncSelectAll();
                        updateBar();
                    }
                });
            }

            window.refreshDienNuocRow = function (phongTroId) {
                refreshRooms([phongTroId]);
            };

            // Bỏ chọn (khi đang chọn phòng) hoặc bỏ thay đổi (khi chỉ có chỉ số chưa chốt)
            $('#btnCancelChanges').on('click', function () {
                if ($('#stickyActionBar').attr('data-mode') === 'selection') {
                    allRowNodes().each(function () {
                        $(this).removeClass('dn-selected').find('.dn-select').prop('checked', false);
                    });
                    syncSelectAll();
                    updateBar();
                    return;
                }

                renderTable(currentData);
                hideStickyBar();
            });

            // Chốt: gom đúng các hàng cần chốt, kiểm tra từng hàng, rồi gửi một giao dịch duy nhất (một phòng lỗi thì cả nhóm hủy)
            function collectPayload($rows) {
                const danhSachPhong = [];
                let ok = true;

                $rows.each(function () {
                    const $tr = $(this);
                    const index = $tr.data('index');
                    if (index === undefined) return;

                    const rowData = currentData[index];
                    if (rowData.isLocked) return;

                    const dienCu = parseFloat($tr.find('.in-dien-cu').val()) || 0;
                    const dienMoi = parseFloat($tr.find('.in-dien-moi').val()) || 0;
                    const nuocCu = parseFloat($tr.find('.in-nuoc-cu').val()) || 0;
                    const nuocMoi = parseFloat($tr.find('.in-nuoc-moi').val()) || 0;

                    if (dienMoi < 0 || nuocMoi < 0) {
                        Swal.fire({ icon: 'error', title: 'Chỉ số không hợp lệ', text: `Phòng ${rowData.tenPhong}: Chỉ số điện/nước mới không được âm.` });
                        ok = false;
                        return false;
                    }

                    if (dienMoi < dienCu) {
                        Swal.fire({ icon: 'error', title: 'Chỉ số điện sai lệch', text: `Phòng ${rowData.tenPhong}: Chỉ số điện mới (${dienMoi}) không được nhỏ hơn chỉ số điện cũ (${dienCu}).` });
                        $tr.find('.in-dien-moi').addClass('is-invalid');
                        ok = false;
                        return false;
                    }

                    if (nuocMoi < nuocCu) {
                        Swal.fire({ icon: 'error', title: 'Chỉ số nước sai lệch', text: `Phòng ${rowData.tenPhong}: Chỉ số nước mới (${nuocMoi}) không được nhỏ hơn chỉ số nước cũ (${nuocCu}).` });
                        $tr.find('.in-nuoc-moi').addClass('is-invalid');
                        ok = false;
                        return false;
                    }

                    const isOfficialDien = rowData.coAnhDienChinhThuc && (rowData.giaTriDienXacNhanTuAnh != null ? dienMoi === rowData.giaTriDienXacNhanTuAnh : dienMoi === dienCu);
                    const isOfficialNuoc = rowData.coAnhNuocChinhThuc && (rowData.giaTriNuocXacNhanTuAnh != null ? nuocMoi === rowData.giaTriNuocXacNhanTuAnh : nuocMoi === nuocCu);
                    const lyDoDien = $tr.find('.in-lydo-dien').val()?.trim() || null;
                    const lyDoNuoc = $tr.find('.in-lydo-nuoc').val()?.trim() || null;

                    if (!isOfficialDien && !lyDoDien) {
                        Swal.fire({ icon: 'warning', title: 'Thiếu lý do nhập tay điện', text: `Phòng ${rowData.tenPhong}: Vui lòng nhập lý do điều chỉnh chỉ số điện thủ công.` });
                        $tr.find('.in-lydo-dien').addClass('is-invalid').focus();
                        ok = false;
                        return false;
                    }

                    if (!isOfficialNuoc && !lyDoNuoc) {
                        Swal.fire({ icon: 'warning', title: 'Thiếu lý do nhập tay nước', text: `Phòng ${rowData.tenPhong}: Vui lòng nhập lý do điều chỉnh chỉ số nước thủ công.` });
                        $tr.find('.in-lydo-nuoc').addClass('is-invalid').focus();
                        ok = false;
                        return false;
                    }

                    danhSachPhong.push({
                        dichVuDienNuocCuaPhongId: rowData.dichVuDienNuocCuaPhongId,
                        phongTroId: rowData.phongTroId,
                        dienMode: isOfficialDien ? 1 : 2,
                        nuocMode: isOfficialNuoc ? 1 : 2,
                        chiSoDienCu: dienCu,
                        chiSoDienMoi: dienMoi,
                        chiSoNuocCu: nuocCu,
                        chiSoNuocMoi: nuocMoi,
                        lyDoNhapThuCongDien: isOfficialDien ? null : lyDoDien,
                        lyDoNhapThuCongNuoc: isOfficialNuoc ? null : lyDoNuoc
                    });
                });

                return ok ? danhSachPhong : null;
            }

            function setChotBusy(busy) {
                $('#btnSaveData, #btnSaveDataSticky, .btn-chot-phong, #btnCancelChanges').prop('disabled', busy);
                $('#btnSaveDataSticky').toggleClass('btn-loading', busy);
            }

            function runChot($rows) {
                const items = collectPayload($rows);
                if (items === null) return;

                if (items.length === 0) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Chưa có phòng nào để chốt',
                        text: 'Nhập chỉ số mới cho phòng cần chốt, hoặc tick chọn phòng rồi chốt.'
                    });
                    return;
                }

                const thang = parseInt($('#filterThang').val());
                const nam = parseInt($('#filterNam').val());
                const names = roomNames($rows);
                const single = items.length === 1;

                Swal.fire({
                    icon: 'question',
                    title: single ? `Chốt phòng ${names[0]}?` : `Chốt ${items.length} phòng?`,
                    text: single
                        ? `Chốt chỉ số điện và nước tháng ${thang}/${nam} của phòng ${names[0]}. Các phòng khác không bị ảnh hưởng.`
                        : `Chốt chỉ số tháng ${thang}/${nam} cho: ${names.join(', ')}. Nếu một phòng không hợp lệ, cả nhóm sẽ không được chốt.`,
                    showCancelButton: true,
                    confirmButtonText: single ? 'Chốt phòng' : 'Chốt nhóm',
                    cancelButtonText: 'Xem lại'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    setChotBusy(true);
                    $.ajax({
                        url: '/DienNuoc/SaveChotDienNuoc',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            chiNhanhId: parseInt($('#filterChiNhanh').val()),
                            thang: thang,
                            nam: nam,
                            danhSachPhong: items
                        }),
                        success: function (res) {
                            showSuccess(res.message);
                            refreshRooms(items.map(i => i.phongTroId));
                        },
                        error: function (xhr) {
                            // Giữ nguyên các hàng và lựa chọn để người dùng sửa phòng lỗi rồi chốt lại
                            showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi chốt chỉ số.');
                        },
                        complete: function () {
                            setChotBusy(false);
                        }
                    });
                });
            }

            // Chốt tất cả: các phòng đã có chỉ số mới hoặc ảnh chính thức; phòng chưa nhập gì và phòng đã chốt không đổi thì bỏ qua
            function chotAll() {
                if (currentData.length === 0) return;

                const $rows = allRowNodes().filter(function () {
                    const rowData = currentData[$(this).data('index')];
                    if (!rowData || rowData.isLocked) return false;
                    if (rowHasChanges($(this))) return true;
                    if (rowData.isDaChot) return false;
                    return !!(rowData.coAnhDienChinhThuc || rowData.coAnhNuocChinhThuc);
                });

                runChot($rows);
            }

            $('#btnSaveData').on('click', chotAll);

            $('#btnSaveDataSticky').on('click', function () {
                runChot($('#stickyActionBar').attr('data-mode') === 'selection' ? selectedRows() : changedRows());
            });

            $('#tbodyDienNuoc').on('click', '.btn-chot-phong', function () {
                runChot($(this).closest('tr'));
            });
        });
    </script>
}
