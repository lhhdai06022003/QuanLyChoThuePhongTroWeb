@* Partial Modal Ảnh Chỉ Số Điện Nước *@
<div class="modal fade" id="modalAnhChiSo" tabindex="-1" data-bs-focus="false" aria-labelledby="modalAnhChiSoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light py-2">
                <h5 class="modal-title font-weight-bold d-flex align-items-center" id="modalAnhChiSoLabel">
                    <i class="ti ti-photo me-2 text-primary"></i>
                    <span>Ảnh chỉ số — Phòng <span id="modalTenPhong" class="text-primary font-weight-bold"></span> — Kỳ <span id="modalKy" class="text-secondary font-weight-bold"></span></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body p-3 anh-chi-so-modal-body">
                <!-- Banner cảnh báo kỳ bị khóa -->
                <div id="modalKyKhoaBanner" class="alert alert-warning py-2 mb-3" style="display: none;">
                    <i class="ti ti-lock me-1"></i>
                    <strong>Kỳ đã khóa:</strong> <span id="modalLyDoKhoa"></span>
                </div>

                <!-- Tabs Điện / Nước -->
                <ul class="nav nav-tabs mb-3" id="meterTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active font-weight-bold" id="tab-dien-btn" data-bs-toggle="tab" data-bs-target="#tab-dien" type="button" role="tab">
                            ⚡ Đồng hồ Điện (<span id="countAnhDien">0</span>)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link font-weight-bold" id="tab-nuoc-btn" data-bs-toggle="tab" data-bs-target="#tab-nuoc" type="button" role="tab">
                            💧 Đồng hồ Nước (<span id="countAnhNuoc">0</span>)
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="meterTabContent">
                    <!-- Tab Điện -->
                    <div class="tab-pane fade show active" id="tab-dien" role="tabpanel">
                        <div class="meter-thumbnail-strip mb-3" id="stripAnhDien">
                            <!-- Danh sách thumbnail điện -->
                        </div>
                    </div>

                    <!-- Tab Nước -->
                    <div class="tab-pane fade" id="tab-nuoc" role="tabpanel">
                        <div class="meter-thumbnail-strip mb-3" id="stripAnhNuoc">
                            <!-- Danh sách thumbnail nước -->
                        </div>
                    </div>
                </div>

                <!-- Main Workspace: Khung xem lớn + Cột Thông tin & Thao tác -->
                <div class="row g-3" id="meterWorkspace">
                    <!-- Khung xem ảnh lớn (Trái) -->
                    <div class="col-lg-7">
                        <div class="meter-viewer-container">
                            <div class="meter-viewer-toolbar">
                                <button type="button" class="btn btn-sm btn-dark" id="btnZoomIn" title="Phóng to">
                                    <i class="ti ti-zoom-in"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-dark" id="btnZoomOut" title="Thu nhỏ">
                                    <i class="ti ti-zoom-out"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-dark" id="btnRotate" title="Xoay 90°">
                                    <i class="ti ti-rotate-clockwise"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary" id="btnResetZoom" title="Đặt lại kích thước">
                                    <i class="ti ti-arrows-maximize"></i>
                                </button>
                            </div>
                            <div class="meter-viewer-stage" id="viewerStage">
                                <img src="" alt="Ảnh đồng hồ" class="meter-viewer-img" id="mainViewerImg" style="display: none;" />
                                <div id="viewerEmptyState" class="text-center text-muted p-5">
                                    <i class="ti ti-photo-off fa-3x mb-2 d-block opacity-50"></i>
                                    <span>Chưa có ảnh nào được chọn.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cột Thông tin & Thao tác (Phải) -->
                    <div class="col-lg-5">
                        <!-- Thẻ thông tin ảnh đang chọn -->
                        <div class="meter-info-card card mb-3">
                            <div class="card-body p-3">
                                <h6 class="card-title font-weight-bold text-uppercase text-secondary mb-2 small">
                                    Thông tin ảnh được chọn
                                </h6>
                                <div id="selectedImageDetails">
                                    <div class="text-muted small">Vui lòng chọn một ảnh để xem chi tiết.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Khu vực Thao tác ảnh (hiện theo cờ) -->
                        <div class="meter-action-box card mb-3" id="boxActionImage" style="display: none;">
                            <div class="card-body p-3">
                                <h6 class="card-title font-weight-bold text-uppercase text-secondary mb-2 small">
                                    Thao tác trên ảnh
                                </h6>

                                <!-- 1. Thử lại OCR -->
                                <div id="actionThuLaiWrap" class="mb-2" style="display: none;">
                                    <button type="button" class="btn btn-warning btn-sm w-100 font-weight-bold" id="btnThuLai">
                                        <i class="ti ti-refresh me-1"></i> Thử nhận diện lại
                                    </button>
                                </div>

                                <!-- 2. Xác nhận chỉ số -->
                                <div id="actionXacNhanWrap" class="border rounded p-2 mb-2 bg-light" style="display: none;">
                                    <label class="form-label small font-weight-bold mb-1">
                                        Xác nhận chỉ số <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="number" step="0.001" min="0" class="form-control font-weight-bold text-primary" id="inGiaTriXacNhan" placeholder="Nhập chỉ số..." />
                                        <span class="input-group-text unit-text">kWh/m³</span>
                                    </div>
                                    <div class="mb-2" id="wrapGhiChuXacNhan">
                                        <label class="form-label small mb-1" id="lblGhiChuXacNhan">
                                            Ghi chú xác nhận <span id="lblBatBuocLyDo" class="text-danger small font-weight-normal">(bắt buộc vì ảnh không đọc được)</span>
                                        </label>
                                        <input type="text" class="form-control form-control-sm" id="inGhiChuXacNhan" placeholder="Nhập lý do / ghi chú..." maxlength="500" />
                                    </div>
                                    <button type="button" class="btn btn-success btn-sm w-100 font-weight-bold" id="btnSubmitXacNhan">
                                        <i class="ti ti-check me-1"></i> Xác nhận chỉ số
                                    </button>
                                </div>

                                <!-- 3. Sửa số đã xác nhận -->
                                <div id="actionSuaSoWrap" class="border rounded p-2 mb-2 bg-light" style="display: none;">
                                    <label class="form-label small font-weight-bold mb-1">
                                        Sửa số đã xác nhận <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="number" step="0.001" min="0" class="form-control font-weight-bold text-danger" id="inGiaTriSuaSo" placeholder="Số mới..." />
                                        <span class="input-group-text unit-text">kWh/m³</span>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">
                                            Lý do điều chỉnh <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control form-control-sm" id="inLyDoSuaSo" placeholder="Nhập lý do điều chỉnh..." maxlength="500" />
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm w-100 font-weight-bold" id="btnSubmitSuaSo">
                                        <i class="ti ti-edit me-1"></i> Lưu số điều chỉnh
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Khu vực Tải ảnh thay khách -->
                        <div class="card" id="boxUploadThayKhach">
                            <div class="card-body p-3">
                                <h6 class="card-title font-weight-bold text-uppercase text-secondary mb-2 small">
                                    Tải ảnh thay khách
                                </h6>
                                <div id="uploadAllowedSection">
                                    <form id="formUploadMeterImage" enctype="multipart/form-data">
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Loại đồng hồ</label>
                                            <div class="btn-group w-100" role="group">
                                                <input type="radio" class="btn-check" name="radioLoaiDongHo" id="optDien" value="0" autocomplete="off" checked>
                                                <label class="btn btn-outline-warning btn-sm" for="optDien">⚡ Điện</label>

                                                <input type="radio" class="btn-check" name="radioLoaiDongHo" id="optNuoc" value="1" autocomplete="off">
                                                <label class="btn btn-outline-info btn-sm" for="optNuoc">💧 Nước</label>
                                            </div>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Chọn tệp ảnh (JPG, PNG, WEBP, tối đa 5MB)</label>
                                            <input type="file" class="form-control form-control-sm" id="fileUploadInput" accept="image/jpeg,image/png,image/webp" capture="environment" />
                                        </div>
                                        <button type="submit" class="btn btn-outline-primary btn-sm w-100 font-weight-bold" id="btnUploadImage">
                                            <i class="ti ti-upload me-1"></i> Tải ảnh & Nhận diện ngay
                                        </button>
                                    </form>
                                </div>
                                <div id="uploadBlockedSection" class="text-muted small py-2" style="display: none;">
                                    <i class="ti ti-info-circle me-1 text-warning"></i>
                                    <span id="txtLyDoKhongTheTai"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/anh-chi-so-viewer.js" asp-append-version="true" defer></script>

<script>
    // jQuery được nạp ở cuối _Layout (sau RenderBody), nên chỉ khởi tạo khi DOM sẵn sàng.
    document.addEventListener('DOMContentLoaded', function () {
        let currentPeriodData = null;
        let selectedImage = null;
        let viewer = null;
        let activeTab = 0; // 0: Điện, 1: Nước
        let currentPhongTroId = 0;
        let currentThang = 0;
        let currentNam = 0;

        const STATUS_CLASSES = {
            0: 'bg-secondary text-white',
            1: 'bg-info text-white',
            2: 'bg-primary text-white',
            3: 'bg-danger text-white',
            4: 'bg-warning text-dark',
            5: 'bg-warning text-dark',
            6: 'bg-success text-white',
            7: 'bg-dark text-white'
        };

        function getCsrfToken() {
            return $('input[name="__RequestVerificationToken"]').first().val() || '';
        }

        function initViewer() {
            if (!viewer) {
                viewer = new MeterImageViewer({
                    containerId: 'viewerStage',
                    imageId: 'mainViewerImg',
                    zoomInBtnId: 'btnZoomIn',
                    zoomOutBtnId: 'btnZoomOut',
                    rotateBtnId: 'btnRotate',
                    resetBtnId: 'btnResetZoom'
                });
            }
        }

        window.openAnhChiSoModal = function (phongTroId, thang, nam, tenPhong) {
            currentPhongTroId = phongTroId;
            currentThang = thang;
            currentNam = nam;

            $('#modalTenPhong').text(tenPhong || ('#' + phongTroId));
            $('#modalKy').text((thang < 10 ? '0' + thang : thang) + '/' + nam);
            $('#modalAnhChiSo').modal('show');

            initViewer();
            loadModalData();
        };

        function loadModalData(selectImageId) {
            $.ajax({
                url: '/DienNuoc/AnhChiSo',
                type: 'GET',
                data: { phongTroId: currentPhongTroId, thang: currentThang, nam: currentNam },
                success: function (res) {
                    if (res && res.success && res.data) {
                        currentPeriodData = res.data;
                        renderModal(selectImageId);
                    } else {
                        showError(res?.message || 'Không thể tải dữ liệu ảnh chỉ số.');
                    }
                },
                error: function (xhr) {
                    showError(xhr.responseJSON?.message || 'Lỗi kết nối khi tải ảnh chỉ số.');
                }
            });
        }

        function renderModal(preferredImageId) {
            if (!currentPeriodData) return;

            // Lock banner
            if (currentPeriodData.kyBiKhoa) {
                $('#modalKyKhoaBanner').show();
                $('#modalLyDoKhoa').text(currentPeriodData.lyDoKhoa || 'Kỳ đã khóa.');
            } else {
                $('#modalKyKhoaBanner').hide();
            }

            // Upload section
            if (currentPeriodData.coTheTaiAnh && !currentPeriodData.kyBiKhoa) {
                $('#uploadAllowedSection').show();
                $('#uploadBlockedSection').hide();
            } else {
                $('#uploadAllowedSection').hide();
                $('#uploadBlockedSection').show();
                $('#txtLyDoKhongTheTai').text(currentPeriodData.kyBiKhoa ? currentPeriodData.lyDoKhoa : (currentPeriodData.lyDoKhongTheTai || 'Không thể tải ảnh cho kỳ này.'));
            }

            const anhDien = currentPeriodData.anhDien || [];
            const anhNuoc = currentPeriodData.anhNuoc || [];

            $('#countAnhDien').text(anhDien.length);
            $('#countAnhNuoc').text(anhNuoc.length);

            renderThumbnailStrip('#stripAnhDien', anhDien);
            renderThumbnailStrip('#stripAnhNuoc', anhNuoc);

            // Select image
            let targetImage = null;
            const currentList = activeTab === 0 ? anhDien : anhNuoc;

            if (preferredImageId) {
                targetImage = [...anhDien, ...anhNuoc].find(x => x.id === preferredImageId);
                if (targetImage) {
                    activeTab = targetImage.loai;
                    if (activeTab === 0) {
                        $('#tab-dien-btn').tab('show');
                    } else {
                        $('#tab-nuoc-btn').tab('show');
                    }
                }
            }

            if (!targetImage && currentList.length > 0) {
                // Ưu tiên ảnh chính thức hoặc ảnh đầu tiên
                targetImage = currentList.find(x => x.laChinhThuc) || currentList[0];
            }

            selectImage(targetImage);
        }

        function renderThumbnailStrip(selector, images) {
            if (!images || images.length === 0) {
                $(selector).html('<div class="text-muted small py-2 px-1">Chưa có ảnh nào được gửi cho loại đồng hồ này.</div>');
                return;
            }

            let html = '';
            images.forEach(img => {
                const badgeClass = STATUS_CLASSES[img.trangThai] || 'bg-secondary text-white';
                const officialBadge = img.laChinhThuc ? '<span class="badge bg-success ms-1">Chính thức</span>' : '';
                html += `
                    <div class="meter-thumbnail-item" data-img-id="${img.id}">
                        <img src="${escapeHtml(img.url)}" alt="Ảnh đồng hồ" class="meter-thumbnail-img" />
                        <div class="mt-1 d-flex flex-wrap gap-1">
                            <span class="badge ${badgeClass} small" style="font-size: 0.65rem;">${escapeHtml(img.nhanTrangThai)}</span>
                            ${officialBadge}
                        </div>
                        <div class="text-muted text-truncate mt-1" style="font-size: 0.65rem;">${escapeHtml(img.ngayGui)}</div>
                    </div>
                `;
            });

            $(selector).html(html);
        }

        function selectImage(img) {
            selectedImage = img;
            $('.meter-thumbnail-item').removeClass('meter-thumbnail-active');

            if (!img) {
                $('#mainViewerImg').hide();
                $('#viewerEmptyState').show();
                $('#selectedImageDetails').html('<div class="text-muted small">Không có ảnh nào trong mục này.</div>');
                $('#boxActionImage').hide();
                return;
            }

            $(`.meter-thumbnail-item[data-img-id="${img.id}"]`).addClass('meter-thumbnail-active');
            $('#viewerEmptyState').hide();
            $('#mainViewerImg').show();
            if (viewer) {
                viewer.loadImage(img.url);
            }

            // Render info
            const badgeClass = STATUS_CLASSES[img.trangThai] || 'bg-secondary text-white';
            const chiSoCuHienThi = activeTab === 0 ? currentPeriodData.chiSoDienCu : currentPeriodData.chiSoNuocCu;

            let detailsHtml = `
                <div class="mb-2">
                    <span class="badge ${badgeClass} me-1">${escapeHtml(img.nhanTrangThai)}</span>
                    ${img.laChinhThuc ? '<span class="badge bg-success">Chính thức</span>' : ''}
                </div>
                <div class="row g-2 mb-2 small">
                    <div class="col-6">
                        <span class="text-muted">Chỉ số cũ kỳ:</span>
                        <div class="font-weight-bold">${formatNumber(chiSoCuHienThi)}</div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Số AI gợi ý:</span>
                        <div class="font-weight-bold text-primary">${img.giaTriAI ? escapeHtml(img.giaTriAI) : '—'} ${img.doTinCay ? `<span class="badge bg-info-lt text-info ms-1">${escapeHtml(img.doTinCay)}</span>` : ''}</div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Số chính thức:</span>
                        <div class="font-weight-bold text-success">${img.giaTriXacNhan ? escapeHtml(img.giaTriXacNhan) : '—'}</div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Nguồn gửi:</span>
                        <div class="font-weight-medium">${escapeHtml(img.nguonGui || '—')}</div>
                    </div>
                    <div class="col-12">
                        <span class="text-muted">Thời điểm gửi:</span>
                        <div class="font-weight-medium">${escapeHtml(img.ngayGui)}</div>
                    </div>
                </div>
            `;

            if (img.thongBaoLoi) {
                detailsHtml += `
                    <div class="alert alert-danger py-1 px-2 mb-2 small">
                        <i class="ti ti-alert-circle me-1"></i> ${escapeHtml(img.thongBaoLoi)}
                    </div>
                `;
            }

            if (img.ghiChuXacNhan) {
                detailsHtml += `
                    <div class="alert alert-info py-1 px-2 mb-2 small">
                        <i class="ti ti-note me-1"></i> <strong>Ghi chú:</strong> ${escapeHtml(img.ghiChuXacNhan)}
                    </div>
                `;
            }

            $('#selectedImageDetails').html(detailsHtml);

            // Render Actions
            if (currentPeriodData.kyBiKhoa) {
                $('#boxActionImage').hide();
                return;
            }

            let hasAnyAction = false;

            if (img.coTheThuLai) {
                $('#actionThuLaiWrap').show();
                hasAnyAction = true;
            } else {
                $('#actionThuLaiWrap').hide();
            }

            if (img.coTheXacNhan) {
                $('#actionXacNhanWrap').show();
                $('#inGiaTriXacNhan').val(img.giaTriAISo !== null && img.giaTriAISo !== undefined ? img.giaTriAISo : '');
                $('#inGhiChuXacNhan').val('');
                if (img.canLyDo) {
                    $('#lblBatBuocLyDo').show();
                } else {
                    $('#lblBatBuocLyDo').hide();
                }
                hasAnyAction = true;
            } else {
                $('#actionXacNhanWrap').hide();
            }

            if (img.coTheSuaSo) {
                $('#actionSuaSoWrap').show();
                $('#inGiaTriSuaSo').val('');
                $('#inLyDoSuaSo').val('');
                hasAnyAction = true;
            } else {
                $('#actionSuaSoWrap').hide();
            }

            if (hasAnyAction) {
                $('#boxActionImage').show();
            } else {
                $('#boxActionImage').hide();
            }
        }

        function formatNumber(val) {
            if (val === null || val === undefined) return '0';
            return Number(val).toLocaleString('vi-VN', { maximumFractionDigits: 3 });
        }

        // Tab events
        $('#tab-dien-btn').on('shown.bs.tab', function () {
            activeTab = 0;
            $('#optDien').prop('checked', true);
            const anhDien = currentPeriodData?.anhDien || [];
            selectImage(anhDien.find(x => x.laChinhThuc) || anhDien[0] || null);
        });

        $('#tab-nuoc-btn').on('shown.bs.tab', function () {
            activeTab = 1;
            $('#optNuoc').prop('checked', true);
            const anhNuoc = currentPeriodData?.anhNuoc || [];
            selectImage(anhNuoc.find(x => x.laChinhThuc) || anhNuoc[0] || null);
        });

        // Click thumbnail
        $('#meterTabContent').on('click', '.meter-thumbnail-item', function () {
            const id = $(this).data('img-id');
            const allImages = [...(currentPeriodData?.anhDien || []), ...(currentPeriodData?.anhNuoc || [])];
            const target = allImages.find(x => x.id === id);
            if (target) {
                selectImage(target);
            }
        });

        // Action: Thử nhận diện lại
        $('#btnThuLai').on('click', function () {
            if (!selectedImage) return;
            const $btn = $(this);
            const origHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin me-1"></i> Đang thử lại...');

            $.ajax({
                url: `/DienNuoc/AnhChiSo/${selectedImage.id}/ThuLai`,
                type: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                success: function (res) {
                    showSuccess(res.message || 'Thử nhận diện lại thành công.');
                    loadModalData(selectedImage.id);
                    if (window.refreshDienNuocRow) {
                        window.refreshDienNuocRow(currentPhongTroId);
                    }
                },
                error: function (xhr) {
                    showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi thử nhận diện lại.');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(origHtml);
                }
            });
        });

        // Action: Xác nhận chỉ số
        $('#btnSubmitXacNhan').on('click', function () {
            if (!selectedImage) return;

            const valStr = $('#inGiaTriXacNhan').val();
            if (!valStr || isNaN(parseFloat(valStr))) {
                showWarning('Vui lòng nhập chỉ số hợp lệ.');
                $('#inGiaTriXacNhan').focus();
                return;
            }

            const giaTri = parseFloat(valStr);
            if (giaTri < 0) {
                showWarning('Chỉ số xác nhận không được âm.');
                $('#inGiaTriXacNhan').focus();
                return;
            }

            const ghiChu = $('#inGhiChuXacNhan').val().trim();
            if (selectedImage.canLyDo && !ghiChu) {
                showWarning('Ảnh không đọc được bắt buộc phải có ghi chú / lý do xác nhận.');
                $('#inGhiChuXacNhan').focus();
                return;
            }

            const $btn = $(this);
            const origHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin me-1"></i> Đang xác nhận...');

            $.ajax({
                url: `/DienNuoc/AnhChiSo/${selectedImage.id}/XacNhan`,
                type: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                contentType: 'application/json',
                data: JSON.stringify({ giaTriXacNhan: giaTri, ghiChu: ghiChu || null }),
                success: function (res) {
                    showSuccess(res.message || 'Xác nhận chỉ số thành công.');
                    loadModalData(selectedImage.id);
                    if (window.refreshDienNuocRow) {
                        window.refreshDienNuocRow(currentPhongTroId);
                    }
                },
                error: function (xhr) {
                    showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi xác nhận chỉ số.');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(origHtml);
                }
            });
        });

        // Action: Sửa số đã xác nhận
        $('#btnSubmitSuaSo').on('click', function () {
            if (!selectedImage) return;

            const valStr = $('#inGiaTriSuaSo').val();
            if (!valStr || isNaN(parseFloat(valStr))) {
                showWarning('Vui lòng nhập chỉ số mới hợp lệ.');
                $('#inGiaTriSuaSo').focus();
                return;
            }

            const giaTriMoi = parseFloat(valStr);
            if (giaTriMoi < 0) {
                showWarning('Chỉ số mới không được âm.');
                $('#inGiaTriSuaSo').focus();
                return;
            }

            const lyDo = $('#inLyDoSuaSo').val().trim();
            if (!lyDo) {
                showWarning('Vui lòng nhập lý do sửa số.');
                $('#inLyDoSuaSo').focus();
                return;
            }

            const $btn = $(this);
            const origHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin me-1"></i> Đang lưu...');

            $.ajax({
                url: `/DienNuoc/AnhChiSo/${selectedImage.id}/SuaSo`,
                type: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                contentType: 'application/json',
                data: JSON.stringify({ giaTriMoi: giaTriMoi, lyDo: lyDo }),
                success: function (res) {
                    showSuccess(res.message || 'Sửa chỉ số thành công.');
                    loadModalData(selectedImage.id);
                    if (window.refreshDienNuocRow) {
                        window.refreshDienNuocRow(currentPhongTroId);
                    }
                },
                error: function (xhr) {
                    showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi sửa chỉ số.');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(origHtml);
                }
            });
        });

        // Action: Tải ảnh thay khách
        $('#formUploadMeterImage').on('submit', function (e) {
            e.preventDefault();

            const fileInput = document.getElementById('fileUploadInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                showWarning('Vui lòng chọn ảnh đồng hồ để tải lên.');
                return;
            }

            const loaiDongHo = $('input[name="radioLoaiDongHo"]:checked').val() || '0';
            const formData = new FormData();
            formData.append('phongTroId', currentPhongTroId);
            formData.append('thang', currentThang);
            formData.append('nam', currentNam);
            formData.append('loaiDongHo', loaiDongHo);
            formData.append('file', fileInput.files[0]);

            const $btn = $('#btnUploadImage');
            const origHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin me-1"></i> Đang tải ảnh và nhận diện…');

            $.ajax({
                url: '/DienNuoc/AnhChiSo/TaiLen',
                type: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    showSuccess(res.message || 'Tải ảnh và nhận diện thành công.');
                    fileInput.value = '';
                    const newImageId = res.data?.id;
                    loadModalData(newImageId);
                    if (window.refreshDienNuocRow) {
                        window.refreshDienNuocRow(currentPhongTroId);
                    }
                },
                error: function (xhr) {
                    showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi tải ảnh lên.');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(origHtml);
                }
            });
        });

        function showSuccess(msg) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: msg,
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        }

        function showWarning(msg) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thông báo',
                    text: msg
                });
            } else {
                alert(msg);
            }
        }

        function showError(msg) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: msg
                });
            } else {
                alert(msg);
            }
        }
    });
</script>
