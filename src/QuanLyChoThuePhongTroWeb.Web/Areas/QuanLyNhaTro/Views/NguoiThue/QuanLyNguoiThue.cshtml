@using QuanLyChoThuePhongTroWeb.Application.Features.NguoiThues.DTOs
@model IEnumerable<NguoiThueReq>
@{
    ViewData["Title"] = "Người thuê";
}

<div class="container-xl mt-3">
    <div class="page-header d-print-none mb-3">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Người thuê</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button type="button" class="btn btn-primary" id="btnOpenAddModal">
                        <i class="ti ti-plus me-1"></i> Thêm người thuê
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="nguoiThueTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                    <thead>
                        <tr>
                            <th class="w-1 text-center">STT</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>CCCD</th>
                            <th>Ngày sinh</th>
                            <th>Quê quán</th>
                            <th class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nguoiThueModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Người Thuê Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <form id="frmNguoiThue">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="HoVaTen">Họ và Tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="HoVaTen" required placeholder="Nhập họ tên...">
                            </div>
                            
                            <div class="form-group mb-3">
                                <label for="Email">Email</label>
                                <input type="email" class="form-control" id="Email" placeholder="Nhập email (nếu có)...">
                            </div>

                            <div class="form-group mb-3">
                                <label for="SoDienThoai">Số Điện Thoại <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="SoDienThoai" required placeholder="Nhập SĐT...">
                            </div>
                            
                            <div class="form-group mb-3">
                                <label for="NgaySinh">Ngày Sinh</label>
                                <input type="date" class="form-control" id="NgaySinh">
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="CCCD">Số CCCD <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="CCCD" required placeholder="Nhập số CCCD...">
                            </div>
                            <div class="form-group mb-3">
                                <label for="NgayCapCCCD">Ngày Cấp CCCD</label>
                                <input type="date" class="form-control" id="NgayCapCCCD">
                            </div>
                            <div class="form-group mb-3">
                                <label for="NoiCapCCCD">Nơi Cấp CCCD</label>
                                <input type="text" class="form-control" id="NoiCapCCCD" placeholder="Nơi cấp...">
                            </div>
                            <div class="form-group mb-3">
                                <label for="QueQuan">Quê Quán</label>
                                <input type="text" class="form-control" id="QueQuan" placeholder="Nhập quê quán...">
                            </div>
                        </div>
                        
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label for="GhiChu">Ghi Chú</label>
                                <textarea class="form-control" id="GhiChu" rows="2" placeholder="Ghi chú thêm..."></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveData">
                    <i class="ti ti-plus me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/quan-ly-nguoi-thue.js" asp-append-version="true"></script>
}
