@{
    ViewData["Title"] = "Phòng trọ";
    // Thêm, xóa phòng chỉ dành cho Admin; server chặn lại lần nữa nên đây chỉ là ẩn nút.
    var laAdmin = User.IsInRole("Admin");
}

<div class="container-xl mt-3">
    <!-- Header bar: Toggle + Add button -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center justify-content-between g-2">
            <div class="col-auto">
                <h2 class="page-title m-0">Phòng trọ</h2>
            </div>
            <div class="col-auto order-sm-3 ms-auto">
                @if (laAdmin)
                {
                    <button type="button" class="btn btn-primary" id="btnOpenAddModal">
                        <i class="ti ti-plus me-1"></i> Thêm phòng
                    </button>
                }
            </div>
            <div class="col-12 col-sm-auto order-sm-2">
                <div class="view-toggle btn-group" role="group">
                    <button class="btn btn-outline-secondary active" id="btnGridView"><i class="ti ti-apps me-1"></i>Sơ đồ</button>
                    <button class="btn btn-outline-secondary" id="btnTableView"><i class="ti ti-table me-1"></i>Bảng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============= GRID VIEW ============= -->
    <div id="gridViewSection">
        <!-- Stats -->
        <div class="row row-cards mb-3">
            <div class="col-6 col-lg-3">
                <a href="#" role="button" class="card card-sm card-link h-100 room-o-so" data-loc="trong">
                    <div class="card-body">
                        <div class="ts-o-so-nhan is-ok">Phòng trống</div>
                        <div class="ts-o-so-gia-tri" id="statTrong">0</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a href="#" role="button" class="card card-sm card-link h-100 room-o-so" data-loc="dathue">
                    <div class="card-body">
                        <div class="ts-o-so-nhan">Đã thuê</div>
                        <div class="ts-o-so-gia-tri" id="statDaThue">0</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a href="#" role="button" class="card card-sm card-link h-100 room-o-so" data-loc="notien">
                    <div class="card-body">
                        <div class="ts-o-so-nhan is-bad">Đang nợ</div>
                        <div class="ts-o-so-gia-tri" id="statNoTien">0</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a href="#" role="button" class="card card-sm card-link h-100 room-o-so" data-loc="saphethan">
                    <div class="card-body">
                        <div class="ts-o-so-nhan is-wait">Sắp hết hạn</div>
                        <div class="ts-o-so-gia-tri" id="statSapHetHan">0</div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row align-items-center g-2">
                    <div class="col-12 col-md-3">
                        <select id="filterChiNhanhGrid" class="form-select form-select-sm">
                            <option value="0">Tất cả chi nhánh</option>
                            @if (ViewBag.ChiNhanhs != null)
                            {
                                foreach (var cn in ViewBag.ChiNhanhs)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 d-flex flex-wrap gap-1">
                        <button class="filter-btn active" data-filter="all"><i class="ti ti-layout-grid me-1"></i>Tất cả</button>
                        <button class="filter-btn" data-filter="trong"><span class="room-status-dot dot-trong"></span>Trống</button>
                        <button class="filter-btn" data-filter="dathue"><span class="room-status-dot dot-dathue"></span>Đã thuê</button>
                        <button class="filter-btn" data-filter="baotri"><span class="room-status-dot dot-baotri"></span>Bảo trì</button>
                        <button class="filter-btn" data-filter="notien"><i class="ti ti-alert-circle me-1"></i>Nợ tiền</button>
                        <button class="filter-btn" data-filter="saphethan"><i class="ti ti-hourglass me-1"></i>Sắp hết hạn</button>
                    </div>
                    <div class="col-12 col-md-3 ms-auto text-end">
                        <input type="search" id="searchRoom" class="form-control form-control-sm w-100" placeholder="Tìm phòng hoặc người thuê" aria-label="Tìm phòng hoặc người thuê">
                    </div>
                </div>
            </div>
        </div>

        <!-- Room cards grouped by floor -->
        <div id="roomGrid"></div>
        <div id="emptyState" class="text-center py-5" style="display:none;">
            <i class="ti ti-building fa-3x text-muted mb-3"></i>
            <p class="text-muted">Không có phòng nào phù hợp với bộ lọc.</p>
        </div>
    </div>

    <!-- ============= TABLE VIEW ============= -->
    <div id="tableViewSection" style="display:none;">
        <div class="card">
            <div class="card-body border-bottom py-3">
                <div class="row align-items-center g-2">
                    <div class="col-12 col-sm-auto ms-auto d-flex align-items-center text-muted fw-medium">
                        <span class="d-none d-sm-inline me-2 text-nowrap">Chi nhánh:</span>
                        <select id="filterChiNhanhTable" class="form-select form-select-sm w-100 w-sm-auto">
                            <option value="">Tất cả chi nhánh</option>
                            @if (ViewBag.ChiNhanhs != null)
                            {
                                foreach (var cn in ViewBag.ChiNhanhs)
                                {
                                    <option value="@cn.Text">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="phongTroTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%">STT</th>
                                <th width="25%">Chi nhánh</th>
                                <th width="12%">Số phòng</th>
                                <th class="text-center" width="10%">Tầng</th>
                                <th class="text-end num-tabular" width="15%">Giá thuê</th>
                                <th class="text-center" width="10%">Diện tích</th>
                                <th class="text-center" width="13%">Trạng thái</th>
                                <th class="w-1" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa -->
<div class="modal fade" id="phongTroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Cập nhật thông tin phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ChiNhanhId" class="form-label">Chi nhánh <span class="text-danger">*</span></label>
                        <select id="ChiNhanhId" class="form-select">
                            <option value="">-- Chọn Chi Nhánh --</option>
                            @if (ViewBag.ChiNhanhs != null)
                            {
                                foreach (var cn in ViewBag.ChiNhanhs)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="SoPhong" class="form-label">Số phòng <span class="text-danger">*</span></label>
                        <input type="text" id="SoPhong" class="form-control" placeholder="VD: P.101">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="TangLau" class="form-label">Tầng lầu</label>
                        <input type="number" id="TangLau" class="form-control" value="1">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="GiaThue" class="form-label">Giá thuê (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" id="GiaThue" class="form-control" placeholder="VD: 3000000">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="DienTich" class="form-label">Diện tích (m²)</label>
                        <input type="number" id="DienTich" class="form-control" placeholder="VD: 20">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="SoNguoiToiDa" class="form-label">Số người tối đa</label>
                        <input type="number" id="SoNguoiToiDa" class="form-control" value="2">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="TrangThai" class="form-label">Trạng thái</label>
                        <select id="TrangThai" class="form-select">
                            <option value="0">Trống</option>
                            <option value="1">Đã Thuê</option>
                            <option value="2">Bảo Trì</option>
                        </select>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label for="MoTa" class="form-label">Mô tả</label>
                        <textarea id="MoTa" class="form-control" rows="3" placeholder="Nội thất, tiện ích đi kèm..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveData">Thêm dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết phòng -->
<div class="modal fade" id="roomDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="roomDetailHeader">
                <h5 class="modal-title"><span id="detailRoomName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="roomDetailBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Quản lý dịch vụ phòng -->
<div class="modal fade" id="dichVuPhongModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="dichVuPhongTitle">Quản lý dịch vụ</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 mb-3">
                    <i class="ti ti-info-circle me-1"></i>
                    Dịch vụ <strong>Mặc định</strong> (Điện, Nước) tự động đăng ký. Các dịch vụ khác có thể nhập số lượng.
                </div>
                <div id="dichVuPhongContainer">
                    <div class="text-center py-4"><i class="ti ti-loader fa-spin fa-2x"></i></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveDichVuPhong">
                    Lưu dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem nhanh hợp đồng -->
<div class="modal fade" id="quickContractModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xem nhanh hợp đồng - Phòng <span id="quickContractRoom"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">Thông tin hợp đồng</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td width="40%">Mã HĐ:</td><td><strong id="qcMaHD"></strong></td></tr>
                            <tr><td>Ngày bắt đầu:</td><td id="qcNgayBatDau"></td></tr>
                            <tr><td>Ngày kết thúc:</td><td id="qcNgayKetThuc"></td></tr>
                            <tr><td>Tiền cọc:</td><td><strong id="qcTienCoc" class="text-danger num-tabular"></strong></td></tr>
                            <tr><td>Tiền thuê:</td><td><strong id="qcTienThue" class="text-danger num-tabular"></strong></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">Đại diện ký hợp đồng</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td width="40%">Họ tên:</td><td><strong id="qcTenDaiDien"></strong></td></tr>
                            <tr><td>Số điện thoại:</td><td id="qcSDTDaiDien"></td></tr>
                            <tr><td>Số CCCD:</td><td id="qcCCCDDaiDien"></td></tr>
                        </table>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-3" id="quickContractTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" id="qc-members-tab" data-bs-toggle="tab" href="#qc-members-pane" role="tab"><i class="ti ti-users me-1"></i> Khách ở ghép (<span id="qcMemberCount">0</span>)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold" id="qc-services-tab" data-bs-toggle="tab" href="#qc-services-pane" role="tab"><i class="ti ti-bell me-1"></i> Dịch vụ đăng ký (<span id="qcServiceCount">0</span>)</a>
                    </li>
                </ul>

                <div class="tab-content" id="quickContractTabContent">
                    <div class="tab-pane fade show active" id="qc-members-pane" role="tabpanel">
                        <div class="table-responsive ts-cuon-ngang">
                            <table class="table table-vcenter table-sm">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="8%">STT</th>
                                        <th>Họ và tên</th>
                                        <th class="text-center" width="25%">Số điện thoại</th>
                                        <th class="text-center" width="25%">Số CCCD</th>
                                        <th class="text-center" width="20%">Ngày vào ở</th>
                                    </tr>
                                </thead>
                                <tbody id="qcMembersBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="qc-services-pane" role="tabpanel">
                        <div class="table-responsive ts-cuon-ngang">
                            <table class="table table-vcenter table-sm">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="8%">STT</th>
                                        <th>Tên dịch vụ</th>
                                        <th class="text-end num-tabular" width="25%">Đơn giá</th>
                                        <th class="text-center" width="20%">Số lượng</th>
                                        <th class="text-center" width="20%">Đơn vị</th>
                                    </tr>
                                </thead>
                                <tbody id="qcServicesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="/QuanLyNhaTro/QuanLyHopDong" class="btn btn-outline-secondary me-auto">Quản lý hợp đồng đầy đủ</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thu tiền nhanh -->
<div class="modal fade" id="quickPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thu tiền nhanh - Phòng <span id="quickPaymentRoom"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="qpInvoiceId" />
                <div class="row">
                    <div class="col-lg-7 border-end">
                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">
                            <i class="ti ti-receipt-dollar me-1"></i> Hóa đơn chưa thanh toán kỳ: <span id="qpInvoicePeriod" class="text-danger fw-bold"></span>
                        </h6>
                        <div class="row mb-3 fw-bold text-secondary">
                            <div class="col-md-6">Mã Hóa Đơn: <span id="qpInvoiceCode"></span></div>
                            <div class="col-md-6 text-end">Khách thuê: <span id="qpTenantName"></span></div>
                        </div>
                        <div class="table-responsive ts-cuon-ngang mb-3">
                            <table class="table table-vcenter table-sm">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="8%">STT</th>
                                        <th>Khoản phí / Dịch vụ</th>
                                        <th class="text-end num-tabular" width="22%">Đơn giá</th>
                                        <th class="text-center" width="12%">SL</th>
                                        <th class="text-center" width="15%">Đơn vị</th>
                                        <th class="text-end num-tabular" width="22%">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody id="qpDetailsBody">
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="5" class="text-end fw-bold align-middle">Tổng cộng:</td>
                                        <td class="text-end text-danger fw-bold align-middle num-tabular" style="font-size: 1.25rem;" id="qpTotalAmount"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <p class="text-secondary small mb-0"><i class="ti ti-info-circle me-1"></i> Bấm "Thu tiền" để ghi nhận đúng số tiền thực nhận, phương thức và ngày thanh toán.</p>
                    </div>

                    <div class="col-lg-5 text-center mt-3 mt-lg-0">
                        <div class="card p-3 shadow-sm h-100 d-flex flex-column justify-content-between border-0">
                            <div>
                                <h6 class="fw-bold text-primary mb-2">Quét mã QR chuyển khoản nhanh</h6>
                                <div class="my-3">
                                    <img id="qpQRImage" src="" class="img-fluid border rounded p-2 room-qr" style="max-width: 200px; height: auto;" alt="VietQR" />
                                </div>
                                <p class="small text-muted mb-3">Chủ nhà hoặc khách thuê quét mã này bằng App ngân hàng để giao dịch lập tức</p>
                            </div>
                            <div class="bg-surface-secondary p-3 rounded text-start small" style="line-height: 1.6;">
                                <div class="border-bottom pb-1 mb-1"><strong>Nội dung thanh toán:</strong></div>
                                <div><strong>Nội dung CK:</strong> <code id="qpCKContent" class="text-primary fw-bold" style="font-size: 0.95rem;"></code></div>
                                <div class="border-top pt-1 mt-1"><strong>Thông tin người nhận thụ hưởng:</strong></div>
                                <div class="row text-muted">
                                    <div class="col-4">Ngân hàng:</div><div class="col-8 fw-bold" id="qpBankId"></div>
                                    <div class="col-4">Số tài khoản:</div><div class="col-8 fw-bold" id="qpAccountNumber"></div>
                                    <div class="col-4">Tên tài khoản:</div><div class="col-8 fw-bold" id="qpAccountName"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnConfirmQuickPayment">
                    Thu tiền
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DangKyDichVuPartial.cshtml")
    <script src="~/js/hoadon-thanhtoan-quanly.js" asp-append-version="true"></script>
    <script>
        // Giá trị từ server cho wwwroot/js/quan-ly-phong-tro.js (file tĩnh không qua Razor); khai báo như khi còn nằm chung một khối.
        const LA_ADMIN = @(laAdmin ? "true" : "false");
        var bankId = '@ViewBag.BankId';
        var accountNumber = '@ViewBag.AccountNumber';
        var accountName = '@ViewBag.AccountName';
    </script>
    <script src="~/js/quan-ly-phong-tro.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/quanlyphongtro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dang-ky-dich-vu.css" asp-append-version="true" />
}