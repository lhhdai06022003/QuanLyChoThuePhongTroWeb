@model QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.HopDongLoiViewModel
@{
    ViewData["Title"] = "Không mở được trang";
}

@* Trang lỗi thân thiện cho chi tiết, thanh lý và gia hạn hợp đồng. Chỉ in giá trị đã mã hóa bởi Razor. *@
<div class="container-xl py-4">
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon"><i class="ti ti-file-off"></i></div>
                <p class="empty-title">@Model.TieuDe</p>
                <p class="empty-subtitle text-secondary">@Model.ThongDiep</p>
                <div class="empty-action">
                    <a href="@Model.QuayLaiUrl" class="btn btn-primary"><i class="ti ti-arrow-left me-1"></i> @Model.QuayLaiText</a>
                </div>
            </div>
        </div>
    </div>
</div>
