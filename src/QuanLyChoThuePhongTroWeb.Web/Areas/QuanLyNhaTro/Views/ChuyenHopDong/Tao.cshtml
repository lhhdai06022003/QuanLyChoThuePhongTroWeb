@model QuanLyChoThuePhongTroWeb.Application.Features.GiuChos.DTOs.ContractCandidateDto
@{ ViewData["Title"] = "Lập hợp đồng từ giữ chỗ"; }
<div class="container-xl py-4">
    <h1>Lập hợp đồng từ giữ chỗ #@Model.ReservationId</h1>
    @if (TempData["ContractError"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="row g-4 mt-2">
        <section class="col-lg-4"><div class="card card-body">
            <h2 class="h3">Phòng @Model.TenPhong</h2><p>@Model.TenChiNhanh</p>
            <p>Khách: @Model.KhachHang<br />Email: @Model.Email<br />CCCD: @Model.CCCD</p>
            <p>Giá thuê đã chốt: <strong>@Model.GiaThueDaChot.ToString("N0") ₫/tháng</strong><br />Cọc đã nhận: <strong>@Model.TienCoc.ToString("N0") ₫</strong></p>
            <p>Khoản cọc được cấn trừ vào hóa đơn tháng bắt đầu hợp đồng. Phần dư chuyển sang các tháng sau.</p>
            <p class="text-secondary">Kiểm tra giấy tờ khách và điều khoản trước khi lập hợp đồng. Tài khoản hiện tại sẽ chuyển thành tài khoản khách thuê.</p>
        </div></section>
        <form class="col-lg-8" method="post" asp-action="Tao" asp-route-id="@Model.ReservationId">
            @Html.AntiForgeryToken()
            <div class="card card-body d-grid gap-3">
                <label>Ngày bắt đầu<input class="form-control" name="ngayBatDau" type="date" required /></label>
                <label>Ngày kết thúc (tùy chọn)<input class="form-control" name="ngayKetThuc" type="date" /></label>
                @if (Model.HanKyHopDongUtc < DateTime.UtcNow)
                {
                    <label class="alert alert-warning"><input type="checkbox" name="xacNhanKyQuaHan" value="true" required /> Tôi đã xử lý yêu cầu quá hạn và cho phép ký hợp đồng.</label>
                }
                <fieldset><legend class="h3">Điều khoản áp dụng</legend>
                    @foreach (var term in Model.DieuKhoans)
                    {
                        <details class="mb-3"><summary><label><input type="checkbox" name="dieuKhoanMauIds" value="@term.Id" /> @term.TieuDe</label></summary><p class="mt-2" style="white-space:pre-wrap">@term.NoiDung</p></details>
                    }
                    @if (Model.DieuKhoans.Count == 0) { <p class="text-secondary">Chưa có điều khoản mẫu. Quản lý có thể bổ sung tại phần điều khoản hợp đồng.</p> }
                </fieldset>
                <div><button type="submit" class="btn btn-primary">Lập hợp đồng và áp dụng cọc</button> <a asp-controller="GiuCho" asp-action="Index" class="btn">Quay lại</a></div>
            </div>
        </form>
    </div>
</div>
