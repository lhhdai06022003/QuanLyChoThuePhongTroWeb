@{
    ViewData["Title"] = "Đặt cọc phòng";
}

<div class="container-xl py-4 guest-admin">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="page-title mb-2">Đặt cọc phòng</h1>
            <p class="text-secondary mb-0">Xem yêu cầu giữ chỗ, đối chiếu chuyển khoản và quyết định hoàn tiền.</p>
        </div>
    </div>

    <div class="card guest-admin-table mb-4">
        <div class="card-header"><h2 class="card-title">Yêu cầu giữ chỗ</h2></div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Yêu cầu / phòng</th><th>Khách</th><th>Trạng thái</th><th>Cọc 50%</th><th>Hạn chuyển</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody><tr><td class="guest-admin-empty" colspan="6">
                    <i class="ti ti-receipt-off" aria-hidden="true"></i>
                    <strong>Chưa có yêu cầu giữ chỗ</strong>
                    <span>Các yêu cầu mới sẽ xuất hiện tại đây.</span>
                </td></tr></tbody>
            </table>
        </div>
    </div>

    <div class="card guest-admin-workflow">
        <div class="card-header"><h2 class="card-title">Thao tác xử lý</h2></div>
        <div class="card-body d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#approvePreviewModal">Duyệt giữ chỗ</button>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reconcilePreviewModal">Đối chiếu chuyển khoản</button>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#refundPreviewModal">Quyết định hoàn tiền</button>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="approvePreviewModal" tabindex="-1" aria-labelledby="approvePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title" id="approvePreviewTitle">Duyệt giữ chỗ</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body">
            <div class="alert alert-info mb-3">Cọc được tính cố định bằng 50% giá thuê tháng đang niêm yết khi duyệt.</div>
            <div class="row g-3">
                <div class="col-sm-6"><label class="form-label" for="approvePaymentDue">Hạn chuyển cọc</label><input class="form-control" id="approvePaymentDue" type="datetime-local" /></div>
                <div class="col-sm-6"><label class="form-label" for="approveContractDue">Hạn ký hợp đồng</label><input class="form-control" id="approveContractDue" type="datetime-local" /></div>
            </div>
            <p class="text-secondary small mt-3 mb-0">Chỉ duyệt khi phòng còn trống và chưa có yêu cầu khác đang giữ.</p>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="button" class="btn btn-primary" disabled>Duyệt yêu cầu</button></div>
    </div></div>
</div>

<div class="modal modal-blur fade" id="reconcilePreviewModal" tabindex="-1" aria-labelledby="reconcilePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title" id="reconcilePreviewTitle">Đối chiếu chuyển khoản</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body">
            <p class="text-secondary">So ảnh khách gửi với giao dịch thực nhận trong tài khoản chung. Chỉ xác nhận khi một giao dịch đủ mức cọc.</p>
            <div class="guest-admin-proof mb-3"><i class="ti ti-photo" aria-hidden="true"></i><span>Chưa có ảnh minh chứng</span></div>
            <div class="row g-3">
                <div class="col-sm-6"><label class="form-label" for="reconcileAmount">Số tiền thực nhận</label><div class="input-group"><input class="form-control" id="reconcileAmount" type="number" min="0" placeholder="0" /><span class="input-group-text">₫</span></div></div>
                <div class="col-sm-6"><label class="form-label" for="reconcileReference">Mã giao dịch</label><input class="form-control" id="reconcileReference" type="text" placeholder="Theo sao kê ngân hàng" /></div>
                <div class="col-12"><label class="form-label" for="reconcileNote">Lý do từ chối (nếu có)</label><textarea class="form-control" id="reconcileNote" rows="2" placeholder="Không thấy tiền, chuyển thiếu hoặc sai giao dịch..."></textarea></div>
            </div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="button" class="btn btn-outline-danger" disabled>Từ chối</button><button type="button" class="btn btn-primary" disabled>Xác nhận đã nhận tiền</button></div>
    </div></div>
</div>

<div class="modal modal-blur fade" id="refundPreviewModal" tabindex="-1" aria-labelledby="refundPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title" id="refundPreviewTitle">Quyết định hoàn tiền</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body">
            <div class="alert alert-info mb-3">Nhân viên hoặc Admin được duyệt 0, một phần hoặc toàn bộ phần cọc. Phần chuyển dư phải hoàn đủ nếu khách không ký hợp đồng.</div>
            <div class="mb-3"><label class="form-label" for="refundChoice">Mức hoàn phần cọc</label><select class="form-select" id="refundChoice"><option value="0">Không hoàn</option><option value="partial">Hoàn một phần</option><option value="all">Hoàn toàn bộ</option></select></div>
            <div class="mb-3"><label class="form-label" for="refundAmount">Số tiền hoàn dự kiến</label><div class="input-group"><input class="form-control" id="refundAmount" type="number" min="0" placeholder="0" /><span class="input-group-text">₫</span></div></div>
            <div><label class="form-label" for="refundReason">Lý do</label><textarea class="form-control" id="refundReason" rows="2" placeholder="Ghi căn cứ xử lý..."></textarea></div>
            <div class="form-hint mt-2">Quyết định hoàn và xác nhận đã chuyển hoàn là hai bước riêng.</div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="button" class="btn btn-primary" disabled>Lưu quyết định hoàn</button></div>
    </div></div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/staff-guest-management.css" asp-append-version="true" /> }
