@model IReadOnlyList<QuanLyChoThuePhongTroWeb.Application.Features.Reservations.ReservationDto>
@{
    ViewData["Title"] = "Giữ chỗ phòng";
}

<div class="container-xl py-4 guest-admin">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="page-title mb-2">Yêu cầu giữ chỗ</h1>
            <p class="text-secondary mb-0">Nhân viên duyệt số tiền và thời hạn theo từng yêu cầu. Chỉ chuyển tiền sau khi được duyệt.</p>
        </div>
    </div>
    @if (TempData["ReservationAdminMessage"] is string message)
    {
        <div class="alert alert-info" role="status">@message</div>
    }
    <div class="card guest-admin-table mb-4">
        <div class="card-header"><h2 class="card-title">Danh sách yêu cầu</h2></div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Phòng</th><th>Khách</th><th>Trạng thái</th><th>Tiền giữ chỗ</th><th>Đã nhận</th><th>Hạn chuyển</th><th>Hạn ký</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td class="guest-admin-empty" colspan="7">Chưa có yêu cầu giữ chỗ.</td></tr>
                    }
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td><strong>@reservation.RoomNumber</strong><br /><a asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="ChiTiet" asp-route-id="@reservation.Id">Xem #@reservation.Id</a></td>
                            <td>@reservation.GuestName</td>
                            <td>@reservation.Status</td>
                            <td>@(reservation.HoldAmount?.ToString("N0") ?? "Chờ duyệt")</td>
                            <td>@reservation.ConfirmedAmount.ToString("N0") ₫</td>
                            <td>@(reservation.PaymentDeadlineUtc.HasValue ? new DateTimeOffset(reservation.PaymentDeadlineUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>@(reservation.ContractDeadlineUtc.HasValue ? new DateTimeOffset(reservation.ContractDeadlineUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") : "—")</td>
                        </tr>
                        @if (reservation.Status == "MoiTao")
                        {
                            <tr><td colspan="7">
                                <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="Duyet" class="row g-2 align-items-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reservationId" value="@reservation.Id" />
                                    <div class="col-md-3"><label class="form-label">Số tiền giữ chỗ (₫)</label><input class="form-control" type="number" name="amount" min="1" step="1" required /></div>
                                    <div class="col-md-3"><label class="form-label">Hạn chuyển</label><input class="form-control" type="datetime-local" name="paymentDeadlineLocal" required /></div>
                                    <div class="col-md-3"><label class="form-label">Hạn ký hợp đồng</label><input class="form-control" type="datetime-local" name="contractDeadlineLocal" required /></div>
                                    <div class="col-md-3"><button class="btn btn-primary" type="submit">Duyệt giữ chỗ</button></div>
                                </form>
                            </td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="alert alert-info">Mở chi tiết từng yêu cầu để xem minh chứng, đối soát tiền, áp dụng vào cọc hợp đồng và xử lý hoàn tiền.</div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/staff-guest-management.css" asp-append-version="true" /> }
