@using QuanLyChoThuePhongTroWeb.Web.Helpers
@model QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.ReservationAdminDetailModel
@{
    ViewData["Title"] = "Chi tiết giữ chỗ";
    var reservation = Model.Reservation;
    var paymentComplete = reservation.PaymentStatus == "DaHoanTat";
}

<div class="container-xl py-4 guest-admin reservation-admin">
    <a class="d-inline-flex align-items-center gap-2 mb-2 small" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="Index">
        <i class="ti ti-arrow-left" aria-hidden="true"></i> Yêu cầu giữ chỗ
    </a>
    <header class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h1 class="page-title mb-0">Phòng @reservation.RoomNumber <span class="text-secondary">#@reservation.Id</span></h1>
                <partial name="_ReservationStatus" model="reservation.Status" />
            </div>
            <p class="text-secondary mb-0">@reservation.GuestName</p>
        </div>
        @if (reservation.Status is "DangGiuCho" or "DaChuyenHopDong")
        {
            <div class="d-flex flex-wrap gap-2">
                @if (reservation.Status == "DangGiuCho")
                {
                    <a class="btn btn-primary" asp-action="XacNhanThue" asp-route-id="@reservation.Id">Xác nhận thuê</a>
                }
                <a class="btn btn-link" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="ThongBaoDatCoc" asp-route-roomId="@reservation.RoomId">Xem trước email báo cọc</a>
            </div>
        }
    </header>
    @if (TempData["ReservationAdminMessage"] is string message)
    {
        <div class="alert alert-info" role="status">@message</div>
    }
    <section class="card mb-3" aria-label="Thông tin tiền cọc">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <dl class="reservation-admin-facts d-flex flex-wrap gap-4 mb-0">
                <div>
                    <dt>Tiền đã đối soát</dt>
                    <dd class="@(paymentComplete ? "reservation-admin-positive" : null)">@VndFormat.Money(reservation.ConfirmedAmount)</dd>
                </div>
                <div>
                    <dt>@(reservation.IsSelfService ? "Mức cọc" : "Cọc được duyệt")</dt>
                    <dd>@(reservation.HoldAmount is { } holdAmount ? VndFormat.Money(holdAmount) : "Chờ duyệt")</dd>
                </div>
            </dl>
            <div class="small text-secondary reservation-admin-numeric">
                @if (!string.IsNullOrWhiteSpace(reservation.PaymentCode))
                {
                    <div>Mã chuyển khoản <strong class="text-body text-break">@reservation.PaymentCode</strong></div>
                }
                @if (reservation.Status == "DangGiuCho" && ReservationContractDeadline.Shown(reservation) is { } contractDeadline)
                {
                    <div>Hạn ký <strong class="text-body">@VietnamTime.Format(contractDeadline, "dd/MM/yyyy HH:mm")</strong></div>
                }
                else if ((reservation.Status is "ChoThanhToan" or "ChoXacNhanTien") && reservation.PaymentDeadlineUtc is { } paymentDeadline)
                {
                    <div>Hạn chuyển <strong class="text-body">@VietnamTime.Format(paymentDeadline, "dd/MM/yyyy HH:mm")</strong></div>
                }
            </div>
        </div>
        @if (Model.Settlement is { } closure && (closure.RetainedDepositAmount > 0 ||
            (reservation.Status == "DaHuy" && closure.UsesPriorRefundForClosure)))
        {
            <div class="card-footer">
                @if (reservation.Status == "DaHuy")
                {
                    <p class="mb-2">Đã hủy giữ chỗ theo quyết định hoàn tiền trước đó.</p>
                }
                @if (closure.RetainedDepositAmount > 0)
                {
                    <p class="mb-2"><strong>Cọc giữ lại: @VndFormat.Money(closure.RetainedDepositAmount)</strong></p>
                }
                <p class="mb-0">Lý do: @closure.ClosureReason</p>
            </div>
        }
    </section>
    @if (Model.Settlement is { CanCloseWithoutRent: true } closeOption)
    {
        <details class="card reservation-admin-disclosure mb-3">
            <summary class="card-header fw-semibold">Khách không thuê</summary>
            <div class="card-body">
                @if (closeOption.UsesPriorRefundForClosure)
                {
                    <p>Khoản hoàn đã duyệt hoặc đã chuyển có dùng tiền cọc. Kết thúc giữ chỗ theo quyết định hoàn tiền trước đó và giữ nguyên số tiền đã duyệt.</p>
                }
                else
                {
                    <p>Kết thúc giữ chỗ và ghi nhận @VndFormat.Money(reservation.HoldAmount.GetValueOrDefault()) tiền cọc giữ lại. Khoản cọc này không hoàn hoặc chuyển sang lần đặt sau. Tiền dư hoặc đến muộn được xử lý riêng.</p>
                }
                <form method="post" asp-action="KhachKhongThue">
                    <input type="hidden" name="reservationId" value="@reservation.Id" />
                    @if (closeOption.UsesPriorRefundForClosure)
                    {
                        <input type="hidden" name="preservePriorRefund" value="true" />
                    }
                    <div class="mb-3"><label class="form-label" for="closeReason">Lý do khách không thuê</label><input class="form-control" id="closeReason" name="reason" maxlength="500" required /></div>
                    <label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirm" value="true" required /><span class="form-check-label">@(closeOption.UsesPriorRefundForClosure ? "Tôi xác nhận hủy giữ chỗ theo quyết định hoàn tiền trước đó." : "Tôi xác nhận khách không thuê và giữ lại tiền cọc.")</span></label>
                    <button class="btn btn-outline-danger" type="submit">Xác nhận khách không thuê</button>
                </form>
            </div>
        </details>
    }
    @if (reservation.Status == "DangGiuCho" &&
        reservation.ContractDeadlineUtc is { } deadlineUtc && deadlineUtc <= DateTime.UtcNow)
    {
        <div class="card mb-4"><div class="card-header"><h2 class="card-title">Đã quá hạn ký hợp đồng</h2></div>
            <div class="card-body">
                <p>@(reservation.IsSelfService ? "Gia hạn nếu khách vẫn thuê. Nếu khách không thuê, dùng mục Khách không thuê để kết thúc giữ chỗ." : "Gia hạn nếu khách vẫn thuê. Nếu hủy yêu cầu cũ, tiếp tục xử lý khoản hoàn bên dưới.")</p>
                <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="GiaHanKyHopDong" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reservationId" value="@reservation.Id" />
                    <div class="col-md-5"><label class="form-label">Hạn ký mới</label><input class="form-control" type="datetime-local" name="newDeadlineLocal" required /></div>
                    <div class="col-md-4"><button class="btn btn-primary" type="submit">Gia hạn ký hợp đồng</button></div>
                </form>
                @if (!reservation.IsSelfService)
                {
                    <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="HuyQuaHanKy" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reservationId" value="@reservation.Id" />
                        <div class="col-md-8"><label class="form-label">Lý do hủy</label><input class="form-control" name="reason" maxlength="500" required /></div>
                        <div class="col-md-4"><button class="btn btn-outline-danger" type="submit">Hủy giữ chỗ</button></div>
                    </form>
                }
            </div>
        </div>
    }
    <div class="card mb-3">
        <div class="card-header"><h2 class="card-title">Lịch sử giao dịch giữ chỗ</h2></div>
        <div class="card-body">
            @if (Model.Transactions.Count == 0)
            {
                <p class="text-secondary mb-0">Chưa có giao dịch tiền nào được ghi nhận cho yêu cầu này.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter">
                        <thead>
                            <tr>
                                <th>Thời gian nhận (VN)</th>
                                <th>Số tiền</th>
                                <th>Mã giao dịch</th>
                                <th>Người xác nhận</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.Transactions)
                            {
                                <tr>
                                    <td>@VietnamTime.Format(tx.ReceivedAtUtc, "dd/MM/yyyy HH:mm")</td>
                                    <td><strong>@VndFormat.Money(tx.SoTien)</strong></td>
                                    <td>
                                        @if (tx.LaSePay)
                                        {
                                            <span class="badge bg-success-lt me-1">SePay</span>
                                            <span>@(tx.MaThamChieu ?? tx.MaGiaoDich)</span>
                                        }
                                        else if (tx.LaVnPay)
                                        {
                                            <span class="badge bg-primary-lt me-1">VNPay</span>
                                            <span>@(tx.MaThamChieu ?? tx.MaGiaoDich)</span>
                                        }
                                        else
                                        {
                                            <span>@tx.MaGiaoDich</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(tx.NguoiXacNhan))
                                        {
                                            <span class="text-secondary">@(tx.LaSePay ? "Hệ thống (SePay)" : tx.LaVnPay ? "Hệ thống (VNPay)" : "Hệ thống")</span>
                                        }
                                        else
                                        {
                                            <span>@tx.NguoiXacNhan</span>
                                        }
                                    </td>
                                    <td>
                                        @if (tx.CanHoan)
                                        {
                                            <span class="badge bg-warning-lt me-1">Cần hoàn</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(tx.GhiChu) && !tx.CanHoan)
                                        {
                                            <span class="text-secondary">@tx.GhiChu</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    @if (Model.Evidence.Count > 0)
    {
        <details class="card reservation-admin-disclosure mb-3">
            <summary class="card-header fw-semibold">Minh chứng khách gửi (@Model.Evidence.Count)</summary>
            <div class="card-body">
                @foreach (var evidence in Model.Evidence)
                {
                    <div class="mb-3">
                        <strong>#@evidence.Id · @GuestStatusText.Evidence(evidence.Status)</strong> — @VndFormat.Money(evidence.ClaimedAmount)
                        <a href="/tai-khoan/yeu-cau-phong/minh-chung/@evidence.Id" target="_blank" rel="noopener">Xem ảnh riêng tư</a>
                        @if (!string.IsNullOrWhiteSpace(evidence.BankReference))
                        {
                            <span>· Mã khách khai: @evidence.BankReference</span>
                        }
                    </div>
                }
            </div>
        </details>
    }
    @if (reservation.PaymentRequestId.HasValue)
    {
        <details class="card reservation-admin-disclosure mb-3">
            <summary class="card-header fw-semibold">Đối soát khoản thực nhận</summary>
            <div class="card-body">
                <p>Kiểm tra giao dịch trong tài khoản ngân hàng trước khi xác nhận. Nhập thời điểm tiền thực vào tài khoản theo sao kê; ảnh khách gửi không quyết định khoản tiền đúng hạn. Có thể ghi nhiều giao dịch; mỗi mã giao dịch chỉ được dùng một lần.</p>
                <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="XacNhanTien" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reservationId" value="@reservation.Id" />
                    <input type="hidden" name="paymentRequestId" value="@reservation.PaymentRequestId.Value" />
                    <div class="col-md-3"><label class="form-label">Minh chứng (nếu có)</label><select class="form-select" name="evidenceId"><option value="">Không gắn ảnh</option>
                        @foreach (var evidence in Model.PendingEvidence)
                        {
                            <option value="@evidence.Id" selected="@(evidence.Id == Model.DefaultEvidenceId)">#@evidence.Id · @VndFormat.Money(evidence.ClaimedAmount)</option>
                        }
                    </select></div>
                    <div class="col-md-3"><label class="form-label">Mã giao dịch ngân hàng</label><input class="form-control" name="bankReference" maxlength="100" required /></div>
                    <div class="col-md-3"><label class="form-label">Tiền thực nhận (₫)</label><input class="form-control" name="actualAmount" type="number" min="1" step="1" required /></div>
                    <div class="col-md-3"><label class="form-label">Thời điểm thực nhận</label><input class="form-control" name="receivedAtLocal" type="datetime-local" required /></div>
                    <div class="col-md-3"><button class="btn btn-primary mt-md-4" type="submit">Xác nhận thực nhận</button></div>
                </form>
            </div>
        </details>
    }
    @if (Model.Settlement is { } settlement && settlement.ConfirmedAmount > 0)
    {
        <details class="card reservation-admin-disclosure mb-3">
            <summary class="card-header fw-semibold">Áp dụng vào cọc hợp đồng và hoàn tiền</summary>
            <div class="card-body">
                <p>Đã xác nhận: @VndFormat.Money(settlement.ConfirmedAmount) · Đã áp dụng cọc: @VndFormat.Money(settlement.AppliedToContractDeposit) · Đã hoàn: @VndFormat.Money(settlement.RefundedAmount)</p>
                <p>@(reservation.Status == "DaHuy" && settlement.UsesPriorRefundForClosure ? "Phải hoàn theo quyết định trước và tiền dư/đến muộn:" : "Phải hoàn tối thiểu theo tiền dư/đến muộn:") @VndFormat.Money(settlement.MandatoryRefundAmount)</p>
                @if (settlement.ApprovedRefundAmount is { } approved)
                {
                    <p>Hoàn đã duyệt: @VndFormat.Money(approved)</p>
                }
                @if (!reservation.IsSelfService && reservation.Status == "DangGiuCho" && settlement.AppliedToContractDeposit == 0)
                {
                    <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="ApDungCoc" class="row g-2 align-items-end mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reservationId" value="@reservation.Id" />
                        <div class="col-md-3"><label class="form-label">Mã ID hợp đồng</label><input class="form-control" name="contractId" type="number" min="1" required /></div>
                        <div class="col-md-3"><label class="form-label">Tiền áp dụng vào cọc (₫)</label><input class="form-control" name="amount" type="number" min="1" step="1" required /></div>
                        <div class="col-md-3"><button class="btn btn-primary mt-md-4" type="submit">Áp dụng vào cọc</button></div>
                    </form>
                }
                @if (settlement.AvailableRefundAmount > 0)
                {
                    <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="QuyetDinhHoan" class="row g-2 align-items-end mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reservationId" value="@reservation.Id" />
                        <div class="col-md-3"><label class="form-label">Số tiền hoàn được duyệt (₫)</label><input class="form-control" name="amount" type="number" min="0" max="@settlement.AvailableRefundAmount" step="1" value="@Math.Max(settlement.ApprovedRefundAmount.GetValueOrDefault(), settlement.MandatoryRefundAmount)" required /></div>
                        <div class="col-md-6"><label class="form-label">Lý do</label><input class="form-control" name="reason" maxlength="500" required /></div>
                        <div class="col-md-3"><button class="btn btn-outline-primary mt-md-4" type="submit">Lưu quyết định hoàn</button></div>
                    </form>
                }
                @if (settlement.RefundDecisionId.HasValue &&
                    settlement.ApprovedRefundAmount > settlement.RefundedAmount)
                {
                    <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="XacNhanHoan" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reservationId" value="@reservation.Id" />
                        <div class="col-md-3"><label class="form-label">Số tiền đã chuyển hoàn (₫)</label><input class="form-control" name="amount" type="number" min="1" step="1" required /></div>
                        <div class="col-md-6"><label class="form-label">Mã giao dịch hoàn</label><input class="form-control" name="bankReference" maxlength="100" required /></div>
                        <div class="col-md-3"><button class="btn btn-outline-primary mt-md-4" type="submit">Xác nhận đã hoàn</button></div>
                    </form>
                }
            </div>
        </details>
    }
</div>

@section Styles { <link rel="stylesheet" href="~/css/staff-guest-management.css" asp-append-version="true" /> }
