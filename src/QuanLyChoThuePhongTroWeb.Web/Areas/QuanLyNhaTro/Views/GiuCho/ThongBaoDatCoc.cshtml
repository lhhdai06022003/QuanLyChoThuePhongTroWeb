@model QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.RoomNoticePageModel
@{
    ViewData["Title"] = "Thông báo phòng đã có người cọc";
    var preview = Model.Preview;
}

<div class="container-xl py-4 guest-admin">
    <a asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="Index">← Yêu cầu giữ chỗ</a>
    <h1 class="page-title mt-3">Thông báo phòng @preview.RoomNumber đã có người đặt cọc</h1>
    <p>Chi nhánh @preview.BranchName · Email gửi riêng tới từng khách. Hãy xem danh sách trước mỗi lần gửi.</p>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info" role="status">@Model.Message</div>
    }
    <div class="card mb-4"><div class="card-header"><h2 class="card-title">Người nhận đang chờ (@preview.Recipients.Count)</h2></div>
        <div class="card-body">
            @if (preview.Recipients.Count == 0)
            {
                <p>Không có khách có lịch xem hoặc giữ chỗ đang chờ.</p>
            }
            @foreach (var recipient in preview.Recipients)
            {
                <p>@recipient.Name · @recipient.Email · @recipient.Source</p>
            }
        </div>
    </div>
    <div class="card mb-4"><div class="card-header"><h2 class="card-title">Nội dung email</h2></div>
        <div class="card-body">
            <p><strong>Tiêu đề:</strong> Thông báo phòng @preview.RoomNumber đã có người đặt cọc</p>
            <p>Xin chào [tên khách],</p>
            <p>Phòng @preview.RoomNumber tại @preview.BranchName đã có người đặt cọc. Yêu cầu xem phòng hoặc giữ chỗ đang chờ của bạn có thể không tiếp tục được. Vui lòng liên hệ nhân viên để được hỗ trợ hoặc xem phòng khác.</p>
        </div>
    </div>
    @if (preview.Recipients.Count > 0)
    {
        <form method="post" asp-area="QuanLyNhaTro" asp-controller="GiuCho" asp-action="GuiThongBaoDatCoc" class="card mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="roomId" value="@preview.RoomId" />
            <input type="hidden" name="recipientDigest" value="@preview.RecipientDigest" />
            <div class="card-body">
                <label><input type="checkbox" name="confirm" value="true" required /> Tôi đã xem danh sách người nhận và xác nhận gửi lần này.</label>
                <div class="mt-3"><button class="btn btn-primary" type="submit">Gửi email riêng cho từng khách</button></div>
            </div>
        </form>
    }
    @if (Model.Results is { Count: > 0 })
    {
        <div class="card"><div class="card-header"><h2 class="card-title">Kết quả gửi</h2></div><div class="card-body">
            @foreach (var result in Model.Results)
            {
                <p>@result.Email — @(result.Sent ? "Đã gửi" : "Lỗi: " + result.Error)</p>
            }
        </div></div>
    }
</div>

@section Styles { <link rel="stylesheet" href="~/css/staff-guest-management.css" asp-append-version="true" /> }
