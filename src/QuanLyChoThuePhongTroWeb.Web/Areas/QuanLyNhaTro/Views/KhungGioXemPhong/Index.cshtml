@model IReadOnlyList<QuanLyChoThuePhongTroWeb.Application.Features.LichXemPhongs.DTOs.ManagedViewingSlotDto>
@using QuanLyChoThuePhongTroWeb.Application.Features.PhongCongKhais.DTOs
@{ ViewData["Title"] = "Khung giờ xem phòng"; var rooms = ViewBag.Phongs as IReadOnlyList<ManagedRoomDto> ?? Array.Empty<ManagedRoomDto>(); }
<div class="container-xl py-4">
    <h1>Khung giờ xem phòng</h1><p class="text-secondary">Khách chọn khung còn chỗ sẽ được xác nhận lịch tự động. Thời gian hiển thị theo giờ Việt Nam.</p>
    @if (TempData["SlotError"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (TempData["SlotSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    <form method="post" asp-action="Tao" class="card card-body mb-4 d-flex flex-row flex-wrap gap-3 align-items-end">
        @Html.AntiForgeryToken()
        <label>Phòng công khai<select class="form-select" name="phongTroId" required><option value="">Chọn phòng</option>
            @foreach (var room in rooms.Where(room => room.DuocDangTin && room.TrangThai == "Trong"))
            { <option value="@room.Id">@room.SoPhong - @room.TenChiNhanh</option> }
        </select></label>
        <label>Bắt đầu<input class="form-control" name="batDau" type="datetime-local" required /></label>
        <label>Kết thúc<input class="form-control" name="ketThuc" type="datetime-local" required /></label>
        <label>Số lượt xem tối đa<input class="form-control" name="sucChua" type="number" min="1" max="100" value="1" required /></label>
        <button type="submit" class="btn btn-primary">Tạo khung giờ</button>
    </form>
    <div class="card table-responsive"><table class="table table-vcenter card-table">
        <thead><tr><th>Phòng</th><th>Thời gian</th><th>Đã đặt</th><th>Tiếp nhận</th><th></th></tr></thead>
        <tbody>@foreach (var slot in Model)
        {
            <tr><td>@slot.TenPhong<br /><small>@slot.TenChiNhanh</small></td>
                <td>@slot.BatDauUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") - @slot.KetThucUtc.AddHours(7).ToString("HH:mm")</td>
                <td>@slot.DaDat / @slot.SucChua</td><td>@(slot.IsActive ? "Đang mở" : "Đã đóng")</td>
                <td>@if (slot.IsActive) { <form method="post" asp-action="Dong" asp-route-id="@slot.Id">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary btn-sm" type="submit">Ngừng nhận lịch mới</button></form> }</td></tr>
        }</tbody>
    </table>@if (Model.Count == 0) { <p class="p-4 text-secondary">Chưa có khung giờ. Tạo khung giờ cho phòng đã đăng công khai ở form phía trên.</p> }</div>
</div>
