@model IEnumerable<QuanLyChoThuePhongTroWeb.Application.Features.ChiNhanhs.DTOs.ChiNhanhRes>
@{
    ViewData["Title"] = "Chi nhánh";
    // Đảm bảo Layout được gọi đúng đường dẫn của bạn
     Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Chi nhánh</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button type="button" class="btn btn-primary" id="btnOpenAddModal">
                        <i class="ti ti-plus me-1"></i> Thêm chi nhánh
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <!-- DataTables tự động chiếm 100% chiều rộng bằng class w-100 -->
                <table id="chiNhanhTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                    <thead>
                        <tr>
                            <th width="5%">STT</th>
                            <th width="10%">Mã CN</th>
                            <th width="20%">Tên chi nhánh</th>
                            <th width="25%">Địa chỉ</th>
                            <th width="15%">Số điện thoại</th>
                            <th width="10%">Ngày tạo</th>
                            <th width="15%" class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <!-- ĐỂ TRỐNG TBODY -->
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL THÊM / SỬA -->
<div class="modal fade" id="chiNhanhModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm chi nhánh mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">

                <div class="form-group row mb-3">
                    <label for="MaChiNhanh" class="col-sm-3 col-form-label">Mã Chi Nhánh <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="MaChiNhanh" name="MaChiNhanh" required placeholder="Ví dụ: Q1, BT, TD..." maxlength="10">
                        <small class="form-text text-muted">Mã viết tắt viết liền không dấu, dùng để tự động sinh mã hợp đồng.</small>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="TenChiNhanh" class="col-sm-3 col-form-label">Tên Chi Nhánh <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="TenChiNhanh" name="TenChiNhanh" required placeholder="Nhập tên chi nhánh...">
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="SoDienThoai" class="col-sm-3 col-form-label">Số Điện Thoại</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="SoDienThoai" name="SoDienThoai" placeholder="Nhập SĐT liên hệ...">
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="SoGioPhanHoiHoaDon" class="col-sm-3 col-form-label">Số giờ phản hồi hóa đơn <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="number" class="form-control" id="SoGioPhanHoiHoaDon" name="SoGioPhanHoiHoaDon" min="1" max="168" step="1" value="24" required>
                        <div class="form-text">Hạn để khách báo sai sót, tính từ lúc công bố hóa đơn (1–168 giờ). Đổi số giờ không làm dời hạn của hóa đơn đã công bố.</div>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="DiaChi" class="col-sm-3 col-form-label">Địa Chỉ <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="DiaChi" name="DiaChi" required placeholder="Nhập địa chỉ đầy đủ...">
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="MoTa" class="col-sm-3 col-form-label">Mô Tả Thêm</label>
                    <div class="col-sm-9">
                        <textarea class="form-control" id="MoTa" name="MoTa" rows="3" placeholder="Ví dụ: Gần trường ĐH Sư Phạm Kỹ Thuật..."></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary" id="btnSaveData">
                    <i class="ti ti-plus me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/quan-ly-chi-nhanh.js" asp-append-version="true"></script>
}
