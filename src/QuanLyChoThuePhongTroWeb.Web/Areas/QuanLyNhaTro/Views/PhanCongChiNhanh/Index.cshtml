@{
    ViewData["Title"] = "Phân công chi nhánh";
    var openNguoiDungId = ViewBag.OpenNguoiDungId as int?;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Phân công chi nhánh</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <select class="form-select" id="filterChiNhanh" style="min-width: 220px;">
                        <option value="">Tất cả chi nhánh</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <table id="phanCongTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                    <thead>
                        <tr>
                            <th width="5%" class="text-center">STT</th>
                            <th width="20%">Tên đăng nhập</th>
                            <th width="15%">Trạng thái tài khoản</th>
                            <th width="35%">Chi nhánh đang phụ trách</th>
                            <th width="15%">Thay đổi gần nhất</th>
                            <th width="10%" class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="phanCongModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="phanCongModalTitle">Phân công chi nhánh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-warning d-none" id="phanCongLockedAlert">Tài khoản đang khóa, phân công chưa có hiệu lực.</div>
                <div class="table-responsive ts-cuon-ngang">
                    <table class="table table-sm table-vcenter">
                        <thead>
                            <tr>
                                <th>Chi nhánh</th>
                                <th>Trạng thái</th>
                                <th>Phân công lúc, bởi ai</th>
                                <th>Thu hồi lúc, bởi ai</th>
                                <th>Lý do</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="phanCongModalBody"></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Giá trị từ server cho wwwroot/js/phan-cong-chi-nhanh.js (file tĩnh không qua Razor).
        window.phanCongChiNhanhConfig = { openNguoiDungId: @Html.Raw(openNguoiDungId.HasValue ? openNguoiDungId.Value.ToString() : "null") };
    </script>
    <script src="~/js/phan-cong-chi-nhanh.js" asp-append-version="true"></script>
}
