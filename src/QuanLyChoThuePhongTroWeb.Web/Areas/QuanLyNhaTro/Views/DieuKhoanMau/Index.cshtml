@model IEnumerable<QuanLyChoThuePhongTroWeb.Application.Features.DieuKhoanMaus.DTOs.DieuKhoanMauRes>
@{
    ViewData["Title"] = "Điều khoản hợp đồng";
    // Điều khoản mẫu dùng chung: nhân viên chỉ xem, server chặn ghi lần nữa.
    var laAdmin = User.IsInRole("Admin");
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Điều khoản hợp đồng</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    @if (laAdmin)
                    {
                        <button class="btn btn-primary" id="btnOpenAddModal">
                            <i class="ti ti-plus me-1"></i> Thêm điều khoản
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Danh sách điều khoản</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover w-100 datatable ts-bang-the" id="dieuKhoanTable">
                        <thead>
                            <tr>
                                <th class="text-center w-1">STT</th>
                                <th style="min-width: 200px;">Tiêu đề điều khoản</th>
                                <th style="min-width: 400px; white-space: normal;">Nội dung chi tiết</th>
                                <th class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int stt = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center text-muted align-middle">@(stt++)</td>
                                        <td class="fw-bold text-primary align-middle">@item.TieuDe</td>
                                        <td style="white-space: pre-line; max-height: 100px; overflow-y: hidden; display: block; text-overflow: ellipsis; border-bottom: none;" class="text-muted">
                                            @Html.Raw(item.NoiDung.Length > 200 ? item.NoiDung.Substring(0, 200) + "..." : item.NoiDung)
                                        </td>
                                        <td class="text-center align-middle">
                                            @if (laAdmin)
                                            {
                                                <div class="btn-list flex-nowrap justify-content-center">
                                                    <button type="button" class="btn btn-icon btn-ghost-warning btn-sm btn-edit-dk" data-id="@item.DieuKhoanMauId" title="Chỉnh sửa">
                                                        <i class="ti ti-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-icon btn-ghost-danger btn-sm btn-delete-dk" data-id="@item.DieuKhoanMauId" title="Xóa">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <div class="empty">
                                            <div class="empty-icon text-muted mb-3">
                                                <i class="ti ti-folder-open fa-3x"></i>
                                            </div>
                                            <p class="empty-title h3">Chưa có dữ liệu</p>
                                            <p class="empty-subtitle text-muted">
                                                Thư viện điều khoản hiện tại đang trống. Vui lòng thêm điều khoản mới.
                                            </p>
                                            @if (laAdmin)
                                            {
                                                <div class="empty-action mt-3">
                                                    <button class="btn btn-primary" id="btnOpenAddModalEmpty">
                                                        <i class="ti ti-plus me-1"></i> Thêm ngay
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Điều Khoản -->
<div class="modal fade" id="dieuKhoanModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dieuKhoanModalTitle">Thêm điều khoản mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DieuKhoanMauId" value="0" />
                
                <div class="mb-3">
                    <label for="TieuDe" class="form-label">
                        Tiêu đề điều khoản <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" id="TieuDe" placeholder="VD: Quy định về giờ giấc, an ninh...">
                    <small class="form-hint mt-1">Tiêu đề ngắn gọn, rõ ràng để dễ dàng nhận biết khi chọn.</small>
                </div>

                <div class="mb-3">
                    <label for="NoiDung" class="form-label">
                        Nội dung chi tiết <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" id="NoiDung" rows="8" placeholder="Nhập chi tiết các quy định, nội dung pháp lý của điều khoản..."></textarea>
                    <small class="form-hint mt-1">Nội dung này sẽ được in trực tiếp vào hợp đồng của người thuê.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveDieuKhoan"><i class="ti ti-plus me-1"></i> Thêm dữ liệu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Khởi tạo datatable nếu có dữ liệu
            if ($('#dieuKhoanTable tbody tr .empty').length === 0) {
                $('#dieuKhoanTable').DataTable({
                    "language": {
                        "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json"
                    },
                    "pageLength": 10,
                    "responsive": true,
                    "order": [[0, "asc"]],
                    "columnDefs": [
                        { "orderable": false, "targets": [2, 3] }
                    ]
                });
            }

            $('#btnOpenAddModal, #btnOpenAddModalEmpty').click(function() {
                $('#DieuKhoanMauId').val(0);
                $('#TieuDe').val('');
                $('#NoiDung').val('');
                $('#dieuKhoanModalTitle').text('Thêm điều khoản mới');
                $('#btnSaveDieuKhoan').html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                $('#dieuKhoanModal').modal('show');
            });

            $('#btnSaveDieuKhoan').click(function() {
                let id = $('#DieuKhoanMauId').val();
                let tieuDe = $('#TieuDe').val().trim();
                let noiDung = $('#NoiDung').val().trim();

                if(!tieuDe || !noiDung) { 
                    showWarning('Vui lòng nhập đầy đủ Tiêu đề và Nội dung!'); 
                    return; 
                }

                let req = { dieuKhoanMauId: parseInt(id), tieuDe: tieuDe, noiDung: noiDung };
                let isUpdate = id > 0;

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Việc chỉnh sửa sẽ không ảnh hưởng tới các Hợp đồng đã ký trước đó.' : 'Thêm điều khoản này vào thư viện?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin"></i> Đang xử lý...');

                        $.ajax({
                            url: isUpdate ? `/DieuKhoanMau/Update/${id}` : '/DieuKhoanMau/Create',
                            type: isUpdate ? 'PUT' : 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message).then(() => {
                                    location.reload(); // Reload trang đơn giản nhất vì dữ liệu không quá lớn
                                });
                            },
                            error: function(xhr) { 
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra'); 
                            },
                            complete: function() { 
                                $btn.prop('disabled', false).html(originalHtml); 
                            }
                        });
                    }
                });
            });

            $('#dieuKhoanTable').on('click', '.btn-edit-dk', function() {
                let id = $(this).data('id');
                $.get(`/DieuKhoanMau/GetById/${id}`, function(res) {
                    $('#DieuKhoanMauId').val(res.dieuKhoanMauId);
                    $('#TieuDe').val(res.tieuDe);
                    $('#NoiDung').val(res.noiDung);
                    $('#dieuKhoanModalTitle').text('Cập nhật điều khoản');
                    $('#btnSaveDieuKhoan').html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                    $('#dieuKhoanModal').modal('show');
                }).fail(function() {
                    showError('Không lấy được dữ liệu điều khoản');
                });
            });

            $('#dieuKhoanTable').on('click', '.btn-delete-dk', function(e) {
                e.preventDefault();
                let id = $(this).data('id');
                
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa điều khoản này khỏi thư viện? Các hợp đồng đã ký sử dụng điều khoản này sẽ không bị ảnh hưởng.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/DieuKhoanMau/Delete/${id}`, 
                            type: 'DELETE',
                            success: function(res) {
                                showSuccess(res.message).then(() => {
                                    location.reload();
                                });
                            },
                            error: function(xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
