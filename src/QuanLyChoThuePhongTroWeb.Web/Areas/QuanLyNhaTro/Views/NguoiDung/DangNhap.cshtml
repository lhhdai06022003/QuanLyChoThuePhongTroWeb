@model QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.DangNhapReq
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    Layout = null;
    // Nút điền nhanh tài khoản mẫu chứa mật khẩu mẫu: chỉ hiện khi chạy Development (máy dev, buổi demo).
    var hienTaiKhoanMau = HostEnvironment.EnvironmentName == "Development";
    var tuTrangPhong = (ViewBag.ReturnUrl as string)?.StartsWith("/phong/", StringComparison.OrdinalIgnoreCase) == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập | TroSync</title>
    <script>
        // Theo chế độ sáng/tối người dùng đã chọn trong ứng dụng (cùng khóa với _Layout), đặt trước khi vẽ để không nháy.
        (function () {
            var theme = 'light';
            try { theme = localStorage.getItem('tablerTheme') || 'light'; } catch (e) { }
            document.documentElement.setAttribute('data-bs-theme', theme === 'dark' ? 'dark' : 'light');
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler-icons.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/trosync-nen.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dang-nhap.css" asp-append-version="true">
</head>
<body class="dn-trang">
    <main class="dn-khung">
        <div class="dn-thuong-hieu">
            <svg class="dn-logo" width="40" height="40" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <linearGradient id="troSyncAuthBg" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" class="ts-logo-dau" />
                        <stop offset="100%" class="ts-logo-cuoi" />
                    </linearGradient>
                </defs>
                <rect width="36" height="36" rx="9" fill="url(#troSyncAuthBg)" />
                <path d="M8 25V17L14.5 12V25H8Z" fill="#ffffff" fill-opacity="0.4" />
                <path d="M13.5 25V14L20.5 8.5L27.5 14V25H22.5V17.5H18.5V25H13.5Z" fill="#ffffff" />
                <circle cx="20.5" cy="8.5" r="2.2" fill="#38bdf8" />
                <circle cx="20.5" cy="8.5" r="0.9" fill="#ffffff" />
            </svg>
            <div>
                <div class="dn-ten">Tro<span>Sync</span></div>
                <div class="dn-mo-ta">Quản lý phòng trọ đa chi nhánh</div>
            </div>
        </div>

        <section class="dn-the" aria-labelledby="dnTieuDe">
            <h1 class="dn-tieu-de" id="dnTieuDe">Đăng nhập</h1>
            @if (tuTrangPhong)
            {
                <p class="dn-phu-de">Đăng nhập để hẹn xem hoặc đặt phòng. Xong sẽ quay lại đúng phòng bạn vừa chọn.</p>
            }
            else
            {
                <p class="dn-phu-de">Dùng tài khoản được cấp để vào hệ thống.</p>
            }

            @if (ViewBag.Error != null)
            {
                <div class="dn-loi" role="alert">
                    <i class="ti ti-alert-circle" aria-hidden="true"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <form action="/QuanLyNhaTro/DangNhap" method="post" id="loginForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="dn-truong">
                    <label class="dn-nhan" for="txtTenDangNhap">Tên đăng nhập</label>
                    <div class="dn-o">
                        <i class="ti ti-user dn-o-icon" aria-hidden="true"></i>
                        <input type="text"
                               id="txtTenDangNhap"
                               class="dn-input"
                               name="TenDangNhap"
                               required
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               value="@(Model?.TenDangNhap)">
                    </div>
                </div>

                <div class="dn-truong">
                    <label class="dn-nhan" for="txtMatKhau">Mật khẩu</label>
                    <div class="dn-o">
                        <i class="ti ti-lock dn-o-icon" aria-hidden="true"></i>
                        <input type="password"
                               id="txtMatKhau"
                               class="dn-input dn-input-co-nut"
                               name="MatKhau"
                               required
                               autocomplete="current-password">
                        <button type="button"
                                class="dn-nut-mat"
                                id="btnTogglePassword"
                                aria-label="Hiện mật khẩu"
                                aria-pressed="false">
                            <i class="ti ti-eye" id="toggleIcon" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="dn-tuy-chon">
                    <label class="dn-ghi-nho">
                        <input type="checkbox" name="GhiNho" value="true" @(Model?.GhiNho == true ? "checked" : "")>
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <button type="button" class="dn-lien-ket" id="btnQuenMatKhau" aria-expanded="false" aria-controls="dnQuenMatKhau">
                        Quên mật khẩu?
                    </button>
                </div>
                <p class="dn-goi-y" id="dnQuenMatKhau" hidden>
                    <i class="ti ti-info-circle" aria-hidden="true"></i>
                    Liên hệ quản lý chi nhánh hoặc Quản trị viên để được cấp lại mật khẩu.
                </p>

                <button type="submit" class="dn-nut-chinh" id="btnSubmit">
                    <span>Đăng nhập</span>
                    <i class="ti ti-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            @if (hienTaiKhoanMau)
            {
                <!-- Thử nghiệm nhanh tài khoản demo -->
                <div class="quick-demo-section">
                    <div class="dn-demo-tieu-de">Điền nhanh tài khoản mẫu</div>
                    <div class="dn-demo-nut">
                        <button type="button" class="demo-pill" id="btnFillAdmin">
                            <i class="ti ti-shield" aria-hidden="true"></i>
                            <span>Admin / Quản lý</span>
                        </button>
                        <button type="button" class="demo-pill" id="btnFillTenant">
                            <i class="ti ti-user-check" aria-hidden="true"></i>
                            <span>Khách thuê mẫu</span>
                        </button>
                    </div>
                </div>
            }
        </section>

        <p class="dn-dang-ky">
            Chưa có tài khoản? <a href="/dang-ky-khach?returnUrl=@Uri.EscapeDataString(ViewBag.ReturnUrl as string ?? "/phong")">Tạo tài khoản khách vãng lai</a>
        </p>

        <p class="dn-chan">© 2026 TroSync</p>
    </main>

    <script>
        // Xóa lịch sử chat trợ lý AI khi về trang đăng nhập (đăng xuất luôn chuyển về đây)
        try {
            Object.keys(sessionStorage)
                .filter(function (k) { return k.indexOf('ai_chat_history') === 0; })
                .forEach(function (k) { sessionStorage.removeItem(k); });
        } catch (e) { }

        const txtMatKhau = document.getElementById('txtMatKhau');

        // Ẩn/hiện mật khẩu
        const btnToggle = document.getElementById('btnTogglePassword');
        const toggleIcon = document.getElementById('toggleIcon');
        if (btnToggle && txtMatKhau && toggleIcon) {
            btnToggle.addEventListener('click', function () {
                const dangAn = txtMatKhau.type === 'password';
                txtMatKhau.type = dangAn ? 'text' : 'password';
                toggleIcon.className = dangAn ? 'ti ti-eye-off' : 'ti ti-eye';
                btnToggle.setAttribute('aria-pressed', dangAn ? 'true' : 'false');
                btnToggle.setAttribute('aria-label', dangAn ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
            });
        }

        // Quên mật khẩu: hiện dòng hướng dẫn ngay dưới form thay cho hộp thoại của trình duyệt
        const btnQuen = document.getElementById('btnQuenMatKhau');
        const goiYQuen = document.getElementById('dnQuenMatKhau');
        if (btnQuen && goiYQuen) {
            btnQuen.addEventListener('click', function () {
                const moRa = goiYQuen.hidden;
                goiYQuen.hidden = !moRa;
                btnQuen.setAttribute('aria-expanded', moRa ? 'true' : 'false');
            });
        }

        // Thiếu ô thì báo ngay tại ô; gửi rồi thì khóa nút để không bấm đúp
        const form = document.getElementById('loginForm');
        const btnSubmit = document.getElementById('btnSubmit');
        if (form && btnSubmit) {
            form.addEventListener('submit', function (e) {
                const oTrong = Array.prototype.find.call(form.querySelectorAll('.dn-input'), function (o) { return !o.value.trim(); });
                form.querySelectorAll('.dn-input').forEach(function (o) {
                    o.setAttribute('aria-invalid', o.value.trim() ? 'false' : 'true');
                });
                if (oTrong) {
                    e.preventDefault();
                    oTrong.focus();
                    return;
                }
                btnSubmit.disabled = true;
                btnSubmit.querySelector('span').textContent = 'Đang đăng nhập…';
            });
            form.addEventListener('input', function (e) {
                if (e.target.classList.contains('dn-input') && e.target.value.trim()) e.target.setAttribute('aria-invalid', 'false');
            });
        }

        @if (hienTaiKhoanMau)
        {
            <text>
        // Điền nhanh tài khoản demo phục vụ kiểm thử / nghiệm thu
        const btnAdmin = document.getElementById('btnFillAdmin');
        const btnTenant = document.getElementById('btnFillTenant');
        const txtTenDangNhap = document.getElementById('txtTenDangNhap');

        if (btnAdmin && txtTenDangNhap && txtMatKhau) {
            btnAdmin.addEventListener('click', function () {
                txtTenDangNhap.value = 'admin';
                txtMatKhau.value = 'admin';
                txtTenDangNhap.focus();
            });
        }

        if (btnTenant && txtTenDangNhap && txtMatKhau) {
            btnTenant.addEventListener('click', function () {
                txtTenDangNhap.value = 'khachthue01';
                txtMatKhau.value = '123456';
                txtTenDangNhap.focus();
            });
        }
            </text>
        }
    </script>
</body>
</html>
