@model IEnumerable<QuanLyChoThuePhongTroWeb.Application.Features.NguoiDungs.DTOs.NguoiDungRes>
@{
    ViewData["Title"] = "Tài khoản";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Tài khoản</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button type="button" class="btn btn-primary" id="btnOpenAddModal">
                        <i class="ti ti-plus me-1"></i> Thêm tài khoản
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <table id="nguoiDungTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                    <thead>
                        <tr>
                            <th width="5%" class="text-center">STT</th>
                            <th width="20%">Tên đăng nhập</th>
                            <th width="15%">Quyền hạn</th>
                            <th width="15%">Trạng thái</th>
                            <th width="15%">Ngày tạo</th>
                            <th width="15%">Đăng nhập cuối</th>
                            <th width="15%" class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nguoiDungModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm tài khoản mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <form id="frmNguoiDung">
                    <div class="form-group mb-3">
                        <label class="form-label">Quyền hạn <span class="text-danger">*</span></label>
                        <select class="form-select" id="Role">
                            <option value="0">Admin</option>
                            <option value="1">Nhân viên</option>
                            <option value="2">Khách thuê</option>
                            <option value="3">Khách vãng lai</option>
                        </select>
                    </div>

                    <div class="form-group mb-3 d-none" id="divNguoiThue">
                        <label class="form-label">Người thuê (Khách có hợp đồng) <span class="text-danger">*</span></label>
                        <select class="form-select select2" id="NguoiThueId" style="width: 100%;">
                            <option value="">-- Chọn khách thuê --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="TenDangNhap" required placeholder="Nhập tên đăng nhập...">
                    </div>

                    <div class="form-group mb-3" id="divMatKhau">
                        <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="MatKhau" placeholder="Nhập mật khẩu...">
                        <small class="text-muted class-edit-note d-none">Để trống nếu không muốn thay đổi mật khẩu</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" id="IsActive" checked>
                            <span class="form-check-label" for="IsActive">Kích hoạt tài khoản</span>
                        </label>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveData">
                    <i class="ti ti-plus me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

@section ThuVienScripts {
    <partial name="_Select2Js" />
}

@section Scripts {
    <script src="~/js/quan-ly-tai-khoan.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/lib/select2/4.0.13/css/select2.min.css" asp-append-version="true" />
    <style>
    /* CSS hỗ trợ Select2 tương thích với Dark Mode của Tabler */
    .select2-container--default .select2-selection--single {
        background-color: var(--tblr-bg-surface);
        border-color: var(--tblr-border-color);
        color: var(--tblr-body-color);
        height: 38px;
        padding-top: 4px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: var(--tblr-body-color);
    }
    .select2-dropdown {
        background-color: var(--tblr-bg-surface);
        border-color: var(--tblr-border-color);
        color: var(--tblr-body-color);
    }
    .select2-search--dropdown .select2-search__field {
        background-color: var(--tblr-bg-surface);
        border-color: var(--tblr-border-color);
        color: var(--tblr-body-color);
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: var(--tblr-primary);
        color: var(--tblr-white);
    }
    .select2-container--default .select2-results__option[aria-selected=true] {
        background-color: var(--tblr-bg-surface-secondary);
        color: var(--tblr-body-color);
    }
</style>
}
