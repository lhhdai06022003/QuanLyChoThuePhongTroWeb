@using QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.Responses
@model LichSuThanhToanPageViewModel
@{
    ViewData["Title"] = "Quản lý lịch sử thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xl mt-3 ls-page">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary fw-bold d-flex align-items-center">
                    <i class="ti ti-history me-2"></i> Quản lý lịch sử thanh toán
                </h2>
            </div>
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="row row-cards mb-4">
        <!-- Card 1: Tiền đã nhận (hoặc Đã thu kỳ khi lọc theo kỳ) -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-success text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2" id="statTongTitle">Tiền đã nhận</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statTongDoanhThu">0 ₫</div>
                    <div class="small text-white text-opacity-75" id="statTongChuThich">Theo ngày nhận tiền</div>
                </div>
            </div>
        </div>

        <!-- Card 2: Số giao dịch -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-primary text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2">Số giao dịch</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statTongSoGiaoDich">0</div>
                </div>
            </div>
        </div>

        <!-- Card 3: Thu tiền mặt -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-info text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2">Thu tiền mặt</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statDoanhThuTienMat">0 ₫</div>
                </div>
            </div>
        </div>

        <!-- Card 4: Chuyển khoản ghi tay -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-indigo text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2">Chuyển khoản</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statDoanhThuChuyenKhoan">0 ₫</div>
                </div>
            </div>
        </div>

        <!-- Card 5: SePay -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-azure text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2">SePay</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statDoanhThuSePay">0 ₫</div>
                </div>
            </div>
        </div>

        <!-- Card 6: VNPay -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-orange text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2">VNPay</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statDoanhThuVnPay">0 ₫</div>
                </div>
            </div>
        </div>

        <!-- Card 7: Cấn trừ cọc -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow border-0 bg-teal text-white" style="position: relative; overflow: hidden;">
                <div class="card-body p-3">
                    <div class="subheader text-white text-opacity-75 fw-bold mb-2">Cấn trừ cọc</div>
                    <div class="h2 mb-0 text-white fw-bold" id="statDoanhThuCanTruCoc">0 ₫</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card quản lý & danh sách giao dịch -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <!-- Khu vực Bộ lọc dạng hàng ngang -->
            <div class="bg-surface-secondary p-3 border border-dashed rounded-3 mb-4">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4 col-xl-3">
                        <label for="filterChiNhanh" class="form-label fw-bold text-secondary mb-1">
                            <i class="ti ti-building me-1"></i> Chi nhánh
                        </label>
                        <select id="filterChiNhanh" class="form-select form-select-sm">
                            <option value="0">-- Tất cả chi nhánh --</option>
                            @foreach (var cn in Model.ChiNhanhs)
                            {
                                <option value="@cn.Value">@cn.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <label for="filterPhuongThuc" class="form-label fw-bold text-secondary mb-1">
                            <i class="ti ti-report-money me-1"></i> Kênh thu
                        </label>
                        <select id="filterPhuongThuc" class="form-select form-select-sm">
                            <option value="">-- Tất cả kênh --</option>
                            <option value="tien-mat">Tiền mặt</option>
                            <option value="chuyen-khoan">Chuyển khoản</option>
                            <option value="sepay">SePay</option>
                            <option value="vnpay">VNPay</option>
                            <option value="can-tru-coc">Cấn trừ tiền cọc</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <label for="filterNguoiThu" class="form-label fw-bold text-secondary mb-1">
                            <i class="ti ti-user-check me-1"></i> Người thu
                        </label>
                        <select id="filterNguoiThu" class="form-select form-select-sm">
                            <option value="">-- Tất cả --</option>
                            <option value="toi">Tôi</option>
                            <option value="he-thong">Hệ thống (SePay, VNPay)</option>
                            @if (Model.LaAdmin && !string.IsNullOrEmpty(Model.TenNguoiThu))
                            {
                                <option value="@Model.NguoiThu">@Model.TenNguoiThu</option>
                            }
                        </select>
                    </div>
                    @if (Model.LaAdmin)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <label for="filterKy" class="form-label fw-bold text-secondary mb-1">
                                <i class="ti ti-calendar-event me-1"></i> Kỳ hóa đơn
                            </label>
                            <div class="input-group input-group-sm">
                                <input type="month" id="filterKy" class="form-control form-control-sm" value="@Model.KyText" />
                                <button type="button" class="btn btn-outline-secondary" id="btnXoaKy" title="Bỏ lọc kỳ" aria-label="Bỏ lọc kỳ"><i class="ti ti-x"></i></button>
                            </div>
                        </div>
                    }
                    <div class="col-12 col-xl-3">
                        <label for="filterDateRange" class="form-label fw-bold text-secondary mb-1">
                            <i class="ti ti-calendar me-1"></i> Khoảng thời gian
                        </label>
                        <div class="d-flex flex-wrap gap-2" id="khoangNgay">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary active" id="btnDateAll">Tất cả</button>
                                <button type="button" class="btn btn-outline-primary" id="btnDateToday">Hôm nay</button>
                                <button type="button" class="btn btn-outline-primary" id="btnDateWeek">Tuần này</button>
                                <button type="button" class="btn btn-outline-primary" id="btnDateMonth">Tháng này</button>
                            </div>
                            <input type="text" id="filterDateRange" class="form-control form-control-sm" placeholder="Tùy chỉnh..." readonly style="max-width: 200px;" />
                        </div>
                        <div class="small text-secondary mt-1 d-none" id="ghiChuKy">Đang lọc theo kỳ, bỏ qua khoảng ngày</div>
                    </div>
                </div>
                <label class="form-check form-check-inline mt-2 mb-0">
                    <input class="form-check-input" type="checkbox" id="filterCoTienThua">
                    <span class="form-check-label">Chỉ khoản có tiền thừa (cần xử lý ngoài hệ thống)</span>
                </label>
            </div>

            <!-- Bảng dữ liệu -->
            <div class="table-responsive" style="overflow-x: auto !important;">
                <table id="lichSuTable" class="table card-table table-vcenter table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th class="text-center" width="4%">STT</th>
                            <th>Mã GD · Mã HĐ</th>
                            <th>Phòng · Chi nhánh</th>
                            <th>Khách thuê</th>
                            <th class="text-end">Số tiền</th>
                            <th class="text-center">Phương thức</th>
                            <th>Ngày thanh toán</th>
                            <th>Người thực hiện</th>
                            <th class="text-center" style="min-width: 90px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết Hóa đơn -->
<div class="modal modal-blur fade modal-fullscreen-sm-down" id="chiTietModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content border-0">
            <div class="modal-header py-2">
                <h5 class="modal-title fw-bold"><i class="ti ti-file-description me-1"></i> Chi tiết hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body py-3 py-md-4" id="chiTietBody">
                <!-- JS render -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i> Đóng</button>
            </div>
        </div>
    </div>
</div>

@section ThuVienScripts {
    <partial name="_FlatpickrJs" />
}

@section Scripts {
    <script>window.lichSuThanhToanConfig = {
        laAdmin: @Html.Raw(Json.Serialize(Model.LaAdmin)),
        chiNhanhId: @Html.Raw(Json.Serialize(Model.ChiNhanhId)),
        phuongThuc: @Html.Raw(Json.Serialize(Model.PhuongThuc)),
        nguoiThu: @Html.Raw(Json.Serialize(Model.NguoiThu)),
        kyThang: @Html.Raw(Json.Serialize(Model.KyThang)),
        kyNam: @Html.Raw(Json.Serialize(Model.KyNam)),
        tuNgay: @Html.Raw(Json.Serialize(Model.TuNgay)),
        denNgay: @Html.Raw(Json.Serialize(Model.DenNgay)),
        bankId: @Html.Raw(Json.Serialize(Model.BankId)),
        accountNumber: @Html.Raw(Json.Serialize(Model.AccountNumber)),
        accountName: @Html.Raw(Json.Serialize(Model.AccountName)),
        urlGetList: "/LichSuThanhToan/GetList",
        urlGetStats: "/LichSuThanhToan/GetStats",
        urlHuyThanhToan: "/LichSuThanhToan/HuyThanhToan/",
        urlHoaDonChiTiet: "/HoaDon/GetById/",
        urlVietQr: "/HoaDon/GetVietQR"
    };</script>
    <script src="~/js/lich-su-thanh-toan.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/themes/material_blue.min.css" />
    <link rel="stylesheet" href="~/css/hoadon.css" asp-append-version="true" />
    <style>
    html[data-bs-theme="dark"] .border-dashed,
    [data-bs-theme="dark"] .border-dashed {
        border-color: rgba(255, 255, 255, 0.15) !important;
    }

    .avatar {
        width: 2.5rem;
        height: 2.5rem;
        font-size: 1.25rem;
    }

    /* Hiệu ứng zoom và background khi hover nút thao tác */
    .btn-list .btn-icon {
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, color 0.2s ease;
    }
    .btn-list .btn-icon:hover {
        transform: scale(1.15);
    }
    .btn-ghost-info:hover {
        background-color: rgba(32, 107, 196, 0.15) !important;
        color: var(--tblr-info) !important;
    }
    .btn-ghost-danger:hover {
        background-color: rgba(214, 63, 63, 0.15) !important;
        color: var(--tblr-danger) !important;
    }
</style>
}
