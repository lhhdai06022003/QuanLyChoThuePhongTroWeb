@model IReadOnlyList<QuanLyChoThuePhongTroWeb.Application.Features.LichXemPhongs.DTOs.StaffViewingDto>
@{
    ViewData["Title"] = "Yêu cầu xem phòng";
}
<div class="container-xl py-4">
    <div class="page-header mb-4"><h1>Yêu cầu xem phòng</h1><p class="text-secondary">Các yêu cầu thuộc chi nhánh bạn phụ trách.</p></div>
    <a class="btn btn-outline-primary mb-3" asp-controller="KhungGioXemPhong" asp-action="Index">Quản lý khung giờ xem</a>
    @if (TempData["ViewingError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (TempData["ViewingSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="card"><div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Phòng</th><th>Khách</th><th>Thời gian mong muốn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.TenPhong</strong><br /><small>@item.TenChiNhanh</small></td>
                    <td>@item.HoTen<br /><a href="tel:@item.SoDienThoai">@item.SoDienThoai</a><br /><small>@item.Email</small><br /><small>@item.GhiChu</small></td>
                    <td>@item.ThoiGianMongMuonUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@GuestStatusText.Of(item.TrangThai)</td>
                    <td>
                        @if (item.TrangThai == "ChoNhanVienXuLy")
                        {
                            <div class="d-flex gap-2">
                                <form asp-area="QuanLyNhaTro" asp-controller="LichXemPhong" asp-action="XacNhan" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary btn-sm" type="submit">Xác nhận</button></form>
                                <form asp-area="QuanLyNhaTro" asp-controller="LichXemPhong" asp-action="TuChoi" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-danger btn-sm" type="submit">Từ chối</button></form>
                            </div>
                        }
                        @if (item.TrangThai == "DaXacNhanLich")
                        {
                            var actionUrl = Url.Action("XuLyLich", "LichXemPhong", new { area = "QuanLyNhaTro", id = item.Id });
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#viewingActionModal" data-viewing-action="Reschedule" data-viewing-url="@actionUrl" data-viewing-slots-url="@Url.Action("KhungGioConTrong", "LichXemPhong", new { area = "QuanLyNhaTro", id = item.Id })" data-viewing-room="@item.TenPhong">Đổi lịch</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#viewingActionModal" data-viewing-action="Cancel" data-viewing-url="@actionUrl" data-viewing-room="@item.TenPhong">Hủy lịch</button>
                                @if (item.ThoiGianMongMuonUtc <= DateTime.UtcNow)
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#viewingActionModal" data-viewing-action="Complete" data-viewing-url="@actionUrl" data-viewing-room="@item.TenPhong">Đã xem phòng</button>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Count == 0) { <p class="p-4 text-secondary">Chưa có yêu cầu xem phòng nào.</p> }
    </div></div>
</div>

<div class="modal modal-blur fade" id="viewingActionModal" tabindex="-1" aria-labelledby="viewingActionTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="viewingActionForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="action" id="viewingActionValue" />
                <div class="modal-header">
                    <h2 class="modal-title" id="viewingActionTitle">Xử lý lịch xem</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary" id="viewingActionRoom"></p>
                    <div class="mb-3">
                        <label class="form-label" for="viewingActionReason">Lý do cập nhật</label>
                        <input id="viewingActionReason" name="reason" class="form-control" maxlength="350" required />
                    </div>
                    <div class="mb-3" id="viewingActionTimeGroup" hidden>
                        <label class="form-label" for="viewingActionSlot">Khung giờ mới</label>
                        <select id="viewingActionSlot" name="newSlotId" class="form-select" disabled>
                            <option value="">Chọn khung giờ còn chỗ</option>
                        </select>
                        <div id="viewingActionSlotStatus" class="form-hint mt-2" role="status">Chọn khung giờ đã thống nhất với khách.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="viewingActionSubmit">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/staff-viewing-actions.js" asp-append-version="true" defer></script>
}
