@{
    ViewData["Title"] = "Dịch vụ";
    // Danh mục dịch vụ hệ thống dùng chung: nhân viên chỉ xem, bảng giá chi nhánh vẫn sửa được.
    var laAdmin = User.IsInRole("Admin");
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Dịch vụ</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <ul class="nav nav-tabs card-header-tabs" id="custom-tabs-four-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="tab-danh-muc-dich-vu" data-bs-toggle="tab" href="#content-danh-muc-dich-vu" role="tab" aria-controls="content-danh-muc-dich-vu" aria-selected="true">Danh mục dịch vụ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="tab-bang-gia" data-bs-toggle="tab" href="#content-bang-gia" role="tab" aria-controls="content-bang-gia" aria-selected="false">Bảng giá theo chi nhánh</a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-four-tabContent">
                            <!-- TAB DANH MỤC DỊCH VỤ -->
                            <div class="tab-pane fade show active" id="content-danh-muc-dich-vu" role="tabpanel" aria-labelledby="tab-danh-muc-dich-vu">
                                <div class="mb-3 d-flex justify-content-between align-items-center">
                                    <h4 class="m-0">Danh sách dịch vụ chung</h4>
                                    @if (laAdmin)
                                    {
                                        <button class="btn btn-primary" id="btnOpenAddDichVu"><i class="ti ti-plus me-1"></i> Thêm dịch vụ</button>
                                    }
                                </div>
                                <table id="dichVuTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                                    <thead>
                                        <tr>
                                            <th class="text-center" width="5%">STT</th>
                                            <th>Tên dịch vụ</th>
                                            <th>Đơn vị tính</th>
                                            <th>Ghi chú</th>
                                            <th class="w-1 text-center" width="15%" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <!-- TAB BẢNG GIÁ THEO CHI NHÁNH -->
                            <div class="tab-pane fade" id="content-bang-gia" role="tabpanel" aria-labelledby="tab-bang-gia">
                                <div class="row mb-3 g-2 align-items-end">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="filterChiNhanh">Lọc theo chi nhánh</label>
                                        <select class="form-select" id="filterChiNhanh">
                                            <option value="0">Tất cả chi nhánh</option>
                                            @if (ViewBag.ListChiNhanh != null)
                                            {
                                                foreach (var cn in ViewBag.ListChiNhanh)
                                                {
                                                    <option value="@cn.Value">@cn.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-8 d-flex justify-content-md-end">
                                        <button class="btn btn-primary" id="btnOpenAddGia"><i class="ti ti-plus me-1"></i> Thêm giá</button>
                                    </div>
                                </div>
                                <table id="bangGiaTable" class="table table-vcenter table-hover w-100 ts-bang-the">
                                    <thead>
                                        <tr>
                                            <th class="text-center" width="5%">STT</th>
                                            <th>Chi nhánh</th>
                                            <th>Tên dịch vụ</th>
                                            <th class="text-end num-tabular">Giá dịch vụ (VNĐ)</th>
                                            <th class="text-center" width="12%">Mặc định</th>
                                            <th class="w-1 text-center" width="15%" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Dịch Vụ -->
<div class="modal fade" id="dichVuModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dichVuModalTitle">Thêm dịch vụ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DichVuId" value="0" />
                <div class="form-group mb-3">
                    <label class="form-label" for="TenDichVu">Tên dịch vụ <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="TenDichVu" placeholder="VD: Điện, Nước, Rác...">
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="DonVi">Đơn vị tính <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="DonVi" placeholder="VD: kWh, m3, Tháng...">
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="GhiChuDichVu">Ghi chú</label>
                    <textarea class="form-control" id="GhiChuDichVu" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveDichVu"><i class="ti ti-plus me-1"></i> Thêm dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Bảng Giá -->
<div class="modal fade" id="bangGiaModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bangGiaModalTitle">Cài đặt giá dịch vụ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DichVuChiNhanhId" value="0" />
                <div class="form-group mb-3">
                    <label class="form-label" for="BgChiNhanhId">Chi nhánh <span class="text-danger">*</span></label>
                    <select class="form-select" id="BgChiNhanhId">
                        <option value="">-- Chọn chi nhánh --</option>
                        @if (ViewBag.ListChiNhanh != null)
                        {
                            foreach (var cn in ViewBag.ListChiNhanh)
                            {
                                <option value="@cn.Value">@cn.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="BgDichVuId">Dịch vụ <span class="text-danger">*</span></label>
                    <select class="form-select" id="BgDichVuId">
                        <option value="">-- Chọn dịch vụ --</option>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="GiaDichVu">Giá dịch vụ (VNĐ) <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="GiaDichVu" value="0" min="0">
                </div>
                <div class="form-group mb-3">
                    <label class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="MacDinhBangGia">
                        <span class="form-check-label" for="MacDinhBangGia">
                            <strong>Bắt buộc sử dụng</strong>
                            <span class="text-muted" style="font-size:0.85rem;"> — Dịch vụ mặc định bắt buộc đăng ký ở chi nhánh này</span>
                        </span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveBangGia"><i class="ti ti-plus me-1"></i> Thêm dữ liệu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(unsafe) {
            return (unsafe || "").toString()
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        $(document).ready(function () {
            // Hàm format tiền
            function formatVND(n) {
                if (n === null || n === undefined) return "0 ₫";
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
            }

            // ================== TAB 1: DỊCH VỤ ==================
            var tableDichVu = $('#dichVuTable').DataTable({
                "language": { "url": window.dataTablesViUrl },
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/DichVu/GetList",
                    "type": "POST"
                },
                "columns": [
                    { "data": null, "className": "text-center", "orderable": false, "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "tenDichVu", "name": "tenDichVu", "render": $.fn.dataTable.render.text() },
                    { "data": "donVi", "render": $.fn.dataTable.render.text() },
                    { "data": "ghiChu", "orderable": false, "render": $.fn.dataTable.render.text() },
                    {
                        "data": "dichVuId", "orderable": false, "className": "text-center align-middle",
                        "render": function(data) {
                            if (!@(laAdmin ? "true" : "false")) return '';
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit-dv" data-id="${data}" title="Sửa">
                                        <i class="ti ti-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete-dv" data-id="${data}" title="Xóa">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            $('#btnOpenAddDichVu').click(function() {
                $('#DichVuId').val(0);
                $('#TenDichVu').val('');
                $('#DonVi').val('');
                $('#GhiChuDichVu').val('');
                $('#dichVuModalTitle').text('Thêm dịch vụ mới');
                $('#btnSaveDichVu').html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                $('#dichVuModal').modal('show');
            });

            $('#btnSaveDichVu').click(function() {
                let id = $('#DichVuId').val();
                let ten = $('#TenDichVu').val().trim();
                let dvi = $('#DonVi').val().trim();
                let ghiChu = $('#GhiChuDichVu').val().trim();

                if(!ten || !dvi) { showWarning('Vui lòng nhập tên và đơn vị!'); return; }

                let req = { dichVuId: parseInt(id), tenDichVu: ten, donVi: dvi, ghiChu: ghiChu };
                let isUpdate = id > 0;

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật dịch vụ này?' : 'Bạn có chắc chắn muốn thêm dịch vụ này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin"></i> Đang lưu...');

                        $.ajax({
                            url: isUpdate ? `/DichVu/Update/${id}` : '/DichVu/Create',
                            type: isUpdate ? 'PUT' : 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message);
                                $('#dichVuModal').modal('hide');
                                tableDichVu.ajax.reload(null, false);
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra'); },
                            complete: function() { 
                                if (isUpdate) {
                                    $btn.prop('disabled', false).html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                                } else {
                                    $btn.prop('disabled', false).html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                                }
                            }
                        });
                    }
                });
            });

            $('#dichVuTable').on('click', '.btn-edit-dv', function() {
                let id = $(this).data('id');
                $.get(`/DichVu/GetById/${id}`, function(res) {
                    $('#DichVuId').val(res.dichVuId);
                    $('#TenDichVu').val(res.tenDichVu);
                    $('#DonVi').val(res.donVi);
                    $('#GhiChuDichVu').val(res.ghiChu);
                    $('#dichVuModalTitle').text('Cập nhật dịch vụ');
                    $('#btnSaveDichVu').html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                    $('#dichVuModal').modal('show');
                });
            });

            $('#dichVuTable').on('click', '.btn-delete-dv', function() {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa dịch vụ này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/DichVu/Delete/${id}`, type: 'DELETE',
                            success: function(res) {
                                showSuccess(res.message);
                                tableDichVu.ajax.reload(null, false);
                            },
                            error: function(xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra');
                            }
                        });
                    }
                });
            });

            // ================== TAB 2: BẢNG GIÁ CHI NHÁNH ==================
            var tableBangGia = $('#bangGiaTable').DataTable({
                "language": { "url": window.dataTablesViUrl },
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/DichVuChiNhanh/GetList",
                    "type": "POST",
                    "data": function(d) {
                        d.chiNhanhId = $('#filterChiNhanh').val() || 0;
                    }
                },
                "columns": [
                    { "data": null, "className": "text-center", "orderable": false, "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "tenChiNhanh", "orderable": false, "render": $.fn.dataTable.render.text() },
                    { "data": "tenDichVu", "orderable": false, "render": $.fn.dataTable.render.text() },
                    { "data": "giaDichVu", "orderable": false, "className": "text-end num-tabular", "render": function(d) { return formatVND(d); } },
                    {
                        "data": "macDinh", "orderable": false, "className": "text-center",
                        "render": function(data) {
                            return data
                                ? `<span class="badge-service-required"><i class="ti ti-lock"></i> Bắt buộc</span>`
                                : `<span class="badge-service-optional"><i class="ti ti-pointer"></i> Tùy chọn</span>`;
                        }
                    },
                    {
                        "data": "dichVuChiNhanhId", "orderable": false, "className": "text-center align-middle",
                        "render": function(data) {
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit-bg" data-id="${data}" title="Sửa">
                                        <i class="ti ti-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete-bg" data-id="${data}" title="Xóa">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            $('#filterChiNhanh').change(function() { tableBangGia.ajax.reload(); });

            $('#tab-bang-gia').on('shown.bs.tab', function() {
                tableBangGia.columns.adjust().draw(false);
            });

            function loadDichVuDropdown(selectedId = 0) {
                $.get('/DichVu/GetDropdown', function(data) {
                    let html = '<option value="">-- Chọn dịch vụ --</option>';
                    data.forEach(item => {
                        let sel = item.value == selectedId ? 'selected' : '';
                        html += `<option value="${escapeHtml(item.value)}" ${sel}>${escapeHtml(item.text)}</option>`;
                    });
                    $('#BgDichVuId').html(html);
                });
            }

            $('#btnOpenAddGia').click(function() {
                $('#DichVuChiNhanhId').val(0);
                $('#BgChiNhanhId').val('');
                loadDichVuDropdown();
                $('#GiaDichVu').val(0);
                $('#MacDinhBangGia').prop('checked', false);
                $('#bangGiaModalTitle').text('Cài đặt giá dịch vụ');
                $('#btnSaveBangGia').html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                $('#bangGiaModal').modal('show');
            });

            $('#btnSaveBangGia').click(function() {
                let id = $('#DichVuChiNhanhId').val();
                let cn = $('#BgChiNhanhId').val();
                let dv = $('#BgDichVuId').val();
                let gia = parseFloat($('#GiaDichVu').val() || 0);
                let macDinh = $('#MacDinhBangGia').is(':checked');

                if(!cn || !dv) { showWarning('Vui lòng chọn chi nhánh và dịch vụ!'); return; }
                if(gia < 0) { showWarning('Giá không được âm!'); return; }

                let req = { dichVuChiNhanhId: parseInt(id), chiNhanhId: parseInt(cn), dichVuId: parseInt(dv), giaDichVu: gia, macDinh: macDinh };
                let isUpdate = id > 0;

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật bảng giá này?' : 'Bạn có chắc chắn muốn cài đặt bảng giá này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="ti ti-loader fa-spin"></i> Đang lưu...');

                        $.ajax({
                            url: isUpdate ? `/DichVuChiNhanh/Update/${id}` : '/DichVuChiNhanh/Create',
                            type: isUpdate ? 'PUT' : 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message);
                                $('#bangGiaModal').modal('hide');
                                tableBangGia.ajax.reload(null, false);
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra'); },
                            complete: function() { 
                                if (isUpdate) {
                                    $btn.prop('disabled', false).html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                                } else {
                                    $btn.prop('disabled', false).html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                                }
                            }
                        });
                    }
                });
            });

            $('#bangGiaTable').on('click', '.btn-edit-bg', function() {
                let id = $(this).data('id');
                $.get(`/DichVuChiNhanh/GetById/${id}`, function(res) {
                    $('#DichVuChiNhanhId').val(res.dichVuChiNhanhId);
                    $('#BgChiNhanhId').val(res.chiNhanhId);
                    loadDichVuDropdown(res.dichVuId);
                    $('#GiaDichVu').val(res.giaDichVu);
                    $('#MacDinhBangGia').prop('checked', res.macDinh === true);
                    $('#bangGiaModalTitle').text('Cập nhật bảng giá');
                    $('#btnSaveBangGia').html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                    $('#bangGiaModal').modal('show');
                });
            });

            // Đồng bộ xác nhận xóa bảng giá
            $('#bangGiaTable').on('click', '.btn-delete-bg', function() {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa bảng giá này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/DichVuChiNhanh/Delete/${id}`, type: 'DELETE',
                            success: function(res) {
                                showSuccess(res.message);
                                tableBangGia.ajax.reload(null, false);
                            },
                            error: function(xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra');
                            }
                        });
                    }
                });
            });
        });
    </script>
}

@section Styles {
    <style>
    /* Custom Badges using design tokens */
    .badge-service-required {
        background-color: var(--ts-brand-soft) !important;
        color: var(--ts-brand-text) !important;
        border: none !important;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.85rem;
    }

    .badge-service-optional {
        background-color: var(--tblr-bg-surface-secondary) !important;
        color: var(--ts-ink-muted) !important;
        border: none !important;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.85rem;
    }
</style>
}
