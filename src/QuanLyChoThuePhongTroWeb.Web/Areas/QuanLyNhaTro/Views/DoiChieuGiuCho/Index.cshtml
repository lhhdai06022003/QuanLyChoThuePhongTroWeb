@model IReadOnlyList<QuanLyChoThuePhongTroWeb.Application.Features.GiuChos.DTOs.ProofReviewDto>
@{ ViewData["Title"] = "Đối chiếu giữ chỗ"; }
<div class="container-xl py-4">
    <div class="page-header mb-4"><h1>Đối chiếu tiền giữ chỗ</h1><p class="text-secondary">Kiểm tra ngân hàng trước khi xác nhận; ảnh khách gửi không thay cho tiền thực nhận.</p></div>
    @if (TempData["ReviewError"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (TempData["ReviewSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    @foreach (var item in Model)
    {
        <section class="card mb-3"><div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4">
                    <span class="badge bg-blue-lt">@GuestStatusText.Of(item.TrangThai)</span>
                    <h2 class="h3 mt-2">Phòng @item.TenPhong · @item.TenChiNhanh</h2>
                    <p>@item.KhachHang · yêu cầu #@item.ReservationId</p>
                    <p>Phải trả: <strong>@item.SoTienPhaiTra.ToString("N0") ₫</strong><br />Khách khai báo: @item.SoTienKhaiBao.ToString("N0") ₫</p>
                    <p>Thời điểm khai báo: @item.NgayChuyenTienUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")<br />Mã khách khai: @item.MaGiaoDichKhaiBao</p>
                    <a asp-area="KhachVangLai" asp-controller="MinhChungGiuCho" asp-action="Anh" asp-route-id="@item.Id" target="_blank" rel="noopener noreferrer">Xem ảnh minh chứng</a>
                </div>
                @if (item.TrangThai == "ChoXacNhan")
                {
                    <div class="col-lg-4">
                        <form asp-area="QuanLyNhaTro" asp-controller="DoiChieuGiuCho" asp-action="XacNhan" asp-route-id="@item.Id" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <h3 class="h4">Xác nhận tiền đúng</h3>
                            <label>Mã giao dịch ngân hàng<input class="form-control" name="maGiaoDich" maxlength="100" required /></label>
                            <label>Tiền thực nhận (₫)<input class="form-control" name="soTienThucNhan" type="number" min="1" step="1" required /></label>
                            <label>Thời điểm nhận<input class="form-control" name="ngayThucNhan" type="datetime-local" required /></label>
                            <button class="btn btn-primary" type="submit">Xác nhận giữ chỗ</button>
                        </form>
                    </div>
                    <div class="col-lg-4">
                        <form asp-area="QuanLyNhaTro" asp-controller="DoiChieuGiuCho" asp-action="TuChoi" asp-route-id="@item.Id" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <h3 class="h4">Từ chối và nhả phòng</h3>
                            <label>Lý do<input class="form-control" name="lyDo" maxlength="500" required /></label>
                            <label>Tiền thực nhận, nếu có (₫)<input class="form-control" name="soTienThucNhan" type="number" min="0" step="1" value="0" /></label>
                            <label>Mã giao dịch, nếu có tiền<input class="form-control" name="maGiaoDich" maxlength="100" /></label>
                            <label>Thời điểm nhận, nếu có tiền<input class="form-control" name="ngayThucNhan" type="datetime-local" /></label>
                            <button class="btn btn-outline-danger" type="submit">Từ chối minh chứng</button>
                        </form>
                    </div>
                }
            </div>
        </div></section>
    }
    @if (Model.Count == 0) { <div class="card p-4 text-secondary">Chưa có minh chứng cần đối chiếu.</div> }
</div>
