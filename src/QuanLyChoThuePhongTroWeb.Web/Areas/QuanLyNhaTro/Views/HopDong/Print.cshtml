@model QuanLyChoThuePhongTroWeb.Application.Features.HopDongs.DTOs.HopDongPrintRes

@{
    Layout = null; // In không cần Layout (Menu/Sidebar)
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>In Hợp Đồng - @Model.MaHopDong</title>
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler-icons.min.css">
</head>
<body>

    <div class="print-btn-container d-print-none">
        <button class="btn-print" onclick="window.print()"><i class="ti ti-printer"></i> 🖨️ In Hợp Đồng / Lưu PDF</button>
        <a href="/HopDong/DownloadWord/@Model.HopDongId" class="btn-print" style="background-color: #28a745; text-decoration: none; display: inline-block; margin-left: 10px;">
            <i class="ti ti-file-type-docx"></i> 📝 Tải Word (.docx)
        </a>
        <button class="btn-print" style="background-color: #6c757d; margin-left: 10px;" onclick="window.close()">Đóng</button>
    </div>

    <div class="a4-container">
        <!-- Quốc hiệu - Tiêu ngữ -->
        <div class="text-center mb-3">
            <div class="title-quoc-hieu">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
            <div class="title-doc-lap">Độc lập - Tự do - Hạnh phúc</div>
        </div>

        <div class="text-center mb-2">
            <i>........., ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year</i>
        </div>

        <!-- Tiêu đề Hợp đồng -->
        <div class="text-center hop-dong-title">
            HỢP ĐỒNG THUÊ PHÒNG TRỌ
        </div>
        <div class="text-center mb-4">
            <i>(Số: @Model.MaHopDong)</i>
        </div>

        <p class="mb-3">
            Hôm nay, ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year, tại địa chỉ: @Model.DiaChiChiNhanh. Chúng tôi gồm:
        </p>

        <!-- BÊN A -->
        <div class="font-weight-bold mb-1">BÊN CHO THUÊ PHÒNG TRỌ (BÊN A):</div>
        <div class="indent-1 mb-1">- Đại diện / Quản lý: <span class="font-weight-bold">@Model.TenChiNhanh</span></div>
        <div class="indent-1 mb-1">- Địa chỉ khu trọ: @Model.DiaChiChiNhanh</div>
        <div class="indent-1 mb-3">- Điện thoại: @Model.SoDienThoaiChiNhanh</div>

        <!-- BÊN B -->
        <div class="font-weight-bold mb-1">BÊN THUÊ PHÒNG TRỌ (BÊN B):</div>
        <div class="indent-1 mb-1">- Ông/Bà: <span class="font-weight-bold">@Model.HoVaTenNguoiThue</span></div>
        <div class="indent-1 mb-1">
            - CCCD số: @Model.CCCDNguoiThue 
            cấp ngày @(Model.NgayCapCCCD?.ToString("dd/MM/yyyy") ?? "...") 
            tại @(Model.NoiCapCCCD ?? "...")
        </div>
        <div class="indent-1 mb-1">- Hộ khẩu thường trú: @(Model.QueQuan ?? "...")</div>
        <div class="indent-1 mb-3">- Điện thoại: @Model.SoDienThoaiNguoiThue</div>

        <p class="mb-3 font-weight-bold">Sau khi bàn bạc, hai bên thống nhất ký kết Hợp đồng thuê phòng trọ với các điều khoản sau:</p>

        <!-- ĐIỀU 1: Đối tượng hợp đồng -->
        <div class="section-title">Điều 1: Đối tượng hợp đồng</div>
        <p class="indent-1 text-justify mb-2">
            Bên A đồng ý cho Bên B thuê phòng trọ số <span class="font-weight-bold">@Model.SoPhong</span> tại địa chỉ: @Model.DiaChiChiNhanh.
        </p>

        <!-- ĐIỀU 2: Thời hạn thuê -->
        <div class="section-title">Điều 2: Thời hạn thuê</div>
        <p class="indent-1 text-justify mb-2">
            - Hợp đồng có giá trị kể từ ngày <span class="font-weight-bold">@Model.ThoiDiemBatDau.ToString("dd/MM/yyyy")</span> 
            @if(Model.ThoiDiemKetThuc.HasValue) {
                <span> đến ngày <span class="font-weight-bold">@Model.ThoiDiemKetThuc.Value.ToString("dd/MM/yyyy")</span>.</span>
            } else {
                <span> không xác định thời hạn.</span>
            }
        </p>

        <!-- ĐIỀU 3: Giá thuê và đặt cọc -->
        <div class="section-title">Điều 3: Giá thuê và Tiền cọc</div>
        <p class="indent-1 mb-1">- Tiền thuê phòng: <span class="font-weight-bold">@Model.TienThuePhong.ToString("N0") VNĐ/tháng</span>.</p>
        <p class="indent-1 mb-1">- Tiền đặt cọc: <span class="font-weight-bold">@Model.TienCocPhong.ToString("N0") VNĐ</span>.</p>
        <p class="indent-1 text-justify mb-2">
            - Tiền cọc sẽ được Bên A hoàn trả cho Bên B khi chấm dứt hợp đồng, sau khi đã trừ đi các khoản chi phí điện, nước, dịch vụ còn nợ và chi phí đền bù hư hỏng tài sản (nếu có) theo đúng thỏa thuận.
        </p>

        <!-- ĐIỀU 4: Chi phí khác (Dịch vụ) -->
        <div class="section-title">Điều 4: Chi phí khác (Dịch vụ)</div>
        <div class="indent-1">
            <p class="mb-1 text-justify">Ngoài tiền thuê phòng, Bên B phải thanh toán các chi phí dịch vụ sử dụng hàng tháng (tính theo đơn giá bên dưới):</p>
            @if (Model.DichVus != null && Model.DichVus.Any())
            {
                <table class="table-dichvu">
                    <thead>
                        <tr>
                            <th width="50%">Tên dịch vụ</th>
                            <th width="30%">Đơn giá</th>
                            <th width="20%">Đơn vị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var dv in Model.DichVus)
                        {
                            <tr>
                                <td>@dv.TenDichVu</td>
                                <td>@dv.DonGia.ToString("N0") VNĐ</td>
                                <td>@dv.DonViTinh</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p><i>- (Không đăng ký dịch vụ nào thêm ngoài tiền phòng)</i></p>
            }
        </div>

        <!-- CÁC ĐIỀU KHOẢN KHÁC (TỪ THƯ VIỆN ĐIỀU KHOẢN MẪU) -->
        @if (Model.DieuKhoans != null && Model.DieuKhoans.Any())
        {
            int index = 5;
            foreach (var dk in Model.DieuKhoans)
            {
                <div class="section-title">Điều @index: @dk.TieuDe</div>
                <div class="indent-1 text-justify mb-2" style="white-space: pre-line;">
                    @Html.Raw(dk.NoiDung)
                </div>
                index++;
            }
            
            <div class="section-title">Điều @index: Cam kết chung</div>
            <p class="indent-1 text-justify mb-2">
                Hai bên cam kết thực hiện đúng các điều khoản đã thỏa thuận trong hợp đồng này. Trong quá trình thực hiện, nếu có phát sinh tranh chấp, hai bên sẽ ưu tiên giải quyết thông qua thương lượng. Nếu không tự giải quyết được, sẽ yêu cầu Tòa án giải quyết theo quy định của pháp luật.
            </p>
            <p class="indent-1 text-justify mb-2">
                Hợp đồng này được lập thành 02 (hai) bản, có giá trị pháp lý như nhau, mỗi bên giữ 01 (một) bản để thực hiện.
            </p>
        }
        else
        {
            <div class="section-title">Điều 5: Cam kết chung</div>
            <p class="indent-1 text-justify mb-2">
                Hai bên cam kết thực hiện đúng các điều khoản đã thỏa thuận trong hợp đồng này. Hợp đồng này được lập thành 02 (hai) bản, có giá trị pháp lý như nhau, mỗi bên giữ 01 (một) bản để thực hiện.
            </p>
        }

        <!-- CHỮ KÝ -->
        <div class="signature-grid">
            <div class="signature-box">
                <div class="font-weight-bold mb-5">BÊN A (Bên cho thuê)</div>
                <p><i>(Ký và ghi rõ họ tên)</i></p>
            </div>
            <div class="signature-box">
                <div class="font-weight-bold mb-5">BÊN B (Bên thuê)</div>
                <p><i>(Ký và ghi rõ họ tên)</i></p>
            </div>
        </div>

    </div>

</body>
</html>

    <style>
        /* CSS reset & base */
        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 14pt;
            line-height: 1.5;
            color: #000;
            background: #fff;
            margin: 0;
            padding: 0;
        }

        /* Khổ giấy A4, margin chuẩn */
        .a4-container {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 20mm;
            box-sizing: border-box;
            background: #fff;
        }

        /* Định dạng các thẻ cơ bản */
        h1, h2, h3, h4, p {
            margin: 0;
            padding: 0;
        }
        
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .font-weight-bold { font-weight: bold; }
        .mb-1 { margin-bottom: 5px; }
        .mb-2 { margin-bottom: 10px; }
        .mb-3 { margin-bottom: 15px; }
        .mt-2 { margin-top: 10px; }
        .mt-3 { margin-top: 15px; }
        .mt-4 { margin-top: 20px; }
        .mt-5 { margin-top: 40px; }

        .title-quoc-hieu {
            font-size: 14pt;
            font-weight: bold;
        }
        .title-doc-lap {
            font-size: 14pt;
            font-weight: bold;
            text-decoration: underline;
        }
        
        .hop-dong-title {
            font-size: 18pt;
            font-weight: bold;
            margin: 20px 0 10px 0;
        }

        .section-title {
            font-size: 14pt;
            font-weight: bold;
            text-decoration: underline;
            margin-top: 15px;
            margin-bottom: 5px;
        }

        .indent-1 { padding-left: 20px; }
        .indent-2 { padding-left: 40px; }

        table.table-dichvu {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            margin-bottom: 15px;
        }
        table.table-dichvu th, table.table-dichvu td {
            border: 1px solid #000;
            padding: 5px;
            text-align: left;
        }

        /* Grid chữ ký */
        .signature-grid {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
        .signature-box {
            text-align: center;
            width: 45%;
        }

        /* Khi in thì ẩn nút in, căn lề giấy A4 thực tế */
        @@media print {
            body {
                background: none;
            }
            .a4-container {
                margin: 0;
                padding: 0;
                box-shadow: none;
                width: 100%;
            }
            .d-print-none {
                display: none !important;
            }
            @@page {
                size: A4;
                margin: 20mm;
            }
        }
        
        /* Hiển thị như một tờ giấy thật trên trình duyệt (trước khi in) */
        @@media screen {
            body { background: #e0e0e0; padding: 20px; }
            .a4-container {
                box-shadow: 0 0 10px rgba(0,0,0,0.5);
                margin-bottom: 20px;
            }
        }
        
        .print-btn-container {
            text-align: center;
            margin-bottom: 20px;
        }
        .btn-print {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #007bff;
            color: #fff;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            font-weight: bold;
        }
        .btn-print:hover {
            background-color: #0056b3;
        }
    </style>
