@using QuanLyChoThuePhongTroWeb.Models
@{
    ViewData["Title"] = "Hợp đồng";
    // Ép kiểu dữ liệu ViewBag sang JSON để xài trong Javascript với CamelCase
    var jsonPhongTros = Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListPhongTro, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
}

<div class="container-xl mt-3">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Hợp đồng</h2>
            </div>
            <div class="col-auto ms-auto">
                <button type="button" class="btn btn-primary" id="btnOpenAddModal">
                    <i class="ti ti-plus me-1"></i> Tạo hợp đồng
                </button>
            </div>
        </div>
    </div>

    <!-- Card quản lý & danh sách hợp đồng -->
    <div class="card mb-5">
        <div class="card-body border-bottom py-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-lg">
                    <label for="filterChiNhanh" class="form-label mb-1">Chi nhánh</label>
                    <select id="filterChiNhanh" class="form-select form-select-sm">
                        <option value="0">Tất cả</option>
                        @if (ViewBag.ListChiNhanh != null)
                        {
                            foreach (var cn in ViewBag.ListChiNhanh)
                            {
                                <option value="@cn.Value">@cn.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg">
                    <label for="filterNguoiThue" class="form-label mb-1">Người thuê</label>
                    @* Người thuê đổ từ khối JSON allNguoiThues trong script (in một lần cho cả hai ô chọn). *@
                    <select id="filterNguoiThue" class="form-select form-select-sm">
                        <option value="0">-- Tất cả --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg">
                    <label for="filterDateRange" class="form-label mb-1">Thời hạn hợp đồng</label>
                    <input type="text" class="form-control form-control-sm" id="filterDateRange" placeholder="Chọn khoảng thời gian...">
                </div>
                <div class="col-12 col-sm-6 col-lg">
                    <label for="filterTrangThai" class="form-label mb-1">Trạng thái</label>
                    <select id="filterTrangThai" class="form-select form-select-sm">
                        <option value="0">Tất cả</option>
                        <option value="1">Đang hoạt động</option>
                        <option value="2">Đã kết thúc</option>
                        <option value="3">Đã hủy</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg">
                    <label for="filterBoLoc" class="form-label mb-1">Bộ lọc nhanh</label>
                    <select id="filterBoLoc" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="QuaHan">Quá hạn chưa xử lý</option>
                        <option value="SapHetHan">Sắp hết hạn (30 ngày)</option>
                        <option value="GiaHan">Gia hạn</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-responsive">
                <table id="hopDongTable" class="table card-table table-vcenter table-hover w-100 ts-bang-the">
                    <thead>
                        <tr>
                            <th class="w-1 text-center">STT</th>
                            <th>Mã HĐ</th>
                            <th>Phòng</th>
                            <th>Người đại diện</th>
                            <th>Ngày bắt đầu</th>
                            <th>Hết hạn</th>
                            <th class="text-end">Tiền thuê/tháng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
    </div>
</div>

<div class="modal modal-blur fade" id="hopDongModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Hợp Đồng Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body py-4">
                <!-- Stepper Progress Bar -->
                <div class="steps steps-counter steps-blue mb-4" id="hopDongStepper">
                    <span class="step-item active" data-step="1" id="step-tab-thongtin">Thông tin chung</span>
                    <span class="step-item" data-step="2" id="step-tab-dichvu">Dịch vụ đăng ký</span>
                    <span class="step-item" data-step="3" id="step-tab-dieukhoan">Điều khoản hợp đồng</span>
                    <span class="step-item" data-step="4" id="stepHeaderThanhVien" style="display:none;">Thành viên ở ghép</span>
                </div>

                <div class="tab-content mt-3">
                    <!-- Tab 1: Thông tin hợp đồng -->
                    <div class="tab-pane fade show active" id="content-thongtin" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="MaHopDong" class="form-label">Mã Hợp Đồng</label>
                                    <input type="text" class="form-control fw-bold text-primary" id="MaHopDong" readonly
                                           placeholder="Hệ thống tự sinh khi lưu">
                                </div>

                                <div class="mb-3">
                                    <label for="ChiNhanhId" class="form-label">Chi Nhánh <span class="text-danger">*</span></label>
                                    <select class="form-select" id="ChiNhanhId">
                                        <option value="">-- Chọn chi nhánh --</option>
                                        @if (ViewBag.ListChiNhanh != null)
                                        {
                                            foreach (var cn in ViewBag.ListChiNhanh)
                                            {
                                                <option value="@cn.Value">@cn.Text</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="PhongTroId" class="form-label">Phòng Trọ <span class="text-danger">*</span></label>
                                    <select class="form-select" id="PhongTroId">
                                        <option value="">-- Vui lòng chọn chi nhánh trước --</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="NguoiThueId" class="form-label">Người Đại Diện <span class="text-danger">*</span></label>
                                    <select class="form-control select2" id="NguoiThueId" style="width: 100%;">
                                        <option value="">-- Chọn khách thuê --</option>
                                    </select>
                                    <div id="canhBaoNoCu"></div>
                                </div>

                                <div class="mb-3" id="groupNguoiDungCoO">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NguoiDungCoOPhongKhong" checked>
                                        <label for="NguoiDungCoOPhongKhong" class="form-check-label text-success fw-bold">
                                            Người đại diện có ở tại phòng này không?
                                        </label>
                                    </div>
                                    <small class="form-text text-muted d-block mt-1">Bỏ chọn nếu người này chỉ đứng tên ký hợp đồng (VD: Bố mẹ thuê cho con).</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="ThoiDiemBatDau" class="form-label">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="ThoiDiemBatDau" placeholder="Chọn ngày bắt đầu...">
                                </div>

                                <div class="mb-3">
                                    <label for="ThoiDiemKetThuc" class="form-label">Ngày Kết Thúc (Dự kiến)</label>
                                    <input type="text" class="form-control" id="ThoiDiemKetThuc" placeholder="Chọn ngày kết thúc...">
                                </div>

                                <div class="mb-3">
                                    <label for="TienCocPhong" class="form-label">Tiền Cọc (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="TienCocPhong" value="0" min="0">
                                </div>

                                <div class="mb-3">
                                    <label for="TienThuePhong" class="form-label">Tiền Thuê/Tháng (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="TienThuePhong" min="0">
                                </div>

                                <div class="mb-3" id="groupTrangThaiHopDong" style="display: none;">
                                    <label for="TrangThaiHopDong" class="form-label">Trạng Thái Hợp Đồng <span class="text-danger">*</span></label>
                                    <select class="form-select" id="TrangThaiHopDong">
                                        <option value="1">Đang hoạt động</option>
                                        <option value="3">Đã hủy</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Dịch vụ đăng ký -->
                    <div class="tab-pane fade" id="content-dichvu" role="tabpanel">
                        <div class="alert alert-info py-2 mb-3 border-0">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-info-circle me-2"></i> 
                                <div>
                                    Chọn các dịch vụ cho phòng trọ. Dịch vụ <strong>Mặc định</strong> (Điện, Nước) sẽ được tích sẵn.
                                </div>
                            </div>
                        </div>
                        <div id="hopDongDichVuContainer">
                            <div class="text-center text-muted py-4">
                                <i class="ti ti-hand-click fa-2x mb-2"></i>
                                <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Điều khoản hợp đồng -->
                    <div class="tab-pane fade" id="content-dieukhoan" role="tabpanel">
                        <div class="alert alert-info py-2 mb-3 border-0">
                            <i class="ti ti-info-circle me-2"></i> Chọn các điều khoản sẽ được áp dụng cho hợp đồng này.
                        </div>
                        <div class="row">
                            @if (ViewBag.ListDieuKhoanMau != null)
                            {
                                foreach (var dk in ViewBag.ListDieuKhoanMau)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card shadow-none border">
                                            <div class="card-header p-2 d-flex align-items-center">
                                                <div class="form-check m-0">
                                                    <input class="form-check-input chk-dieukhoan" type="checkbox" id="dk_@dk.DieuKhoanMauId" value="@dk.DieuKhoanMauId">
                                                    <label class="form-check-label fw-bold" for="dk_@dk.DieuKhoanMauId">
                                                        @dk.TieuDe
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="card-body p-2 hopdong-dieukhoan-body">
                                                @dk.NoiDung
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Tab 4: Danh sách thành viên -->
                    <div class="tab-pane fade" id="content-thanhvien" role="tabpanel">
                        @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DanhSachThanhVienPartial.cshtml")
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between py-3">
                <button type="button" class="btn btn-secondary" id="btnWizardBack">
                    <i class="ti ti-arrow-left me-1"></i> Quay lại
                </button>
                <div>
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnWizardNext">
                        Tiếp theo <i class="ti ti-arrow-right ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-primary" id="btnSaveData" style="display: none;">
                        <i class="ti ti-plus me-1"></i> Thêm dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section ThuVienScripts {
    <partial name="_FlatpickrJs" />
    <partial name="_Select2Js" />
}

@section Scripts {
    @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DangKyDichVuPartial.cshtml")

    <script>
        // Dữ liệu từ server cho wwwroot/js/quan-ly-hop-dong.js (file tĩnh không qua Razor).
        window.hopDongConfig = { trangThaiPhongTrong: @((int)QuanLyChoThuePhongTroWeb.Application.Common.Enums.AppTrangThaiPhong.Trong), allNguoiThues: [], allPhongTros: [] };
        @if (ViewBag.ListNguoiThue != null)
        {
            <text>
            window.hopDongConfig.allNguoiThues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListNguoiThue, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            </text>
        }
        window.hopDongConfig.allPhongTros = @jsonPhongTros || [];
    </script>
    <script src="~/js/quan-ly-hop-dong.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/lib/flatpickr/4.6.13/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/flatpickr/4.6.13/themes/material_blue.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/select2/4.0.13/css/select2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hopdong.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dang-ky-dich-vu.css" asp-append-version="true" />
}
