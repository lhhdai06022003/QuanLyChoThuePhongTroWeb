@{
    ViewBag.Title = "Hợp đồng thuê phòng";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Hợp đồng thuê phòng</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover w-100 ts-bang-the" id="hopDongTable">
                        <thead>
                            <tr>
                                <th>Mã hợp đồng</th>
                                <th>Phòng / chi nhánh</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th class="text-end num-tabular">Tiền thuê</th>
                                <th>Trạng thái</th>
                                <th class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem nhanh hợp đồng -->
<div class="modal fade" id="quickContractModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h5 class="modal-title">Xem chi tiết hợp đồng - Phòng <span id="quickContractRoom"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold text-primary border-bottom pb-1 mb-2"><i class="ti ti-info-circle"></i> Thông tin hợp đồng</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td width="40%">Mã HĐ:</td><td><strong id="qcMaHD"></strong></td></tr>
                            <tr><td>Ngày bắt đầu:</td><td id="qcNgayBatDau"></td></tr>
                            <tr><td>Ngày kết thúc:</td><td id="qcNgayKetThuc"></td></tr>
                            <tr><td>Tiền cọc:</td><td><strong id="qcTienCoc" class="text-danger"></strong></td></tr>
                            <tr><td>Tiền thuê:</td><td><strong id="qcTienThue" class="text-danger"></strong></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-primary border-bottom pb-1 mb-2"><i class="ti ti-user"></i> Đại diện ký hợp đồng</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td width="40%">Họ tên:</td><td><strong id="qcTenDaiDien"></strong></td></tr>
                            <tr><td>Số điện thoại:</td><td id="qcSDTDaiDien"></td></tr>
                            <tr><td>Số CCCD:</td><td id="qcCCCDDaiDien"></td></tr>
                        </table>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-3" id="quickContractTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" id="qc-members-tab" data-bs-toggle="tab" href="#qc-members-pane" role="tab"><i class="ti ti-users me-1"></i> Khách ở ghép (<span id="qcMemberCount">0</span>)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold" id="qc-services-tab" data-bs-toggle="tab" href="#qc-services-pane" role="tab"><i class="ti ti-bell me-1"></i> Dịch vụ đăng ký (<span id="qcServiceCount">0</span>)</a>
                    </li>
                </ul>

                <div class="tab-content" id="quickContractTabContent">
                    <div class="tab-pane fade show active" id="qc-members-pane" role="tabpanel">
                        <div class="table-responsive ts-cuon-ngang">
                            <table class="table table-sm table-vcenter">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="8%">STT</th>
                                        <th>Họ và tên</th>
                                        <th class="text-center" width="25%">Số điện thoại</th>
                                        <th class="text-center" width="25%">Số CCCD</th>
                                        <th class="text-center" width="20%">Ngày vào ở</th>
                                    </tr>
                                </thead>
                                <tbody id="qcMembersBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="qc-services-pane" role="tabpanel">
                        <div class="table-responsive ts-cuon-ngang">
                            <table class="table table-sm table-vcenter">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="8%">STT</th>
                                        <th>Tên dịch vụ</th>
                                        <th class="text-end num-tabular" width="25%">Đơn giá</th>
                                        <th class="text-center" width="20%">Số lượng</th>
                                        <th class="text-center" width="20%">Đơn vị</th>
                                    </tr>
                                </thead>
                                <tbody id="qcServicesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/khachthue-hop-dong.js" asp-append-version="true"></script>
}
