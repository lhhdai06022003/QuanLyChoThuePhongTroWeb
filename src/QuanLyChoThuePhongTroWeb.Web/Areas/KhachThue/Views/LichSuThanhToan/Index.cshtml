@{
    ViewBag.Title = "Lịch sử thanh toán";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Lịch sử thanh toán</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover w-100 ts-bang-the" id="lichSuTable">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%">STT</th>
                                <th>Mã giao dịch</th>
                                <th>Mã hóa đơn</th>
                                <th>Phòng</th>
                                <th class="text-end num-tabular">Số tiền (VNĐ)</th>
                                <th class="text-center">Phương thức</th>
                                <th>Ngày thanh toán</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(unsafe) {
            return (unsafe || "").toString()
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        $(document).ready(function () {
            $('#lichSuTable').DataTable({
                "ajax": {
                    "url": "/KhachThue/LichSuThanhToan/GetDanhSach",
                    "dataSrc": ""
                },
                "columns": [
                    { 
                        "data": null,
                        "className": "text-center",
                        "render": function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    { "data": "maGiaoDich", "className": "fw-bold", "render": $.fn.dataTable.render.text() },
                    { 
                        "data": "maHoaDon",
                        "render": function (data) {
                            return '<span class="text-primary fw-bold">' + escapeHtml(data) + '</span>';
                        }
                    },
                    { 
                        "data": "soPhong",
                        "render": function (data) {
                            return 'Phòng ' + escapeHtml(data);
                        }
                    },
                    { 
                        "data": "soTienThanhToan",
                        "className": "text-end num-tabular fw-bold",
                        "render": function (data) {
                            return formatVND(data);
                        }
                    },
                    { 
                        "data": "phuongThucThanhToan",
                        "className": "text-center",
                        "render": function (data) {
                            if (data === 0) {
                                return '<span class="badge bg-secondary-lt"><i class="ti ti-cash me-1"></i> Tiền mặt</span>';
                            } else if (data === 1) {
                                return '<span class="badge bg-primary-lt"><i class="ti ti-building-bank me-1"></i> Chuyển khoản</span>';
                            } else if (data === 2) {
                                return '<span class="badge bg-purple-lt"><i class="ti ti-arrows-exchange me-1"></i> Cấn trừ tiền cọc</span>';
                            }
                            return '';
                        }
                    },
                    { "data": "ngayThanhToan", "render": $.fn.dataTable.render.text() },
                    { 
                        "data": "ghiChu",
                        "className": "text-muted text-wrap",
                        "render": function (data) {
                            return escapeHtml(data) || '-';
                        }
                    }
                ],
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json"
                },
                "pageLength": 10,
                "ordering": true,
                "info": true,
                "autoWidth": false
            });
        });

        function formatVND(n) {
            if (n === null || n === undefined) return "0 ₫";
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
        }
    </script>
}
