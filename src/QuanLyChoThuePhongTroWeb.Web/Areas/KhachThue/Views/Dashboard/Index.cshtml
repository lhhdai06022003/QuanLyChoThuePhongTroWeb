@{
    ViewBag.Title = "Tổng quan";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Tổng quan</div>
                <h2 class="page-title d-flex align-items-center"><i class="ti ti-home me-2 text-primary"></i> Xin chào người thuê @ViewBag.NguoiThueName</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">Tìm và đặt phòng</h3>
                        <p class="text-muted">Xem phòng trống, chọn lịch hẹn trên trang phòng, hoặc gửi yêu cầu giữ chỗ để được duyệt tiền cọc.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-primary" href="/phong">Xem phòng trống</a>
                            <a class="btn btn-outline-primary" href="/lich-xem">Lịch xem của tôi</a>
                            <a class="btn btn-outline-primary" href="/giu-cho">Yêu cầu đặt cọc</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="subheader">Tình trạng hợp đồng</div>
                        </div>
                        <div class="h1 mb-3">Đang hoạt động</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="subheader">Hóa đơn chưa thanh toán</div>
                        </div>
                        <div class="h1 mb-3">@string.Format("{0:#,##0} VNĐ", ViewBag.TongTienChuaThanhToan ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
