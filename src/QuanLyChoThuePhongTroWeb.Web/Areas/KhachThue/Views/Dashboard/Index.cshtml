@using QuanLyChoThuePhongTroWeb.Web.Helpers
@model QuanLyChoThuePhongTroWeb.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    Layout = Model.HasTenantProfile ? "_LayoutKhachThue" : "_PublicRoomLayout";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Tổng quan tài khoản</div>
                <h1 class="page-title">Xin chào @Model.CustomerName</h1>
                <p class="text-secondary mt-2">Theo dõi lịch xem phòng, yêu cầu giữ chỗ và tiền đặt cọc của bạn.</p>
            </div>
            <div class="col-auto"><a class="btn @(Model.HasTenantProfile ? "btn-outline-secondary" : "btn-primary")" href="/phong">Tìm phòng</a></div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (Model.HasTenantProfile)
        {
            <section class="card mb-3 tenant-thanh-toan" aria-label="Hóa đơn chưa thanh toán">
                <div class="card-body">
                    @if (Model.OutstandingInvoiceAmount > 0)
                    {
                        <div class="d-flex justify-content-between align-items-baseline gap-2">
                            <span class="fw-medium">Cần thanh toán</span>
                            <span class="text-secondary small">@Model.OutstandingInvoiceCount hóa đơn</span>
                        </div>
                        <div class="h1 my-2 num-tabular">@VndFormat.Money(Model.OutstandingInvoiceAmount)</div>
                        @if (Model.NearestDueUtc.HasValue)
                        {
                            var hanNgay = VietnamTime.Format(Model.NearestDueUtc.Value, "dd/MM");
                            @if (!Model.NearestDueOverdue)
                            {
                                <div class="tenant-han is-wait"><i class="ti ti-clock me-1" aria-hidden="true"></i>@(Model.NearestDueDays > 0 ? $"Hạn {hanNgay}, còn {Model.NearestDueDays} ngày" : $"Hạn {hanNgay}, hết hạn hôm nay")</div>
                            }
                            else
                            {
                                <div class="tenant-han is-bad"><i class="ti ti-alert-circle me-1" aria-hidden="true"></i>@(Model.NearestDueDays > 0 ? $"Quá hạn {Model.NearestDueDays} ngày" : "Quá hạn từ hôm nay")</div>
                            }
                        }
                        <a href="/KhachThue/HoaDon" class="btn btn-primary w-100 mt-3"><i class="ti ti-qrcode me-1" aria-hidden="true"></i>Thanh toán bằng mã QR</a>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-circle-check fs-2 tenant-han is-ok" aria-hidden="true"></i>
                            <span class="fw-medium">Bạn đã thanh toán đủ</span>
                        </div>
                        <a href="/KhachThue/HoaDon" class="d-inline-block mt-2">Xem hóa đơn</a>
                    }
                </div>
            </section>

            <div class="card mb-3">
                <div class="list-group list-group-flush">
                    <a href="/KhachThue/ChiSoDienNuoc" class="list-group-item list-group-item-action d-flex align-items-center gap-2"><i class="ti ti-bolt text-secondary" aria-hidden="true"></i><span class="flex-fill">Điện nước</span><i class="ti ti-chevron-right text-secondary" aria-hidden="true"></i></a>
                    <a href="/KhachThue/SuCo" class="list-group-item list-group-item-action d-flex align-items-center gap-2"><i class="ti ti-tools text-secondary" aria-hidden="true"></i><span class="flex-fill">Báo sự cố</span><i class="ti ti-chevron-right text-secondary" aria-hidden="true"></i></a>
                    <a href="/KhachThue/HopDong" class="list-group-item list-group-item-action d-flex align-items-center gap-2"><i class="ti ti-file-text text-secondary" aria-hidden="true"></i><span class="flex-fill">Hợp đồng</span><i class="ti ti-chevron-right text-secondary" aria-hidden="true"></i></a>
                </div>
            </div>
        }
        <partial name="_CustomerRequestSummary" model="Model" />
    </div>
</div>
