@{
    ViewBag.Title = "Hóa đơn và thanh toán";
    var moHoaDonId = (ViewBag.MoHoaDonId != null && (int)ViewBag.MoHoaDonId > 0) ? (int)ViewBag.MoHoaDonId : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hoadon.css" asp-append-version="true" />
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Hóa đơn và thanh toán</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive kt-hoadon-list-scroll">
                    <table class="table table-vcenter table-hover w-100 ts-bang-the" id="hoaDonTable">
                        <thead>
                            <tr>
                                <th>Mã hóa đơn</th>
                                <th>Kỳ</th>
                                <th class="text-end num-tabular">Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày lập</th>
                                <th class="w-1 text-center" data-the-nhan=""><span class="visually-hidden">Thao tác</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết Hóa đơn -->
<div class="modal modal-blur fade modal-fullscreen-sm-down" id="chiTietModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h5 class="modal-title fw-bold">Chi tiết hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body py-3 py-md-4" id="chiTietBody">
                <div class="text-center"><i class="ti ti-loader fa-spin fa-2x"></i> Đang tải dữ liệu...</div>
            </div>
            <div class="modal-footer" id="chiTietFooter">
                <a href="#" class="btn btn-outline-danger me-auto d-none" id="btnDownloadPdf" target="_blank">
                    <i class="ti ti-file-type-pdf me-1"></i> Tải PDF
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/khachthue-vnpay.js" asp-append-version="true"></script>
    <script src="~/js/khachthue-thanhtoan.js" asp-append-version="true"></script>
    <script>
        // Giá trị từ server cho wwwroot/js/khachthue-hoa-don.js (file tĩnh không qua Razor); khai báo như khi còn nằm chung một khối.
        var autoOpenHoaDonId = @moHoaDonId;
    </script>
    <script src="~/js/khachthue-hoa-don.js" asp-append-version="true"></script>
}
