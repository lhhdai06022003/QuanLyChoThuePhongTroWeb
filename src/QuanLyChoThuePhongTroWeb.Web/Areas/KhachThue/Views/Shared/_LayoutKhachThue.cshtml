<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Khách Thuê - Quản Lý Trọ</title>

    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler-icons.min.css" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler-vendors.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/trosync-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tenant-bento.css" asp-append-version="true" />

    <style>
        .swal2-popup.swal2-custom-popup {
            border-radius: 12px !important;
            font-family: inherit !important;
        }
        .swal2-custom-popup .swal2-title { font-weight: 600 !important; }
        .swal2-custom-popup .swal2-actions button {
            border-radius: 6px !important; font-weight: 500 !important; padding: 8px 20px !important;
        }
        /* SweetAlert2 Dark Mode Sync */
        [data-bs-theme="dark"] .swal2-popup {
            background-color: var(--tblr-bg-surface) !important;
            color: var(--tblr-body-color) !important;
        }
        [data-bs-theme="dark"] .swal2-title,
        [data-bs-theme="dark"] .swal2-html-container {
            color: var(--tblr-body-color) !important;
        }
    </style>
    <script>
        const savedTheme = localStorage.getItem('tablerTheme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="layout-fluid">
    @Html.AntiForgeryToken()
    <div class="page">
        <!-- Sidebar -->
        <partial name="_SidebarKhachThue" />

        <div class="page-wrapper">
            <!-- Header (Navbar) -->
            <partial name="~/Views/Shared/_Header.cshtml" />

            <main class="page-body m-0 pt-3" role="main">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <partial name="~/Views/Shared/_Footer.cshtml" />
        </div>

        <!-- Mobile Bottom Navigation Bar (< 768px) -->
        <nav class="tenant-bottom-nav d-md-none" aria-label="Điều hướng chính di động">
            <a href="/KhachThue/Dashboard" class="tenant-bottom-nav-item @(Context.Request.Path.StartsWithSegments("/KhachThue/Dashboard") ? "active" : "")">
                <i class="ti ti-layout-dashboard"></i>
                <span>Tổng quan</span>
            </a>
            <a href="/KhachThue/HoaDon" class="tenant-bottom-nav-item @(Context.Request.Path.StartsWithSegments("/KhachThue/HoaDon") ? "active" : "")">
                <i class="ti ti-receipt-2"></i>
                <span>Hóa đơn</span>
            </a>
            <a href="/KhachThue/ChiSoDienNuoc" class="tenant-bottom-nav-item @(Context.Request.Path.StartsWithSegments("/KhachThue/ChiSoDienNuoc") ? "active" : "")">
                <i class="ti ti-bolt"></i>
                <span>Điện nước</span>
            </a>
            <a href="/KhachThue/SuCo" class="tenant-bottom-nav-item @(Context.Request.Path.StartsWithSegments("/KhachThue/SuCo") ? "active" : "")">
                <i class="ti ti-tool"></i>
                <span>Báo sự cố</span>
            </a>
            <a href="/KhachThue/HopDong" class="tenant-bottom-nav-item @(Context.Request.Path.StartsWithSegments("/KhachThue/HopDong") ? "active" : "")">
                <i class="ti ti-file-text"></i>
                <span>Hợp đồng</span>
            </a>
        </nav>
    </div>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $.ajaxSetup({
            beforeSend: function (xhr, settings) {
                if (!/^(GET|HEAD|OPTIONS|TRACE)$/i.test(settings.type)) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    if (token) {
                        xhr.setRequestHeader("RequestVerificationToken", token);
                    }
                }
            }
        });
    </script>
    <script src="~/Theme/tabler/dist/js/tabler.min.js"></script>
    <script>
        window.bootstrap = window.tabler;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        if (typeof Swal !== 'undefined') {
            const originalFire = Swal.fire;
            // Chữ nút mặc định của SweetAlert2 là OK / Cancel; hộp thoại nào tự đặt chữ nút thì giữ nguyên.
            const nutMacDinh = { confirmButtonText: 'Đóng', cancelButtonText: 'Hủy bỏ' };
            Swal.fire = function(...args) {
                if (typeof args[0] === 'string') {
                    // Dạng rút gọn Swal.fire(tiêu đề, nội dung, biểu tượng): đổi sang object để đặt chữ nút, giữ nguyên giao diện.
                    return originalFire.call(this, Object.assign({}, nutMacDinh, { title: args[0], text: args[1], icon: args[2] }));
                }
                if (args.length === 1 && typeof args[0] === 'object') {
                    let options = args[0] = Object.assign({}, nutMacDinh, args[0]);
                    options.customClass = options.customClass || {};
                    options.customClass.popup = (options.customClass.popup || '') + ' swal2-custom-popup';
                    if (!options.confirmButtonColor) {
                        options.confirmButtonColor = (options.icon === 'error' || options.icon === 'warning') ? '#d33' : '#3085d6';
                    }
                    if (!options.cancelButtonColor) { options.cancelButtonColor = '#6c757d'; }
                }
                return originalFire.apply(this, args);
            };
            window.showSuccess = msg => Swal.fire({ icon: 'success', title: 'Thành công', text: msg, confirmButtonColor: '#3085d6' });
            window.showError = msg => Swal.fire({ icon: 'error', title: 'Lỗi', text: msg, confirmButtonColor: '#3085d6' });
        }
    </script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        // Cảnh báo lỗi mặc định của DataTables là tiếng Anh ("DataTables warning: ..."); đổi sang thông báo tiếng Việt, chi tiết kỹ thuật ghi ra console.
        if ($.fn.dataTable) {
            $.fn.dataTable.ext.errMode = function (settings, techNote, message) {
                console.error(message);
                if (typeof window.showError === 'function') {
                    window.showError('Không tải được dữ liệu bảng. Vui lòng tải lại trang.');
                }
            };
        }
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/thongbao.js" asp-append-version="true"></script>
    @{ ViewData["AiChatPortal"] = "KhachThue"; }
    <partial name="~/Views/Shared/_AiChatWidget.cshtml" />
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function (err) {
                    console.warn('ServiceWorker registration error:', err);
                });
            });
        }
    </script>
</body>
</html>
