@model IReadOnlyList<QuanLyChoThuePhongTroWeb.Application.Features.LichXemPhongs.DTOs.GuestViewingDto>
@{ ViewData["Title"] = "Lịch xem của tôi"; }
<div class="guest-container guest-form-page guest-reservation-page">
    <p class="guest-kicker">Tài khoản của bạn</p>
    <h1>Lịch xem phòng.</h1>
    <p>Các yêu cầu gửi khi đã đăng nhập được hiển thị tại đây.</p>
    @if (Model.Count == 0) { <div class="guest-empty"><h2>Chưa có lịch xem</h2><a class="guest-button guest-button-primary" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Tìm phòng</a></div> }
    else
    {
        <div class="guest-reservation-list">
        @foreach (var item in Model)
        {
            <article class="guest-reservation-card">
                <div><span class="guest-kicker">LỊCH XEM #@item.Id</span><h2>Phòng @item.TenPhong</h2><p>@item.TenChiNhanh</p></div>
                <div><span class="guest-status">@GuestStatusText.Of(item.TrangThai)</span><p>@item.ThoiGianMongMuonUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>
                    @if (item.TrangThai == "DaXacNhanLich" && item.MaCongKhai is not null)
                    {
                        <a asp-area="KhachVangLai" asp-controller="GiuCho" asp-action="Tao" asp-route-maCongKhai="@item.MaCongKhai" asp-route-yeuCauXemPhongId="@item.Id">Yêu cầu giữ chỗ từ lịch này ↗</a>
                    }
                </div>
            </article>
        }
        </div>
    }
</div>
