@model QuanLyChoThuePhongTroWeb.Areas.KhachVangLai.ViewModels.TaoLichXemViewModel
@{
    ViewData["Title"] = "Đặt lịch xem phòng";
    var vietnamZone = TimeZoneInfo.CreateCustomTimeZone("Việt Nam", TimeSpan.FromHours(7), "Việt Nam", "Việt Nam");
}

<div class="guest-container guest-form-page">
    <a class="guest-back" asp-area="KhachVangLai" asp-controller="Phong" asp-action="ChiTiet" asp-route-maCongKhai="@Model.MaCongKhai">← Về thông tin phòng</a>
    <div class="guest-form-grid">
        <div>
            <p class="guest-kicker">Bước tiếp theo</p>
            <h1>Đến xem phòng<br />theo lịch của bạn.</h1>
            <p class="guest-form-lead">Chọn khung giờ còn chỗ để xác nhận ngay, hoặc đề xuất thời gian khác và chờ nhân viên liên hệ.</p>
            <div class="guest-form-room">
                <span>Phòng bạn muốn xem</span>
                <strong>@Model.Phong?.TieuDe</strong>
                <small>@Model.Phong?.TenChiNhanh · @Model.Phong?.DiaChi</small>
            </div>
        </div>
        <form method="post" class="guest-viewing-form" asp-area="KhachVangLai" asp-controller="LichXem" asp-action="Tao" asp-route-maCongKhai="@Model.MaCongKhai">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="guest-validation" role="alert"></div>
            <h2>Thông tin lịch xem</h2>
            <label asp-for="KhungGioXemPhongId">Khung giờ có sẵn</label>
            <select asp-for="KhungGioXemPhongId">
                <option value="">Tôi muốn đề xuất thời gian khác</option>
                @foreach (var slot in Model.KhungGios)
                {
                    var start = TimeZoneInfo.ConvertTimeFromUtc(slot.BatDauUtc, vietnamZone);
                    var end = TimeZoneInfo.ConvertTimeFromUtc(slot.KetThucUtc, vietnamZone);
                    <option value="@slot.Id">@start.ToString("dd/MM/yyyy HH:mm")–@end.ToString("HH:mm") · còn @slot.SoChoConLai chỗ</option>
                }
            </select>
            <label asp-for="ThoiGianMongMuon">Thời gian mong muốn (nếu không chọn khung giờ)</label>
            <input asp-for="ThoiGianMongMuon" type="datetime-local" />
            <span asp-validation-for="ThoiGianMongMuon" class="guest-validation"></span>
            <div class="guest-form-divider"></div>
            <h2>Thông tin liên hệ</h2>
            <label asp-for="HoTen">Họ và tên <span>*</span></label>
            <input asp-for="HoTen" autocomplete="name" placeholder="Nguyễn Văn A" />
            <span asp-validation-for="HoTen" class="guest-validation"></span>
            <label asp-for="SoDienThoai">Số điện thoại <span>*</span></label>
            <input asp-for="SoDienThoai" type="tel" autocomplete="tel" inputmode="numeric" placeholder="09..." />
            <span asp-validation-for="SoDienThoai" class="guest-validation"></span>
            <label asp-for="Email">Email (không bắt buộc)</label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="ban@example.com" />
            <span asp-validation-for="Email" class="guest-validation"></span>
            <label asp-for="GhiChu">Ghi chú cho nhân viên</label>
            <textarea asp-for="GhiChu" rows="3" placeholder="Bạn muốn hỏi thêm điều gì?"></textarea>
            <span asp-validation-for="GhiChu" class="guest-validation"></span>
            <button class="guest-button guest-button-primary" type="submit">Gửi yêu cầu xem phòng <span aria-hidden="true">↗</span></button>
            <p class="guest-form-footnote">Lịch này được lưu vào tài khoản của bạn. Khung giờ có sẵn được xác nhận ngay; thời gian đề xuất cần nhân viên duyệt.</p>
        </form>
    </div>
</div>
