@{
    ViewData["Title"] = "Đã gửi yêu cầu";
}
<div class="guest-container guest-confirmation">
    <span class="guest-confirmation-icon" aria-hidden="true">✓</span>
    <p class="guest-kicker">Yêu cầu đã được tiếp nhận</p>
    <h1>Hẹn gặp bạn tại phòng.</h1>
    <p>Nếu bạn chọn khung giờ có sẵn, lịch đã được xác nhận. Nếu bạn đề xuất thời gian khác, nhân viên sẽ liên hệ theo số điện thoại đã cung cấp.</p>
    <a class="guest-button guest-button-primary" asp-area="KhachVangLai" asp-controller="LichXem" asp-action="Index">Xem lịch hẹn của tôi</a>
    <a class="guest-confirmation-secondary" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Tiếp tục xem phòng</a>
</div>
