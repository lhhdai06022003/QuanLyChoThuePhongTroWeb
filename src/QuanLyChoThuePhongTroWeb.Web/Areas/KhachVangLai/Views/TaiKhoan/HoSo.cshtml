@model QuanLyChoThuePhongTroWeb.Areas.KhachVangLai.ViewModels.HoSoViewModel
@{ ViewData["Title"] = "Hồ sơ của tôi"; }
<div class="guest-container guest-form-page guest-reservation-page">
    <p class="guest-kicker">Tài khoản của bạn</p><h1>Thông tin cá nhân.</h1>
    <p>Email và CCCD cần được nhập trước khi gửi yêu cầu giữ chỗ và lập hợp đồng.</p>
    @if (TempData["ProfileSuccess"] is string success) { <p class="guest-success" role="status">@success</p> }
    <form asp-area="KhachVangLai" asp-controller="TaiKhoan" asp-action="HoSo" method="post" class="guest-viewing-form" style="max-width:560px">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="guest-validation" role="alert"></div>
        <h2>@Model.HoTen</h2><p>@Model.SoDienThoai</p>
        <label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="guest-validation"></span>
        <label asp-for="CCCD">Số CCCD</label><input asp-for="CCCD" inputmode="numeric" maxlength="12" /><span asp-validation-for="CCCD" class="guest-validation"></span>
        <button class="guest-button guest-button-primary" type="submit">Lưu hồ sơ</button>
    </form>
</div>
