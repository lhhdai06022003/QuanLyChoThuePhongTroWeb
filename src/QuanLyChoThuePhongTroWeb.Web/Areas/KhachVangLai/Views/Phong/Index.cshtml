@model PublicRoomPageDto
@{
    ViewData["Title"] = "Tìm phòng";
    var query = ViewBag.Query as PublicRoomQuery ?? new PublicRoomQuery();
    var pageCount = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<section class="guest-intro">
    <div class="guest-container guest-intro-grid">
        <div>
            <p class="guest-kicker">Một chỗ ở hợp nhịp sống</p>
            <h1>Tìm căn phòng vừa với bạn.</h1>
            <p class="guest-intro-copy">Xem ảnh, diện tích và giá thuê trước khi chọn nơi muốn đến xem. Mỗi tin ở đây đang nhận yêu cầu mới.</p>
        </div>
        <div class="guest-intro-mark" aria-hidden="true"><span class="mark-door"></span><span class="mark-window"></span><span class="mark-number">P</span></div>
    </div>
</section>

<section class="guest-container guest-listing" aria-labelledby="room-results-heading">
    <form method="get" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index" class="guest-filter" aria-label="Lọc phòng">
        <div class="guest-filter-title">Lọc nhanh</div>
        <label>
            <span>Giá từ</span>
            <input type="number" name="GiaTu" min="0" step="100000" value="@query.GiaTu" inputmode="numeric" placeholder="Ví dụ 2.000.000" />
        </label>
        <label>
            <span>Giá đến</span>
            <input type="number" name="GiaDen" min="0" step="100000" value="@query.GiaDen" inputmode="numeric" placeholder="Không giới hạn" />
        </label>
        <label>
            <span>Diện tích từ (m²)</span>
            <input type="number" name="DienTichTu" min="0" step="1" value="@query.DienTichTu" inputmode="decimal" placeholder="Không giới hạn" />
        </label>
        <button class="guest-button guest-button-primary" type="submit">Xem phòng phù hợp</button>
    </form>

    <div class="guest-results-head">
        <div>
            <h2 id="room-results-heading">Phòng đang có</h2>
            <p>@Model.TotalCount phòng phù hợp với bộ lọc</p>
        </div>
        @if (query.GiaTu.HasValue || query.GiaDen.HasValue || query.DienTichTu.HasValue)
        {
            <a class="guest-clear" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Xóa bộ lọc</a>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="guest-empty">
            <span class="guest-empty-mark" aria-hidden="true">⌂</span>
            <h3>Chưa có phòng phù hợp</h3>
            <p>Thử nới khoảng giá hoặc diện tích để xem thêm lựa chọn.</p>
            <a class="guest-button guest-button-outline" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Xem tất cả phòng</a>
        </div>
    }
    else
    {
        <div class="guest-room-grid">
            @foreach (var room in Model.Items)
            {
                var image = room.AnhPhongs.FirstOrDefault();
                <article class="guest-room-card">
                    <a class="guest-room-visual" asp-area="KhachVangLai" asp-controller="Phong" asp-action="ChiTiet" asp-route-maCongKhai="@room.MaCongKhai" aria-label="Xem chi tiết @room.TieuDe">
                        @if (image is not null)
                        {
                            <img src="@image.Url" alt="Ảnh phòng @room.SoPhong" loading="lazy" />
                        }
                        else
                        {
                            <span class="guest-room-no-image"><span class="guest-room-no-image-icon" aria-hidden="true">⌂</span><span>Ảnh phòng đang được cập nhật</span></span>
                        }
                        <span class="guest-room-number">@room.SoPhong</span>
                    </a>
                    <div class="guest-room-body">
                        <p class="guest-room-location">@room.TenChiNhanh · @room.DiaChi</p>
                        <h3><a asp-area="KhachVangLai" asp-controller="Phong" asp-action="ChiTiet" asp-route-maCongKhai="@room.MaCongKhai">@room.TieuDe</a></h3>
                        <div class="guest-room-facts"><span>@room.DienTich.ToString("0.#") m²</span><span>Tối đa @room.SoNguoiToiDa người</span></div>
                        <div class="guest-room-bottom">
                            <p><strong>@room.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</strong><span>/ tháng</span></p>
                            <a asp-area="KhachVangLai" asp-controller="Phong" asp-action="ChiTiet" asp-route-maCongKhai="@room.MaCongKhai" aria-label="Xem chi tiết @room.TieuDe">Xem phòng <span aria-hidden="true">↗</span></a>
                        </div>
                    </div>
                </article>
            }
        </div>
        @if (pageCount > 1)
        {
            <nav class="guest-pagination" aria-label="Trang phòng">
                @if (Model.Page > 1)
                {
                    <a asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index" asp-route-Page="@(Model.Page - 1)" asp-route-GiaTu="@query.GiaTu" asp-route-GiaDen="@query.GiaDen" asp-route-DienTichTu="@query.DienTichTu">Trang trước</a>
                }
                <span>Trang @Model.Page / @pageCount</span>
                @if (Model.Page < pageCount)
                {
                    <a asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index" asp-route-Page="@(Model.Page + 1)" asp-route-GiaTu="@query.GiaTu" asp-route-GiaDen="@query.GiaDen" asp-route-DienTichTu="@query.DienTichTu">Trang sau</a>
                }
            </nav>
        }
    }
</section>
