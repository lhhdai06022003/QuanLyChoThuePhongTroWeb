@model PublicRoomDto
@{
    ViewData["Title"] = Model.TieuDe;
    var cover = Model.AnhPhongs.FirstOrDefault();
}

<div class="guest-container guest-detail">
    <nav class="guest-breadcrumb" aria-label="Đường dẫn trang">
        <a asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Tìm phòng</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">@Model.TieuDe</span>
    </nav>

    <div class="guest-detail-title">
        <div>
            <p class="guest-kicker">@Model.TenChiNhanh</p>
            <h1>@Model.TieuDe</h1>
            <p>@Model.DiaChi</p>
        </div>
        <span class="guest-detail-room-number">Phòng @Model.SoPhong</span>
    </div>

    <div class="guest-gallery" data-room-gallery>
        <div class="guest-gallery-main">
            @if (cover is not null)
            {
                <img src="@cover.Url" alt="@(cover.ChuThich ?? $"Ảnh phòng {Model.SoPhong}")" data-gallery-main />
                @if (Model.AnhPhongs.Count > 1)
                {
                    <button type="button" class="guest-gallery-arrow guest-gallery-arrow-prev" data-gallery-prev aria-label="Ảnh trước"><span aria-hidden="true">‹</span></button>
                    <button type="button" class="guest-gallery-arrow guest-gallery-arrow-next" data-gallery-next aria-label="Ảnh tiếp theo"><span aria-hidden="true">›</span></button>
                    <span class="guest-gallery-count" data-gallery-count aria-live="polite">1 / @Model.AnhPhongs.Count</span>
                }
            }
            else
            {
                <div class="guest-gallery-empty"><span aria-hidden="true">⌂</span><p>Ảnh phòng đang được cập nhật</p></div>
            }
        </div>
        @if (Model.AnhPhongs.Count > 1)
        {
            <div class="guest-gallery-thumbs" role="group" aria-label="Chọn ảnh phòng">
                @for (var index = 0; index < Model.AnhPhongs.Count; index++)
                {
                    var image = Model.AnhPhongs[index];
                    var description = image.ChuThich ?? $"Ảnh {index + 1} phòng {Model.SoPhong}";
                    <button type="button" class="guest-gallery-thumb" data-gallery-thumb data-gallery-src="@image.Url" data-gallery-alt="@description" aria-label="Xem ảnh @(index + 1) trên @Model.AnhPhongs.Count" aria-pressed="@(index == 0 ? "true" : "false")">
                        <img src="@image.Url" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>

    <div class="guest-detail-grid">
        <div class="guest-detail-content">
            <h2>Thông tin phòng</h2>
            <div class="guest-detail-facts">
                <div><span>Diện tích</span><strong>@Model.DienTich.ToString("0.#") m²</strong></div>
                <div><span>Số người tối đa</span><strong>@Model.SoNguoiToiDa người</strong></div>
                <div><span>Chi nhánh</span><strong>@Model.TenChiNhanh</strong></div>
            </div>
            <h2>Mô tả</h2>
            <p class="guest-detail-description">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Người quản lý đang cập nhật mô tả phòng." : Model.MoTa)</p>
        </div>
        <aside class="guest-detail-aside" aria-label="Giá thuê và các bước tiếp theo">
            <p class="guest-detail-price"><strong>@Model.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</strong><span>/ tháng</span></p>
            <p>Phòng đang nhận yêu cầu mới. Chọn cách tiếp tục phù hợp với bạn.</p>
            <a class="guest-button guest-button-primary" asp-area="KhachVangLai" asp-controller="LichXem" asp-action="Tao" asp-route-maCongKhai="@Model.MaCongKhai">Hẹn xem phòng <span aria-hidden="true">↗</span></a>
            <a class="guest-button guest-button-outline" asp-area="KhachVangLai" asp-controller="GiuCho" asp-action="Tao" asp-route-maCongKhai="@Model.MaCongKhai">Đặt phòng và đặt cọc</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="guest-button guest-button-outline" href="tel:@Model.SoDienThoaiLienHe">Liên hệ: @Model.SoDienThoaiLienHe</a>
            }
            else
            {
                <a class="guest-button guest-button-outline" asp-area="QuanLyNhaTro" asp-controller="NguoiDung" asp-action="DangNhap" asp-route-returnUrl="@($"/phong/{Uri.EscapeDataString(Model.MaCongKhai)}")">Đăng nhập để liên hệ</a>
            }
            <span class="guest-detail-note">Hẹn xem và đặt cọc cần đăng nhập. Tiền cọc bằng 50% giá thuê tháng; bạn chuyển khoản sau khi nhân viên duyệt yêu cầu giữ chỗ.</span>
        </aside>
    </div>
</div>
@section Scripts {
    <script src="~/js/khach-vang-lai-gallery.js" asp-append-version="true" defer></script>
}
