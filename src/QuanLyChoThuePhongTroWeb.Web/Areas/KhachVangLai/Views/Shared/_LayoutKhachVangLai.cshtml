<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183b53" />
    <title>@ViewData["Title"] · Phòng trọ</title>
    <link rel="stylesheet" href="~/Theme/tabler/dist/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/khach-vang-lai.css" asp-append-version="true" />
</head>
<body class="guest-site">
    <a class="guest-skip-link" href="#main-content">Đi đến nội dung</a>
    <header class="guest-header">
        <div class="guest-container guest-header-inner">
            <a class="guest-brand" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index" aria-label="Trang danh sách phòng">
                <span class="guest-brand-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>Phòng trọ<span class="guest-brand-dot">.</span></span>
            </a>
            <nav class="guest-nav" aria-label="Điều hướng chính">
                <a asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Tìm phòng</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="guest-signed-in" title="Tài khoản đang đăng nhập">Đang đăng nhập: <strong>@User.Identity.Name</strong></span>
                }
                @if (User.IsInRole("KhachVangLai") || User.IsInRole("KhachThue"))
                {
                    <a asp-area="KhachVangLai" asp-controller="LichXem" asp-action="Index">Lịch xem</a>
                    <a asp-area="KhachVangLai" asp-controller="GiuCho" asp-action="Index">Yêu cầu của tôi</a>
                    @if (User.IsInRole("KhachVangLai")) { <a asp-area="KhachVangLai" asp-controller="TaiKhoan" asp-action="HoSo">Hồ sơ</a> }
                    else { <a asp-area="KhachThue" asp-controller="Dashboard" asp-action="Index">Cổng khách thuê</a> }
                    <form method="post" asp-area="QuanLyNhaTro" asp-controller="NguoiDung" asp-action="DangXuat">@Html.AntiForgeryToken()<button class="guest-nav-button" type="submit">Đăng xuất</button></form>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-area="QuanLyNhaTro" asp-controller="NguoiDung" asp-action="DangXuat">@Html.AntiForgeryToken()<button class="guest-nav-button" type="submit">Đăng xuất</button></form>
                }
                else
                {
                    <a asp-area="QuanLyNhaTro" asp-controller="NguoiDung" asp-action="DangNhap">Đăng nhập</a>
                }
            </nav>
        </div>
    </header>
    <main id="main-content">
        @RenderBody()
    </main>
    <footer class="guest-footer">
        <div class="guest-container guest-footer-inner">
            <span>Phòng trọ<span class="guest-brand-dot">.</span></span>
            <span>Thông tin phòng được cập nhật bởi người quản lý.</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
