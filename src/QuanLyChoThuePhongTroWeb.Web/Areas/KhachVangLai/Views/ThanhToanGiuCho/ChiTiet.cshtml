@model QuanLyChoThuePhongTroWeb.Application.Features.GiuChos.DTOs.HoldPaymentDto
@{ ViewData["Title"] = "Chuyển tiền giữ chỗ"; }
<div class="guest-container guest-form-page guest-payment-page">
    <a class="guest-back" asp-area="KhachVangLai" asp-controller="GiuCho" asp-action="Index">← Yêu cầu giữ chỗ</a>
    <p class="guest-kicker">Thanh toán giữ chỗ · @Model.MaYeuCau</p>
    <h1>Phòng @Model.TenPhong</h1>
    @if (TempData["PaymentSuccess"] is string success) { <p class="guest-success" role="status">@success</p> }
    @if (TempData["PaymentError"] is string error) { <p class="guest-validation" role="alert">@error</p> }
    <div class="guest-form-grid">
        <div class="guest-payment-summary">
            <span>Số tiền giữ chỗ</span>
            <strong>@Model.SoTien.ToString("N0") ₫</strong>
            <p>Hạn chuyển: @Model.HanThanhToanUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>
            <p>Trạng thái: @GuestStatusText.Of(Model.TrangThai)</p>
            @if (ViewBag.BankConfigured == true)
            {
                <div class="guest-bank-details">
                    <p>Ngân hàng <strong>@ViewBag.BankId</strong></p>
                    <p>Số tài khoản <strong>@ViewBag.AccountNumber</strong></p>
                    <p>Người nhận <strong>@ViewBag.AccountName</strong></p>
                    <p>Nội dung <strong>@Model.NoiDungChuyenKhoan</strong></p>
                </div>
                <img class="guest-payment-qr" src="@ViewBag.QrImage" alt="Mã QR chuyển khoản giữ chỗ" />
            }
            else
            {
                <p class="guest-validation">Chưa cấu hình tài khoản nhận tiền. Vui lòng liên hệ nhân viên trước khi chuyển khoản.</p>
            }
            @if (Model.MinhChungId is int proofId)
            {
                <p>Minh chứng: @GuestStatusText.Of(Model.TrangThaiMinhChung)</p>
                <a asp-area="KhachVangLai" asp-controller="MinhChungGiuCho" asp-action="Anh" asp-route-id="@proofId" target="_blank" rel="noopener noreferrer">Xem ảnh đã gửi</a>
            }
        </div>
        @if (Model.TrangThai == "ChoThanhToan" && Model.MinhChungId is null && ViewBag.BankConfigured == true)
        {
            <form class="guest-viewing-form" method="post" enctype="multipart/form-data" asp-area="KhachVangLai" asp-controller="ThanhToanGiuCho" asp-action="GuiMinhChung" asp-route-reservationId="@Model.ReservationId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@Model.Id" />
                <h2>Gửi minh chứng chuyển khoản</h2>
                <label for="proof-amount">Số tiền đã chuyển (₫)</label><input id="proof-amount" name="soTienKhaiBao" type="number" min="1" step="1" required />
                <label for="proof-time">Thời điểm chuyển</label><input id="proof-time" name="ngayChuyenTien" type="datetime-local" required />
                <label for="proof-reference">Mã giao dịch ngân hàng (nếu có)</label><input id="proof-reference" name="maGiaoDichNganHang" maxlength="100" />
                <label for="proof-image">Ảnh biên lai (PNG, JPEG, WebP; tối đa 5 MB)</label><input id="proof-image" name="image" type="file" accept="image/png,image/jpeg,image/webp" required />
                <label for="proof-note">Ghi chú</label><textarea id="proof-note" name="ghiChu" maxlength="500" rows="3"></textarea>
                <button class="guest-button guest-button-primary" type="submit">Gửi để đối chiếu</button>
                <p class="guest-form-footnote">Ảnh chỉ là minh chứng. Nhân viên xác nhận theo tiền thực nhận trên ngân hàng.</p>
            </form>
        }
    </div>
</div>
