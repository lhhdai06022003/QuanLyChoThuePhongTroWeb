@model IReadOnlyList<QuanLyChoThuePhongTroWeb.Application.Features.GiuChos.DTOs.ReservationDto>
@{ ViewData["Title"] = "Yêu cầu giữ chỗ của tôi"; }
<div class="guest-container guest-form-page guest-reservation-page">
    <p class="guest-kicker">Tài khoản của bạn</p>
    <h1>Yêu cầu giữ chỗ.</h1>
    <a class="guest-section-link" asp-area="KhachVangLai" asp-controller="HoanTien" asp-action="Index">Theo dõi hoàn tiền ↗</a>
    <p>Theo dõi trạng thái, số tiền giữ chỗ và các thời hạn do nhân viên xác nhận.</p>
    @if (Model.Count == 0) { <div class="guest-empty"><h2>Chưa có yêu cầu giữ chỗ</h2><a class="guest-button guest-button-primary" asp-area="KhachVangLai" asp-controller="Phong" asp-action="Index">Tìm phòng</a></div> }
    else
    {
        <div class="guest-reservation-list">
        @foreach (var item in Model)
        {
            <article class="guest-reservation-card">
                <div><span class="guest-kicker">Yêu cầu #@item.Id</span><h2><a asp-action="ChiTiet" asp-route-id="@item.Id">Phòng @item.TenPhong</a></h2><p>@item.TenChiNhanh</p></div>
                <div><span class="guest-status">@GuestStatusText.Of(item.TrangThai)</span>
                    @if (item.SoTienGiuCho is decimal amount) { <p><strong>@amount.ToString("N0") ₫</strong> tiền giữ chỗ</p> }
                    @if (item.HanThanhToanUtc is DateTime due) { <p>Hạn chuyển: @due.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p> }
                    @if (item.HanKyHopDongUtc is DateTime signDue) { <p>Hạn ký: @signDue.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p> }
                    @if (item.MaYeuCau is not null) { <p>Mã yêu cầu: @item.MaYeuCau</p> }
                    @if (item.TrangThai is "ChoThanhToan" or "ChoXacNhanTien" or "DangGiuCho") { <a asp-area="KhachVangLai" asp-controller="ThanhToanGiuCho" asp-action="ChiTiet" asp-route-reservationId="@item.Id">Xem thanh toán ↗</a> }
                </div>
            </article>
        }
        </div>
    }
</div>
