@model QuanLyChoThuePhongTroWeb.Application.Features.GiuChos.DTOs.ReservationProgressDto
@{ ViewData["Title"] = "Chi tiết giữ chỗ"; }
<div class="guest-container guest-form-page">
    <a asp-action="Index">Các yêu cầu giữ chỗ</a>
    <h1>Phòng @Model.TenPhong</h1><p>@Model.TenChiNhanh</p>
    <span class="guest-status">@GuestStatusText.Of(Model.TrangThai)</span>
    <div class="guest-reservation-card mt-4">
        <section><h2>Tiền và thời hạn</h2>
            @if (Model.SoTienGiuCho is decimal amount) { <p>Tiền giữ chỗ: <strong>@amount.ToString("N0") ₫</strong></p> }
            <p>Tiền đã được đối chiếu: @Model.TienThucNhan.ToString("N0") ₫</p>
            @if (Model.HanThanhToanUtc is DateTime due) { <p>Hạn chuyển: @due.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p> }
            @if (Model.HanKyHopDongUtc is DateTime signing) { <p>Hạn ký hợp đồng: @signing.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p> }
            @if (!string.IsNullOrWhiteSpace(Model.LyDo)) { <p>Lý do xử lý: @Model.LyDo</p> }
            @if (Model.TrangThai == "ChoThanhToan")
            { <p>Chuyển đúng số tiền trong một giao dịch và gửi ảnh minh chứng. Sau hạn thêm 5 phút mà chưa gửi minh chứng, phòng sẽ được mở lại.</p> }
            @if (Model.TrangThai == "ChoXacNhanTien")
            { <p>Nhân viên đang đối chiếu ngân hàng. Phòng tiếp tục được giữ đến khi có kết quả.</p> }
            @if (Model.TrangThai == "HetHan")
            { <p>Yêu cầu này không còn giữ phòng. Hãy tìm phòng còn trống và gửi yêu cầu mới.</p> }
            @if (Model.TrangThai is "ChoThanhToan" or "ChoXacNhanTien" or "DangGiuCho")
            { <a class="guest-button guest-button-primary" asp-controller="ThanhToanGiuCho" asp-action="ChiTiet" asp-route-reservationId="@Model.Id">Xem thông tin thanh toán</a> }
            <p class="mt-3"><a asp-controller="HoanTien" asp-action="Index">Theo dõi hoàn tiền</a></p>
        </section>
        @if (Model.HopDongId is int contractId)
        {
            <section><h2>Hợp đồng và cấn trừ</h2><p>Hợp đồng #@contractId đã được lập.</p>
                <p>Đã chuyển thành cọc: <strong>@Model.DaApDungCoc.ToString("N0") ₫</strong></p>
                <p>Đã cấn trừ hóa đơn: @Model.DaCanTruHoaDon.ToString("N0") ₫<br />Còn chờ cấn trừ: @Model.ConCanTru.ToString("N0") ₫</p>
                <p>Cọc được trừ từ hóa đơn tháng bắt đầu hợp đồng; phần dư chuyển sang tháng sau.</p>
                <a asp-area="KhachThue" asp-controller="Dashboard" asp-action="Index">Mở cổng khách thuê</a>
            </section>
        }
    </div>
    <section class="mt-5"><h2>Lịch sử xử lý</h2><ol class="guest-timeline">
        @foreach (var entry in Model.LichSu)
        { <li><time>@entry.ThoiDiemUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time><strong>@GuestStatusText.Of(entry.TrangThai)</strong>@if (!string.IsNullOrWhiteSpace(entry.LyDo)) { <p>@entry.LyDo</p> }</li> }
    </ol></section>
</div>
