{
  // ---------------------------------------------------------
  // HƯỚNG DẪN CÀI ĐẶT CẤU HÌNH HỆ THỐNG (appsettings.json)
  // ---------------------------------------------------------
  // 1. Đổi tên file này thành `appsettings.json` hoặc copy nội 
  //    dung sang file `appsettings.json` hiện có.
  // 2. Thay thế các giá trị nằm trong thẻ <...> bằng thông tin thật.
  // 3. (Lưu ý) File `appsettings.json` chứa thông tin nhạy cảm (mật khẩu)
  //    nên sẽ không được đẩy lên Git.

  "ConnectionStrings": {
    // Chuỗi kết nối đến cơ sở dữ liệu PostgreSQL.
    // Thay đổi thông tin Host, Port, Database, Username và Password tương ứng với máy chủ của bạn.
    "DefaultConnection": "Host=<YOUR_HOST_IP_OR_LOCALHOST>;Port=5432;Database=<YOUR_DATABASE_NAME>;Username=<YOUR_POSTGRES_USERNAME>;Password=<YOUR_POSTGRES_PASSWORD>"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "AllowedHosts": "*",

  "VietQRSettings": {
    // Thông tin tài khoản ngân hàng để tự động tạo mã QR thanh toán trên hóa đơn.
    // BankId: Tên viết tắt hoặc mã định danh của ngân hàng (VD: MB, VCB, TCB, BIDV).
    // BankId cũng được dùng nguyên giá trị trong tham số "ba" ({SoTaiKhoan}@{BankId}) của link mở app ngân hàng
    // trên panel thanh toán của khách thuê, nên phải là mã VietQR của ngân hàng (VD: MB, VCB).
    "BankId": "<YOUR_BANK_ID_EXAMPLE_MB>",
    // Số tài khoản người nhận tiền.
    "AccountNumber": "<YOUR_BANK_ACCOUNT_NUMBER>",
    // Tên chủ tài khoản (Nên viết hoa, không dấu để tránh lỗi font khi tạo QR).
    "AccountName": "<YOUR_ACCOUNT_NAME_WITHOUT_ACCENTS>",
    // Tên ngân hàng hiển thị trên panel thanh toán của khách thuê (VD: MBBank). Để trống thì hiển thị BankId.
    "BankName": "<TEN_NGAN_HANG_HIEN_THI_VD_MBBank>"
  },

  "EmailSettings": {
    // Cấu hình máy chủ gửi Email tự động (Mặc định sử dụng SMTP của Gmail).
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Hệ thống Quản lý Nhà Trọ",
    "SenderEmail": "<YOUR_GMAIL_ADDRESS@gmail.com>",
    // Mật khẩu ứng dụng (App Password) của Gmail.
    // Khuyến nghị: Bật 2FA trên tài khoản Google và tạo App Password, KHÔNG dùng mật khẩu đăng nhập email gốc.
    "Password": "<YOUR_GMAIL_APP_PASSWORD>"
  },
  "BackgroundJobs": {
    // Cấu hình chạy các tác vụ nền định kỳ (ContractAutoCloseJob, ContractExpiryAlertJob, InvoiceReminderJob).
    // Mặc định: true. Test host đặt false để cô lập hoàn toàn môi trường test.
    "Enabled": true
  },

  "AutoReminderSettings": {
    // Cấu hình tự động nhắc nhở khách hàng khi quá hạn thanh toán.
    // Enabled: Bật (true) hoặc Tắt (false) tính năng tự động gửi nhắc nhở.
    "Enabled": false,
    // Số ngày quá hạn được cho phép trước khi hệ thống bắt đầu gửi nhắc nhở.
    "OverdueDays": 5
  },

  "ContractAlertSettings": {
    // Cấu hình cảnh báo hợp đồng sắp hết hạn để thông báo cho Admin.
    // Enabled: Bật (true) hoặc Tắt (false) tính năng cảnh báo hợp đồng.
    "Enabled": false,
    // Địa chỉ Email của Admin để nhận thông báo cảnh báo.
    "AdminEmail": "<ADMIN_EMAIL_ADDRESS@gmail.com>",
    // Danh sách các mốc thời gian (số ngày) trước khi hết hạn hợp đồng để gửi cảnh báo.
    "AlertDays": [
      30,
      15
    ]
  },
  "DashboardSettings": {
    "ChotDienNuocDay": 25
  },
  // thông tin cấu hình Cloudinary để lưu trữ hình ảnh (ví dụ: ảnh phòng trọ, hóa đơn, ...)
  "Cloudinary": {
    "CloudName": "CloudName",// Tên Cloud Name của tài khoản Cloudinary
    "ApiKey": "ApiKey",// API Key của Cloudinary
    "ApiSecret": "ApiSecret"// API Secret của Cloudinary
  },
  "Gemini": {
    // API Key của Gemini từ Google AI Studio (https://aistudio.google.com/)
    "ApiKey": "<YOUR_GEMINI_API_KEY>",
    // Tên Model sử dụng (Ví dụ: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
    "Model": "gemini-2.5-flash"
  },
  "MeterImageOptions": {
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "DownloadTimeoutSeconds": 15,
    "StaleProcessingMinutes": 10
  },
  "InvoiceIssuanceOptions": {
    // Số ngày hạn thanh toán kể từ ngày công bố hóa đơn (tính theo giờ Việt Nam).
    // Hạn = 23:59:59 giờ VN của ngày (ngày công bố + N). Phải lớn hơn 0, mặc định 7.
    "SoNgayHanThanhToan": 7
  },
  "AutoInvoiceOptions": {
    // Hóa đơn tự động: ngưỡng độ tin cậy OCR (0 < x <= 1).
    // Kiểm tra chỉ số bất thường: lấy trung vị M tiêu thụ tối đa SoKyLichSuToiDa kỳ trọn tháng của hợp đồng (>= 1).
    // Đủ SoKyToiThieu kỳ (1 <= x <= SoKyLichSuToiDa): tăng bất thường khi tiêu thụ > M × HeSoTang (> 1) và vượt M quá SanTang*;
    // thấp bất thường khi M > NguongXetThap* và tiêu thụ < M × HeSoThap (0 < x < 1).
    // Chưa đủ kỳ: so với trần Tran* (cả tháng), co theo số ngày hợp đồng phủ trong tháng.
    "NguongDoTinCay": 0.90,
    "SoKyLichSuToiDa": 6,
    "SoKyToiThieu": 2,
    "HeSoTang": 2,
    "SanTangDienKwh": 50,
    "SanTangNuocM3": 5,
    "HeSoThap": 0.3,
    "NguongXetThapDienKwh": 20,
    "NguongXetThapNuocM3": 2,
    "TranDienKwh": 500,
    "TranNuocM3": 30
  },
  "InvoicePayment": {
    // Hạn của một lượt thanh toán (giờ), tính từ lúc tạo hoặc lúc minh chứng bị từ chối.
    "YeuCauHetHanSauGio": 24,
    // Dung lượng tối đa ảnh minh chứng chuyển khoản (byte).
    "MinhChungToiDaBytes": 5242880,
    // Ngày chuyển hoặc ngày giao dịch không được sau giờ server quá số phút này.
    "DungSaiNgayTuongLaiPhut": 5
  },
  "SePay": {
    // Webhook SePay báo tiền vào tài khoản: POST /api/webhooks/payment/sepay. Tắt (false) thì endpoint trả 404.
    "Enabled": false,
    // Hmac (khuyến nghị): SePay ký "{timestamp}.{body}" bằng WebhookSecret. ApiKey: header "Authorization: Apikey {WebhookApiKey}", chỉ dùng khi thử nhanh.
    "WebhookAuthMode": "Hmac",
    "WebhookSecret": "<SEPAY_WEBHOOK_SECRET>",
    "WebhookApiKey": "",
    // Webhook có timestamp lệch giờ server quá số giây này thì bị từ chối (30 đến 900).
    "TimestampToleranceSeconds": 300,
    // Live: https://userapi.sepay.vn/v2 · Test mode: host userapi-sandbox.sepay.vn (kiểm đường dẫn /v2 khi cài).
    "ApiBaseUrl": "https://userapi.sepay.vn/v2",
    // API token SePay cho màn Giao dịch SePay (đồng bộ bù, chỉ Admin). Trống = khóa nút Đồng bộ.
    "ApiToken": "",
    // false = màn Giao dịch SePay chỉ đối chiếu, không ghi sổ. Bật sau khi kiểm referenceCode (webhook) trùng reference_number (API).
    "SyncRecordEnabled": false
  },
  "OnlinePayment": {
    // URL công khai của web cho link trong email (ví dụ https://<ten-mien-ngrok>). Trống = không chèn link.
    "PublicBaseUrl": ""
  },
  "Telegram": {
    // Gửi tin thu tiền và cảnh báo chuyển khoản cần xử lý tay. Tắt (false) thì bỏ qua.
    "Enabled": false,
    "BotToken": "<TELEGRAM_BOT_TOKEN>",
    "DefaultChatId": "<CHAT_ID_NHOM_CHU_TRO>",
    // ChiNhanhId -> ChatId, tùy chọn (ví dụ "1": "-1001234567890").
    "BranchChatIds": { }
  }
}