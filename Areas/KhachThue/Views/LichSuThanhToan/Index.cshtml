@{
    ViewBag.Title = "Lịch sử thanh toán";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title d-flex align-items-center"><i class="fas fa-history me-2 text-primary"></i> Lịch sử thanh toán</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover w-100" id="lichSuTable">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%">STT</th>
                                <th>Mã Giao Dịch</th>
                                <th>Mã Hóa Đơn</th>
                                <th>Phòng</th>
                                <th class="text-right">Số Tiền (VNĐ)</th>
                                <th class="text-center">Phương Thức</th>
                                <th>Ngày Thanh Toán</th>
                                <th>Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#lichSuTable').DataTable({
                "ajax": {
                    "url": "/KhachThue/LichSuThanhToan/GetDanhSach",
                    "dataSrc": ""
                },
                "columns": [
                    { 
                        "data": null,
                        "className": "text-center",
                        "render": function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    { "data": "maGiaoDich", "className": "font-weight-bold" },
                    { 
                        "data": "maHoaDon",
                        "render": function (data) {
                            return '<span class="text-primary font-weight-bold">' + data + '</span>';
                        }
                    },
                    { 
                        "data": "soPhong",
                        "render": function (data) {
                            return 'Phòng ' + data;
                        }
                    },
                    { 
                        "data": "soTienThanhToan",
                        "className": "text-right text-danger font-weight-bold",
                        "render": function (data) {
                            return formatVND(data);
                        }
                    },
                    { 
                        "data": "phuongThucThanhToan",
                        "className": "text-center",
                        "render": function (data) {
                            if (data === 0) {
                                return '<span class="badge bg-secondary-lt"><i class="fas fa-money-bill-wave me-1"></i> Tiền mặt</span>';
                            } else if (data === 1) {
                                return '<span class="badge bg-primary-lt"><i class="fas fa-university me-1"></i> Chuyển khoản</span>';
                            }
                            return '';
                        }
                    },
                    { "data": "ngayThanhToan" },
                    { 
                        "data": "ghiChu",
                        "className": "text-muted text-wrap",
                        "render": function (data) {
                            return data || '-';
                        }
                    }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json"
                },
                "pageLength": 10,
                "ordering": true,
                "info": true,
                "autoWidth": false
            });
        });

        function formatVND(n) {
            if (n === null || n === undefined) return "0 ₫";
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
        }
    </script>
}
