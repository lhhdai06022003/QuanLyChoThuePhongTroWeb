<div class="card card-outline card-info mb-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-list"></i> Danh sách thành viên trong phòng</h3>
        <button type="button" class="btn btn-sm btn-success ml-auto" id="btnOpenAddMemberModal">
            <i class="fas fa-user-plus"></i> Thêm thành viên
        </button>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover" id="thanhVienTable">
            <thead class="bg-light">
                <tr>
                    <th width="5%" class="text-center">STT</th>
                    <th>Họ và Tên</th>
                    <th>Số ĐT</th>
                    <th>CCCD</th>
                    <th>Ngày Vào</th>
                    <th>Ngày Rời</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-center" width="15%">Thao tác</th>
                </tr>
            </thead>
            <tbody id="thanhVienTbody">
                <tr>
                    <td colspan="8" class="text-center text-muted">Vui lòng tải dữ liệu...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Thành Viên -->
<div class="modal fade" id="addMemberModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Thêm thành viên ở ghép</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formAddMember">
                    <!-- Input ẩn lưu NguoiThueId khi chọn từ danh sách autocomplete -->
                    <input type="hidden" id="addMember_NguoiThueId" value="" />

                    <div class="form-group">
                        <label>Tìm khách thuê có sẵn (Gõ Tên, SĐT hoặc CCCD)</label>
                        <div class="d-flex align-items-center">
                            <div style="flex-grow: 1; margin-right: 10px;">
                                <select class="form-control" id="addMember_SearchNguoiThue" style="width: 100%;">
                                    <option value="">-- Gõ để tìm kiếm --</option>
                                </select>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline-primary" id="btnToggleNewMember" title="Nhập mới hoàn toàn">
                                    <i class="fas fa-plus"></i> Nhập mới
                                </button>
                            </div>
                        </div>
                        <small class="form-text text-muted">Nhập từ khóa để tìm kiếm khách có sẵn, hoặc bấm "Nhập mới" để đăng ký thông tin mới.</small>
                    </div>
                    <hr />
                    <div id="newMemberFields">
                        <div class="form-group">
                            <label>Họ và Tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addMember_HoVaTen" placeholder="Nhập họ tên..." disabled>
                        </div>
                        <div class="form-group">
                            <label>Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addMember_SoDienThoai" placeholder="Nhập số ĐT..." disabled>
                        </div>
                        <div class="form-group">
                            <label>CCCD/CMND <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addMember_CCCD" placeholder="Nhập CCCD..." disabled>
                        </div>
                    </div>
                    <div class="form-group mt-2">
                        <label>Ngày bắt đầu ở <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addMember_NgayVao" placeholder="Chọn ngày...">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnSaveMember">
                    <i class="fas fa-save"></i> Lưu thành viên
                </button>
            </div>
        </div>
    </div>
</div>

