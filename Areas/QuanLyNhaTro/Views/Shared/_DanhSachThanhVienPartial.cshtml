<div class="card shadow-none border-0 mb-0 bg-transparent">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent p-0 mb-3 border-0">
        <h3 class="card-title font-weight-bold m-0">
            <i class="fas fa-list me-2 text-info"></i> Danh sách thành viên trong phòng
        </h3>
        <button type="button" class="btn btn-sm btn-success ms-auto shadow-sm" id="btnOpenAddMemberModal">
            <i class="fas fa-user-plus me-1"></i> Thêm thành viên
        </button>
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter table-striped table-hover w-100" id="thanhVienTable">
            <thead>
                <tr>
                    <th width="5%" class="text-center">STT</th>
                    <th>Họ và Tên</th>
                    <th>Số ĐT</th>
                    <th>CCCD</th>
                    <th>Ngày Vào</th>
                    <th>Ngày Rời</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-center" width="15%">Thao tác</th>
                </tr>
            </thead>
            <tbody id="thanhVienTbody">
                <tr>
                    <td colspan="8" class="text-center text-muted">Vui lòng tải dữ liệu...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Thành Viên -->
<div class="modal modal-blur fade" id="addMemberModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title font-weight-bold">Thêm thành viên ở ghép</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <form id="formAddMember">
                    <!-- Input ẩn lưu NguoiThueId khi chọn từ danh sách autocomplete -->
                    <input type="hidden" id="addMember_NguoiThueId" value="" />

                    <div class="mb-3">
                        <label class="form-label">Tìm khách thuê có sẵn (Gõ Tên, SĐT hoặc CCCD)</label>
                        <div class="row g-2">
                            <div class="col">
                                <select class="form-select" id="addMember_SearchNguoiThue" style="width:100%">
                                    <option value="">-- Gõ để tìm kiếm --</option>
                                </select>
                            </div>

                            <div class="col-auto">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        id="btnToggleNewMember"
                                        title="Nhập mới hoàn toàn">
                                    <i class="fas fa-plus me-1"></i> Nhập mới
                                </button>
                            </div>
                        </div>
                        <small class="form-text text-muted d-block mt-1">Nhập từ khóa để tìm kiếm khách có sẵn, hoặc bấm "Nhập mới" để đăng ký thông tin mới.</small>
                    </div>
                    <hr class="my-3 text-secondary opacity-25" />
                    <div id="newMemberFields">
                        <div class="mb-3">
                            <label class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addMember_HoVaTen" placeholder="Nhập họ tên..." disabled>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addMember_SoDienThoai" placeholder="Nhập số ĐT..." disabled>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">CCCD/CMND <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addMember_CCCD" placeholder="Nhập CCCD..." disabled>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày bắt đầu ở <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addMember_NgayVao" placeholder="Chọn ngày...">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary shadow-sm" id="btnSaveMember">
                    <i class="fas fa-save me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>


