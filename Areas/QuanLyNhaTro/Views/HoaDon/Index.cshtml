@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}

<section class="content">
    <div class="container-fluid">
        <!-- Card quản lý & danh sách hóa đơn -->
        <div class="card card-primary card-outline shadow">
            <div class="card-header d-flex align-items-center justify-content-between p-3">
                <h3 class="card-title m-0"><i class="fas fa-file-invoice-dollar text-primary mr-2"></i> Quản lý & Danh sách Hóa đơn</h3>
                <div class="card-tools ml-auto">
                    <button class="btn btn-success btn-sm font-weight-bold px-3 py-2 shadow-sm" id="btnPhatSinh">
                        <i class="fas fa-plus-circle mr-1"></i> Phát sinh Hóa đơn
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Khu vực Bộ lọc dạng hàng ngang -->
                <div class="bg-light p-3 border rounded mb-4 shadow-sm">
                    <div class="row align-items-end">
                        <div class="col-md-3 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-building mr-1"></i> Chi Nhánh</label>
                            <select id="filterChiNhanh" class="form-control form-control-sm">
                                <option value="0">-- Tất cả --</option>
                                @if (ViewBag.ListChiNhanh != null)
                                {
                                    foreach (var cn in ViewBag.ListChiNhanh)
                                    {
                                        <option value="@cn.Value">@cn.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-calendar-alt mr-1"></i> Tháng</label>
                            <select id="filterThang" class="form-control form-control-sm">
                                <option value="0">-- Tất cả --</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    if (i == DateTime.Now.Month)
                                    {
                                        <option value="@i" selected>Tháng @i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Tháng @i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-calendar-check mr-1"></i> Năm</label>
                            <input type="number" id="filterNam" class="form-control form-control-sm" value="@DateTime.Now.Year">
                        </div>
                        <div class="col-md-3 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-info-circle mr-1"></i> Trạng thái</label>
                            <select id="filterTrangThai" class="form-control form-control-sm">
                                <option value="-1">-- Tất cả --</option>
                                <option value="0">Chưa thanh toán</option>
                                <option value="1">Đã thanh toán</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-0">
                            <button class="btn btn-primary btn-sm w-100 font-weight-bold py-2" id="btnFilter">
                                <i class="fas fa-search mr-1"></i> Lọc danh sách
                            </button>
                        </div>
                    </div>
                </div>
                <table id="hoaDonTable" class="table table-bordered table-striped w-100">
                    <thead>
                        <tr>
                            <th class="text-center" width="4%">STT</th>
                            <th>Mã HĐ</th>
                            <th>Phòng</th>
                            <th>Người thuê</th>
                            <th class="text-center">Kỳ</th>
                            <th class="text-right">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center" width="22%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Modal Chi tiết Hóa đơn -->
<div class="modal fade" id="chiTietModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-file-alt"></i> Chi tiết Hóa đơn</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" id="chiTietBody">
                <!-- JS sẽ render nội dung ở đây -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thu tiền -->
<div class="modal fade" id="thuTienModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-hand-holding-usd"></i> Xác nhận Thu tiền</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="thuTienHoaDonId" />
                <p>Bạn đang thu tiền cho hóa đơn: <strong id="thuTienMaHD"></strong></p>
                <p>Tổng tiền: <strong class="text-danger" id="thuTienTongTien"></strong></p>
                <div class="form-group">
                    <label>Phương thức thanh toán</label>
                    <select id="thuTienPhuongThuc" class="form-control">
                        <option value="0">Tiền mặt</option>
                        <option value="1">Chuyển khoản</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Ghi chú</label>
                    <textarea id="thuTienGhiChu" class="form-control" rows="2" placeholder="VD: Đã nhận đủ tiền mặt..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnConfirmThuTien"><i class="fas fa-check"></i> Xác nhận Thu tiền</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem trước Phát sinh Hóa đơn -->
<div class="modal fade" id="previewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-eye"></i> Xem trước Phát sinh Hóa đơn</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 mb-3">
                    <i class="fas fa-info-circle"></i> Vui lòng chọn Chi nhánh, Kỳ tháng/năm cần phát sinh và bấm <strong>"Tải dữ liệu"</strong> để xem trước danh sách phòng.
                </div>
                <!-- Khung bộ chọn dữ liệu phát sinh -->
                <div class="card card-outline card-secondary p-3 mb-3 bg-light">
                    <div class="row">
                        <div class="col-md-5 form-group mb-md-0">
                            <label class="font-weight-bold"><i class="fas fa-building text-secondary"></i> Chi Nhánh <span class="text-danger">*</span></label>
                            <select id="previewChiNhanh" class="form-control form-control-sm">
                                @if (ViewBag.ListChiNhanh != null)
                                {
                                    foreach (var cn in ViewBag.ListChiNhanh)
                                    {
                                        <option value="@cn.Value">@cn.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 form-group mb-md-0">
                            <label class="font-weight-bold"><i class="fas fa-calendar-alt text-secondary"></i> Tháng <span class="text-danger">*</span></label>
                            <select id="previewThang" class="form-control form-control-sm">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    if (i == DateTime.Now.Month)
                                    {
                                        <option value="@i" selected>Tháng @i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Tháng @i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 form-group mb-md-0">
                            <label class="font-weight-bold"><i class="fas fa-calendar-check text-secondary"></i> Năm <span class="text-danger">*</span></label>
                            <input type="number" id="previewNam" class="form-control form-control-sm" value="@DateTime.Now.Year">
                        </div>
                        <div class="col-md-2 form-group mb-0 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-sm w-100 font-weight-bold" id="btnLoadPreview"><i class="fas fa-sync-alt"></i> Tải dữ liệu</button>
                        </div>
                    </div>
                </div>
                <!-- Tabs phân loại -->
                <ul class="nav nav-tabs mb-3" id="previewTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active font-weight-bold" id="ready-tab" data-toggle="tab" href="#ready-pane" role="tab"><i class="fas fa-check-circle text-success"></i> Sẵn sàng (<span id="ready-count">0</span>)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="missing-tab" data-toggle="tab" href="#missing-pane" role="tab"><i class="fas fa-exclamation-triangle text-warning"></i> Chưa chốt điện nước (<span id="missing-count">0</span>)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="invalid-tab" data-toggle="tab" href="#invalid-pane" role="tab"><i class="fas fa-times-circle text-danger"></i> Đã có HĐ / Không hợp lệ (<span id="invalid-count">0</span>)</a>
                    </li>
                </ul>
                <div class="tab-content" id="previewTabContent">
                    <!-- Ready Tab -->
                    <div class="tab-pane fade show active" id="ready-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="previewReadyTable">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="5%"><input type="checkbox" id="checkAllPreview" checked /></th>
                                        <th>Số phòng</th>
                                        <th>Người thuê</th>
                                        <th class="text-right">Tiền phòng dự kiến</th>
                                        <th class="text-center">Kỳ hạn ở</th>
                                        <th class="text-right">Tổng tiền dự kiến</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Missing Utilities Tab -->
                    <div class="tab-pane fade" id="missing-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="previewMissingTable">
                                <thead>
                                    <tr>
                                        <th>Số phòng</th>
                                        <th>Người thuê</th>
                                        <th>Trạng thái</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Invalid Tab -->
                    <div class="tab-pane fade" id="invalid-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="previewInvalidTable">
                                <thead>
                                    <tr>
                                        <th>Số phòng</th>
                                        <th>Người thuê</th>
                                        <th>Lý do bỏ qua</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnConfirmPhatSinh"><i class="fas fa-magic"></i> Phát sinh Hóa đơn (<span id="selected-preview-count">0</span> phòng)</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Hóa đơn -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-edit"></i> Chỉnh sửa Chi tiết Hóa đơn</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editHoaDonId" />
                <div class="row mb-3 font-weight-bold" style="font-size: 1.1rem;">
                    <div class="col-md-6" id="editMaHDText"></div>
                    <div class="col-md-6 text-right" id="editPhongText"></div>
                </div>
                <table class="table table-bordered table-sm" id="editLinesTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Tên khoản phí / Dịch vụ</th>
                            <th width="20%">Đơn giá (đ)</th>
                            <th width="15%">Số lượng</th>
                            <th width="10%">Đơn vị</th>
                            <th width="22%">Thành tiền</th>
                            <th width="8%" class="text-center">Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- JS sẽ render ở đây -->
                    </tbody>
                </table>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddEditRow"><i class="fas fa-plus"></i> Thêm dòng phí mới</button>
                <div class="text-right mt-3">
                    <h4>Tổng cộng: <span class="text-danger font-weight-bold" id="editTongTienText">0 ₫</span></h4>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning font-weight-bold" id="btnSaveEdit"><i class="fas fa-save"></i> Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var bankId = '@ViewBag.BankId';
            var accountNumber = '@ViewBag.AccountNumber';
            var accountName = '@ViewBag.AccountName';

            function formatVND(n) {
                if (n === null || n === undefined) return "0 ₫";
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
            }

            // ========== DataTable ==========
            var table = $('#hoaDonTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/HoaDon/GetList",
                    "type": "POST",
                    "data": function(d) {
                        d.chiNhanhId = $('#filterChiNhanh').val();
                        d.thang = $('#filterThang').val();
                        d.nam = $('#filterNam').val();
                        d.trangThai = $('#filterTrangThai').val();
                    }
                },
                "columns": [
                    { "data": null, "className": "text-center", "orderable": false, "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "maHoaDon" },
                    { "data": "tenPhong", "className": "font-weight-bold" },
                    { "data": "tenNguoiThue" },
                    { "data": null, "className": "text-center", "orderable": false, "render": (d) => `${d.thang}/${d.nam}` },
                    { "data": "tongTien", "className": "text-right font-weight-bold text-danger", "render": (d) => formatVND(d) },
                    {
                        "data": "trangThaiHoaDonValue", "className": "text-center", "orderable": false,
                        "render": function(d, t, r) {
                            if (d === 1) return '<span class="badge badge-success"><i class="fas fa-check-circle"></i> Đã thanh toán</span>';
                            return '<span class="badge badge-warning"><i class="fas fa-clock"></i> Chưa thanh toán</span>';
                        }
                    },
                    {
                        "data": "hoaDonId", "orderable": false, "className": "text-center",
                        "render": function(data, t, row) {
                            let html = `<button class="btn btn-info btn-sm btn-detail" data-id="${data}" title="Chi tiết"><i class="fas fa-eye"></i></button> `;
                            if (row.trangThaiHoaDonValue === 0) {
                                html += `<button class="btn btn-warning btn-sm btn-edit" data-id="${data}" title="Chỉnh sửa"><i class="fas fa-edit"></i></button> `;
                                html += `<button class="btn btn-success btn-sm btn-thutien" data-id="${data}" data-ma="${row.maHoaDon}" data-tien="${row.tongTien}" title="Thu tiền"><i class="fas fa-hand-holding-usd"></i></button> `;
                                html += `<button class="btn btn-danger btn-sm btn-delete" data-id="${data}" title="Xóa"><i class="fas fa-trash"></i></button> `;
                            }
                            html += `<a href="/HoaDon/ExportExcel/${data}" class="btn btn-outline-success btn-sm" title="Xuất Excel"><i class="fas fa-file-excel"></i></a> `;
                            html += `<a href="/HoaDon/ExportPdf/${data}" class="btn btn-outline-danger btn-sm" title="Xuất PDF"><i class="fas fa-file-pdf"></i></a>`;
                            return html;
                        }
                    }
                ]
            });

            // ========== Filter ==========
            $('#btnFilter').click(function() { table.ajax.reload(); });

            // ========== Xem trước & Phát sinh hóa đơn ==========
            var previewDataList = [];

            $('#btnPhatSinh').click(function() {
                let cn = $('#filterChiNhanh').val();
                let th = $('#filterThang').val();
                let na = $('#filterNam').val();

                // Đồng bộ từ bộ lọc sang bộ cấu hình phát sinh trong Modal nếu hợp lệ
                if (cn && cn !== '0') { $('#previewChiNhanh').val(cn); }
                if (th && th !== '0') { $('#previewThang').val(th); }
                if (na) { $('#previewNam').val(na); }

                // Xóa dữ liệu cũ trong modal
                $('#previewReadyTable tbody').empty();
                $('#previewMissingTable tbody').empty();
                $('#previewInvalidTable tbody').empty();
                $('#ready-count').text(0);
                $('#missing-count').text(0);
                $('#invalid-count').text(0);
                $('#selected-preview-count').text(0);
                $('#btnConfirmPhatSinh').prop('disabled', true);

                $('#previewModal').modal('show');
            });

            // Tải dữ liệu xem trước khi bấm nút trong Modal
            $('#btnLoadPreview').click(function() {
                let cn = $('#previewChiNhanh').val();
                let th = $('#previewThang').val();
                let na = $('#previewNam').val();

                if (!cn || cn === '0') { alert('Vui lòng chọn Chi nhánh cụ thể!'); return; }
                if (!th || th === '0') { alert('Vui lòng chọn Tháng cụ thể!'); return; }
                if (!na || na < 2000) { alert('Vui lòng nhập Năm hợp lệ!'); return; }

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang tải...');

                $.ajax({
                    url: `/HoaDon/PreviewPhatSinh?chiNhanhId=${cn}&thang=${th}&nam=${na}`,
                    type: 'GET',
                    success: function(res) {
                        previewDataList = res;
                        renderPreviewModal();
                    },
                    error: function(xhr) { alert(xhr.responseJSON?.message || 'Có lỗi khi chuẩn bị xem trước.'); },
                    complete: function() { $btn.prop('disabled', false).html('<i class="fas fa-sync-alt"></i> Tải dữ liệu'); }
                });
            });

            function renderPreviewModal() {
                let readyBody = $('#previewReadyTable tbody').empty();
                let missingBody = $('#previewMissingTable tbody').empty();
                let invalidBody = $('#previewInvalidTable tbody').empty();

                let readyCount = 0;
                let missingCount = 0;
                let invalidCount = 0;

                previewDataList.forEach(item => {
                    if (item.daCoHoaDon || (!item.hopDongHopLe && item.tenNguoiThue === '')) {
                        let reason = item.daCoHoaDon ? '<span class="badge badge-secondary">Đã có hóa đơn</span>' : `<span class="text-danger">${item.ghiChuTrangThai}</span>`;
                        invalidBody.append(`
                            <tr>
                                <td class="font-weight-bold">${item.soPhong}</td>
                                <td>${item.tenNguoiThue}</td>
                                <td>${reason}</td>
                            </tr>
                        `);
                        invalidCount++;
                    } else if (!item.daChotDienNuoc) {
                        missingBody.append(`
                            <tr>
                                <td class="font-weight-bold">${item.soPhong}</td>
                                <td>${item.tenNguoiThue}</td>
                                <td><span class="badge badge-warning"><i class="fas fa-exclamation-triangle"></i> Chưa chốt điện nước</span></td>
                                <td class="text-center">
                                    <a href="/QuanLyNhaTro/ChotDienNuoc" class="btn btn-xs btn-outline-warning" target="_blank"><i class="fas fa-edit"></i> Chốt nhanh điện nước</a>
                                </td>
                            </tr>
                        `);
                        missingCount++;
                    } else {
                        readyBody.append(`
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" class="preview-select" data-id="${item.phongTroId}" checked />
                                </td>
                                <td class="font-weight-bold">${item.soPhong}</td>
                                <td>${item.tenNguoiThue}</td>
                                <td class="text-right">${formatVND(item.tienPhongDuKien)}</td>
                                <td class="text-center">${item.soNgayO}/${item.tongSoNgayTrongThang} ngày</td>
                                <td class="text-right text-primary font-weight-bold">${formatVND(item.tongTienDuKien)}</td>
                                <td><span class="badge badge-success">${item.ghiChuTrangThai}</span></td>
                            </tr>
                        `);
                        readyCount++;
                    }
                });

                $('#ready-count').text(readyCount);
                $('#missing-count').text(missingCount);
                $('#invalid-count').text(invalidCount);

                updateSelectedPreviewCount();

                // Select tab
                if (readyCount > 0) {
                    $('#ready-tab').tab('show');
                } else if (missingCount > 0) {
                    $('#missing-tab').tab('show');
                } else {
                    $('#invalid-tab').tab('show');
                }
            }

            $('#checkAllPreview').change(function() {
                $('.preview-select').prop('checked', this.checked);
                updateSelectedPreviewCount();
            });

            $('#previewReadyTable').on('change', '.preview-select', function() {
                updateSelectedPreviewCount();
            });

            function updateSelectedPreviewCount() {
                let cnt = $('.preview-select:checked').length;
                $('#selected-preview-count').text(cnt);
                $('#btnConfirmPhatSinh').prop('disabled', cnt === 0);
            }

            $('#btnConfirmPhatSinh').click(function() {
                let selectedIds = [];
                $('.preview-select:checked').each(function() {
                    selectedIds.push(parseInt($(this).data('id')));
                });

                if (selectedIds.length === 0) return;

                let cn = $('#previewChiNhanh').val();
                let th = $('#previewThang').val();
                let na = $('#previewNam').val();

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                $.ajax({
                    url: '/HoaDon/PhatSinh',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        chiNhanhId: parseInt(cn),
                        thang: parseInt(th),
                        nam: parseInt(na),
                        selectedPhongTroIds: selectedIds
                    }),
                    success: function(res) {
                        alert(res.message);
                        $('#previewModal').modal('hide');
                        table.ajax.reload();
                    },
                    error: function(xhr) { alert(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); },
                    complete: function() { $btn.prop('disabled', false).html('<i class="fas fa-magic"></i> Phát sinh HĐ'); }
                });
            });

            // ========== Xem chi tiết ==========
            $('#hoaDonTable').on('click', '.btn-detail', function() {
                let id = $(this).data('id');
                $.get(`/HoaDon/GetById/${id}`, function(res) {
                    let html = `
                        <div class="row mb-3">
                            <div class="col-md-6 mb-2"><strong>Mã HĐ:</strong> ${res.maHoaDon}</div>
                            <div class="col-md-6 mb-2"><strong>Ngày tạo:</strong> ${res.ngayTao}</div>
                            <div class="col-md-6 mb-2"><strong>Phòng:</strong> ${res.tenPhong}</div>
                            <div class="col-md-6 mb-2"><strong>Kỳ:</strong> Tháng ${res.thang}/${res.nam}</div>
                            <div class="col-md-6 mb-2"><strong>Người thuê:</strong> ${res.tenNguoiThue}</div>
                            <div class="col-md-6 mb-2"><strong>Trạng thái:</strong> <span class="badge ${res.trangThaiHoaDon === 'Đã thanh toán' ? 'badge-success' : 'badge-warning'}">${res.trangThaiHoaDon}</span></div>
                        </div>
                        <h6 class="font-weight-bold"><i class="fas fa-list"></i> Chi tiết dịch vụ</h6>
                        <table class="table table-bordered table-sm mb-3">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center" width="6%">STT</th>
                                    <th>Dịch vụ</th>
                                    <th class="text-right" width="18%">Đơn giá</th>
                                    <th class="text-center" width="12%">SL</th>
                                    <th class="text-center" width="12%">Đơn vị</th>
                                    <th class="text-right" width="20%">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>`;

                    res.chiTietHoaDons.forEach((ct, idx) => {
                        let donViText = ct.donVi ? ct.donVi : '-';
                        html += `<tr>
                            <td class="text-center">${idx+1}</td>
                            <td>${ct.tenDichVu}</td>
                            <td class="text-right">${formatVND(ct.donGia)}</td>
                            <td class="text-center">${ct.soLuong}</td>
                            <td class="text-center">${donViText}</td>
                            <td class="text-right font-weight-bold">${formatVND(ct.tongTien)}</td>
                        </tr>`;
                    });

                    html += `</tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-right font-weight-bold">TỔNG CỘNG</td>
                                    <td class="text-right font-weight-bold text-danger" style="font-size: 1.1rem;">${formatVND(res.tongTien)}</td>
                                </tr>
                            </tfoot>
                        </table>`;

                    // Lịch sử thanh toán
                    if (res.lichSuThanhToans && res.lichSuThanhToans.length > 0) {
                        html += `<h6 class="font-weight-bold mt-3"><i class="fas fa-history"></i> Lịch sử thanh toán</h6>
                            <table class="table table-bordered table-sm">
                                <thead class="bg-light">
                                    <tr><th>Mã GD</th><th class="text-right">Số tiền</th><th>Phương thức</th><th>Ngày</th><th>Người xác nhận</th><th>Ghi chú</th></tr>
                                </thead><tbody>`;
                        res.lichSuThanhToans.forEach(ls => {
                            html += `<tr><td>${ls.maGiaoDich}</td><td class="text-right">${formatVND(ls.soTienThanhToan)}</td><td>${ls.phuongThucThanhToan}</td><td>${ls.ngayThanhToan}</td><td>${ls.nguoiXacNhan}</td><td>${ls.ghiChu || ''}</td></tr>`;
                        });
                        html += `</tbody></table>`;
                    }

                    // Nhúng mã QR thanh toán nếu chưa thanh toán
                    if (res.trangThaiHoaDon === 'Chưa thanh toán') {
                        html += `
                        <div class="row mt-4 pt-3 border-top justify-content-center">
                            <div class="col-md-6 text-center">
                                <div class="card card-outline card-primary p-3 shadow-sm bg-white">
                                    <h6 class="font-weight-bold text-primary mb-2"><i class="fas fa-qrcode mr-1"></i> Quét mã QR để thanh toán</h6>
                                    <div class="mb-2">
                                        <img src="/HoaDon/GetVietQR?hoaDonId=${res.hoaDonId}" class="img-fluid border rounded p-2 bg-white" style="max-width: 170px; height: auto;" alt="VietQR" />
                                    </div>
                                    <p class="small text-muted mb-2">Sử dụng ứng dụng ngân hàng quét mã QR để chuyển khoản nhanh</p>
                                    <div class="bg-light p-2 rounded text-left" style="font-size: 0.85rem; line-height: 1.5;">
                                        <div><strong>Ngân hàng:</strong> ${bankId}</div>
                                        <div><strong>Số tài khoản:</strong> ${accountNumber}</div>
                                        <div><strong>Chủ tài khoản:</strong> ${accountName}</div>
                                        <div><strong>Số tiền:</strong> <span class="text-danger font-weight-bold">${formatVND(res.tongTien)}</span></div>
                                        <div><strong>Nội dung CK:</strong> <code class="text-primary font-weight-bold">THANH TOAN ${res.maHoaDon}</code></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        `;
                    }

                    $('#chiTietBody').html(html);
                    $('#chiTietModal').modal('show');
                });
            });

            // ========== Chỉnh sửa hóa đơn ==========
            $('#hoaDonTable').on('click', '.btn-edit', function() {
                let id = $(this).data('id');
                $('#editHoaDonId').val(id);
                $.get(`/HoaDon/GetById/${id}`, function(res) {
                    $('#editMaHDText').html(`Mã HĐ: <span class="text-primary">${res.maHoaDon}</span>`);
                    $('#editPhongText').html(`Phòng: <span class="text-primary">${res.tenPhong}</span> (${res.tenNguoiThue})`);
                    
                    let tbody = $('#editLinesTable tbody').empty();
                    
                    res.chiTietHoaDons.forEach(ct => {
                        addEditRow(ct.tenDichVu, ct.donGia, ct.soLuong, ct.donVi || '', ct.chiTietHoaDonId, ct.dichVuId);
                    });
                    
                    recalculateEditTotal();
                    $('#editModal').modal('show');
                });
            });

            function addEditRow(ten = '', gia = 0, sl = 1, dv = '', ctId = 0, dvId = null) {
                let tbody = $('#editLinesTable tbody');
                let rowId = 'editRow_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
                let tr = $(`
                    <tr id="${rowId}">
                        <td>
                            <input type="text" class="form-control form-control-sm edit-ten" value="${ten}" placeholder="Nhập tên dịch vụ/khoản phí" required />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm text-right edit-gia" value="${gia}" min="0" required />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm text-center edit-sl" value="${sl}" min="0" required />
                        </td>
                        <td>
                            <span class="text-muted edit-dv-label" style="font-size: 0.9rem;">${dv}</span>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm text-right edit-thanhtien" value="${formatVND(gia * sl)}" disabled />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-link text-danger btn-delete-edit-row p-0"><i class="fas fa-trash-alt"></i></button>
                            <input type="hidden" class="edit-ct-id" value="${ctId}" />
                            <input type="hidden" class="edit-dv-id" value="${dvId || ''}" />
                        </td>
                    </tr>
                `);
                
                tr.find('.edit-gia, .edit-sl').on('input', function() {
                    let g = parseFloat(tr.find('.edit-gia').val()) || 0;
                    let s = parseFloat(tr.find('.edit-sl').val()) || 0;
                    tr.find('.edit-thanhtien').val(formatVND(g * s));
                    recalculateEditTotal();
                });
                
                tr.find('.btn-delete-edit-row').click(function() {
                    tr.remove();
                    recalculateEditTotal();
                });
                
                tbody.append(tr);
            }

            $('#btnAddEditRow').click(function() {
                addEditRow('Khoản phí khác', 0, 1, '');
            });

            function recalculateEditTotal() {
                let total = 0;
                $('#editLinesTable tbody tr').each(function() {
                    let g = parseFloat($(this).find('.edit-gia').val()) || 0;
                    let s = parseFloat($(this).find('.edit-sl').val()) || 0;
                    total += g * s;
                });
                $('#editTongTienText').text(formatVND(total));
            }

            $('#btnSaveEdit').click(function() {
                let id = $('#editHoaDonId').val();
                let req = { chiTiets: [] };
                let valid = true;

                $('#editLinesTable tbody tr').each(function() {
                    let ten = $(this).find('.edit-ten').val();
                    let gia = parseFloat($(this).find('.edit-gia').val());
                    let sl = parseFloat($(this).find('.edit-sl').val());
                    let dvIdVal = $(this).find('.edit-dv-id').val();
                    
                    if (!ten || ten.trim() === '') {
                        alert('Tên khoản phí không được để trống.');
                        valid = false;
                        return false;
                    }
                    if (isNaN(gia) || gia < 0 || isNaN(sl) || sl < 0) {
                        alert('Đơn giá và số lượng phải lớn hơn hoặc bằng 0.');
                        valid = false;
                        return false;
                    }

                    req.chiTiets.push({
                        chiTietHoaDonId: parseInt($(this).find('.edit-ct-id').val()) || 0,
                        tenDichVu: ten,
                        donGia: gia,
                        soLuong: parseInt(sl),
                        dichVuId: dvIdVal ? parseInt(dvIdVal) : null
                    });
                });

                if (!valid) return;
                if (req.chiTiets.length === 0) {
                    alert('Hóa đơn phải có ít nhất một dòng chi phí.');
                    return;
                }

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                $.ajax({
                    url: `/HoaDon/Update/${id}`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(req),
                    success: function(res) {
                        alert(res.message);
                        $('#editModal').modal('hide');
                        table.ajax.reload(null, false);
                    },
                    error: function(xhr) { alert(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); },
                    complete: function() { $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thay đổi'); }
                });
            });

            // ========== Thu tiền ==========
            $('#hoaDonTable').on('click', '.btn-thutien', function() {
                $('#thuTienHoaDonId').val($(this).data('id'));
                $('#thuTienMaHD').text($(this).data('ma'));
                $('#thuTienTongTien').text(formatVND($(this).data('tien')));
                $('#thuTienPhuongThuc').val(0);
                $('#thuTienGhiChu').val('');
                $('#thuTienModal').modal('show');
            });

            $('#btnConfirmThuTien').click(function() {
                let req = {
                    hoaDonId: parseInt($('#thuTienHoaDonId').val()),
                    phuongThucThanhToan: parseInt($('#thuTienPhuongThuc').val()),
                    ghiChu: $('#thuTienGhiChu').val()
                };

                let $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    url: '/HoaDon/ThuTien',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(req),
                    success: function(res) {
                        alert(res.message);
                        $('#thuTienModal').modal('hide');
                        table.ajax.reload(null, false);
                    },
                    error: function(xhr) { alert(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); },
                    complete: function() { $btn.prop('disabled', false); }
                });
            });

            // ========== Xóa hóa đơn ==========
            $('#hoaDonTable').on('click', '.btn-delete', function() {
                let id = $(this).data('id');
                if (!confirm('Xóa hóa đơn này?')) return;
                $.ajax({
                    url: `/HoaDon/Delete/${id}`,
                    type: 'DELETE',
                    success: function(res) { alert(res.message); table.ajax.reload(null, false); },
                    error: function(xhr) { alert(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); }
                });
            });
        });
    </script>
}
