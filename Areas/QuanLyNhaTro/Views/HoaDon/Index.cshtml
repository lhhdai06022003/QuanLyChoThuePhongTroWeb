@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}
<link rel="stylesheet" href="~/css/hoadon.css" asp-append-version="true" />
<style>
    /* Đồng bộ màu nền bộ lọc trong chế độ tối */
    html[data-bs-theme="dark"] .bg-light,
    [data-bs-theme="dark"] .bg-light {
        background-color: var(--tblr-bg-surface-secondary, #1b2434) !important;
        color: var(--tblr-body-color, #f4f6fa) !important;
    }
    html[data-bs-theme="dark"] .border-dashed,
    [data-bs-theme="dark"] .border-dashed {
        border-color: rgba(255, 255, 255, 0.15) !important;
    }
</style>

<div class="container-xl mt-3">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold d-flex align-items-center">
                    <i class="fas fa-file-invoice-dollar me-2"></i> Quản lý & Danh sách Hóa đơn
                </h2>
            </div>
            <div class="col-auto ms-auto d-flex gap-2">
                <button class="btn btn-primary font-weight-bold shadow-sm" id="btnOpenBulkEmailModal">
                    <i class="fas fa-envelope me-1"></i> Gửi Email Hóa Đơn
                </button>
                <button class="btn btn-success font-weight-bold shadow-sm" id="btnPhatSinh">
                    <i class="fas fa-plus-circle me-1"></i> Phát sinh Hóa đơn
                </button>
            </div>
        </div>
    </div>

    <!-- Card quản lý & danh sách hóa đơn -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <!-- Khu vực Bộ lọc dạng hàng ngang -->
            <div class="bg-light p-3 border border-dashed rounded-3 mb-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label for="filterChiNhanh" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-building text-secondary me-1"></i> Chi Nhánh 
                        </label>
                        <select id="filterChiNhanh" class="form-select form-select-sm">
                            <option value="0">-- Tất cả --</option>
                            @if (ViewBag.ListChiNhanh != null)
                            {
                                foreach (var cn in ViewBag.ListChiNhanh)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filterThang" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-alt text-secondary me-1"></i> Tháng 
                        </label>
                        <select id="filterThang" class="form-select form-select-sm">
                            <option value="0">-- Tất cả --</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (i == DateTime.Now.Month)
                                {
                                    <option value="@i" selected>Tháng @i</option>
                                }
                                else
                                {
                                    <option value="@i">Tháng @i</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filterNam" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-check text-secondary me-1"></i> Năm 
                        </label>
                        <input type="number" id="filterNam" class="form-control form-control-sm" value="@DateTime.Now.Year">
                    </div>
                    <div class="col-md-3">
                        <label for="filterTrangThai" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-info-circle me-1"></i> Trạng thái
                        </label>
                        <select id="filterTrangThai" class="form-select form-select-sm">
                            <option value="-1">-- Tất cả --</option>
                            <option value="0">Chưa thanh toán</option>
                            <option value="1">Đã thanh toán</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="hoaDonTable" class="table card-table table-vcenter table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th class="text-center" width="4%">STT</th>
                            <th>Mã HĐ</th>
                            <th>Phòng</th>
                            <th>Người thuê</th>
                            <th class="text-center">Kỳ</th>
                            <th class="text-right">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center" style="min-width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết Hóa đơn -->
<div class="modal modal-blur fade" id="chiTietModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-info-lt py-3">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-file-alt me-1"></i> Chi tiết Hóa đơn</h5>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4" id="chiTietBody">
                <!-- JS sẽ render nội dung ở đây -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thu tiền -->
<div class="modal modal-blur fade" id="thuTienModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-success-lt py-3">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-hand-holding-usd me-1"></i> Xác nhận Thu tiền</h5>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <input type="hidden" id="thuTienHoaDonId" />
                <p class="fs-3 mb-2">Bạn đang thu tiền cho hóa đơn: <strong id="thuTienMaHD" class="text-primary"></strong></p>
                <p class="fs-3 mb-3">Tổng tiền: <strong class="text-danger" id="thuTienTongTien"></strong></p>
                <div class="mb-3">
                    <label for="thuTienPhuongThuc" class="form-label font-weight-bold">Phương thức thanh toán</label>
                    <select id="thuTienPhuongThuc" class="form-select">
                        <option value="0">Tiền mặt</option>
                        <option value="1">Chuyển khoản</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="thuTienGhiChu" class="form-label font-weight-bold">Ghi chú</label>
                    <textarea id="thuTienGhiChu" class="form-control" rows="2" placeholder="VD: Đã nhận đủ tiền mặt..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-success shadow-sm" id="btnConfirmThuTien">
                    <i class="fas fa-save me-1"></i> Lưu dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem trước Phát sinh Hóa đơn -->
<div class="modal modal-blur fade" id="previewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary-lt py-3">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-eye me-1"></i> Xem trước Phát sinh Hóa đơn</h5>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="alert alert-info py-2 mb-3 shadow-sm border-0">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle me-2"></i>
                        <div>
                            Vui lòng chọn Chi nhánh, Kỳ tháng/năm cần phát sinh và bấm <strong>"Tải dữ liệu"</strong> để xem trước danh sách phòng.
                        </div>
                    </div>
                </div>
                <!-- Khung bộ chọn dữ liệu phát sinh -->
                <div class="card card-body bg-light border border-dashed rounded-3 p-3 mb-3 shadow-none">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="previewChiNhanh" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-building text-secondary me-1"></i> Chi Nhánh <span class="text-danger">*</span>
                        </label>
                        <select id="previewChiNhanh" class="form-select form-select-sm">
                                @if (ViewBag.ListChiNhanh != null)
                                {
                                    foreach (var cn in ViewBag.ListChiNhanh)
                                    {
                                        <option value="@cn.Value">@cn.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="previewThang" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-alt text-secondary me-1"></i> Tháng <span class="text-danger">*</span>
                        </label>
                        <select id="previewThang" class="form-select form-select-sm">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    if (i == DateTime.Now.Month)
                                    {
                                        <option value="@i" selected>Tháng @i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Tháng @i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="previewNam" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-check text-secondary me-1"></i> Năm <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="previewNam" class="form-control form-control-sm" value="@DateTime.Now.Year">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-sm w-100 font-weight-bold" id="btnLoadPreview" style="height: 36px;">
                                <i class="fas fa-sync-alt me-1"></i> Tải dữ liệu
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Tabs phân loại -->
                <ul class="nav nav-tabs mb-3" id="previewTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active font-weight-bold" id="ready-tab" data-bs-toggle="tab" data-bs-target="#ready-pane" role="tab">
                            <i class="fas fa-check-circle text-success me-1"></i> Sẵn sàng (<span id="ready-count">0</span>)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="missing-tab" data-bs-toggle="tab" data-bs-target="#missing-pane" role="tab">
                            <i class="fas fa-exclamation-triangle text-warning me-1"></i> Chưa chốt điện nước (<span id="missing-count">0</span>)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="invalid-tab" data-bs-toggle="tab" data-bs-target="#invalid-pane" role="tab">
                            <i class="fas fa-times-circle text-danger me-1"></i> Đã có HĐ / Không hợp lệ (<span id="invalid-count">0</span>)
                        </a>
                    </li>
                </ul>
                <div class="tab-content" id="previewTabContent">
                    <!-- Ready Tab -->
                    <div class="tab-pane fade show active" id="ready-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table card-table table-vcenter table-striped table-hover w-100" id="previewReadyTable">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="5%"><input type="checkbox" id="checkAllPreview" checked /></th>
                                        <th>Số phòng</th>
                                        <th>Người thuê</th>
                                        <th class="text-right">Tiền phòng dự kiến</th>
                                        <th class="text-center">Kỳ hạn ở</th>
                                        <th class="text-right">Tổng tiền dự kiến</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Missing Utilities Tab -->
                    <div class="tab-pane fade" id="missing-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table card-table table-vcenter table-striped table-hover w-100" id="previewMissingTable">
                                <thead>
                                    <tr>
                                        <th>Số phòng</th>
                                        <th>Người thuê</th>
                                        <th>Trạng thái</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Invalid Tab -->
                    <div class="tab-pane fade" id="invalid-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table card-table table-vcenter table-striped table-hover w-100" id="previewInvalidTable">
                                <thead>
                                    <tr>
                                        <th>Số phòng</th>
                                        <th>Người thuê</th>
                                        <th>Lý do bỏ qua</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary shadow-sm" id="btnConfirmPhatSinh">
                    <i class="fas fa-plus me-1"></i> Thêm dữ liệu (<span id="selected-preview-count">0</span> phòng)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Gửi Email Hóa Đơn Hàng Loạt -->
<div class="modal modal-blur fade" id="emailBulkModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary-lt py-3">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-envelope me-1"></i> Gửi Email Hóa Đơn Hàng Loạt</h5>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="alert alert-info py-2 mb-3 shadow-sm border-0">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle me-2"></i>
                        <div>
                            Chọn Chi nhánh, Kỳ tháng/năm cần gửi và bấm <strong>"Tải dữ liệu"</strong> để hiển thị danh sách hóa đơn chưa thanh toán.
                        </div>
                    </div>
                </div>
                <!-- Khung bộ lọc dữ liệu gửi mail -->
                <div class="card card-body bg-light border border-dashed rounded-3 p-3 mb-3 shadow-none">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="emailBulkChiNhanh" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-building text-secondary me-1"></i> Chi Nhánh 
                        </label>
                        <select id="emailBulkChiNhanh" class="form-select form-select-sm">
                                <option value="0">-- Tất cả chi nhánh --</option>
                                @if (ViewBag.ListChiNhanh != null)
                                {
                                    foreach (var cn in ViewBag.ListChiNhanh)
                                    {
                                        <option value="@cn.Value">@cn.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="emailBulkThang" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-alt text-secondary me-1"></i> Tháng 
                        </label>
                        <select id="emailBulkThang" class="form-select form-select-sm">
                                <option value="0">-- Tất cả tháng --</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    if (i == DateTime.Now.Month)
                                    {
                                        <option value="@i" selected>Tháng @i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Tháng @i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="emailBulkNam" class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-check text-secondary me-1"></i> Năm 
                        </label>
                        <input type="number" id="emailBulkNam" class="form-control form-control-sm" value="@DateTime.Now.Year">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-sm w-100 font-weight-bold" id="btnLoadEmailBulk" style="height: 36px;">
                                <i class="fas fa-sync-alt me-1"></i> Tải dữ liệu
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table card-table table-vcenter table-striped table-hover w-100" id="emailBulkTable">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%"><input type="checkbox" id="checkAllEmailBulk" checked /></th>
                                <th>Mã HĐ</th>
                                <th>Số phòng</th>
                                <th>Khách thuê</th>
                                <th>Email nhận thư</th>
                                <th class="text-right">Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu. Vui lòng bấm "Tải dữ liệu".</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-success shadow-sm" id="btnConfirmSendEmailBulk" disabled>
                    <i class="fas fa-paper-plane me-1"></i> Bắt đầu gửi (<span id="selected-email-bulk-count">0</span> hóa đơn)
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Modal Chỉnh sửa Hóa đơn -->
<div class="modal modal-blur fade" id="editModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-warning-lt py-3">
                <h5 class="modal-title font-weight-bold text-reset"><i class="fas fa-edit me-1"></i> Chỉnh sửa Chi tiết Hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <input type="hidden" id="editHoaDonId" />
                <div class="row mb-3 font-weight-bold fs-3">
                    <div class="col-md-6" id="editMaHDText"></div>
                    <div class="col-md-6 text-md-end text-start" id="editPhongText"></div>
                </div>
                <div class="table-responsive">
                    <table class="table card-table table-vcenter table-striped table-hover w-100 table-sm" id="editLinesTable">
                        <thead>
                            <tr>
                                <th>Tên khoản phí / Dịch vụ</th>
                                <th width="20%">Đơn giá (đ)</th>
                                <th width="15%">Số lượng</th>
                                <th width="10%">Đơn vị</th>
                                <th width="22%">Thành tiền</th>
                                <th width="8%" class="text-center">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- JS sẽ render ở đây -->
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm mt-3" id="btnAddEditRow">
                    <i class="fas fa-plus me-1"></i> Thêm dòng phí mới
                </button>
                <div class="text-end mt-3">
                    <h3>Tổng cộng: <span class="text-danger font-weight-bold" id="editTongTienText">0 ₫</span></h3>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-success shadow-sm" id="btnSaveEdit">
                    <i class="fas fa-save me-1"></i> Lưu dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(unsafe) {
            return (unsafe || "").toString()
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        $(document).ready(function () {
            var bankId = '@ViewBag.BankId';
            var accountNumber = '@ViewBag.AccountNumber';
            var accountName = '@ViewBag.AccountName';

            // Đọc tham số URL query nếu có (dành cho redirect từ Dashboard)
            const urlParams = new URLSearchParams(window.location.search);
            const urlThang = urlParams.get('thang');
            const urlNam = urlParams.get('nam');
            const urlTrangThai = urlParams.get('trangThai');
            const urlChiNhanh = urlParams.get('chiNhanhId');
            if (urlThang) $('#filterThang').val(urlThang);
            if (urlNam) $('#filterNam').val(urlNam);
            if (urlTrangThai) $('#filterTrangThai').val(urlTrangThai);
            if (urlChiNhanh) $('#filterChiNhanh').val(urlChiNhanh);
            function formatVND(n) {
                if (n === null || n === undefined) return "0 ₫";
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
            }

            // ========== DataTable ==========
            const urlSearch = urlParams.get('search') || '';
            var table = $('#hoaDonTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "search": { "search": urlSearch },
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/HoaDon/GetList",
                    "type": "POST",
                    "data": function(d) {
                        d.chiNhanhId = $('#filterChiNhanh').val();
                        d.thang = $('#filterThang').val();
                        d.nam = $('#filterNam').val();
                        d.trangThai = $('#filterTrangThai').val();
                    }
                },
                "columns": [
                    { "data": null, "className": "text-center align-middle", "orderable": false, "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "maHoaDon", "className": "align-middle font-weight-bold" },
                    { "data": "tenPhong", "className": "font-weight-bold align-middle text-primary" },
                    { "data": "tenNguoiThue", "className": "align-middle" },
                    { "data": null, "className": "text-center align-middle", "orderable": false, "render": (d) => `${d.thang}/${d.nam}` },
                    { "data": "tongTien", "className": "text-right align-middle font-weight-bold text-danger", "render": (d) => formatVND(d) },
                    {
                        "data": "trangThaiHoaDonValue", "className": "text-center align-middle", "orderable": false,
                        "render": function(d, t, r) {
                            if (d === 1) return '<span class="badge bg-success-lt px-2 py-1"><i class="fas fa-check-circle me-1"></i> Đã thanh toán</span>';
                            return '<span class="badge bg-warning-lt-lt px-2 py-1"><i class="fas fa-clock me-1"></i> Chưa thanh toán</span>';
                        }
                    },
                    {
                        "data": "hoaDonId", "orderable": false, "className": "text-center align-middle",
                        "render": function(data, t, row) {
                            return `
                                <div class="d-flex justify-content-center">
                                    <div class="dropdown">
                                        <button class="btn btn-icon btn-light btn-sm" data-bs-toggle="dropdown" aria-expanded="false" title="Thao tác">
                                            <i class="fas fa-cog"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <button class="dropdown-item btn-detail text-info py-2" data-id="${data}">
                                                <i class="fas fa-eye me-2"></i> Chi tiết Hóa đơn
                                            </button>
                                            ${row.trangThaiHoaDonValue === 0 ? `
                                                <button class="dropdown-item btn-edit text-warning py-2" data-id="${data}">
                                                    <i class="fas fa-edit me-2"></i> Chỉnh sửa
                                                </button>
                                                <button class="dropdown-item btn-thutien text-success py-2" data-id="${data}" data-ma="${row.maHoaDon}" data-tien="${row.tongTien}">
                                                    <i class="fas fa-hand-holding-usd me-2"></i> Thu tiền
                                                </button>
                                                <div class="dropdown-divider"></div>
                                                <button class="dropdown-item btn-delete text-danger py-2" data-id="${data}">
                                                    <i class="fas fa-trash-alt me-2"></i> Xóa hóa đơn
                                                </button>
                                            ` : ''}
                                            <div class="dropdown-divider"></div>
                                            <button class="dropdown-item btn-send-email text-primary py-2" data-id="${data}" data-email="${row.email || ''}" data-ma="${row.maHoaDon}">
                                                <i class="fas fa-envelope me-2"></i> Gửi Email hóa đơn
                                            </button>
                                            <div class="dropdown-divider"></div>
                                            <a class="dropdown-item text-secondary py-2" href="/HoaDon/ExportExcel/${data}">
                                                <i class="fas fa-file-excel text-success me-2"></i> Xuất Excel
                                            </a>
                                            <a class="dropdown-item text-secondary py-2" href="/HoaDon/ExportPdf/${data}">
                                                <i class="fas fa-file-pdf text-danger me-2"></i> Xuất PDF
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }
                    }
                ]
            });

            // ========== Filter ==========
            $('#filterChiNhanh, #filterThang, #filterTrangThai').change(function() {
                table.ajax.reload();
            });

            var filterNamTimeout = null;
            $('#filterNam').on('change input keyup', function() {
                clearTimeout(filterNamTimeout);
                filterNamTimeout = setTimeout(function() {
                    table.ajax.reload();
                }, 400);
            });

            // ========== Xem trước & Phát sinh hóa đơn ==========
            var previewDataList = [];

            $('#btnPhatSinh').click(function() {
                let cn = $('#filterChiNhanh').val();
                let th = $('#filterThang').val();
                let na = $('#filterNam').val();

                // Đồng bộ từ bộ lọc sang bộ cấu hình phát sinh trong Modal nếu hợp lệ
                if (cn && cn !== '0') { $('#previewChiNhanh').val(cn); }
                if (th && th !== '0') { $('#previewThang').val(th); }
                if (na) { $('#previewNam').val(na); }

                // Xóa dữ liệu cũ trong modal
                $('#previewReadyTable tbody').empty();
                $('#previewMissingTable tbody').empty();
                $('#previewInvalidTable tbody').empty();
                $('#ready-count').text(0);
                $('#missing-count').text(0);
                $('#invalid-count').text(0);
                $('#selected-preview-count').text(0);
                $('#btnConfirmPhatSinh').prop('disabled', true);

                bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal')).show();
            });

            // Tải dữ liệu xem trước khi bấm nút trong Modal
            $('#btnLoadPreview').click(function() {
                let cn = $('#previewChiNhanh').val();
                let th = $('#previewThang').val();
                let na = $('#previewNam').val();

                if (!cn || cn === '0') { showWarning('Vui lòng chọn Chi nhánh cụ thể!'); return; }
                if (!th || th === '0') { showWarning('Vui lòng chọn Tháng cụ thể!'); return; }
                if (!na || na < 2000) { showWarning('Vui lòng nhập Năm hợp lệ!'); return; }

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang tải...');

                $.ajax({
                    url: `/HoaDon/PreviewPhatSinh?chiNhanhId=${cn}&thang=${th}&nam=${na}`,
                    type: 'GET',
                    success: function(res) {
                        previewDataList = res;
                        renderPreviewModal();
                    },
                    error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi khi chuẩn bị xem trước.'); },
                    complete: function() { $btn.prop('disabled', false).html('<i class="fas fa-sync-alt me-1"></i> Tải dữ liệu'); }
                });
            });

            function renderPreviewModal() {
                let readyBody = $('#previewReadyTable tbody').empty();
                let missingBody = $('#previewMissingTable tbody').empty();
                let invalidBody = $('#previewInvalidTable tbody').empty();

                let readyCount = 0;
                let missingCount = 0;
                let invalidCount = 0;

                previewDataList.forEach(item => {
                    if (item.daCoHoaDon || (!item.hopDongHopLe && item.tenNguoiThue === '')) {
                        let reason = item.daCoHoaDon ? '<span class="badge bg-secondary-lt px-2 py-1">Đã có hóa đơn</span>' : `<span class="text-danger font-weight-bold">${escapeHtml(item.ghiChuTrangThai)}</span>`;
                        invalidBody.append(`
                            <tr>
                                <td class="font-weight-bold align-middle">${escapeHtml(item.soPhong)}</td>
                                <td class="align-middle">${escapeHtml(item.tenNguoiThue)}</td>
                                <td class="align-middle">${reason}</td>
                            </tr>
                        `);
                        invalidCount++;
                    } else if (!item.daChotDienNuoc) {
                        missingBody.append(`
                            <tr>
                                <td class="font-weight-bold align-middle">${escapeHtml(item.soPhong)}</td>
                                <td class="align-middle">${escapeHtml(item.tenNguoiThue)}</td>
                                <td class="align-middle"><span class="badge bg-warning-lt-lt px-2 py-1"><i class="fas fa-exclamation-triangle me-1"></i> Chưa chốt điện nước</span></td>
                                <td class="text-center align-middle">
                                    <a href="/QuanLyNhaTro/ChotDienNuoc" class="btn btn-xs btn-outline-warning" target="_blank"><i class="fas fa-edit me-1"></i> Chốt nhanh điện nước</a>
                                </td>
                            </tr>
                        `);
                        missingCount++;
                    } else {
                        readyBody.append(`
                            <tr>
                                <td class="text-center align-middle">
                                    <input type="checkbox" class="form-check-input preview-select" data-id="${item.phongTroId}" checked />
                                </td>
                                <td class="font-weight-bold align-middle text-primary">${escapeHtml(item.soPhong)}</td>
                                <td class="align-middle">${escapeHtml(item.tenNguoiThue)}</td>
                                <td class="text-right align-middle">${formatVND(item.tienPhongDuKien)}</td>
                                <td class="text-center align-middle">${item.soNgayO}/${item.tongSoNgayTrongThang} ngày</td>
                                <td class="text-right align-middle text-primary font-weight-bold">${formatVND(item.tongTienDuKien)}</td>
                                <td class="align-middle"><span class="badge bg-success-lt px-2 py-1">${escapeHtml(item.ghiChuTrangThai)}</span></td>
                            </tr>
                        `);
                        readyCount++;
                    }
                });

                $('#ready-count').text(readyCount);
                $('#missing-count').text(missingCount);
                $('#invalid-count').text(invalidCount);

                updateSelectedPreviewCount();

                // Select tab
                let tabEl;
                if (readyCount > 0) {
                    tabEl = document.getElementById('ready-tab');
                } else if (missingCount > 0) {
                    tabEl = document.getElementById('missing-tab');
                } else {
                    tabEl = document.getElementById('invalid-tab');
                }
                if (tabEl) {
                    bootstrap.Tab.getOrCreateInstance(tabEl).show();
                }
            }

            $('#checkAllPreview').change(function() {
                $('.preview-select').prop('checked', this.checked);
                updateSelectedPreviewCount();
            });

            $('#previewReadyTable').on('change', '.preview-select', function() {
                updateSelectedPreviewCount();
            });

            function updateSelectedPreviewCount() {
                let cnt = $('.preview-select:checked').length;
                $('#selected-preview-count').text(cnt);
                $('#btnConfirmPhatSinh').prop('disabled', cnt === 0);
            }

            $('#btnConfirmPhatSinh').click(function() {
                let selectedIds = [];
                $('.preview-select:checked').each(function() {
                    selectedIds.push(parseInt($(this).data('id')));
                });

                if (selectedIds.length === 0) return;

                let cn = $('#previewChiNhanh').val();
                let th = $('#previewThang').val();
                let na = $('#previewNam').val();

                Swal.fire({
                    title: 'Xác nhận phát sinh hóa đơn?',
                    text: `Bạn có chắc chắn muốn phát sinh hóa đơn cho ${selectedIds.length} phòng đã chọn?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý...');

                        $.ajax({
                            url: '/HoaDon/PhatSinh',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                chiNhanhId: parseInt(cn),
                                thang: parseInt(th),
                                nam: parseInt(na),
                                selectedPhongTroIds: selectedIds
                            }),
                            success: function(res) {
                                showSuccess(res.message);
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal')).hide();
                                table.ajax.reload();
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); },
                            complete: function() { $btn.prop('disabled', false).html('<i class="fas fa-plus me-1"></i> Thêm dữ liệu'); }
                        });
                    }
                });
            });

            // ========== Xem chi tiết ==========
            $('#hoaDonTable').on('click', '.btn-detail', function() {
                let id = $(this).data('id');
                $.get(`/HoaDon/GetById/${id}`, function(res) {
                    let html = `
                        <div class="row mb-3 fs-3">
                            <div class="col-md-6 mb-2"><strong>Mã HĐ:</strong> <span class="text-primary font-weight-bold">${escapeHtml(res.maHoaDon)}</span></div>
                            <div class="col-md-6 mb-2"><strong>Ngày tạo:</strong> ${escapeHtml(res.ngayTao)}</div>
                            <div class="col-md-6 mb-2"><strong>Phòng:</strong> <span class="text-primary font-weight-bold">${escapeHtml(res.tenPhong)}</span></div>
                            <div class="col-md-6 mb-2"><strong>Kỳ:</strong> Tháng ${res.thang}/${res.nam}</div>
                            <div class="col-md-6 mb-2"><strong>Người thuê:</strong> ${escapeHtml(res.tenNguoiThue)}</div>
                            <div class="col-md-6 mb-2"><strong>Trạng thái:</strong> <span class="badge ${res.trangThaiHoaDon === 'Đã thanh toán' ? 'bg-success-lt' : 'bg-warning-lt-lt'} px-2 py-1">${escapeHtml(res.trangThaiHoaDon)}</span></div>
                        </div>
                        <h4 class="font-weight-bold border-bottom pb-2 mt-4"><i class="fas fa-list me-1"></i> Chi tiết các khoản phí</h4>
                        <div class="table-responsive mb-3">
                            <table class="table card-table table-vcenter table-striped table-hover w-100 table-sm">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="6%">STT</th>
                                        <th>Dịch vụ</th>
                                        <th class="text-right" width="18%">Đơn giá</th>
                                        <th class="text-center" width="12%">SL</th>
                                        <th class="text-center" width="12%">Đơn vị</th>
                                        <th class="text-right" width="20%">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>`;

                    res.chiTietHoaDons.forEach((ct, idx) => {
                        let donViText = ct.donVi ? ct.donVi : '-';
                        html += `<tr>
                            <td class="text-center align-middle">${idx+1}</td>
                            <td class="align-middle">${escapeHtml(ct.tenDichVu)}</td>
                            <td class="text-right align-middle">${formatVND(ct.donGia)}</td>
                            <td class="text-center align-middle">${ct.soLuong}</td>
                            <td class="text-center align-middle">${donViText}</td>
                            <td class="text-right align-middle font-weight-bold">${formatVND(ct.tongTien)}</td>
                        </tr>`;
                    });

                    html += `</tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-right font-weight-bold align-middle fs-2 text-uppercase">TỔNG CỘNG</td>
                                    <td class="text-right font-weight-bold text-danger align-middle fs-2">${formatVND(res.tongTien)}</td>
                                </tr>
                            </tfoot>
                        </table>
                        </div>`;

                    // Lịch sử thanh toán
                    if (res.lichSuThanhToans && res.lichSuThanhToans.length > 0) {
                        html += `<h4 class="font-weight-bold border-bottom pb-2 mt-4"><i class="fas fa-history me-1"></i> Lịch sử thanh toán</h4>
                            <div class="table-responsive">
                            <table class="table card-table table-vcenter table-striped table-hover w-100 table-sm">
                                <thead>
                                    <tr><th>Mã GD</th><th class="text-right">Số tiền</th><th>Phương thức</th><th>Ngày</th><th>Người xác nhận</th><th>Ghi chú</th></tr>
                                </thead><tbody>`;
                        res.lichSuThanhToans.forEach(ls => {
                            html += `<tr><td>${escapeHtml(ls.maGiaoDich)}</td><td class="text-right font-weight-bold text-success">${formatVND(ls.soTienThanhToan)}</td><td>${escapeHtml(ls.phuongThucThanhToan)}</td><td>${escapeHtml(ls.ngayThanhToan)}</td><td>${escapeHtml(ls.nguoiXacNhan)}</td><td>${escapeHtml(ls.ghiChu || '')}</td></tr>`;
                        });
                        html += `</tbody></table></div>`;
                    }

                    // Nhúng mã QR thanh toán nếu chưa thanh toán
                    if (res.trangThaiHoaDon === 'Chưa thanh toán') {
                        html += `
                        <div class="row mt-4 pt-3 border-top justify-content-center">
                            <div class="col-md-7 text-center">
                                <div class="qr-payment-box p-4 shadow-sm">
                                    <h4 class="qr-title text-primary font-weight-bold mb-3"><i class="fas fa-qrcode me-1"></i> Quét mã QR để chuyển khoản nhanh</h4>
                                    <div class="mb-3">
                                        <img src="/HoaDon/GetVietQR?hoaDonId=${res.hoaDonId}" alt="VietQR" />
                                    </div>
                                    <p class="small text-muted mb-3">Sử dụng ứng dụng ngân hàng hoặc ví điện tử để quét mã QR</p>
                                    <div class="qr-details-list bg-light p-3 rounded text-start">
                                        <div class="qr-detail-item"><span>Ngân hàng:</span><strong>${escapeHtml(bankId)}</strong></div>
                                        <div class="qr-detail-item"><span>Số tài khoản:</span><strong>${escapeHtml(accountNumber)}</strong></div>
                                        <div class="qr-detail-item"><span>Chủ tài khoản:</span><strong>${escapeHtml(accountName)}</strong></div>
                                        <div class="qr-detail-item"><span>Số tiền:</span><strong class="text-danger">${formatVND(res.tongTien)}</strong></div>
                                        <div class="qr-detail-item"><span>Nội dung CK:</span><code class="text-primary font-weight-bold">THANH TOAN ${escapeHtml(res.maHoaDon)}</code></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        `;
                    }

                    $('#chiTietBody').html(html);
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('chiTietModal')).show();
                });
            });

            // ========== Chỉnh sửa hóa đơn ==========
            $('#hoaDonTable').on('click', '.btn-edit', function() {
                let id = $(this).data('id');
                $('#editHoaDonId').val(id);
                $.get(`/HoaDon/GetById/${id}`, function(res) {
                    $('#editMaHDText').html(`Mã HĐ: <span class="text-primary">${escapeHtml(res.maHoaDon)}</span>`);
                    $('#editPhongText').html(`Phòng: <span class="text-primary">${escapeHtml(res.tenPhong)}</span> (${escapeHtml(res.tenNguoiThue)})`);
                    
                    let tbody = $('#editLinesTable tbody').empty();
                    
                    res.chiTietHoaDons.forEach(ct => {
                        addEditRow(ct.tenDichVu, ct.donGia, ct.soLuong, ct.donVi || '', ct.chiTietHoaDonId, ct.dichVuId);
                    });
                    
                    recalculateEditTotal();
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).show();
                });
            });

            function addEditRow(ten = '', gia = 0, sl = 1, dv = '', ctId = 0, dvId = null) {
                let tbody = $('#editLinesTable tbody');
                let rowId = 'editRow_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
                let tr = $(`
                    <tr id="${rowId}">
                        <td>
                            <input type="text" class="form-control form-control-sm edit-ten" value="${escapeHtml(ten)}" placeholder="Nhập tên dịch vụ/khoản phí" required />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm text-right edit-gia" value="${gia}" min="0" required />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm text-center edit-sl" value="${sl}" min="0" required />
                        </td>
                        <td class="align-middle">
                            <span class="text-muted edit-dv-label" style="font-size: 0.9rem;">${escapeHtml(dv)}</span>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm text-right edit-thanhtien" value="${formatVND(gia * sl)}" disabled />
                        </td>
                        <td class="text-center align-middle">
                            <button type="button" class="btn btn-link text-danger btn-delete-edit-row p-0"><i class="fas fa-trash-alt"></i></button>
                            <input type="hidden" class="edit-ct-id" value="${ctId}" />
                            <input type="hidden" class="edit-dv-id" value="${dvId || ''}" />
                        </td>
                    </tr>
                `);
                
                tr.find('.edit-gia, .edit-sl').on('input', function() {
                    let g = parseFloat(tr.find('.edit-gia').val()) || 0;
                    let s = parseFloat(tr.find('.edit-sl').val()) || 0;
                    tr.find('.edit-thanhtien').val(formatVND(g * s));
                    recalculateEditTotal();
                });
                
                tr.find('.btn-delete-edit-row').click(function() {
                    tr.remove();
                    recalculateEditTotal();
                });
                
                tbody.append(tr);
            }

            $('#btnAddEditRow').click(function() {
                addEditRow('Khoản phí khác', 0, 1, '');
            });

            function recalculateEditTotal() {
                let total = 0;
                $('#editLinesTable tbody tr').each(function() {
                    let g = parseFloat($(this).find('.edit-gia').val()) || 0;
                    let s = parseFloat($(this).find('.edit-sl').val()) || 0;
                    total += g * s;
                });
                $('#editTongTienText').text(formatVND(total));
            }

            $('#btnSaveEdit').click(function() {
                let id = $('#editHoaDonId').val();
                let req = { chiTiets: [] };
                let valid = true;

                $('#editLinesTable tbody tr').each(function() {
                    let ten = $(this).find('.edit-ten').val();
                    let gia = parseFloat($(this).find('.edit-gia').val());
                    let sl = parseFloat($(this).find('.edit-sl').val());
                    let dvIdVal = $(this).find('.edit-dv-id').val();
                    
                    if (!ten || ten.trim() === '') {
                        showWarning('Tên khoản phí không được để trống.');
                        valid = false;
                        return false;
                    }
                    if (isNaN(gia) || gia < 0 || isNaN(sl) || sl < 0) {
                        showWarning('Đơn giá và số lượng phải lớn hơn hoặc bằng 0.');
                        valid = false;
                        return false;
                    }

                    req.chiTiets.push({
                        chiTietHoaDonId: parseInt($(this).find('.edit-ct-id').val()) || 0,
                        tenDichVu: ten,
                        donGia: gia,
                        soLuong: parseInt(sl),
                        dichVuId: dvIdVal ? parseInt(dvIdVal) : null
                    });
                });

                if (!valid) return;
                if (req.chiTiets.length === 0) {
                    showWarning('Hóa đơn phải có ít nhất một dòng chi phí.');
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận lưu thay đổi?',
                    text: 'Bạn có chắc chắn muốn cập nhật các khoản phí của hóa đơn này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...');

                        $.ajax({
                            url: `/HoaDon/Update/${id}`,
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message);
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).hide();
                                table.ajax.reload(null, false);
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); },
                            complete: function() { $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Lưu dữ liệu'); }
                        });
                    }
                });
            });

            // ========== Thu tiền ==========
            $('#hoaDonTable').on('click', '.btn-thutien', function() {
                $('#thuTienHoaDonId').val($(this).data('id'));
                $('#thuTienMaHD').text($(this).data('ma'));
                $('#thuTienTongTien').text(formatVND($(this).data('tien')));
                $('#thuTienPhuongThuc').val(0);
                $('#thuTienGhiChu').val('');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('thuTienModal')).show();
            });

            $('#btnConfirmThuTien').click(function() {
                let req = {
                    hoaDonId: parseInt($('#thuTienHoaDonId').val()),
                    phuongThucThanhToan: parseInt($('#thuTienPhuongThuc').val()),
                    ghiChu: $('#thuTienGhiChu').val()
                };

                Swal.fire({
                    title: 'Xác nhận thu tiền?',
                    text: 'Bạn có chắc chắn muốn xác nhận thanh toán cho hóa đơn này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true);

                        $.ajax({
                            url: '/HoaDon/ThuTien',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message);
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('thuTienModal')).hide();
                                table.ajax.reload(null, false);
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra.'); },
                            complete: function() { $btn.prop('disabled', false); }
                        });
                    }
                });
            });

            // ========== Xóa hóa đơn ==========
            $('#hoaDonTable').on('click', '.btn-delete', function() {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa hóa đơn này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/HoaDon/Delete/${id}`,
                            type: 'DELETE',
                            success: function(res) {
                                Swal.fire('Thành công!', res.message, 'success');
                                table.ajax.reload(null, false);
                            },
                            error: function(xhr) {
                                Swal.fire('Lỗi!', xhr.responseJSON?.message || 'Có lỗi xảy ra.', 'error');
                            }
                        });
                    }
                });
            });

            // ========== Gửi Email hóa đơn đơn lẻ ==========
            $('#hoaDonTable').on('click', '.btn-send-email', function() {
                let id = $(this).data('id');
                let email = $(this).data('email');
                let maHd = $(this).data('ma');

                if (!email || email.trim() === '') {
                    Swal.fire('Lỗi!', 'Khách thuê của hóa đơn này chưa đăng ký địa chỉ email.', 'error');
                    return;
                }

                Swal.fire({
                    title: 'Gửi Email hóa đơn?',
                    text: `Bạn có chắc chắn muốn gửi email thông báo hóa đơn ${maHd} đến địa chỉ ${email}?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý gửi',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).addClass('disabled').html('<i class="fas fa-spinner fa-spin me-2"></i> Đang gửi...');

                        $.ajax({
                            url: `/HoaDon/SendEmail/${id}`,
                            type: 'POST',
                            success: function(res) {
                                Swal.fire('Thành công!', res.message, 'success');
                            },
                            error: function(xhr) {
                                Swal.fire('Lỗi!', xhr.responseJSON?.message || 'Có lỗi xảy ra khi gửi email.', 'error');
                            },
                            complete: function() {
                                $btn.prop('disabled', false).removeClass('disabled').html(originalHtml);
                            }
                        });
                    }
                });
            });

            // ========== Gửi Email Hóa Đơn Hàng Loạt qua Modal ==========
            var emailBulkDataList = [];

            $('#btnOpenBulkEmailModal').click(function() {
                // Đồng bộ từ bộ lọc ngoài vào bộ lọc Modal để hỗ trợ tiện dụng
                let cn = $('#filterChiNhanh').val();
                let th = $('#filterThang').val();
                let na = $('#filterNam').val();

                if (cn) $('#emailBulkChiNhanh').val(cn);
                if (th) $('#emailBulkThang').val(th);
                if (na) $('#emailBulkNam').val(na);

                // Reset table & footer count in modal
                $('#emailBulkTable tbody').html('<tr><td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu. Vui lòng bấm "Tải dữ liệu".</td></tr>');
                $('#selected-email-bulk-count').text(0);
                $('#btnConfirmSendEmailBulk').prop('disabled', true);
                $('#checkAllEmailBulk').prop('checked', true);

                bootstrap.Modal.getOrCreateInstance(document.getElementById('emailBulkModal')).show();
            });

            // Tải dữ liệu hóa đơn chưa thanh toán cho Modal
            $('#btnLoadEmailBulk').click(function() {
                let cn = $('#emailBulkChiNhanh').val();
                let th = $('#emailBulkThang').val();
                let na = $('#emailBulkNam').val();

                if (!na || na < 2000) {
                    showWarning('Vui lòng nhập năm hợp lệ!');
                    return;
                }

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang tải...');

                $.ajax({
                    url: `/HoaDon/GetUnpaidList?chiNhanhId=${cn}&thang=${th}&nam=${na}`,
                    type: 'GET',
                    success: function(res) {
                        emailBulkDataList = res;
                        renderEmailBulkTable();
                    },
                    error: function(xhr) {
                        showError(xhr.responseJSON?.message || 'Có lỗi khi tải danh sách hóa đơn chưa thanh toán.');
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html('<i class="fas fa-sync-alt me-1"></i> Tải dữ liệu');
                    }
                });
            });

            function renderEmailBulkTable() {
                let tbody = $('#emailBulkTable tbody').empty();
                if (emailBulkDataList.length === 0) {
                    tbody.html('<tr><td colspan="7" class="text-center text-muted py-4">Không có hóa đơn nào chưa thanh toán trong kỳ này.</td></tr>');
                    $('#selected-email-bulk-count').text(0);
                    $('#btnConfirmSendEmailBulk').prop('disabled', true);
                    return;
                }

                emailBulkDataList.forEach(item => {
                    let emailText = item.email ? item.email : '<span class="text-danger font-weight-bold"><i class="fas fa-exclamation-triangle"></i> Chưa có Email</span>';
                    let disabledCheckbox = !item.email ? 'disabled' : 'checked';
                    
                    tbody.append(`
                        <tr>
                            <td class="text-center align-middle">
                                <input type="checkbox" class="form-check-input email-bulk-select" data-id="${item.hoaDonId}" data-email="${escapeHtml(item.email || '')}" data-ma="${escapeHtml(item.maHoaDon)}" ${disabledCheckbox} />
                            </td>
                            <td class="align-middle font-weight-bold">${escapeHtml(item.maHoaDon)}</td>
                            <td class="align-middle font-weight-bold text-primary">${escapeHtml(item.tenPhong)}</td>
                            <td class="align-middle">${escapeHtml(item.tenNguoiThue)}</td>
                            <td class="align-middle">${emailText}</td>
                            <td class="text-right align-middle text-danger font-weight-bold">${formatVND(item.tongTien)}</td>
                            <td class="align-middle"><span class="badge bg-warning-lt-lt px-2 py-1"><i class="fas fa-clock me-1"></i> Chưa thanh toán</span></td>
                        </tr>
                    `);
                });

                $('#checkAllEmailBulk').prop('checked', $('.email-bulk-select:not(:disabled)').length === $('.email-bulk-select:checked').length);
                updateSelectedEmailBulkCount();
            }

            $('#checkAllEmailBulk').change(function() {
                $('.email-bulk-select:not(:disabled)').prop('checked', this.checked);
                updateSelectedEmailBulkCount();
            });

            $('#emailBulkTable').on('change', '.email-bulk-select', function() {
                updateSelectedEmailBulkCount();
            });

            function updateSelectedEmailBulkCount() {
                let cnt = $('.email-bulk-select:checked').length;
                $('#selected-email-bulk-count').text(cnt);
                $('#btnConfirmSendEmailBulk').prop('disabled', cnt === 0);
            }

            // Thực hiện gửi hàng loạt bằng AJAX tuần tự
            $('#btnConfirmSendEmailBulk').click(function() {
                let selected = [];
                $('.email-bulk-select:checked').each(function() {
                    selected.push({
                        id: parseInt($(this).data('id')),
                        email: $(this).data('email'),
                        ma: $(this).data('ma')
                    });
                });

                if (selected.length === 0) return;

                Swal.fire({
                    title: 'Gửi Email hàng loạt?',
                    text: `Bạn có chắc chắn muốn gửi email thông báo hóa đơn cho ${selected.length} phòng đã chọn?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('emailBulkModal')).hide();

                        // Hiển thị SweetAlert2 Progress bar
                        Swal.fire({
                            title: 'Đang gửi email hàng loạt...',
                            html: `Đã gửi thành công: <strong class="text-success" id="swal-success-cnt">0</strong> / <strong>${selected.length}</strong> email.<br/>
                                   <div class="progress progress-sm mt-3" style="height: 10px; border-radius: 5px;">
                                       <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%; border-radius: 5px;"></div>
                                   </div>`,
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        let successCount = 0;
                        let failCount = 0;

                        for (let i = 0; i < selected.length; i++) {
                            let item = selected[i];
                            
                            // Gửi request AJAX
                            try {
                                await $.ajax({
                                    url: `/HoaDon/SendEmail/${item.id}`,
                                    type: 'POST'
                                });
                                successCount++;
                            } catch (err) {
                                failCount++;
                            }

                            // Cập nhật progress bar
                            let percent = Math.round(((i + 1) / selected.length) * 100);
                            $('#swal-success-cnt').text(successCount);
                            $('.progress-bar').css('width', `${percent}%`);
                        }

                        // Hoàn thành
                        Swal.fire({
                            icon: successCount === selected.length ? 'success' : (failCount === selected.length ? 'error' : 'warning'),
                            title: 'Kết quả gửi email',
                            text: `Đã gửi xong! Thành công: ${successCount}, Thất bại: ${failCount}.`,
                            confirmButtonText: 'Đóng'
                        });

                        table.ajax.reload(null, false);
                    }
                });
            });
        });
    </script>
}
