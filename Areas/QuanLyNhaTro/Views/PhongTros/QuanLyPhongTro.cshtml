@{
    ViewData["Title"] = "Quản Lý Phòng Trọ";
}

<!-- Main Content -->
<section class="content mt-3">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-bed"></i> Danh Sách Phòng Trọ</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" id="btnOpenAddModal">
                        <i class="fas fa-plus"></i> Thêm Mới Phòng
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table id="phongTroTable" class="table table-bordered table-striped table-hover w-100">
                    <thead class="bg-light">
                        <tr>
                            <th>ID</th>
                            <th>Chi Nhánh</th>
                            <th>Số Phòng</th>
                            <th>Tầng</th>
                            <th>Giá Thuê</th>
                            <th>Diện Tích</th>
                            <th>Trạng Thái</th>
                            <th class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Modal Thêm/Sửa -->
<div class="modal fade" id="phongTroModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <!-- Dùng modal-lg vì nhiều input -->
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Cập nhật thông tin phòng</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Chi Nhánh <span class="text-danger">*</span></label>
                        <select id="ChiNhanhId" class="form-control">
                            <option value="">-- Chọn Chi Nhánh --</option>
                            @if (ViewBag.ChiNhanhs != null)
                            {
                                foreach (var cn in ViewBag.ChiNhanhs)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Số Phòng <span class="text-danger">*</span></label>
                        <input type="text" id="SoPhong" class="form-control" placeholder="VD: P.101">
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Tầng Lầu</label>
                        <input type="number" id="TangLau" class="form-control" value="1">
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Giá Thuê (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" id="GiaThue" class="form-control" placeholder="VD: 3000000">
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Diện Tích (m2)</label>
                        <input type="number" id="DienTich" class="form-control" placeholder="VD: 20">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Số Người Tối Đa</label>
                        <input type="number" id="SoNguoiToiDa" class="form-control" value="2">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Trạng Thái</label>
                        <select id="TrangThai" class="form-control">
                            <option value="0">Trống</option>
                            <option value="1">Đã Thuê</option>
                            <option value="2">Bảo Trì</option>
                        </select>
                    </div>
                    <div class="col-md-12 form-group">
                        <label>Mô Tả</label>
                        <textarea id="MoTa" class="form-control" rows="3" placeholder="Nội thất, tiện ích đi kèm..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveData">
                    <i class="fas fa-save"></i> Lưu thông tin
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // 🌟 Biến toàn cục để lưu trạng thái
        var table;
        let currentPhongTroId = 0; // 0 = Thêm mới, Khác 0 = Cập nhật

        $(document).ready(function () {

            // 1. KHỞI TẠO DATATABLE
            table = $('#phongTroTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "ajax": {
                    "url": "/PhongTros/DanhSachPhongTro",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "phongTroId", "width": "5%" },
                    { "data": "tenChiNhanh" },
                    {
                        "data": "soPhong",
                        "render": data => `<span class="font-weight-bold text-info">${data}</span>`
                    },
                    { "data": "tangLau", "className": "text-center" },
                    {
                        "data": "giaThue",
                        "className": "text-right",
                        "render": data => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data)
                    },
                    {
                        "data": "dienTich",
                        "className": "text-center",
                        "render": data => data + " m²"
                    },
                    {
                        "data": "trangThai",
                        "className": "text-center",
                        "render": function(data) {
                            // Render HTML dựa trên Enum Trạng Thái (0: Trống, 1: Đã Thuê, 2: Bảo Trì)
                            if (data === 0) return '<span class="badge badge-success">Trống</span>';
                            if (data === 1) return '<span class="badge badge-danger">Đã Thuê</span>';
                            if (data === 2) return '<span class="badge badge-warning">Bảo Trì</span>';
                            return '';
                        }
                    },
                    {
                        "data": "phongTroId",
                        "className": "text-center",
                        "width": "10%",
                        "render": function (data) {
                            return `
                                <button class="btn btn-warning btn-sm btn-edit" data-id="${data}" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-sm btn-delete" data-id="${data}" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                "order": [[ 0, "desc" ]]
            });

            // 2. SỰ KIỆN CLICK MỞ MODAL THÊM MỚI
            $('#btnOpenAddModal').on('click', function () {
                currentPhongTroId = 0; // Đặt về 0 là chế độ thêm mới

                // Reset form (Clear tất cả input/select)
                $('#ChiNhanhId').val('');
                $('#SoPhong').val('');
                $('#TangLau').val('1');
                $('#GiaThue').val('');
                $('#DienTich').val('');
                $('#SoNguoiToiDa').val('2');
                $('#TrangThai').val('0'); // Mặc định là Trống
                $('#MoTa').val('');

                $('#modalTitle').text('Thêm Phòng Trọ Mới');
                $('#phongTroModal').modal('show');
            });

            // 3. SỰ KIỆN CLICK NÚT LƯU (THÊM / SỬA)
            $('#btnSaveData').on('click', function () {
                // Thu thập dữ liệu (Sử dụng toán tử || "" để tránh Null)
                let chiNhanhId = $('#ChiNhanhId').val();
                let soPhong = $('#SoPhong').val() || "";
                let tangLau = $('#TangLau').val() || 0;
                let giaThue = $('#GiaThue').val() || 0;
                let dienTich = $('#DienTich').val() || 0;
                let soNguoiToiDa = $('#SoNguoiToiDa').val() || 0;
                let trangThai = $('#TrangThai').val() || 0;
                let moTa = $('#MoTa').val() || "";

                // Frontend Validation
                if (!chiNhanhId) { alert("Vui lòng chọn chi nhánh!"); return; }
                if (soPhong.trim() === "") { alert("Vui lòng nhập số phòng!"); return; }
                if (giaThue <= 0) { alert("Giá thuê phải lớn hơn 0!"); return; }

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                // Xác định Endpoint API
                let actionUrl = (currentPhongTroId === 0) ? '/PhongTros/ThemPhongTro' : '/PhongTros/CapNhatPhongTro';

                $.ajax({
                    url: actionUrl,
                    type: 'POST',
                    data: {
                        PhongTroId: currentPhongTroId, // Nếu là Thêm thì gửi số 0, Cập nhật thì gửi ID thực tế
                        ChiNhanhId: chiNhanhId,
                        SoPhong: soPhong,
                        TangLau: tangLau,
                        GiaThue: giaThue,
                        DienTich: dienTich,
                        SoNguoiToiDa: soNguoiToiDa,
                        TrangThai: trangThai,
                        MoTa: moTa
                    },
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            $('#phongTroModal').modal('hide');
                            table.ajax.reload(null, false); // Reload nhưng giữ nguyên trang hiện tại
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                        alert("Không thể kết nối đến máy chủ!");
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thông tin');
                    }
                });
            });

            // 4. SỰ KIỆN CLICK NÚT SỬA (TRÊN TABLE)
            $('#phongTroTable tbody').on('click', '.btn-edit', function () {
                let id = $(this).data('id');
                let $btn = $(this);

                if (!id || isNaN(id) || parseInt(id) <= 0) {
                    alert("Dữ liệu không hợp lệ!"); return;
                }

                currentPhongTroId = id; // Ghi nhớ ID đang thao tác

                let originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                // Gọi API lấy thông tin chi tiết
                $.ajax({
                    url: '/PhongTros/GetPhongTro?id=' + id,
                    type: 'GET',
                    success: function (res) {
                        if (res.success && res.data) {
                            let d = res.data;

                            // Đổ dữ liệu vào Modal
                            $('#ChiNhanhId').val(d.chiNhanhId);
                            $('#SoPhong').val(d.soPhong);
                            $('#TangLau').val(d.tangLau);
                            $('#GiaThue').val(d.giaThue);
                            $('#DienTich').val(d.dienTich);
                            $('#SoNguoiToiDa').val(d.soNguoiToiDa);
                            $('#TrangThai').val(d.trangThai);
                            $('#MoTa').val(d.moTa);

                            $('#modalTitle').text('Chỉnh sửa: Phòng ' + (d.soPhong || ""));
                            $('#phongTroModal').modal('show');
                        } else {
                            alert("Lỗi: " + (res.message || "Không tải được dữ liệu."));
                        }
                    },
                    error: function () { alert("Lỗi kết nối máy chủ!"); },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });

            // 5. SỰ KIỆN CLICK NÚT XÓA
            $('#phongTroTable tbody').on('click', '.btn-delete', function () {
                let id = $(this).data('id');
                let $btn = $(this);

                if (!id || isNaN(id) || parseInt(id) <= 0) return;

                if (confirm('Bạn có chắc chắn muốn xóa phòng trọ này? Thao tác này không thể hoàn tác.')) {
                    let originalHtml = $btn.html();
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                    $.ajax({
                        url: '/PhongTros/XoaPhongTro',
                        type: 'POST',
                        data: { id: id }, // Truyền data dạng POST an toàn
                        success: function (res) {
                            if (res.success) {
                                alert(res.message);
                                table.ajax.reload(null, false);
                            } else {
                                alert("Không thể xóa: " + res.message);
                                $btn.prop('disabled', false).html(originalHtml);
                            }
                        },
                        error: function (xhr) {
                            console.error(xhr);
                            alert("Lỗi kết nối máy chủ khi xóa!");
                            $btn.prop('disabled', false).html(originalHtml);
                        }
                    });
                }
            });

        });
    </script>
}