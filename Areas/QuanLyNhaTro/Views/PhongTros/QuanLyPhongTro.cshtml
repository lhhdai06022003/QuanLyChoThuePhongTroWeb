@{
    ViewData["Title"] = "Quản Lý Phòng Trọ";
}
<link rel="stylesheet" href="~/css/quanlyphongtro.css" />

<div class="container-xl mt-3">
    <!-- Header bar: Toggle + Add button -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="view-toggle btn-group" role="group">
                    <button class="btn btn-outline-primary active" id="btnGridView"><i class="fas fa-th-large"></i> Sơ đồ</button>
                    <button class="btn btn-outline-primary" id="btnTableView"><i class="fas fa-table"></i> Bảng</button>
                </div>
            </div>
            <div class="col-auto ms-auto">
                @* <button type="button" class="btn btn-success me-2 font-weight-bold" id="btnPhatSinhPhong">
                    <i class="fas fa-magic"></i> Phát sinh 10 phòng ngẫu nhiên
                </button> *@
                <button type="button" class="btn btn-success font-weight-bold shadow-sm" id="btnOpenAddModal">
                    <i class="fas fa-plus-circle me-1"></i> Thêm Mới Phòng
                </button>
            </div>
        </div>
    </div>

    <!-- ============= GRID VIEW ============= -->
    <div id="gridViewSection">
        <!-- Stats -->
        <div class="row row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0" style="border-left: 4px solid var(--tblr-success, #2fb344) !important;">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-success-lt text-success avatar rounded"><i class="fas fa-door-open"></i></span>
                            </div>
                            <div class="col text-end">
                                <div class="text-secondary small font-weight-medium">Phòng trống</div>
                                <div class="h3 mb-0 font-weight-bold" id="statTrong">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0" style="border-left: 4px solid var(--tblr-primary, #206bc4) !important;">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-primary-lt text-primary avatar rounded"><i class="fas fa-user-check"></i></span>
                            </div>
                            <div class="col text-end">
                                <div class="text-secondary small font-weight-medium">Đã thuê</div>
                                <div class="h3 mb-0 font-weight-bold" id="statDaThue">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0" style="border-left: 4px solid var(--tblr-danger, #d63939) !important;">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-danger-lt text-danger avatar rounded"><i class="fas fa-exclamation-triangle"></i></span>
                            </div>
                            <div class="col text-end">
                                <div class="text-secondary small font-weight-medium">Đang nợ</div>
                                <div class="h3 mb-0 font-weight-bold" id="statNoTien">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0" style="border-left: 4px solid var(--tblr-warning, #f59f00) !important;">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-warning-lt text-warning avatar rounded"><i class="fas fa-hourglass-half"></i></span>
                            </div>
                            <div class="col text-end">
                                <div class="text-secondary small font-weight-medium">Sắp hết hạn</div>
                                <div class="h3 mb-0 font-weight-bold" id="statSapHetHan">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body py-2">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <select id="filterChiNhanhGrid" class="form-select form-select-sm">
                            <option value="0">-- Tất cả Chi nhánh --</option>
                            @if (ViewBag.ChiNhanhs != null)
                            {
                                foreach (var cn in ViewBag.ChiNhanhs)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex flex-wrap gap-1">
                        <button class="filter-btn active" data-filter="all"><i class="fas fa-th"></i> Tất cả</button>
                        <button class="filter-btn" data-filter="trong"><span class="room-status-dot dot-trong"></span>Trống</button>
                        <button class="filter-btn" data-filter="dathue"><span class="room-status-dot dot-dathue"></span>Đã thuê</button>
                        <button class="filter-btn" data-filter="baotri"><span class="room-status-dot dot-baotri"></span>Bảo trì</button>
                        <button class="filter-btn" data-filter="notien"><i class="fas fa-exclamation-circle text-danger"></i> Nợ tiền</button>
                        <button class="filter-btn" data-filter="saphethan"><i class="fas fa-hourglass-half text-warning"></i> Sắp hết hạn</button>
                    </div>
                    <div class="col-md-3 ms-auto text-end">
                        <input type="text" id="searchRoom" class="form-control form-control-sm d-inline-block" placeholder="🔍 Tìm phòng..." style="max-width:180px;">
                    </div>
                </div>
            </div>
        </div>

        <!-- Room cards grouped by floor -->
        <div id="roomGrid"></div>
        <div id="emptyState" class="text-center py-5" style="display:none;">
            <i class="fas fa-building fa-3x text-muted mb-3"></i>
            <p class="text-muted">Không có phòng nào phù hợp với bộ lọc.</p>
        </div>
    </div>

    <!-- ============= TABLE VIEW ============= -->
    <div id="tableViewSection" style="display:none;">
        <div class="card border-0 shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between py-3">
                <h3 class="card-title font-weight-bold"><i class="fas fa-bed me-2 text-primary"></i> Danh Sách Phòng Trọ</h3>
                <div class="card-actions" style="min-width:200px;">
                    <select id="filterChiNhanhTable" class="form-select form-select-sm">
                        <option value="">-- Tất cả Chi nhánh --</option>
                        @if (ViewBag.ChiNhanhs != null)
                        {
                            foreach (var cn in ViewBag.ChiNhanhs)
                            {
                                <option value="@cn.Text">@cn.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="phongTroTable" class="table table-bordered table-striped table-hover text-nowrap datatable w-100">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" width="5%">STT</th>
                                <th width="25%">Chi Nhánh</th>
                                <th width="12%">Số Phòng</th>
                                <th class="text-center" width="10%">Tầng</th>
                                <th class="text-end" width="15%">Giá Thuê</th>
                                <th class="text-center" width="10%">Diện Tích</th>
                                <th class="text-center" width="13%">Trạng Thái</th>
                                <th class="text-center" width="10%">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa -->
<div class="modal fade" id="phongTroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Cập nhật thông tin phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ChiNhanhId" class="form-label">Chi Nhánh <span class="text-danger">*</span></label>
                        <select id="ChiNhanhId" class="form-select">
                            <option value="">-- Chọn Chi Nhánh --</option>
                            @if (ViewBag.ChiNhanhs != null)
                            {
                                foreach (var cn in ViewBag.ChiNhanhs)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="SoPhong" class="form-label">Số Phòng <span class="text-danger">*</span></label>
                        <input type="text" id="SoPhong" class="form-control" placeholder="VD: P.101">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="TangLau" class="form-label">Tầng Lầu</label>
                        <input type="number" id="TangLau" class="form-control" value="1">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="GiaThue" class="form-label">Giá Thuê (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" id="GiaThue" class="form-control" placeholder="VD: 3000000">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="DienTich" class="form-label">Diện Tích (m²)</label>
                        <input type="number" id="DienTich" class="form-control" placeholder="VD: 20">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="SoNguoiToiDa" class="form-label">Số Người Tối Đa</label>
                        <input type="number" id="SoNguoiToiDa" class="form-control" value="2">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="TrangThai" class="form-label">Trạng Thái</label>
                        <select id="TrangThai" class="form-select">
                            <option value="0">Trống</option>
                            <option value="1">Đã Thuê</option>
                            <option value="2">Bảo Trì</option>
                        </select>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label for="MoTa" class="form-label">Mô Tả</label>
                        <textarea id="MoTa" class="form-control" rows="3" placeholder="Nội thất, tiện ích đi kèm..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold shadow-sm" id="btnSaveData"><i class="fas fa-plus me-1"></i> Thêm dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết phòng -->
<div class="modal fade" id="roomDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="roomDetailHeader">
                <h5 class="modal-title"><i class="fas fa-door-open"></i> <span id="detailRoomName"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="roomDetailBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Quản lý dịch vụ phòng -->
<div class="modal fade" id="dichVuPhongModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-concierge-bell"></i> <span id="dichVuPhongTitle">Quản lý dịch vụ</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 mb-3">
                    <i class="fas fa-info-circle"></i>
                    Dịch vụ <strong>Mặc định</strong> (Điện, Nước) tự động đăng ký. Các dịch vụ khác có thể nhập số lượng.
                </div>
                <div id="dichVuPhongContainer">
                    <div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-success" id="btnSaveDichVuPhong">
                    <i class="fas fa-save"></i> Lưu dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem nhanh hợp đồng -->
<div class="modal fade" id="quickContractModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-file-contract"></i> Xem Nhanh Hợp Đồng - Phòng <span id="quickContractRoom"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6 border-end">
                        <h6 class="font-weight-bold text-primary border-bottom pb-1 mb-2"><i class="fas fa-info-circle"></i> Thông tin hợp đồng</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td width="40%">Mã HĐ:</td><td><strong id="qcMaHD"></strong></td></tr>
                            <tr><td>Ngày bắt đầu:</td><td id="qcNgayBatDau"></td></tr>
                            <tr><td>Ngày kết thúc:</td><td id="qcNgayKetThuc"></td></tr>
                            <tr><td>Tiền cọc:</td><td><strong id="qcTienCoc" class="text-danger"></strong></td></tr>
                            <tr><td>Tiền thuê:</td><td><strong id="qcTienThue" class="text-danger"></strong></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="font-weight-bold text-primary border-bottom pb-1 mb-2"><i class="fas fa-user-tie"></i> Đại diện ký hợp đồng</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td width="40%">Họ tên:</td><td><strong id="qcTenDaiDien"></strong></td></tr>
                            <tr><td>Số điện thoại:</td><td id="qcSDTDaiDien"></td></tr>
                            <tr><td>Số CCCD:</td><td id="qcCCCDDaiDien"></td></tr>
                        </table>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-3" id="quickContractTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active font-weight-bold" id="qc-members-tab" data-bs-toggle="tab" href="#qc-members-pane" role="tab"><i class="fas fa-users me-1"></i> Khách ở ghép (<span id="qcMemberCount">0</span>)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="qc-services-tab" data-bs-toggle="tab" href="#qc-services-pane" role="tab"><i class="fas fa-concierge-bell me-1"></i> Dịch vụ đăng ký (<span id="qcServiceCount">0</span>)</a>
                    </li>
                </ul>

                <div class="tab-content" id="quickContractTabContent">
                    <div class="tab-pane fade show active" id="qc-members-pane" role="tabpanel">
                        <table class="table table-bordered table-sm table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center" width="8%">STT</th>
                                    <th>Họ và Tên</th>
                                    <th class="text-center" width="25%">Số Điện Thoại</th>
                                    <th class="text-center" width="25%">Số CCCD</th>
                                    <th class="text-center" width="20%">Ngày vào ở</th>
                                </tr>
                            </thead>
                            <tbody id="qcMembersBody">
                            </tbody>
                        </table>
                    </div>
                    <div class="tab-pane fade" id="qc-services-pane" role="tabpanel">
                        <table class="table table-bordered table-sm table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center" width="8%">STT</th>
                                    <th>Tên dịch vụ</th>
                                    <th class="text-right" width="25%">Đơn giá</th>
                                    <th class="text-center" width="20%">Số lượng</th>
                                    <th class="text-center" width="20%">Đơn vị</th>
                                </tr>
                            </thead>
                            <tbody id="qcServicesBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="/QuanLyNhaTro/QuanLyHopDong" class="btn btn-outline-primary me-auto"><i class="fas fa-external-link-alt me-1"></i> Quản lý hợp đồng đầy đủ</a>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thu tiền nhanh -->
<div class="modal fade" id="quickPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-hand-holding-usd"></i> Thu Tiền Nhanh - Phòng <span id="quickPaymentRoom"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="qpInvoiceId" />
                <div class="row">
                    <div class="col-lg-7 border-end">
                        <h6 class="font-weight-bold text-success border-bottom pb-2 mb-3">
                            <i class="fas fa-file-invoice-dollar me-1"></i> Hóa đơn chưa thanh toán kỳ: <span id="qpInvoicePeriod" class="text-danger font-weight-bold"></span>
                        </h6>
                        <div class="row mb-3 font-weight-bold text-secondary">
                            <div class="col-md-6">Mã Hóa Đơn: <span id="qpInvoiceCode"></span></div>
                            <div class="col-md-6 text-end">Khách thuê: <span id="qpTenantName"></span></div>
                        </div>
                        <table class="table table-bordered table-sm table-striped mb-3">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center" width="8%">STT</th>
                                    <th>Khoản phí / Dịch vụ</th>
                                    <th class="text-right" width="22%">Đơn giá</th>
                                    <th class="text-center" width="12%">SL</th>
                                    <th class="text-center" width="15%">Đơn vị</th>
                                    <th class="text-right" width="22%">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody id="qpDetailsBody">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-right font-weight-bold align-middle">TỔNG CỘNG THANH TOÁN:</td>
                                    <td class="text-right text-danger font-weight-bold align-middle" style="font-size: 1.25rem;" id="qpTotalAmount"></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="card p-3 bg-light border-0">
                            <h6 class="font-weight-bold text-success mb-3"><i class="fas fa-check-double me-1"></i> Cấu hình thu tiền nhanh</h6>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label font-weight-bold">Phương thức thanh toán</label>
                                    <select id="qpPaymentMethod" class="form-select">
                                        <option value="0">Tiền mặt</option>
                                        <option value="1">Chuyển khoản</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label font-weight-bold">Ghi chú nhanh</label>
                                    <input type="text" id="qpNotes" class="form-control" placeholder="Ví dụ: Đã nhận đủ chuyển khoản...">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5 text-center mt-3 mt-lg-0">
                        <div class="card p-3 shadow-sm h-100 d-flex flex-column justify-content-between border-0">
                            <div>
                                <h6 class="font-weight-bold text-primary mb-2"><i class="fas fa-qrcode me-1"></i> Quét mã QR chuyển khoản nhanh</h6>
                                <div class="my-3">
                                    <img id="qpQRImage" src="" class="img-fluid border rounded p-2 bg-white" style="max-width: 200px; height: auto;" alt="VietQR" />
                                </div>
                                <p class="small text-muted mb-3">Chủ nhà hoặc khách thuê quét mã này bằng App ngân hàng để giao dịch lập tức</p>
                            </div>
                            <div class="bg-light p-3 rounded text-start small" style="line-height: 1.6;">
                                <div class="border-bottom pb-1 mb-1"><strong>Nội dung thanh toán:</strong></div>
                                <div><strong>Nội dung CK:</strong> <code id="qpCKContent" class="text-primary font-weight-bold" style="font-size: 0.95rem;"></code></div>
                                <div class="border-top pt-1 mt-1"><strong>Thông tin người nhận thụ hưởng:</strong></div>
                                <div class="row text-muted">
                                    <div class="col-4">Ngân hàng:</div><div class="col-8 font-weight-bold" id="qpBankId"></div>
                                    <div class="col-4">Số tài khoản:</div><div class="col-8 font-weight-bold" id="qpAccountNumber"></div>
                                    <div class="col-4">Tên tài khoản:</div><div class="col-8 font-weight-bold" id="qpAccountName"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold px-4" id="btnConfirmQuickPayment">
                    <i class="fas fa-check-circle me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DangKyDichVuPartial.cshtml")
    <script>
        // ========== Shared State ==========
        var table;
        let currentPhongTroId = 0;
        let allRooms = [];
        let currentFilter = 'all';

        function formatVND(n) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n || 0);
        }

        // ========== VIEW TOGGLE ==========
        $('#btnGridView').click(function () {
            $(this).addClass('active');
            $('#btnTableView').removeClass('active');
            $('#gridViewSection').show();
            $('#tableViewSection').hide();
            loadGridData();
        });
        $('#btnTableView').click(function () {
            $(this).addClass('active');
            $('#btnGridView').removeClass('active');
            $('#tableViewSection').show();
            $('#gridViewSection').hide();
            if (table) table.ajax.reload();
        });

        // ========== GRID VIEW LOGIC ==========
        function loadGridData() {
            let chiNhanhId = $('#filterChiNhanhGrid').val();
            $.get(`/PhongTros/GetSoDoPhong?chiNhanhId=${chiNhanhId}`, function (data) {
                allRooms = data;
                updateStats();
                renderGrid();
            });
        }

        function updateStats() {
            $('#statTrong').text(allRooms.filter(r => r.trangThai === 0).length);
            $('#statDaThue').text(allRooms.filter(r => r.trangThai === 1).length);
            $('#statNoTien').text(allRooms.filter(r => r.coNoTien).length);
            $('#statSapHetHan').text(allRooms.filter(r => r.sapHetHan).length);
        }

        function renderGrid() {
            let filtered = allRooms;
            let search = ($('#searchRoom').val() || '').toLowerCase();

            if (currentFilter === 'trong') filtered = filtered.filter(r => r.trangThai === 0);
            else if (currentFilter === 'dathue') filtered = filtered.filter(r => r.trangThai === 1);
            else if (currentFilter === 'baotri') filtered = filtered.filter(r => r.trangThai === 2);
            else if (currentFilter === 'notien') filtered = filtered.filter(r => r.coNoTien);
            else if (currentFilter === 'saphethan') filtered = filtered.filter(r => r.sapHetHan);

            if (search) {
                filtered = filtered.filter(r =>
                    r.soPhong.toLowerCase().includes(search) ||
                    (r.tenNguoiThue || '').toLowerCase().includes(search)
                );
            }

            if (filtered.length === 0) {
                $('#roomGrid').html('');
                $('#emptyState').show();
                return;
            }
            $('#emptyState').hide();

            // Group by floor
            let floors = {};
            filtered.forEach(r => {
                let key = r.tangLau || 0;
                if (!floors[key]) floors[key] = [];
                floors[key].push(r);
            });

            let html = '';
            let sortedFloors = Object.keys(floors).sort((a, b) => a - b);

            sortedFloors.forEach(floor => {
                html += `<div class="floor-group">
                    <div class="floor-label"><i class="fas fa-layer-group"></i> Tầng ${floor}</div>
                    <div class="room-grid">`;

                floors[floor].forEach(r => {
                    let cssClass = r.trangThai === 0 ? 'room-trong' : r.trangThai === 1 ? 'room-dathue' : 'room-baotri';
                    let iconClass = r.trangThai === 0 ? 'icon-trong' : r.trangThai === 1 ? 'icon-dathue' : 'icon-baotri';
                    let iconFa = r.trangThai === 0 ? 'fa-door-open' : r.trangThai === 1 ? 'fa-user-check' : 'fa-tools';

                    let badges = '';
                    if (r.coNoTien) badges += `<div class="room-badge badge-debt" title="Nợ ${formatVND(r.soTienNo)}"><i class="fas fa-exclamation"></i></div>`;
                    if (r.sapHetHan) badges += `<div class="room-badge badge-expiring" title="Còn ${r.soNgayConLai} ngày"><i class="fas fa-hourglass-half"></i></div>`;

                    let tenant = r.tenNguoiThue ? `<div class="room-tenant"><i class="fas fa-user"></i> ${r.tenNguoiThue}</div>` : '';
                    let meta = '';
                    if (r.trangThai === 1 && r.soNgayConLai !== null) meta = `<div class="room-meta"><i class="fas fa-calendar-alt"></i> Còn ${r.soNgayConLai} ngày</div>`;
                    if (r.coNoTien) meta += `<div class="room-meta text-danger"><i class="fas fa-exclamation-circle"></i> Nợ: ${formatVND(r.soTienNo)}</div>`;

                    // Kebab menu items based on status
                    let menuItems = `
                        <button class="kebab-item" onclick="openEditFromGrid(${r.phongTroId})"><i class="fas fa-edit text-warning"></i> Sửa thông tin</button>
                        <button class="kebab-item" onclick="showDetail(${r.phongTroId})"><i class="fas fa-info-circle text-info"></i> Xem chi tiết</button>`;
                    if (r.trangThai === 1) {
                        menuItems += `<div class="kebab-divider"></div>`;
                        menuItems += `<button class="kebab-item" onclick="openDichVuPhong(${r.phongTroId})"><i class="fas fa-concierge-bell text-success"></i> Quản lý dịch vụ</button>`;
                        if (r.coNoTien) menuItems += `<button class="kebab-item" onclick="openQuickPayment(${r.phongTroId})"><i class="fas fa-file-invoice-dollar text-danger"></i> Thu tiền</button>`;
                        menuItems += `<button class="kebab-item" onclick="openQuickContract(${r.phongTroId})"><i class="fas fa-file-contract text-primary"></i> Xem hợp đồng</button>`;
                    }
                    menuItems += `<div class="kebab-divider"></div>
                        <button class="kebab-item" onclick="deleteRoom(${r.phongTroId})"><i class="fas fa-trash text-danger"></i> Xóa phòng</button>`;

                    html += `
                        <div class="room-card ${cssClass}" data-id="${r.phongTroId}">
                            <div class="room-badges">${badges}</div>
                            <div class="kebab-menu">
                                <button class="kebab-btn" onclick="event.stopPropagation(); toggleKebab(this)"><i class="fas fa-ellipsis-v"></i></button>
                                <div class="kebab-dropdown">${menuItems}</div>
                            </div>
                            <div class="room-header" onclick="showDetail(${r.phongTroId})">
                                <div class="room-status-icon ${iconClass}"><i class="fas ${iconFa}"></i></div>
                                <div>
                                    <div class="room-number">${r.soPhong}</div>
                                    <div class="room-price">${formatVND(r.giaThue)}/tháng</div>
                                </div>
                            </div>
                            <div onclick="showDetail(${r.phongTroId})">
                                ${tenant}
                                <div class="room-meta"><i class="fas fa-ruler-combined"></i> ${r.dienTich} m²</div>
                                ${meta}
                            </div>
                        </div>`;
                });

                html += `</div></div>`;
            });

            $('#roomGrid').html(html);
        }

        function toggleKebab(btn) {
            let dropdown = $(btn).next('.kebab-dropdown');
            let card = $(btn).closest('.room-card');
            // Close all others first
            $('.kebab-dropdown.show').not(dropdown).removeClass('show');
            $('.room-card.kebab-open').not(card).removeClass('kebab-open');
            
            dropdown.toggleClass('show');
            card.toggleClass('kebab-open');
        }

        // Close kebab when clicking outside
        $(document).click(function (e) {
            if (!$(e.target).closest('.kebab-menu').length) {
                $('.kebab-dropdown.show').removeClass('show');
                $('.room-card.kebab-open').removeClass('kebab-open');
            }
        });

        function openEditFromGrid(id) {
            $('.kebab-dropdown.show').removeClass('show');
            currentPhongTroId = id;
            $.get('/PhongTros/GetPhongTro?id=' + id, function (res) {
                if (res.success && res.data) {
                    let d = res.data;
                    $('#ChiNhanhId').val(d.chiNhanhId);
                    $('#SoPhong').val(d.soPhong);
                    $('#TangLau').val(d.tangLau);
                    $('#GiaThue').val(d.giaThue);
                    $('#DienTich').val(d.dienTich);
                    $('#SoNguoiToiDa').val(d.soNguoiToiDa);
                    $('#TrangThai').val(d.trangThai);
                    $('#MoTa').val(d.moTa);
                    $('#modalTitle').text('Chỉnh sửa: Phòng ' + (d.soPhong || ""));
                    $('#btnSaveData').removeClass('btn-primary').addClass('btn-success').addClass('font-weight-bold').addClass('shadow-sm').html('<i class="fas fa-save me-1"></i> Lưu dữ liệu');
                    $('#phongTroModal').modal('show');
                }
            });
        }

        function deleteRoom(id) {
            $('.kebab-dropdown.show').removeClass('show');
            Swal.fire({
                title: 'Xác nhận xóa phòng?',
                text: 'Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa phòng này?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/PhongTros/XoaPhongTro', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Thành công!', res.message, 'success');
                            loadGridData();
                            if (table) table.ajax.reload(null, false);
                        } else {
                            Swal.fire('Lỗi!', res.message, 'error');
                        }
                    });
                }
            });
        }

        var bankId = '@ViewBag.BankId';
        var accountNumber = '@ViewBag.AccountNumber';
        var accountName = '@ViewBag.AccountName';
        let currentQuickPaymentRoomId = 0;

        function openQuickContract(phongTroId) {
            $('.kebab-dropdown.show').removeClass('show');
            let room = allRooms.find(r => r.phongTroId === phongTroId);
            let roomName = room ? room.soPhong : phongTroId;
            $('#quickContractRoom').text(roomName);

            $('#qcMaHD').text('Đang tải...');
            $('#qcNgayBatDau').text('Đang tải...');
            $('#qcNgayKetThuc').text('Đang tải...');
            $('#qcTienCoc').text('Đang tải...');
            $('#qcTienThue').text('Đang tải...');
            $('#qcTenDaiDien').text('Đang tải...');
            $('#qcSDTDaiDien').text('Đang tải...');
            $('#qcCCCDDaiDien').text('Đang tải...');
            $('#qcMembersBody').html('<tr><td colspan="5" class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải thành viên...</td></tr>');
            $('#qcServicesBody').html('<tr><td colspan="5" class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải dịch vụ...</td></tr>');
            $('#qcMemberCount').text(0);
            $('#qcServiceCount').text(0);

            $('#quickContractModal').modal('show');

            $.get(`/PhongTros/GetQuickContract?phongTroId=${phongTroId}`, function (res) {
                $('#qcMaHD').text(res.maHopDong);
                $('#qcNgayBatDau').text(res.thoiDiemBatDau);
                $('#qcNgayKetThuc').text(res.thoiDiemKetThuc);
                $('#qcTienCoc').text(formatVND(res.tienCocPhong));
                $('#qcTienThue').text(formatVND(res.tienThuePhong));
                $('#qcTenDaiDien').text(res.tenNguoiDaiDien);
                $('#qcSDTDaiDien').text(res.soDienThoaiDaiDien || '-');
                $('#qcCCCDDaiDien').text(res.cccdDaiDien || '-');

                let mHtml = '';
                if (res.members && res.members.length > 0) {
                    res.members.forEach((m, idx) => {
                        mHtml += `
                            <tr>
                                <td class="text-center">${idx + 1}</td>
                                <td class="font-weight-bold">${m.hoVaTen}</td>
                                <td class="text-center">${m.soDienThoai || '-'}</td>
                                <td class="text-center">${m.cccd || '-'}</td>
                                <td class="text-center">${m.ngayVao}</td>
                            </tr>`;
                    });
                    $('#qcMemberCount').text(res.members.length);
                } else {
                    mHtml = '<tr><td colspan="5" class="text-center text-muted">Chưa có thành viên nào khác ở ghép.</td></tr>';
                }
                $('#qcMembersBody').html(mHtml);

                let sHtml = '';
                if (res.services && res.services.length > 0) {
                    res.services.forEach((s, idx) => {
                        sHtml += `
                            <tr>
                                <td class="text-center">${idx + 1}</td>
                                <td class="font-weight-bold">${s.tenDichVu}</td>
                                <td class="text-right">${formatVND(s.donGia)}</td>
                                <td class="text-center">${s.soLuong}</td>
                                <td class="text-center">${s.donVi || '-'}</td>
                            </tr>`;
                    });
                    $('#qcServiceCount').text(res.services.length);
                } else {
                    sHtml = '<tr><td colspan="5" class="text-center text-muted">Không có dịch vụ đăng ký nào.</td></tr>';
                }
                $('#qcServicesBody').html(sHtml);
            }).fail(function (xhr) {
                $('#quickContractModal').modal('hide');
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: xhr.responseJSON?.message || 'Không thể tải thông tin hợp đồng.'
                });
            });
        }

        function openQuickPayment(phongTroId) {
            $('.kebab-dropdown.show').removeClass('show');
            currentQuickPaymentRoomId = phongTroId;
            let room = allRooms.find(r => r.phongTroId === phongTroId);
            let roomName = room ? room.soPhong : phongTroId;
            $('#quickPaymentRoom').text(roomName);

            $('#qpInvoiceId').val('');
            $('#qpInvoicePeriod').text('');
            $('#qpInvoiceCode').text('Đang tải...');
            $('#qpTenantName').text('Đang tải...');
            $('#qpTotalAmount').text('0 ₫');
            $('#qpDetailsBody').html('<tr><td colspan="6" class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải hóa đơn...</td></tr>');
            $('#qpNotes').val('');
            $('#qpQRImage').attr('src', '');
            $('#qpCKContent').text('');

            $('#qpBankId').text(bankId || '-');
            $('#qpAccountNumber').text(accountNumber || '-');
            $('#qpAccountName').text(accountName || '-');

            $('#quickPaymentModal').modal('show');

            $.get(`/PhongTros/GetUnpaidInvoice?phongTroId=${phongTroId}`, function (res) {
                $('#qpInvoiceId').val(res.hoaDonId);
                $('#qpInvoicePeriod').text(`Tháng ${res.thang}/${res.nam}`);
                $('#qpInvoiceCode').text(res.maHoaDon);
                $('#qpTenantName').text(res.tenNguoiThue);
                $('#qpTotalAmount').text(formatVND(res.tongTien));

                $('#qpQRImage').attr('src', `/HoaDon/GetVietQR?hoaDonId=${res.hoaDonId}`);
                $('#qpCKContent').text(`THANH TOAN ${res.maHoaDon}`);

                let dHtml = '';
                if (res.chiTiets && res.chiTiets.length > 0) {
                    res.chiTiets.forEach((d, idx) => {
                        dHtml += `
                            <tr>
                                <td class="text-center">${idx + 1}</td>
                                <td>${d.tenDichVu}</td>
                                <td class="text-right">${formatVND(d.donGia)}</td>
                                <td class="text-center">${d.soLuong}</td>
                                <td class="text-center">${d.donVi || '-'}</td>
                                <td class="text-right font-weight-bold">${formatVND(d.tongTien)}</td>
                            </tr>`;
                    });
                } else {
                    dHtml = '<tr><td colspan="6" class="text-center text-muted">Không có chi tiết dịch vụ nào.</td></tr>';
                }
                $('#qpDetailsBody').html(dHtml);
            }).fail(function (xhr) {
                $('#quickPaymentModal').modal('hide');
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: xhr.responseJSON?.message || 'Không tìm thấy hóa đơn chưa thanh toán cho phòng này.'
                });
            });
        }

        // Đăng ký sự kiện nút xác nhận thanh toán nhanh
        $(document).on('click', '#btnConfirmQuickPayment', function () {
            let hoaDonId = $('#qpInvoiceId').val();
            let pMethod = $('#qpPaymentMethod').val();
            let notes = $('#qpNotes').val();

            if (!hoaDonId) return;

            let $btn = $(this);
            let originalText = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang xử lý...');

            $.ajax({
                url: '/HoaDon/ThuTien',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    hoaDonId: parseInt(hoaDonId),
                    phuongThucThanhToan: parseInt(pMethod),
                    ghiChu: notes
                }),
                success: function (res) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: 'Đã xác nhận thu tiền phòng thành công!'
                    });
                    $('#quickPaymentModal').modal('hide');
                    
                    // Cập nhật giao diện động
                    let card = $(`.room-card[data-id="${currentQuickPaymentRoomId}"]`);
                    card.find('.badge-debt').fadeOut(400, function() { $(this).remove(); });
                    
                    let statNo = $('#statNoTien');
                    if (statNo.length > 0) {
                        let currentVal = parseInt(statNo.text()) || 0;
                        if (currentVal > 0) statNo.text(currentVal - 1);
                    }
                    
                    let roomItem = allRooms.find(r => r.phongTroId === currentQuickPaymentRoomId);
                    if (roomItem) {
                        roomItem.coNoTien = false;
                    }
                },
                error: function (xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: xhr.responseJSON?.message || 'Có lỗi xảy ra khi xác nhận thanh toán.'
                    });
                },
                complete: function () {
                    $btn.prop('disabled', false).html(originalText);
                }
            });
        });

        // ========== QUẢN LÝ DỊCH VỤ PHÒNG ==========
        let currentDichVuPhongId = 0;

        function openDichVuPhong(phongTroId) {
            $('.kebab-dropdown.show').removeClass('show');
            currentDichVuPhongId = phongTroId;

            let room = allRooms.find(r => r.phongTroId === phongTroId);
            let roomName = room ? room.soPhong : phongTroId;
            $('#dichVuPhongTitle').text(`Quản lý dịch vụ - Phòng ${roomName}`);
            $('#dichVuPhongContainer').html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
            $('#dichVuPhongModal').modal('show');

            $.get(`/DangKyDichVu/GetByPhong?phongTroId=${phongTroId}`, function (data) {
                renderDangKyDichVu('dichVuPhongContainer', data, false);
            }).fail(function () {
                $('#dichVuPhongContainer').html('<div class="alert alert-danger">Không thể tải dịch vụ.</div>');
            });
        }

        // Nút lưu dịch vụ từ modal phòng trọ
        $(document).on('click', '#btnSaveDichVuPhong', function () {
            let $btn = $(this);
            Swal.fire({
                title: 'Xác nhận lưu đăng ký dịch vụ?',
                text: 'Bạn có chắc chắn muốn lưu thông tin đăng ký dịch vụ cho phòng này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
                    saveDangKyDichVu(
                        currentDichVuPhongId,
                        'dichVuPhongContainer',
                        function (res) {
                            $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu dữ liệu');
                            if (res && res.success) {
                                showSuccess(res.message || 'Đăng ký dịch vụ thành công!');
                                $('#dichVuPhongModal').modal('hide');
                            } else {
                                showError(res?.message || 'Đã có lỗi xảy ra!');
                            }
                        },
                        function (errMsg) {
                            $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu dữ liệu');
                            showError(errMsg);
                        }
                    );
                }
            });
        });

        function showDetail(id) {
            let r = allRooms.find(x => x.phongTroId === id);
            if (!r) return;
            let statusColors = { 0: '#43a047', 1: '#e53935', 2: '#fb8c00' };
            $('#roomDetailHeader').css('background', statusColors[r.trangThai] || '#5c6bc0').css('color', '#fff');
            $('#detailRoomName').text(`Phòng ${r.soPhong} - ${r.trangThaiText}`);

            let html = `
                <div class="detail-row"><span class="detail-label">Chi nhánh:</span> <span class="detail-value">${r.tenChiNhanh}</span></div>
                <div class="detail-row"><span class="detail-label">Giá thuê:</span> <span class="detail-value text-danger font-weight-bold">${formatVND(r.giaThue)}/tháng</span></div>
                <div class="detail-row"><span class="detail-label">Diện tích:</span> <span class="detail-value">${r.dienTich} m²</span></div>
                <div class="detail-row"><span class="detail-label">Tầng:</span> <span class="detail-value">${r.tangLau}</span></div>
                <div class="detail-row"><span class="detail-label">Số người tối đa:</span> <span class="detail-value">${r.soNguoiToiDa}</span></div><hr>`;

            if (r.trangThai === 1 && r.tenNguoiThue) {
                html += `<h6 class="font-weight-bold"><i class="fas fa-user"></i> Thông tin người thuê</h6>
                    <div class="detail-row"><span class="detail-label">Họ tên:</span> <span class="detail-value">${r.tenNguoiThue}</span></div>
                    <div class="detail-row"><span class="detail-label">SĐT:</span> <span class="detail-value">${r.sdtNguoiThue || 'N/A'}</span></div>`;
                if (r.ngayHetHan) html += `<div class="detail-row"><span class="detail-label">Hết hạn HĐ:</span> <span class="detail-value">${new Date(r.ngayHetHan).toLocaleDateString('vi-VN')}</span></div>`;
                if (r.sapHetHan) html += `<div class="alert alert-warning mt-2 py-2"><i class="fas fa-hourglass-half"></i> <strong>Cảnh báo:</strong> Hợp đồng sắp hết hạn (còn ${r.soNgayConLai} ngày)!</div>`;
                if (r.coNoTien) html += `<div class="alert alert-danger mt-2 py-2"><i class="fas fa-exclamation-triangle"></i> <strong>Nợ tiền:</strong> Phòng này đang nợ <strong>${formatVND(r.soTienNo)}</strong>!</div>`;
            } else if (r.trangThai === 0) {
                html += `<div class="alert alert-success mt-2 py-2"><i class="fas fa-check-circle"></i> Phòng đang trống, sẵn sàng cho thuê.</div>`;
            } else if (r.trangThai === 2) {
                html += `<div class="alert alert-warning mt-2 py-2"><i class="fas fa-tools"></i> Phòng đang bảo trì.</div>`;
            }

            $('#roomDetailBody').html(html);
            $('#roomDetailModal').modal('show');
        }

        // ========== TABLE VIEW LOGIC ==========
        $(document).ready(function () {
            // DataTable
            table = $('#phongTroTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true, "autoWidth": false,
                "ajax": { "url": "/PhongTros/DanhSachPhongTro", "type": "GET", "datatype": "json" },
                "columns": [
                    { "data": null, "className": "text-center align-middle", "orderable": false, "searchable": false,
                        "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "tenChiNhanh", "className": "align-middle" },
                    { "data": "soPhong", "className": "align-middle", "render": d => `<span class="font-weight-bold text-primary">${d}</span>` },
                    { "data": "tangLau", "className": "text-center align-middle" },
                    { "data": "giaThue", "className": "text-end align-middle", "render": d => formatVND(d) },
                    { "data": "dienTich", "className": "text-center align-middle", "render": d => d + " m²" },
                    { "data": "trangThai", "className": "text-center align-middle",
                        "render": d => d === 0 ? '<span class="badge bg-success-lt text-success"><i class="fas fa-door-open me-1"></i> Trống</span>'
                                     : d === 1 ? '<span class="badge bg-blue-lt text-blue"><i class="fas fa-user-check me-1"></i> Đã Thuê</span>'
                                     : '<span class="badge bg-warning-lt text-warning"><i class="fas fa-tools me-1"></i> Bảo Trì</span>' },
                    { "data": "phongTroId", "className": "text-center align-middle", "width": "10%",
                        "render": id => `
                            <div class="btn-list flex-nowrap justify-content-center">
                                <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit" data-id="${id}" title="Sửa"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete" data-id="${id}" title="Xóa"><i class="fas fa-trash-alt"></i></button>
                            </div>
                        ` }
                ],
                "order": [[0, "desc"]]
            });

            // Table filter by Chi nhánh
            $('#filterChiNhanhTable').change(function () {
                table.column(1).search($(this).val()).draw();
            });

            // Load grid on start
            loadGridData();

            // Grid filters
            $('#filterChiNhanhGrid').change(function () { loadGridData(); });
            $('.filter-btn').click(function () {
                $('.filter-btn').removeClass('active');
                $(this).addClass('active');
                currentFilter = $(this).data('filter');
                renderGrid();
            });
            $('#searchRoom').on('input', function () { renderGrid(); });

            // Phát sinh phòng ngẫu nhiên
            $('#btnPhatSinhPhong').click(function () {
                let $btn = $(this);
                Swal.fire({
                    title: 'Phát sinh phòng ngẫu nhiên?',
                    text: 'Bạn muốn tự động phát sinh 10 phòng trọ ngẫu nhiên cho các chi nhánh hiện có?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang phát sinh...');
                        $.post('/PhongTros/PhatSinhNgauNhien', function (res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success');
                                loadGridData();
                                if (table) table.ajax.reload(null, false);
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                            }
                        }).fail(function() {
                            Swal.fire('Lỗi!', 'Lỗi hệ thống khi phát sinh phòng!', 'error');
                        }).always(function() {
                            $btn.prop('disabled', false).html('<i class="fas fa-magic"></i> Phát sinh 10 phòng ngẫu nhiên');
                        });
                    }
                });
            });

            // ========== SHARED CRUD ==========
            $('#btnOpenAddModal').on('click', function () {
                currentPhongTroId = 0;
                $('#ChiNhanhId').val(''); $('#SoPhong').val(''); $('#TangLau').val('1');
                $('#GiaThue').val(''); $('#DienTich').val(''); $('#SoNguoiToiDa').val('2');
                $('#TrangThai').val('0'); $('#MoTa').val('');
                $('#modalTitle').text('Thêm Phòng Trọ Mới');
                $('#btnSaveData').removeClass('btn-success').addClass('btn-primary').addClass('font-weight-bold').addClass('shadow-sm').html('<i class="fas fa-plus me-1"></i> Thêm dữ liệu');
                $('#phongTroModal').modal('show');
            });

            $('#btnSaveData').on('click', function () {
                let chiNhanhId = $('#ChiNhanhId').val();
                let soPhong = $('#SoPhong').val() || "";
                let giaThue = $('#GiaThue').val() || 0;
                if (!chiNhanhId) { showWarning("Vui lòng chọn chi nhánh!"); return; }
                if (soPhong.trim() === "") { showWarning("Vui lòng nhập số phòng!"); return; }
                if (giaThue <= 0) { showWarning("Giá thuê phải lớn hơn 0!"); return; }

                let isUpdate = currentPhongTroId > 0;
                let actionUrl = isUpdate ? '/PhongTros/CapNhatPhongTro' : '/PhongTros/ThemPhongTro';

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật thông tin phòng trọ này?' : 'Bạn có chắc chắn muốn thêm phòng trọ này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
                        $.ajax({
                            url: actionUrl,
                            type: 'POST',
                            data: {
                                PhongTroId: currentPhongTroId,
                                ChiNhanhId: chiNhanhId,
                                SoPhong: soPhong,
                                TangLau: $('#TangLau').val() || 0,
                                GiaThue: giaThue,
                                DienTich: $('#DienTich').val() || 0,
                                SoNguoiToiDa: $('#SoNguoiToiDa').val() || 0,
                                TrangThai: $('#TrangThai').val() || 0,
                                MoTa: $('#MoTa').val() || ""
                            },
                            success: function (res) {
                                if (res.success) {
                                    showSuccess(res.message);
                                    $('#phongTroModal').modal('hide');
                                    table.ajax.reload(null, false);
                                    loadGridData();
                                } else {
                                    showError("Lỗi: " + res.message);
                                }
                            },
                            error: function () {
                                showError("Không thể kết nối đến máy chủ!");
                            },
                            complete: function () {
                                if (isUpdate) {
                                    $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu dữ liệu');
                                } else {
                                    $btn.prop('disabled', false).html('<i class="fas fa-plus"></i> Thêm dữ liệu');
                                }
                            }
                        });
                    }
                });
            });

            // Table Edit
            $('#phongTroTable tbody').on('click', '.btn-edit', function () {
                let id = $(this).data('id');
                currentPhongTroId = id;
                let $btn = $(this), orig = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
                $.get('/PhongTros/GetPhongTro?id=' + id, function (res) {
                    if (res.success && res.data) {
                        let d = res.data;
                        $('#ChiNhanhId').val(d.chiNhanhId); $('#SoPhong').val(d.soPhong);
                        $('#TangLau').val(d.tangLau); $('#GiaThue').val(d.giaThue);
                        $('#DienTich').val(d.dienTich); $('#SoNguoiToiDa').val(d.soNguoiToiDa);
                        $('#TrangThai').val(d.trangThai); $('#MoTa').val(d.moTa);
                        $('#modalTitle').text('Chỉnh sửa: Phòng ' + (d.soPhong || ""));
                        $('#btnSaveData').removeClass('btn-primary').addClass('btn-success').addClass('font-weight-bold').addClass('shadow-sm').html('<i class="fas fa-save me-1"></i> Lưu dữ liệu');
                        $('#phongTroModal').modal('show');
                    } else showError("Lỗi: " + (res.message || "Không tải được."));
                    $btn.prop('disabled', false).html(orig);
                });
            });

            // Table Delete
            $('#phongTroTable tbody').on('click', '.btn-delete', function () {
                let id = $(this).data('id'), $btn = $(this);
                Swal.fire({
                    title: 'Xác nhận xóa phòng?',
                    text: 'Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa phòng này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let orig = $btn.html();
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
                        $.post('/PhongTros/XoaPhongTro', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success');
                                table.ajax.reload(null, false);
                                loadGridData();
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                                $btn.prop('disabled', false).html(orig);
                            }
                        }).fail(function() {
                            Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
                            $btn.prop('disabled', false).html(orig);
                        });
                    }
                });
            });
        });
    </script>
}