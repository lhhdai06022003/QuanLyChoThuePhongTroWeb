@{
    ViewData["Title"] = "Chốt Chỉ Số Điện/Nước Hàng Tháng";
}

<link rel="stylesheet" href="~/css/diennuoc.css" asp-append-version="true" />
<style>
    /* Đồng bộ màu nền bộ lọc trong chế độ tối */
    html[data-bs-theme="dark"] .bg-light,
    [data-bs-theme="dark"] .bg-light {
        background-color: var(--tblr-bg-surface-secondary, #1b2434) !important;
        color: var(--tblr-body-color, #f4f6fa) !important;
    }
    html[data-bs-theme="dark"] .border-bottom,
    [data-bs-theme="dark"] .border-bottom {
        border-color: rgba(255, 255, 255, 0.15) !important;
    }
</style>

<div class="container-xl mt-3">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold d-flex align-items-center">
                    <i class="fas fa-bolt me-1 text-warning"></i> <i class="fas fa-tint me-2 text-info"></i> Chốt Chỉ Số Điện/Nước Hàng Tháng
                </h2>
            </div>
        </div>
    </div>

    <!-- Unified Card Layout -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header d-flex justify-content-between align-items-center py-3 border-bottom">
            <h3 class="card-title font-weight-bold mb-0">
                <i class="fas fa-list me-2 text-primary"></i> Danh sách ghi nhận chỉ số
            </h3>
            <div class="ms-auto" id="saveActionArea" style="display: none;">
                <button type="button" class="btn btn-success font-weight-bold shadow-sm" id="btnSaveData">
                    <i class="fas fa-save me-1"></i> Lưu tất cả chỉ số
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <!-- Filter Bar inside Card (Horizontal Toolbar) -->
            <div class="p-3 border-bottom bg-light">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small font-weight-bold text-secondary mb-1">Chi Nhánh <span class="text-danger">*</span></label>
                        <select id="filterChiNhanh" class="form-select">
                            <option value="">-- Chọn chi nhánh --</option>
                            @if (ViewBag.ListChiNhanh != null)
                            {
                                foreach (var cn in ViewBag.ListChiNhanh)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small font-weight-bold text-secondary mb-1">Tháng <span class="text-danger">*</span></label>
                        <select id="filterThang" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (i == DateTime.Now.Month)
                                {
                                    <option value="@i" selected>Tháng @i</option>
                                }
                                else
                                {
                                    <option value="@i">Tháng @i</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small font-weight-bold text-secondary mb-1">Năm <span class="text-danger">*</span></label>
                        <input type="number" id="filterNam" class="form-control" value="@DateTime.Now.Year" min="2000">
                    </div>
                </div>
            </div>

            <!-- Empty State Container -->
            <div id="emptyState" class="text-center py-5">
                <i class="fas fa-building fa-3x text-muted mb-3" style="opacity: 0.5;"></i>
                <p class="text-muted font-weight-medium">Vui lòng chọn <strong>Chi nhánh</strong> để bắt đầu ghi nhận chỉ số điện nước.</p>
            </div>

            <!-- Table Container (Initially Hidden) -->
            <div id="tableContainer" style="display: none;" class="p-3">
                <div class="alert alert-info py-2 mb-3">
                    <i class="fas fa-info-circle me-1"></i> 
                    <strong>Hướng dẫn:</strong> Nhập chỉ số điện và nước mới. Chỉ số cũ ở trạng thái chỉ đọc. Bấm các phím <code>Enter</code> hoặc phím <code>Mũi tên lên/xuống</code> để tự động chuyển ô nhập liệu cực kỳ nhanh chóng.
                </div>
                <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap datatable w-100" id="dienNuocTable">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%">STT</th>
                                <th>Phòng</th>
                                <th>Người Đại Diện</th>
                                <th class="text-center bg-warning-light-td" width="12%">Chỉ số Điện Cũ</th>
                                <th class="text-center bg-danger-light-td" width="15%">Chỉ số Điện Mới</th>
                                <th class="text-center bg-info-light-td" width="12%">Chỉ số Nước Cũ</th>
                                <th class="text-center bg-primary-light-td" width="15%">Chỉ số Nước Mới</th>
                                <th class="text-center" width="12%">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDienNuoc">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sticky Bottom Action Bar -->
<div class="fixed-bottom bg-body border-top shadow-lg py-3 px-4 d-flex align-items-center justify-content-between d-print-none" id="stickyActionBar" style="z-index: 1050;">
    <div class="d-flex align-items-center">
        <span class="badge bg-yellow-lt text-warning me-2"><i class="fas fa-exclamation-triangle"></i></span>
        <span class="font-weight-medium">Bạn có chỉ số mới chưa được lưu lại vào hệ thống.</span>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary px-4" id="btnCancelChanges">Hủy bỏ</button>
        <button type="button" class="btn btn-success px-4 font-weight-bold" id="btnSaveDataSticky">
            <i class="fas fa-save me-1"></i> Lưu thay đổi ngay
        </button>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentData = [];
            let table = null;

            // Đọc query params (nếu có, VD click từ Dashboard qua)
            const urlParams = new URLSearchParams(window.location.search);
            let hasQueryParams = false;
            
            if (urlParams.has('chiNhanhId')) {
                $('#filterChiNhanh').val(urlParams.get('chiNhanhId'));
                hasQueryParams = true;
            }
            if (urlParams.has('thang')) {
                $('#filterThang').val(urlParams.get('thang'));
                hasQueryParams = true;
            }
            if (urlParams.has('nam')) {
                $('#filterNam').val(urlParams.get('nam'));
                hasQueryParams = true;
            }

            // Nếu có param thì tự động load data luôn
            if (hasQueryParams) {
                setTimeout(function() {
                    loadData();
                }, 100);
            }

            // Auto-tab navigation between input fields using Enter and Arrow keys
            $('#tbodyDienNuoc').on('keydown', '.in-dien-moi, .in-nuoc-moi', function (e) {
                const key = e.key;
                const isDien = $(this).hasClass('in-dien-moi');
                const targetClass = isDien ? '.in-dien-moi' : '.in-nuoc-moi';
                const tr = $(this).closest('tr');
                let targetTr = null;

                if (key === 'Enter' || key === 'ArrowDown') {
                    e.preventDefault();
                    // Find the next available unlocked row
                    let nextRows = tr.nextAll('tr');
                    for (let i = 0; i < nextRows.length; i++) {
                        let nextTr = $(nextRows[i]);
                        if (!nextTr.hasClass('row-locked')) {
                            targetTr = nextTr;
                            break;
                        }
                    }
                } else if (key === 'ArrowUp') {
                    e.preventDefault();
                    // Find the previous available unlocked row
                    let prevRows = tr.prevAll('tr');
                    for (let i = 0; i < prevRows.length; i++) {
                        let prevTr = $(prevRows[i]);
                        if (!prevTr.hasClass('row-locked')) {
                            targetTr = prevTr;
                            break;
                        }
                    }
                } else if (key === 'ArrowRight' && isDien) {
                    e.preventDefault();
                    tr.find('.in-nuoc-moi').focus().select();
                } else if (key === 'ArrowLeft' && !isDien) {
                    e.preventDefault();
                    tr.find('.in-dien-moi').focus().select();
                }

                if (targetTr) {
                    targetTr.find(targetClass).focus().select();
                }
            });

            // Auto-load trigger when filters change
            $('#filterChiNhanh, #filterThang, #filterNam').on('change', function () {
                loadData();
            });

            function loadData() {
                let chiNhanhId = $('#filterChiNhanh').val();
                let thang = $('#filterThang').val();
                let nam = $('#filterNam').val();

                if (!chiNhanhId) {
                    $('#emptyState').show();
                    $('#tableContainer').hide();
                    $('#saveActionArea').hide();
                    hideStickyBar();
                    return;
                }

                $('#emptyState').hide();
                $('#tableContainer').show();
                $('#tbodyDienNuoc').html('<tr><td colspan="8" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary mb-2"></i><div>Đang tải dữ liệu...</div></td></tr>');
                hideStickyBar();

                $.ajax({
                    url: '/DienNuoc/GetDanhSachPhongs',
                    type: 'GET',
                    data: { chiNhanhId: chiNhanhId, thang: thang, nam: nam },
                    success: function (res) {
                        currentData = res;
                        renderTable(res);
                        $('#saveActionArea').show();
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi tải dữ liệu',
                            text: xhr.responseJSON?.message || 'Có lỗi xảy ra khi tải dữ liệu.'
                        });
                        $('#tableContainer').hide();
                        $('#emptyState').show();
                        $('#saveActionArea').hide();
                    }
                });
            }

            function renderTable(data) {
                // Hủy DataTable nếu đang có để vẽ lại
                if ($.fn.DataTable.isDataTable('#dienNuocTable')) {
                    $('#dienNuocTable').DataTable().destroy();
                }

                let html = '';
                if (data.length === 0) {
                    html = '<tr><td colspan="8" class="text-center text-muted py-4">Không có phòng nào đang thuê tại chi nhánh này.</td></tr>';
                } else {
                    data.forEach((item, index) => {
                        let statusBadge = '';
                        let rowClass = '';
                        let disabledAttr = '';
                        
                        if (item.isLocked) {
                            statusBadge = '<span class="badge bg-danger-lt text-danger"><i class="fas fa-lock me-1"></i> Đã khóa</span>';
                            rowClass = 'row-locked';
                            disabledAttr = 'disabled';
                        } else if (item.isDaChot) {
                            statusBadge = '<span class="badge bg-success-lt text-success"><i class="fas fa-check-circle me-1"></i> Đã chốt</span>';
                        } else {
                            statusBadge = '<span class="badge bg-secondary-lt text-secondary"><i class="fas fa-clock me-1"></i> Chưa chốt</span>';
                        }
                        
                        let defaultDienMoi = (item.chiSoDienMoi === 0 && !item.isDaChot) ? item.chiSoDienCu : item.chiSoDienMoi;
                        let defaultNuocMoi = (item.chiSoNuocMoi === 0 && !item.isDaChot) ? item.chiSoNuocCu : item.chiSoNuocMoi;

                        html += `
                            <tr data-index="${index}" class="${rowClass}">
                                <td class="text-center align-middle">${index + 1}</td>
                                <td class="align-middle font-weight-bold">${item.tenPhong}</td>
                                <td class="align-middle">${item.tenNguoiDaiDien}</td>
                                <td class="text-center align-middle bg-warning-light-td diennuoc-input-td">
                                    <input type="number" class="form-control text-center in-dien-cu" value="${item.chiSoDienCu}" readonly>
                                </td>
                                <td class="text-center align-middle bg-danger-light-td diennuoc-input-td">
                                    <input type="number" class="form-control text-center text-danger font-weight-bold in-dien-moi" value="${defaultDienMoi}" min="0" ${disabledAttr}>
                                    <div class="invalid-feedback text-center small" style="display: none;">Mới phải ≥ Cũ</div>
                                </td>
                                <td class="text-center align-middle bg-info-light-td diennuoc-input-td">
                                    <input type="number" class="form-control text-center in-nuoc-cu" value="${item.chiSoNuocCu}" readonly>
                                </td>
                                <td class="text-center align-middle bg-primary-light-td diennuoc-input-td">
                                    <input type="number" class="form-control text-center text-primary font-weight-bold in-nuoc-moi" value="${defaultNuocMoi}" min="0" ${disabledAttr}>
                                    <div class="invalid-feedback text-center small" style="display: none;">Mới phải ≥ Cũ</div>
                                </td>
                                <td class="text-center align-middle">${statusBadge}</td>
                            </tr>
                        `;
                    });
                }
                
                $('#tbodyDienNuoc').html(html);

                // Khởi tạo lại DataTable (Giữ cuộn dọc, chỉ tìm kiếm và sắp xếp)
                if (data.length > 0) {
                    table = $('#dienNuocTable').DataTable({
                        "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                        "paging": false,
                        "ordering": true,
                        "searching": true,
                        "info": false,
                        "autoWidth": false,
                        "columnDefs": [
                            { "orderable": false, "targets": [0, 3, 4, 5, 6, 7] } // Không sort trên STT, các cột chỉ số và trạng thái
                        ]
                    });
                    
                    // Tự động căn chỉnh lại độ rộng cột của header sau khi vẽ để thẳng hàng tuyệt đối với body
                    setTimeout(function() {
                        if (table) {
                            table.columns.adjust().draw();
                        }
                    }, 50);
                }
            }

            // Real-time validation viền đỏ khi nhập sai chỉ số điện mới
            $('#tbodyDienNuoc').on('input change', '.in-dien-moi', function () {
                let tr = $(this).closest('tr');
                let cu = parseFloat(tr.find('.in-dien-cu').val()) || 0;
                let moi = parseFloat($(this).val()) || 0;

                if (moi < cu || moi < 0) {
                    $(this).addClass('is-invalid');
                    tr.find('.in-dien-moi').siblings('.invalid-feedback').show();
                } else {
                    $(this).removeClass('is-invalid');
                    tr.find('.in-dien-moi').siblings('.invalid-feedback').hide();
                }
            });

            // Real-time validation viền đỏ khi nhập sai chỉ số nước mới
            $('#tbodyDienNuoc').on('input change', '.in-nuoc-moi', function () {
                let tr = $(this).closest('tr');
                let cu = parseFloat(tr.find('.in-nuoc-cu').val()) || 0;
                let moi = parseFloat($(this).val()) || 0;

                if (moi < cu || moi < 0) {
                    $(this).addClass('is-invalid');
                    tr.find('.in-nuoc-moi').siblings('.invalid-feedback').show();
                } else {
                    $(this).removeClass('is-invalid');
                    tr.find('.in-nuoc-moi').siblings('.invalid-feedback').hide();
                }
            });

            // Detect changes in inputs to toggle sticky bottom bar
            function checkForChanges() {
                let hasChanges = false;
                $('#tbodyDienNuoc tr').not('.row-locked').each(function () {
                    let index = $(this).data('index');
                    if (index !== undefined) {
                        let rowData = currentData[index];
                        let defaultDienMoi = (rowData.chiSoDienMoi === 0 && !rowData.isDaChot) ? rowData.chiSoDienCu : rowData.chiSoDienMoi;
                        let defaultNuocMoi = (rowData.chiSoNuocMoi === 0 && !rowData.isDaChot) ? rowData.chiSoNuocCu : rowData.chiSoNuocMoi;

                        let currentDienMoi = parseFloat($(this).find('.in-dien-moi').val()) || 0;
                        let currentNuocMoi = parseFloat($(this).find('.in-nuoc-moi').val()) || 0;

                        if (currentDienMoi !== defaultDienMoi || currentNuocMoi !== defaultNuocMoi) {
                            hasChanges = true;
                            return false; // break loop
                        }
                    }
                });

                if (hasChanges) {
                    showStickyBar();
                } else {
                    hideStickyBar();
                }
            }

            function showStickyBar() {
                $('#stickyActionBar').addClass('show-bar');
            }

            function hideStickyBar() {
                $('#stickyActionBar').removeClass('show-bar');
            }

            $('#tbodyDienNuoc').on('input change', '.in-dien-moi, .in-nuoc-moi', function () {
                checkForChanges();
            });

            // Reset changes
            $('#btnCancelChanges').on('click', function () {
                renderTable(currentData);
                hideStickyBar();
            });

            // Save Data
            $('#btnSaveData, #btnSaveDataSticky').on('click', function () {
                saveAllData();
            });

            function saveAllData() {
                if (currentData.length === 0) return;

                let chiNhanhId = $('#filterChiNhanh').val();
                let thang = $('#filterThang').val();
                let nam = $('#filterNam').val();

                let danhSachPhong = [];
                let hasError = false;

                // Lấy tất cả hàng trong DataTable (kể cả những hàng đang bị ẩn do search)
                let rows = table ? table.rows().nodes().to$() : $('#tbodyDienNuoc tr');

                rows.each(function () {
                    let index = $(this).data('index');
                    if (index !== undefined) {
                        let rowData = currentData[index];
                        
                        // Bỏ qua nếu dòng này đã bị khóa
                        if (rowData.isLocked) return;

                        let dienCu = parseFloat($(this).find('.in-dien-cu').val()) || 0;
                        let dienMoi = parseFloat($(this).find('.in-dien-moi').val()) || 0;
                        let nuocCu = parseFloat($(this).find('.in-nuoc-cu').val()) || 0;
                        let nuocMoi = parseFloat($(this).find('.in-nuoc-moi').val()) || 0;

                        if (dienMoi < 0 || nuocMoi < 0) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Chỉ số không hợp lệ',
                                text: `Phòng ${rowData.tenPhong}: Chỉ số điện/nước mới không được âm.`
                            });
                            hasError = true;
                            return false; // break each
                        }

                        if (dienMoi < dienCu) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Chỉ số điện sai lệch',
                                text: `Phòng ${rowData.tenPhong}: Chỉ số điện mới (${dienMoi}) không được nhỏ hơn chỉ số điện cũ (${dienCu}).`
                            });
                            hasError = true;
                            $(this).find('.in-dien-moi').addClass('is-invalid');
                            return false; // break each
                        }

                        if (nuocMoi < nuocCu) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Chỉ số nước sai lệch',
                                text: `Phòng ${rowData.tenPhong}: Chỉ số nước mới (${nuocMoi}) không được nhỏ hơn chỉ số nước cũ (${nuocCu}).`
                            });
                            hasError = true;
                            $(this).find('.in-nuoc-moi').addClass('is-invalid');
                            return false; // break each
                        }

                        danhSachPhong.push({
                            dichVuDienNuocCuaPhongId: rowData.dichVuDienNuocCuaPhongId,
                            phongTroId: rowData.phongTroId,
                            chiSoDienCu: dienCu,
                            chiSoDienMoi: dienMoi,
                            chiSoNuocCu: nuocCu,
                            chiSoNuocMoi: nuocMoi
                        });
                    }
                });

                if (hasError) return;

                if (danhSachPhong.length === 0) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Thông báo',
                        text: 'Tất cả các phòng trong danh sách đã bị khóa hoặc không có chỉ số mới cần lưu.'
                    });
                    return;
                }

                let payload = {
                    chiNhanhId: parseInt(chiNhanhId),
                    thang: parseInt(thang),
                    nam: parseInt(nam),
                    danhSachPhong: danhSachPhong
                };

                let $btn = $('#btnSaveData');
                let $btnSticky = $('#btnSaveDataSticky');
                let originalHtml = $btn.html();
                let originalStickyHtml = $btnSticky.html();

                Swal.fire({
                    title: 'Xác nhận chốt chỉ số?',
                    text: `Bạn có chắc chắn muốn chốt và lưu chỉ số điện/nước cho các phòng của tháng ${thang}/${nam}?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...');
                        $btnSticky.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...');

                        $.ajax({
                            url: '/DienNuoc/SaveChotDienNuoc',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: function (res) {
                                showSuccess(res.message).then(() => {
                                    loadData();
                                });
                            },
                            error: function (xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu chỉ số.');
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html(originalHtml);
                                $btnSticky.prop('disabled', false).html(originalStickyHtml);
                            }
                        });
                    }
                });
            }
        });
    </script>
}
