@{
    ViewData["Title"] = "Hệ thống Quản lý Hóa đơn - Tính tiền tự động";
}

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="fas fa-file-invoice-dollar"></i> Danh sách Hóa đơn & Tiền phòng</h3>
                <button type="button" class="btn btn-success btn-sm ml-auto" id="btnOpenChotTienModal">
                    <i class="fas fa-calculator"></i> Tính Tiền Phòng Thường Niên
                </button>
            </div>
            <div class="card-body">
                <table id="hoaDonTable" class="table table-bordered table-striped table-hover w-100">
                    <thead class="thead-light">
                        <tr>
                            <th width="5%" class="text-center">STT</th>
                            <th width="15%">Mã Hóa Đơn</th>
                            <th width="10%">Số Phòng</th>
                            <th width="20%">Đại Diện Thuê</th>
                            <th width="12%">Kỳ Hóa Đơn</th>
                            <th width="15%">Tổng Tiền (VND)</th>
                            <th width="13%">Trạng Thái</th>
                            <th width="10%" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="chotTienModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title text-white"><i class="fas fa-calculator"></i> Tính Tiền & Chốt Chỉ Số Phòng</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form id="frmChotTien">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Chọn Phòng Cần Tính <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="txtPhongId" required placeholder="Nhập ID Phòng Trọ...">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Tháng Tính Toán</label>
                                <select class="form-control" id="txtThang">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == DateTime.Now.Month)">Tháng @i</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Năm Tính Toán</label>
                                <input type="number" class="form-control" id="txtNam" value="@DateTime.Now.Year">
                            </div>
                        </div>
                    </div>
                    <hr>
                    <h6 class="text-primary font-weight-bold"><i class="fas fa-bolt"></i> Chỉ số Điện (VND/kWh)</h6>
                    <div class="row">
                        <div class="col-md-4"><div class="form-group"><label>Số Cũ</label><input type="number" class="form-control" id="DienCu" value="0"></div></div>
                        <div class="col-md-4"><div class="form-group"><label>Số Mới</label><input type="number" class="form-control" id="DienMoi"></div></div>
                        <div class="col-md-4"><div class="form-group"><label>Đơn Giá</label><input type="number" class="form-control" id="GiaDien" value="3500"></div></div>
                    </div>
                    <h6 class="text-info font-weight-bold"><i class="fas fa-water"></i> Chỉ số Nước (VND/m³)</h6>
                    <div class="row">
                        <div class="col-md-4"><div class="form-group"><label>Số Cũ</label><input type="number" class="form-control" id="NuocCu" value="0"></div></div>
                        <div class="col-md-4"><div class="form-group"><label>Số Mới</label><input type="number" class="form-control" id="NuocMoi"></div></div>
                        <div class="col-md-4"><div class="form-group"><label>Đơn Giá</label><input type="number" class="form-control" id="GiaNuoc" value="15000"></div></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="btnSaveChotTien"><i class="fas fa-check"></i> Tạo Hóa Đơn</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailHoaDonModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"><i class="fas fa-file-invoice"></i> Phiếu Chi Tiết Hóa Đơn Tiền Phòng</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="printArea">
                <div class="text-center">
                    <h5>PHIẾU THU TIỀN PHÒNG KHÁCH SẠN / NHÀ TRỌ</h5>
                    <p class="font-italic text-muted">Kỳ hóa đơn: <span id="lblKyHD"></span> - Mã số: <span id="lblMaHD"></span></p>
                </div>
                <table class="table table-sm table-borderless table-responsive-md">
                    <tr><td><strong>Số Phòng:</strong> <span id="lblSoPhong"></span></td><td><strong>Khách thuê đại diện:</strong> <span id="lblKhachHang"></span></td></tr>
                    <tr><td><strong>Số Điện thoại:</strong> <span id="lblSdt"></span></td><td><strong>Trạng thái:</strong> <span id="lblTrangThai"></span></td></tr>
                </table>
                <table class="table table-bordered table-striped">
                    <thead class="thead-light">
                        <tr><th>Tên Chi Phí / Dịch vụ</th><th>Chỉ số Cũ</th><th>Chỉ số Mới</th><th>Tiêu thụ</th><th>Đơn giá</th><th>Thành Tiền</th></tr>
                    </thead>
                    <tbody id="invoiceItems">
                    </tbody>
                </table>

                <div class="row mt-4 align-items-center">
                    <div class="col-md-6 text-center">
                        <p class="font-weight-bold mb-1"><i class="fas fa-qrcode"></i> Quét Mã QR Để Thanh Toán</p>
                        <img id="imgVietQR" src="" alt="Mã chuyển khoản VietQR tự động" class="img-fluid border p-2 bg-white shadow-sm" style="max-width:230px;">
                        <p class="small text-muted font-italic mt-1">Hệ thống VietQR tự động điền STK & Số tiền.</p>
                    </div>
                    <div class="col-md-6 text-right">
                        <h4>TỔNG TIỀN: <span class="text-danger font-weight-bold" id="lblTongTien"></span> VND</h4>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning" id="btnMarkAsPaid"><i class="fas fa-cash-register"></i> Xác nhận Đã Thu Tiền</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let selectedHoaDonId = 0;

            // 1. Nạp danh sách hóa đơn bằng Datatable AJAX
            var table = $('#hoaDonTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "ajax": { "url": "/QuanLyNhaTro/HoaDon/GetAll", "type": "GET", "dataSrc": "" },
                "columns": [
                    { "data": null, "className": "text-center align-middle", "render": function (d, t, r, meta) { return meta.row + 1; } },
                    { "data": "maHoaDon", "className": "font-weight-bold align-middle" },
                    { "data": "soPhong", "className": "text-primary font-weight-bold align-middle" },
                    { "data": "tenKhach", "className": "align-middle" },
                    { "data": "thoiGian", "className": "align-middle" },
                    {
                        "data": "tongTien",
                        "className": "font-weight-bold text-right align-middle",
                        "render": function(data) { return data.toLocaleString('vi-VN'); }
                    },
                    {
                        "data": "trangThaiHoaDon",
                        "className": "text-center align-middle",
                        "render": function(data) {
                            return data === 1
                                ? `<span class="badge badge-success p-2"><i class="fas fa-check"></i> Đã thanh toán</span>`
                                : `<span class="badge badge-danger p-2"><i class="fas fa-clock"></i> Chưa thanh toán</span>`;
                        }
                    },
                    {
                        "data": "hoaDonId",
                        "className": "text-center align-middle",
                        "render": function (data) {
                            return `<button class="btn btn-info btn-sm btn-view-invoice" data-id="${data}" title="Xem phiếu thu"><i class="fas fa-eye"></i> Phiếu Thu</button>`;
                        }
                    }
                ]
            });

            // 2. Khi chủ trọ nhập ID phòng, tự động gọi Ajax lấy số điện nước Cũ của tháng trước điền vào form
            $('#txtPhongId').on('change', function() {
                let idPhong = $(this).val();
                if(idPhong) {
                    $.get('/QuanLyNhaTro/HoaDon/GetChiSoCu/' + idPhong, function(res) {
                        $('#DienCu').val(res.dienCu);
                        $('#NuocCu').val(res.nuocCu);
                    });
                }
            });

            // 3. Sự kiện bấm nút Tạo hóa đơn tính tiền tự động
            $('#btnSaveChotTien').on('click', function() {
                let data = {
                    phongTroId: parseInt($('#txtPhongId').val()),
                    thang: parseInt($('#txtThang').val()),
                    nam: parseInt($('#txtNam').val()),
                    chiSoDienCu: parseFloat($('#DienCu').val()),
                    chiSoDienMoi: parseFloat($('#DienMoi').val()),
                    donGiaDien: parseFloat($('#GiaDien').val()),
                    chiSoNuocCu: parseFloat($('#NuocCu').val()),
                    chiSoNuocMoi: parseFloat($('#NuocMoi').val()),
                    donGiaNuoc: parseFloat($('#GiaNuoc').val())
                };

                if(!data.phongTroId || !data.chiSoDienMoi || !data.chiSoNuocMoi) {
                    alert("Vui lòng điền đầy đủ thông tin chỉ số điện nước mới!");
                    return;
                }

                $.ajax({
                    url: '/QuanLyNhaTro/HoaDon/ChotTien',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        if(res.success) {
                            alert(res.message);
                            $('#chotTienModal').modal('hide');
                            table.ajax.reload();
                        } else { alert(res.message); }
                    }
                });
            });

            // 4. Bấm xem phiếu thu chi tiết (Tự nạp bảng chi tiết và ảnh QR động VietQR)
            $('#hoaDonTable tbody').on('click', '.btn-view-invoice', function () {
                selectedHoaDonId = $(this).data('id');
                $.get('/QuanLyNhaTro/HoaDon/Details/' + selectedHoaDonId, function(res) {
                    let d = res.data;
                    $('#lblMaHD').text(d.maHoaDon);
                    $('#lblKyHD').text(d.thangNam);
                    $('#lblSoPhong').text(d.soPhong);
                    $('#lblKhachHang').text(d.tenKhach);
                    $('#lblSdt').text(d.sdt);
                    $('#lblTongTien').text(d.tongTien.toLocaleString('vi-VN'));
                    $('#lblTrangThai').html(d.trangThaiHoaDon === 1 ? '<span class="text-success">Đã đóng tiền</span>' : '<span class="text-danger">Chưa đóng tiền</span>');

                    // Gán link ảnh mã QR động từ API vào thẻ img
                    $('#imgVietQR').attr('src', res.qrUrl);

                    // Xây dựng bảng tính tiền chi tiết
                    let html = `
                        <tr><td>Tiền Thuê Phòng (Cơ bản)</td><td>-</td><td>-</td><td>1 tháng</td><td>${d.tienPhong.toLocaleString('vi-VN')}</td><td>${d.tienPhong.toLocaleString('vi-VN')}</td></tr>
                        <tr><td>Tiền Điện sinh hoạt</td><td>${d.dienCu}</td><td>${d.dienMoi}</td><td>${d.dienMoi - d.dienCu} kWh</td><td>${d.donGiaDien}</td><td>${d.tienDien.toLocaleString('vi-VN')}</td></tr>
                        <tr><td>Tiền Nước sinh hoạt</td><td>${d.nuocCu}</td><td>${d.nuocMoi}</td><td>${d.nuocMoi - d.nuocCu} m³</td><td>${d.donGiaNuoc}</td><td>${d.tienNuoc.toLocaleString('vi-VN')}</td></tr>
                    `;
                    // Nạp các dịch vụ đăng ký thêm (wifi, rác...)
                    d.dichVuKhac.forEach(item => {
                        html += `<tr><td>${item.tenDichVu}</td><td>-</td><td>-</td><td>${item.soLuong}</td><td>${item.gia.toLocaleString('vi-VN')}</td><td>${item.thanhTien.toLocaleString('vi-VN')}</td></tr>`;
                    });

                    $('#invoiceItems').html(html);

                    if(d.trangThaiHoaDon === 1) { $('#btnMarkAsPaid').hide(); } else { $('#btnMarkAsPaid').show(); }
                    $('#detailHoaDonModal').modal('show');
                });
            });

            // 5. Xác nhận đã thu tiền đóng hóa đơn
            $('#btnMarkAsPaid').on('click', function() {
                if(confirm("Bạn có chắc chắn tài khoản này đã thanh toán hóa đơn này không?")) {
                    $.post(`/QuanLyNhaTro/HoaDon/XacNhanThanhToan/${selectedHoaDonId}?trangThai=1`, function(res) {
                        alert(res.message);
                        $('#detailHoaDonModal').modal('hide');
                        table.ajax.reload();
                    });
                }
            });

            // Mở modal thêm mới
            $('#btnOpenChotTienModal').on('click', function () {
                $('#frmChotTien')[0].reset();
                $('#chotTienModal').modal('show');
            });
        });
    </script>
}