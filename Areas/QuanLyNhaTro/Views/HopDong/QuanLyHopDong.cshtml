
@using QuanLyChoThuePhongTroWeb.Models
@{
    ViewData["Title"] = "Quản lý Hợp Đồng";
    // Ép kiểu dữ liệu ViewBag sang JSON để xài trong Javascript với CamelCase
    var jsonPhongTros = Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListPhongTro, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
}
<link rel="stylesheet" href="~/css/hopdong.css" asp-append-version="true" />
<style>
    /* Đồng bộ màu nền bộ lọc trong chế độ tối */
    html[data-bs-theme="dark"] .bg-light,
    [data-bs-theme="dark"] .bg-light {
        background-color: var(--tblr-bg-surface-secondary, #1b2434) !important;
        color: var(--tblr-body-color, #f4f6fa) !important;
    }
    html[data-bs-theme="dark"] .border-dashed,
    [data-bs-theme="dark"] .border-dashed {
        border-color: rgba(255, 255, 255, 0.15) !important;
    }
</style>
<div class="container-xl mt-3">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold">
                    <i class="fas fa-file-contract me-2"></i> Quản lý & Danh sách Hợp Đồng
                </h2>
            </div>
            <div class="col-auto ms-auto">
                <button type="button" class="btn btn-success font-weight-bold shadow-sm" id="btnOpenAddModal">
                    <i class="fas fa-plus-circle me-1"></i> Tạo Hợp Đồng Mới
                </button>
            </div>
        </div>
    </div>

    <!-- Card quản lý & danh sách hợp đồng -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <!-- Khu vực Bộ lọc dạng hàng ngang -->
            <div class="bg-light p-3 border border-dashed rounded-3 mb-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-building me-1"></i> Chi Nhánh
                        </label>
                        <select id="filterChiNhanh" class="form-select form-select-sm">
                            <option value="0">-- Tất cả --</option>
                            @if (ViewBag.ListChiNhanh != null)
                            {
                                foreach (var cn in ViewBag.ListChiNhanh)
                                {
                                    <option value="@cn.Value">@cn.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-user me-1"></i> Người Thuê
                        </label>
                        <select id="filterNguoiThue" class="form-select form-select-sm">
                            <option value="0">-- Tất cả --</option>
                            @if (ViewBag.ListNguoiThue != null)
                            {
                                foreach (var nt in ViewBag.ListNguoiThue)
                                {
                                    <option value="@nt.Value">@nt.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-calendar-alt me-1"></i> Thời hạn hợp đồng
                        </label>
                        <input type="text" class="form-control form-control-sm" id="filterDateRange" placeholder="Chọn khoảng thời gian...">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label font-weight-bold text-secondary mb-1">
                            <i class="fas fa-info-circle me-1"></i> Trạng thái
                        </label>
                        <select id="filterTrangThai" class="form-select form-select-sm">
                            <option value="0">-- Tất cả --</option>
                            <option value="1">Đang hoạt động</option>
                            <option value="2">Đã kết thúc</option>
                            <option value="3">Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-primary btn-sm w-100 font-weight-bold" id="btnFilter" style="height: 36px;">
                            <i class="fas fa-search me-1"></i> Lọc
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="hopDongTable" class="table card-table table-vcenter table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th class="text-center" width="5%">STT</th>
                            <th>Mã HĐ</th>
                            <th>Phòng</th>
                            <th>Người Đại Diện</th>
                            <th>Ngày Bắt Đầu</th>
                            <th>Tiền Thuê/Tháng</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="hopDongModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title font-weight-bold" id="modalTitle">Thêm Hợp Đồng Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <!-- Stepper Progress Bar -->
                <div class="steps steps-counter steps-blue mb-4" id="hopDongStepper">
                    <span class="step-item active" data-step="1" id="step-tab-thongtin">Thông tin chung</span>
                    <span class="step-item" data-step="2" id="step-tab-dichvu">Dịch vụ đăng ký</span>
                    <span class="step-item" data-step="3" id="stepHeaderThanhVien" style="display:none;">Thành viên ở ghép</span>
                </div>

                <div class="tab-content mt-3">
                    <!-- Tab 1: Thông tin hợp đồng -->
                    <div class="tab-pane fade show active" id="content-thongtin" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="MaHopDong" class="form-label">Mã Hợp Đồng</label>
                                    <input type="text" class="form-control" id="MaHopDong" readonly 
                                           placeholder="Hệ thống tự sinh khi lưu" 
                                           style="background-color: #f4f6f9; font-weight: bold; color: #206bc4;">
                                </div>

                                <div class="mb-3">
                                    <label for="ChiNhanhId" class="form-label">Chi Nhánh <span class="text-danger">*</span></label>
                                    <select class="form-select" id="ChiNhanhId">
                                        <option value="">-- Chọn chi nhánh --</option>
                                        @if (ViewBag.ListChiNhanh != null)
                                        {
                                            foreach (var cn in ViewBag.ListChiNhanh)
                                            {
                                                <option value="@cn.Value">@cn.Text</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="PhongTroId" class="form-label">Phòng Trọ <span class="text-danger">*</span></label>
                                    <select class="form-select" id="PhongTroId">
                                        <option value="">-- Vui lòng chọn chi nhánh trước --</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="NguoiThueId" class="form-label">Người Đại Diện <span class="text-danger">*</span></label>
                                    <select class="form-control select2" id="NguoiThueId" style="width: 100%;">
                                        <option value="">-- Chọn khách thuê --</option>
                                        @if (ViewBag.ListNguoiThue != null)
                                        {
                                            foreach (var nt in ViewBag.ListNguoiThue)
                                            {
                                                <option value="@nt.Value">@nt.Text</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="mb-3" id="groupNguoiDungCoO">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NguoiDungCoOPhongKhong" checked>
                                        <label for="NguoiDungCoOPhongKhong" class="form-check-label text-success font-weight-bold">
                                            Người đại diện có ở tại phòng này không?
                                        </label>
                                    </div>
                                    <small class="form-text text-muted d-block mt-1">Bỏ chọn nếu người này chỉ đứng tên ký hợp đồng (VD: Bố mẹ thuê cho con).</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="ThoiDiemBatDau" class="form-label">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="ThoiDiemBatDau" placeholder="Chọn ngày bắt đầu...">
                                </div>

                                <div class="mb-3">
                                    <label for="ThoiDiemKetThuc" class="form-label">Ngày Kết Thúc (Dự kiến)</label>
                                    <input type="text" class="form-control" id="ThoiDiemKetThuc" placeholder="Chọn ngày kết thúc...">
                                </div>

                                <div class="mb-3">
                                    <label for="TienCocPhong" class="form-label">Tiền Cọc (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="TienCocPhong" value="0" min="0">
                                </div>

                                <div class="mb-3">
                                    <label for="TienThuePhong" class="form-label">Tiền Thuê/Tháng (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="TienThuePhong" min="0">
                                </div>

                                <div class="mb-3" id="groupTrangThaiHopDong" style="display: none;">
                                    <label for="TrangThaiHopDong" class="form-label">Trạng Thái Hợp Đồng <span class="text-danger">*</span></label>
                                    <select class="form-select" id="TrangThaiHopDong">
                                        <option value="1">Đang hoạt động</option>
                                        <option value="2">Đã kết thúc</option>
                                        <option value="3">Đã hủy</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Dịch vụ đăng ký -->
                    <div class="tab-pane fade" id="content-dichvu" role="tabpanel">
                        <div class="alert alert-info py-2 mb-3 shadow-sm border-0">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle me-2"></i> 
                                <div>
                                    Chọn các dịch vụ cho phòng trọ. Dịch vụ <strong>Mặc định</strong> (Điện, Nước) sẽ được tích sẵn.
                                </div>
                            </div>
                        </div>
                        <div id="hopDongDichVuContainer">
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-hand-point-up fa-2x mb-2"></i>
                                <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Danh sách thành viên -->
                    <div class="tab-pane fade" id="content-thanhvien" role="tabpanel">
                        @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DanhSachThanhVienPartial.cshtml")
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between py-3">
                <button type="button" class="btn btn-secondary shadow-sm" id="btnWizardBack">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                </button>
                <div>
                    <button type="button" class="btn btn-danger me-2" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                    <button type="button" class="btn btn-primary shadow-sm" id="btnWizardNext">
                        Tiếp theo <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-success shadow-sm" id="btnSaveData" style="display: none;">
                        <i class="fas fa-save me-1"></i> Lưu thông tin
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DangKyDichVuPartial.cshtml")

    <script>
        // Hàm hiển thị thông báo thay cho alert() mặc định
        function showToastr(message, type = 'info') {
            // Chuẩn bị tích hợp Toastr/SweetAlert2 sau này
            // Hiện tạm dùng alert, nhưng đã quy về một hàm duy nhất
            alert(`[${type.toUpperCase()}] ${message}`);
        }

        window.currentHopDongId = 0;
        window.currentStep = 1;

        // Quản lý các bước của Stepper Wizard
        function goToStep(step) {
            let hasThanhVien = window.currentHopDongId > 0;
            let maxStepVal = hasThanhVien ? 3 : 2;

            if (step > maxStepVal || step < 1) return;

            // Validate di chuyển tiến tới từ bước 1
            if (step > window.currentStep && window.currentStep === 1) {
                let chiNhanhId = $('#ChiNhanhId').val();
                let phongTroId = $('#PhongTroId').val();
                let nguoiThueId = $('#NguoiThueId').val();
                let dateBatDau = batDauPicker.selectedDates[0];
                let tienThuePhong = parseFloat($('#TienThuePhong').val() || 0);

                if (!chiNhanhId || !phongTroId || !nguoiThueId || !dateBatDau) {
                    showToastr("Vui lòng nhập đầy đủ các trường bắt buộc (*).", "warning");
                    return;
                }
                if (tienThuePhong <= 0) {
                    showToastr("Vui lòng nhập Tiền Thuê Phòng (phải lớn hơn 0).", "warning");
                    return;
                }
            }

            window.currentStep = step;

            // Cập nhật UI Stepper Progress Bar
            $('#hopDongStepper .step-item').removeClass('active completed');
            $('#hopDongStepper .step-item').each(function() {
                let stepNum = parseInt($(this).data('step'));
                if (stepNum < window.currentStep) {
                    $(this).addClass('completed');
                } else if (stepNum === window.currentStep) {
                    $(this).addClass('active');
                }
            });

            // Cập nhật hiển thị Pane
            $('.tab-content .tab-pane').removeClass('show active');
            if (window.currentStep === 1) {
                $('#content-thongtin').addClass('show active');
            } else if (window.currentStep === 2) {
                $('#content-dichvu').addClass('show active');
            } else if (window.currentStep === 3) {
                $('#content-thanhvien').addClass('show active');
            }

            updateWizardButtons();
        }

        function updateWizardButtons() {
            let hasThanhVien = window.currentHopDongId > 0;
            let maxStepVal = hasThanhVien ? 3 : 2;

            // Hiển thị tiêu đề bước 3 trong stepper
            if (hasThanhVien) {
                $('#stepHeaderThanhVien').show();
            } else {
                $('#stepHeaderThanhVien').hide();
            }

            // Điều khiển hiển thị Nút Quay lại
            if (window.currentStep === 1) {
                $('#btnWizardBack').hide();
            } else {
                $('#btnWizardBack').show();
            }

            // Điều khiển hiển thị Nút Tiếp theo / Nút Lưu
            if (window.currentStep < maxStepVal) {
                $('#btnWizardNext').show();
                $('#btnSaveData').hide();
            } else {
                $('#btnWizardNext').hide();
                $('#btnSaveData').show();
            }
        }

        $(document).ready(function () {
            // Khởi tạo Partial View Thành Viên
            let allNguoiThues = [];
            @if (ViewBag.ListNguoiThue != null)
            {
                <text>
                allNguoiThues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListNguoiThue, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
                </text>
            }
            if (typeof initThanhVienModule === "function") {
                initThanhVienModule(allNguoiThues);
            }

            // Hàm format tiền VNĐ
            function formatVND(n) {
                if (n === null || n === undefined) return "0 ₫";
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
            }

            // Tính toán Ngày đầu/cuối quý hiện tại bằng JS thuần
            const now = new Date();
            const quarter = Math.floor(now.getMonth() / 3);
            const startOfQuarter = new Date(now.getFullYear(), quarter * 3, 1);
            const endOfQuarter = new Date(now.getFullYear(), (quarter + 1) * 3, 0);

            // === KHỞI TẠO FLATPICKR CHO BỘ LỌC (Chọn khoảng ngày) ===
            let filterPicker = flatpickr("#filterDateRange", {
                mode: "range",
                dateFormat: "d/m/Y",
                locale: "vn",
                // defaultDate: [startOfQuarter, endOfQuarter]
            });

            // === KHỞI TẠO FLATPICKR CHO MODAL (Chọn ngày đơn) ===
            window.batDauPicker = flatpickr("#ThoiDiemBatDau", { dateFormat: "d/m/Y", locale: "vn" });
            window.ketThucPicker = flatpickr("#ThoiDiemKetThuc", { dateFormat: "d/m/Y", locale: "vn" });

            // Khởi tạo Select2 trong Modal (có dropdownParent tránh lỗi mất focus trong BS5 modal)
            if ($('#NguoiThueId').length > 0) {
                $('#NguoiThueId').select2({
                    theme: 'bootstrap4',
                    dropdownParent: $('#hopDongModal')
                });
            }

            // Mảng dữ liệu phòng trọ từ ViewBag
            let allPhongTros = @jsonPhongTros || [];

            // Logic Chọn Chi Nhánh -> Lọc Phòng Trọ
            $('#ChiNhanhId').on('change', function () {
                let chiNhanhId = $(this).val();
                let $phongTroSelect = $('#PhongTroId');
                $phongTroSelect.empty();
                if (!chiNhanhId) {
                    $phongTroSelect.append('<option value="">-- Vui lòng chọn chi nhánh trước --</option>');
                    return;
                }
                $phongTroSelect.append('<option value="">-- Chọn phòng trọ --</option>');
                let phongsFilter = allPhongTros.filter(p => p.chiNhanhId == parseInt(chiNhanhId));
                if(window.currentHopDongId == 0){
                    phongsFilter = phongsFilter.filter(p => p.trangThai == @((int)TrangThaiPhong.Trong));
                }
                phongsFilter.forEach(p => {
                    $phongTroSelect.append(`<option value="${p.phongTroId}" data-gia-thue="${p.giaThue || 0}">${p.soPhong}</option>`);
                });
            });

            // Logic Chọn Phòng Trọ -> Tải dịch vụ đăng ký
            $('#PhongTroId').on('change', function () {
                let phongTroId = $(this).val();
                
                // Tránh ghi đè tiền thuê/dịch vụ liên tục khi đang load chi tiết cập nhật
                if (window.isBindingData) return;

                // Lấy giá thuê phòng mặc định gán vào ô Tiền thuê từ thuộc tính data
                if (phongTroId) {
                    let giaThue = $(this).find(':selected').data('gia-thue');
                    if (giaThue !== undefined && giaThue !== null) {
                        $('#TienThuePhong').val(giaThue);
                    }
                } else {
                    $('#TienThuePhong').val('');
                }

                if (!phongTroId) {
                    $('#hopDongDichVuContainer').html(`
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-hand-point-up fa-2x mb-2"></i>
                            <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                        </div>
                    `);
                    return;
                }
                // Hiện loading
                $('#hopDongDichVuContainer').html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');

                $.get(`/DangKyDichVu/GetByPhong?phongTroId=${phongTroId}`, function (data) {
                    let isNew = window.currentHopDongId === 0;
                    renderDangKyDichVu('hopDongDichVuContainer', data, isNew);
                }).fail(function () {
                    $('#hopDongDichVuContainer').html('<div class="alert alert-danger">Không thể tải dịch vụ.</div>');
                });
            });

            // KHỞI TẠO DATATABLE SERVER-SIDE
            var table = $('#hopDongTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/HopDong/DanhSachHopDongSideAsync",
                    "type": "POST",
                    "data": function (d) {
                        d.chiNhanhId = $('#filterChiNhanh').val();
                        d.nguoiThueId = $('#filterNguoiThue').val();
                        d.trangThai = $('#filterTrangThai').val();

                        // Lấy khoảng ngày từ Flatpickr gửi lên Server
                        let selectedDates = filterPicker.selectedDates;
                        if (selectedDates.length === 2) {
                            d.startDate = flatpickr.formatDate(selectedDates[0], "Y-m-d");
                            d.endDate = flatpickr.formatDate(selectedDates[1], "Y-m-d");
                        }
                    }
                },
                "columns": [
                    {
                        "data": null,
                        "className": "text-center align-middle",
                        "orderable": false,
                        "searchable": false,
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { "data": "maHopDong", "name": "maHopDong", "className": "font-weight-bold text-primary align-middle" },
                    { "data": "soPhong", "name": "SoPhong", "orderable": true, "className": "align-middle" },
                    { "data": "tenNguoiThue", "orderable": false, "className": "align-middle" },
                    {
                        "data": "thoiDiemBatDau",
                        "name": "thoiDiemBatDau",
                        "className": "align-middle",
                        "render": function(data) {
                            if(!data) return '';
                            return new Date(data).toLocaleDateString('vi-VN');
                        }
                    },
                    {
                        "data": "tienThuePhong",
                        "name": "tienThuePhong",
                        "className": "align-middle",
                        "render": function(data) { return formatVND(data); }
                    },
                    {
                        "data": "trangThaiHopDong",
                        "orderable": false,
                        "className": "text-center align-middle",
                        "render": function (data) {
                            if (data === 1) return '<span class="badge bg-success-lt px-2 py-1">Đang hoạt động</span>';
                            if (data === 2) return '<span class="badge bg-secondary-lt px-2 py-1">Đã kết thúc</span>';
                            return '<span class="badge bg-danger-lt px-2 py-1">Đã hủy</span>';
                        }
                    },
                    {
                        "data": "hopDongId",
                        "orderable": false,
                        "className": "text-center align-middle",
                        "render": function (data) {
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit" data-id="${data}" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete" data-id="${data}" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                "order": [[4, 'desc']]
            });

            // Nút tìm kiếm / Lọc danh sách
            $('#btnFilter').on('click', function () {
                table.ajax.reload();
            });

            // Nút mở Modal Thêm mới
            $('#btnOpenAddModal').on('click', function() {
                window.currentHopDongId = 0;
                $('#MaHopDong').val('Hệ thống tự sinh khi lưu');
                $('#TienCocPhong').val('0');
                $('#TienThuePhong').val('');

                // Clear ngày tháng bằng hàm của Flatpickr
                window.batDauPicker.clear();
                window.ketThucPicker.clear();

                $('#ChiNhanhId').val('').trigger('change').prop('disabled', false);
                $('#NguoiThueId').val('').trigger('change').prop('disabled', false);
                $('#PhongTroId').prop('disabled', false);

                $('#groupTrangThaiHopDong').hide();
                $('#TrangThaiHopDong').val(1);
                $('#groupNguoiDungCoO').show();
                $('#NguoiDungCoOPhongKhong').prop('checked', true);

                // Reset tab dịch vụ
                $('#hopDongDichVuContainer').html(`
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-hand-point-up fa-2x mb-2"></i>
                        <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                    </div>
                `);

                // Thiết lập trạng thái Stepper về Bước 1
                goToStep(1);

                $('#modalTitle').text('Thêm Hợp Đồng Mới');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('hopDongModal')).show();
            });

            // Stepper Navigation Buttons
            $('#btnWizardNext').on('click', function() {
                goToStep(window.currentStep + 1);
            });

            $('#btnWizardBack').on('click', function() {
                goToStep(window.currentStep - 1);
            });

            $('#hopDongStepper').on('click', '.step-item', function() {
                let targetStep = parseInt($(this).data('step'));
                goToStep(targetStep);
            });

            // ================== LOGIC THÀNH VIÊN Ở GHÉP ==================
            // Khởi tạo Select2 Autocomplete và Flatpickr cho Modal Thêm Thành Viên
            $('#addMember_SearchNguoiThue').select2({
                dropdownParent: $('#addMemberModal'),
                theme: 'bootstrap4',
                placeholder: 'Gõ Tên, SĐT hoặc CCCD...',
                allowClear: true,
                minimumInputLength: 1,
                ajax: {
                    url: '/NguoiThue/SearchAutocomplete',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            searchTerm: params.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.hoVaTen} - ${item.soDienThoai || ''} (CCCD: ${item.cccd || ''})`,
                                    hoVaTen: item.hoVaTen,
                                    soDienThoai: item.soDienThoai,
                                    cccd: item.cccd
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            let memberNgayVaoPicker = flatpickr("#addMember_NgayVao", { dateFormat: "d/m/Y", locale: "vn", defaultDate: new Date() });

            // Khi chọn một khách thuê có sẵn từ danh sách tìm kiếm
            $('#addMember_SearchNguoiThue').on('select2:select', function (e) {
                let data = e.params.data;
                $('#addMember_NguoiThueId').val(data.id);
                $('#addMember_HoVaTen').val(data.hoVaTen).prop('disabled', true);
                $('#addMember_SoDienThoai').val(data.soDienThoai).prop('disabled', true);
                $('#addMember_CCCD').val(data.cccd).prop('disabled', true);
            });

            // Khi người dùng click nút clear trong select2
            $('#addMember_SearchNguoiThue').on('select2:clear', function () {
                resetAddMemberForm();
            });

            // Khi người dùng bấm nút Nhập mới hoàn toàn
            $('#btnToggleNewMember').on('click', function () {
                $('#addMember_SearchNguoiThue').val(null).trigger('change');
                $('#addMember_NguoiThueId').val('');
                $('#addMember_HoVaTen').val('').prop('disabled', false).focus();
                $('#addMember_SoDienThoai').val('').prop('disabled', false);
                $('#addMember_CCCD').val('').prop('disabled', false);
            });

            // Hàm reset dữ liệu form modal thành viên
            function resetAddMemberForm() {
                $('#addMember_SearchNguoiThue').val(null).trigger('change');
                $('#addMember_NguoiThueId').val('');
                $('#addMember_HoVaTen').val('').prop('disabled', true);
                $('#addMember_SoDienThoai').val('').prop('disabled', true);
                $('#addMember_CCCD').val('').prop('disabled', true);
                memberNgayVaoPicker.setDate(new Date());
            }

            // Hàm load danh sách thành viên
            window.loadDanhSachThanhVien = function(hopDongId) {
                $('#thanhVienTbody').html('<tr><td colspan="8" class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>');
                $.ajax({
                    url: `/ThanhVienHopDong/GetDanhSach/${hopDongId}`,
                    type: 'GET',
                    success: function (res) {
                        let html = '';
                        if (res && res.length > 0) {
                            res.forEach(function (tv, index) {
                                let ngayVao = tv.ngayVao ? new Date(tv.ngayVao).toLocaleDateString('vi-VN') : '-';
                                let ngayRoi = tv.ngayChuyenDi ? new Date(tv.ngayChuyenDi).toLocaleDateString('vi-VN') : '-';
                                let isChuHopDong = tv.isChuHopDong ? '<span class="badge bg-primary-lt"><i class="fas fa-crown"></i> Đại diện</span>' : '';
                                let trangThai = tv.ngayChuyenDi ? '<span class="badge bg-secondary-lt">Đã chuyển đi</span>' : '<span class="badge bg-success-lt">Đang ở</span>';
                                
                                let buttons = '';
                                if (!tv.ngayChuyenDi) {
                                    buttons += `<button type="button" class="btn btn-icon btn-ghost-warning btn-sm btn-checkout" data-id="${tv.chiTietThanhVienHopDongId}" title="Báo chuyển đi"><i class="fas fa-sign-out-alt"></i></button> `;
                                }
                                if (!tv.isChuHopDong) {
                                    buttons += `<button type="button" class="btn btn-icon btn-ghost-danger btn-sm btn-delete-member" data-id="${tv.chiTietThanhVienHopDongId}" title="Xoá thành viên (nhập sai)"><i class="fas fa-trash"></i></button>`;
                                }
                                buttons = `<div class="btn-list flex-nowrap justify-content-center">${buttons}</div>`;

                                html += `
                                    <tr>
                                        <td class="text-center align-middle">${index + 1}</td>
                                        <td class="align-middle"><strong>${tv.hoVaTen}</strong> ${isChuHopDong}</td>
                                        <td class="align-middle">${tv.soDienThoai || '-'}</td>
                                        <td class="align-middle">${tv.cccd || '-'}</td>
                                        <td class="align-middle">${ngayVao}</td>
                                        <td class="align-middle">${ngayRoi}</td>
                                        <td class="text-center align-middle">${trangThai}</td>
                                        <td class="text-center align-middle">${buttons}</td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="8" class="text-center text-muted">Chưa có thành viên nào.</td></tr>';
                        }
                        $('#thanhVienTbody').html(html);
                    },
                    error: function () {
                        $('#thanhVienTbody').html('<tr><td colspan="8" class="text-center text-danger">Lỗi khi tải dữ liệu!</td></tr>');
                    }
                });
            };

            // Nút mở modal thêm thành viên
            $(document).on('click', '#btnOpenAddMemberModal', function () {
                if (!window.currentHopDongId || window.currentHopDongId === 0) {
                    showToastr("Hợp đồng chưa được lưu. Vui lòng tạo hợp đồng trước khi thêm thành viên.", "warning");
                    return;
                }
                resetAddMemberForm();
                bootstrap.Modal.getOrCreateInstance(document.getElementById('addMemberModal')).show();
            });

            // Nút lưu thành viên mới
            $(document).on('click', '#btnSaveMember', function () {
                let hopDongId = window.currentHopDongId;
                let nguoiThueId = $('#addMember_NguoiThueId').val();
                let hoVaTen = $('#addMember_HoVaTen').val().trim();
                let soDienThoai = $('#addMember_SoDienThoai').val().trim();
                let cccd = $('#addMember_CCCD').val().trim();
                let ngayVaoDate = memberNgayVaoPicker.selectedDates[0];

                if (!ngayVaoDate) {
                    showToastr("Vui lòng chọn ngày vào.", "warning");
                    return;
                }

                if (!nguoiThueId) {
                    if (!hoVaTen || !soDienThoai || !cccd) {
                        showToastr("Vui lòng nhập đủ Họ tên, Số ĐT và CCCD cho khách mới.", "warning");
                        return;
                    }
                }

                let requestData = {
                    hopDongId: hopDongId,
                    nguoiThueId: nguoiThueId ? parseInt(nguoiThueId) : null,
                    hoVaTen: hoVaTen,
                    soDienThoai: soDienThoai,
                    cccd: cccd,
                    ngayVao: flatpickr.formatDate(ngayVaoDate, "Y-m-d")
                };

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                $.ajax({
                    url: '/ThanhVienHopDong/AddThanhVien',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (res) {
                        showToastr(res.message, "success");
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('addMemberModal')).hide();
                        window.loadDanhSachThanhVien(hopDongId);
                    },
                    error: function (xhr) {
                        let msg = "Đã xảy ra lỗi!";
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        showToastr(msg, "error");
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thành viên');
                    }
                });
            });

            // Báo chuyển đi
            $(document).on('click', '.btn-checkout', function () {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận chuyển đi?',
                    text: 'Xác nhận thành viên này đã chuyển đi? (Ngày rời phòng sẽ cập nhật hôm nay)',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post(`/ThanhVienHopDong/BaoRoiPhong/${id}`, function (res) {
                            showToastr(res.message, "success");
                            window.loadDanhSachThanhVien(window.currentHopDongId);
                        }).fail(function (xhr) {
                            showToastr(xhr.responseJSON ? xhr.responseJSON.message : "Lỗi!", "error");
                        });
                    }
                });
            });

            // Xoá nhầm thành viên
            $(document).on('click', '.btn-delete-member', function () {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa thành viên?',
                    text: 'Hành động này sẽ xóa hoàn toàn thành viên (nhập sai). Bạn có chắc muốn xoá?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/ThanhVienHopDong/XoaThanhVien/${id}`,
                            type: 'DELETE',
                            success: function (res) {
                                showToastr(res.message, "success");
                                window.loadDanhSachThanhVien(window.currentHopDongId);
                            },
                            error: function (xhr) {
                                showToastr(xhr.responseJSON ? xhr.responseJSON.message : "Lỗi!", "error");
                            }
                        });
                    }
                });
            });
            // =============================================================

            // SỰ KIỆN LƯU DỮ LIỆU (Hợp đồng + Dịch vụ)
            $('#btnSaveData').on('click', function () {
                let maHopDong = window.currentHopDongId > 0 ? $('#MaHopDong').val().trim() : '';
                let phongTroId = $('#PhongTroId').val();
                let nguoiThueId = $('#NguoiThueId').val();

                let dateBatDau = window.batDauPicker.selectedDates[0];
                let dateKetThuc = window.ketThucPicker.selectedDates[0];

                let tienCocPhong = parseFloat($('#TienCocPhong').val() || 0);
                let tienThuePhong = parseFloat($('#TienThuePhong').val() || 0);

                if (!phongTroId || !nguoiThueId || !dateBatDau) {
                    showToastr("Vui lòng nhập đầy đủ các trường bắt buộc (*).", "warning");
                    return;
                }

                if (tienThuePhong <= 0) {
                    showToastr("Vui lòng nhập Tiền Thuê Phòng (phải lớn hơn 0).", "warning");
                    return;
                }
                let requestData = {
                    hopDongId: window.currentHopDongId,
                    maHopDong: maHopDong,
                    phongTroId: parseInt(phongTroId),
                    nguoiThueId: parseInt(nguoiThueId),
                    thoiDiemBatDau: flatpickr.formatDate(dateBatDau, "Y-m-d"),
                    thoiDiemKetThuc: dateKetThuc ? flatpickr.formatDate(dateKetThuc, "Y-m-d") : null,
                    tienCocPhong: tienCocPhong,
                    tienThuePhong: tienThuePhong,
                    trangThaiHopDong: parseInt($('#TrangThaiHopDong').val() || 1),
                    nguoiDungCoOPhongKhong: $('#NguoiDungCoOPhongKhong').is(':checked')
                };

                let isUpdate = window.currentHopDongId > 0;
                let apiUrl = isUpdate ? `/HopDong/Update/${window.currentHopDongId}` : `/HopDong/Create`;
                let httpMethod = isUpdate ? 'PUT' : 'POST';

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                // Bước 1: Lưu hợp đồng
                $.ajax({
                    url: apiUrl,
                    type: httpMethod,
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (res) {
                        // Bước 2: Lưu dịch vụ đăng ký (nếu có dịch vụ nào được render)
                        let hasDichVu = $('#hopDongDichVuContainer .dkdv-checkbox').length > 0;
                        if (hasDichVu) {
                            saveDangKyDichVu(
                                parseInt(phongTroId),
                                'hopDongDichVuContainer',
                                function () {
                                    showToastr(res.message || "Thao tác thành công!", "success");
                                    bootstrap.Modal.getOrCreateInstance(document.getElementById('hopDongModal')).hide();
                                    table.ajax.reload(null, false);
                                },
                                function (errMsg) {
                                    showToastr("Hợp đồng đã lưu, nhưng lỗi khi lưu dịch vụ: " + errMsg, "warning");
                                    bootstrap.Modal.getOrCreateInstance(document.getElementById('hopDongModal')).hide();
                                    table.ajax.reload(null, false);
                                }
                            );
                        } else {
                            showToastr(res.message || "Thao tác thành công!", "success");
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('hopDongModal')).hide();
                            table.ajax.reload(null, false);
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = "Đã xảy ra lỗi!";
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.message) {
                                errorMessage = xhr.responseJSON.message;
                            } else if (xhr.responseJSON.errors) {
                                errorMessage = Object.values(xhr.responseJSON.errors).flat().join('\n');
                            }
                        }
                        showToastr(errorMessage, "error");
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thông tin');
                    }
                });
            });

            // SỰ KIỆN NÚT SỬA (ĐỔ DỮ LIỆU)
            $('#hopDongTable tbody').on('click', '.btn-edit', function () {
                let id = $(this).data('id');
                window.currentHopDongId = id;

                let $btn = $(this);
                let originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: `/HopDong/GetById/${id}`,
                    type: 'GET',
                    success: function (res) {
                        $('#MaHopDong').val(res.maHopDong);
                        if(res.phongTroId) {
                            window.isBindingData = true; // Tránh trigger đổi giá phòng/dịch vụ
                            $('#ChiNhanhId').val(res.chiNhanhId || '').trigger('change');
                            setTimeout(() => {
                                if ($('#PhongTroId option[value="'+res.phongTroId+'"]').length === 0) {
                                    let soPhongName = res.soPhong || res.phongTroId;
                                    $('#PhongTroId').append(`<option value="${res.phongTroId}" data-gia-thue="${res.tienThuePhong}">${soPhongName}</option>`);
                                }
                                $('#PhongTroId').val(res.phongTroId).change();
                                window.isBindingData = false;

                                setTimeout(() => {
                                    $.get(`/DangKyDichVu/GetByPhong?phongTroId=${res.phongTroId}`, function (dvData) {
                                        renderDangKyDichVu('hopDongDichVuContainer', dvData, false);
                                    });
                                }, 100);
                            }, 150);
                        }

                        if ($('#NguoiThueId option[value="'+res.nguoiThueId+'"]').length === 0) {
                            $('#NguoiThueId').append(`<option value="${res.nguoiThueId}">${res.tenNguoiThue || "Khách thuê (ID: " + res.nguoiThueId + ")"}</option>`);
                        }
                        $('#NguoiThueId').val(res.nguoiThueId).trigger('change');

                        $('#ChiNhanhId').prop('disabled', true);
                        $('#PhongTroId').prop('disabled', true);
                        $('#NguoiThueId').prop('disabled', true);
                        
                        $('#groupNguoiDungCoO').hide();

                        $('#groupTrangThaiHopDong').show();
                        $('#TrangThaiHopDong').val(res.trangThaiHopDong);

                        if(res.thoiDiemBatDau) window.batDauPicker.setDate(new Date(res.thoiDiemBatDau));
                        if(res.thoiDiemKetThuc) window.ketThucPicker.setDate(new Date(res.thoiDiemKetThuc));
                        else window.ketThucPicker.clear();

                        $('#TienCocPhong').val(res.tienCocPhong);
                        $('#TienThuePhong').val(res.tienThuePhong);

                        // Load danh sách thành viên và chuyển bước 1
                        if (typeof window.loadDanhSachThanhVien === "function") {
                            window.loadDanhSachThanhVien(id);
                        }

                        goToStep(1);

                        $('#modalTitle').text('Cập nhật Hợp Đồng');
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('hopDongModal')).show();
                    },
                    error: function () { showToastr("Không thể tải thông tin.", "error"); },
                    complete: function() { $btn.prop('disabled', false).html(originalHtml); }
                });
            });

            // SỰ KIỆN NÚT XÓA
            $('#hopDongTable tbody').on('click', '.btn-delete', function () {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa hợp đồng?',
                    text: 'Bạn có chắc chắn muốn xóa hợp đồng này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                        $.ajax({
                            url: `/HopDong/Delete/${id}`,
                            type: 'DELETE',
                            success: function (res) {
                                showToastr(res.message || "Đã xóa.", "success");
                                table.ajax.reload(null, false);
                            },
                            error: function (xhr) {
                                let msg = "Lỗi khi xóa!";
                                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                                showToastr(msg, "error");
                                $btn.prop('disabled', false).html(originalHtml);
                            }
                        });
                    }
                });
            });
        });
    </script>
}
