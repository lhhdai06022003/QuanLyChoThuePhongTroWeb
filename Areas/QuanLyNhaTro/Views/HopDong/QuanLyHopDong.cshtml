
@using QuanLyChoThuePhongTroWeb.Models
@{
    ViewData["Title"] = "Quản lý Hợp Đồng";
    // Ép kiểu dữ liệu ViewBag sang JSON để xài trong Javascript với CamelCase
    var jsonPhongTros = Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListPhongTro, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/themes/material_blue.min.css" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2-bootstrap4-theme/1.5.2/select2-bootstrap4.min.css" />
<section class="content">
    <div class="container-fluid">
        <!-- Card quản lý & danh sách hợp đồng -->
        <div class="card card-primary card-outline shadow">
            <div class="card-header d-flex align-items-center justify-content-between p-3">
                <h3 class="card-title m-0"><i class="fas fa-file-contract text-primary mr-2"></i> Quản lý & Danh sách Hợp Đồng</h3>
                <div class="card-tools ml-auto">
                    <button type="button" class="btn btn-success btn-sm font-weight-bold px-3 py-2 shadow-sm" id="btnOpenAddModal">
                        <i class="fas fa-plus-circle mr-1"></i> Tạo Hợp Đồng Mới
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Khu vực Bộ lọc dạng hàng ngang -->
                <div class="bg-light p-3 border rounded mb-4 shadow-sm">
                    <div class="row align-items-end">
                        <div class="col-md-2 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-building mr-1"></i> Chi Nhánh</label>
                            <select id="filterChiNhanh" class="form-control form-control-sm">
                                <option value="0">-- Tất cả --</option>
                                @if (ViewBag.ListChiNhanh != null)
                                {
                                    foreach (var cn in ViewBag.ListChiNhanh)
                                    {
                                        <option value="@cn.Value">@cn.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-user mr-1"></i> Người Thuê</label>
                            <select id="filterNguoiThue" class="form-control form-control-sm">
                                <option value="0">-- Tất cả --</option>
                                @if (ViewBag.ListNguoiThue != null)
                                {
                                    foreach (var nt in ViewBag.ListNguoiThue)
                                    {
                                        <option value="@nt.Value">@nt.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-calendar-alt mr-1"></i> Thời hạn hợp đồng</label>
                            <input type="text" class="form-control form-control-sm" id="filterDateRange" placeholder="Chọn khoảng thời gian...">
                        </div>
                        <div class="col-md-2 form-group mb-md-0">
                            <label class="font-weight-bold text-secondary mb-1"><i class="fas fa-info-circle mr-1"></i> Trạng thái</label>
                            <select id="filterTrangThai" class="form-control form-control-sm">
                                <option value="0">-- Tất cả --</option>
                                <option value="1">Đang hoạt động</option>
                                <option value="2">Đã kết thúc</option>
                                <option value="3">Đã hủy</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-0">
                            <button type="button" class="btn btn-primary btn-sm w-100 font-weight-bold py-2" id="btnFilter">
                                <i class="fas fa-search mr-1"></i> Lọc danh sách
                            </button>
                        </div>
                    </div>
                </div>

                <table id="hopDongTable" class="table table-bordered table-striped table-hover w-100">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center" width="5%">STT</th>
                            <th>Mã HĐ</th>
                            <th>Phòng</th>
                            <th>Người Đại Diện</th>
                            <th>Ngày Bắt Đầu</th>
                            <th>Tiền Thuê/Tháng</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="hopDongModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Thêm Hợp Đồng Mới</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <!-- Bootstrap Tabs -->
                <ul class="nav nav-tabs mb-3" id="hopDongTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="tab-thongtin" data-toggle="tab" href="#content-thongtin" role="tab">
                            <i class="fas fa-file-contract"></i> Thông tin hợp đồng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-dichvu" data-toggle="tab" href="#content-dichvu" role="tab">
                            <i class="fas fa-concierge-bell"></i> Dịch vụ đăng ký
                        </a>
                    </li>
                    <li class="nav-item" id="nav-item-thanhvien" style="display:none;">
                        <a class="nav-link" id="tab-thanhvien" data-toggle="tab" href="#content-thanhvien" role="tab">
                            <i class="fas fa-users"></i> Thành viên
                        </a>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Tab 1: Thông tin hợp đồng -->
                    <div class="tab-pane fade show active" id="content-thongtin" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Mã Hợp Đồng <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="MaHopDong" placeholder="VD: HD-001">
                                </div>

                                <div class="form-group">
                                    <label>Chi Nhánh <span class="text-danger">*</span></label>
                                    <select class="form-control" id="ChiNhanhId">
                                        <option value="">-- Chọn chi nhánh --</option>
                                        @if (ViewBag.ListChiNhanh != null)
                                        {
                                            foreach (var cn in ViewBag.ListChiNhanh)
                                            {
                                                <option value="@cn.Value">@cn.Text</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Phòng Trọ <span class="text-danger">*</span></label>
                                    <select class="form-control" id="PhongTroId">
                                        <option value="">-- Vui lòng chọn chi nhánh trước --</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Người Đại Diện <span class="text-danger">*</span></label>
                                    <select class="form-control select2" id="NguoiThueId">
                                        <option value="">-- Chọn khách thuê --</option>
                                        @if (ViewBag.ListNguoiThue != null)
                                        {
                                            foreach (var nt in ViewBag.ListNguoiThue)
                                            {
                                                <option value="@nt.Value">@nt.Text</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="form-group" id="groupNguoiDungCoO">
                                    <div class="custom-control custom-checkbox">
                                        <input class="custom-control-input" type="checkbox" id="NguoiDungCoOPhongKhong" checked>
                                        <label for="NguoiDungCoOPhongKhong" class="custom-control-label text-success">Người đại diện có ở tại phòng này không?</label>
                                    </div>
                                    <small class="form-text text-muted">Bỏ chọn nếu người này chỉ đứng tên ký hợp đồng (VD: Bố mẹ thuê cho con).</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Ngày Bắt Đầu <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="ThoiDiemBatDau" placeholder="Chọn ngày bắt đầu...">
                                </div>

                                <div class="form-group">
                                    <label>Ngày Kết Thúc (Dự kiến)</label>
                                    <input type="text" class="form-control" id="ThoiDiemKetThuc" placeholder="Chọn ngày kết thúc...">
                                </div>

                                <div class="form-group">
                                    <label>Tiền Cọc (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="TienCocPhong" value="0" min="0">
                                </div>

                                <div class="form-group">
                                    <label>Tiền Thuê/Tháng (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="TienThuePhong" min="0">
                                </div>

                                <div class="form-group" id="groupTrangThaiHopDong" style="display: none;">
                                    <label>Trạng Thái Hợp Đồng <span class="text-danger">*</span></label>
                                    <select class="form-control" id="TrangThaiHopDong">
                                        <option value="1">Đang hoạt động</option>
                                        <option value="2">Đã kết thúc</option>
                                        <option value="3">Đã hủy</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Dịch vụ đăng ký -->
                    <div class="tab-pane fade" id="content-dichvu" role="tabpanel">
                        <div class="alert alert-info py-2 mb-3">
                            <i class="fas fa-info-circle"></i> 
                            Chọn các dịch vụ cho phòng trọ. Dịch vụ <strong>Mặc định</strong> (Điện, Nước) sẽ được tích sẵn.
                        </div>
                        <div id="hopDongDichVuContainer">
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-hand-point-up fa-2x mb-2"></i>
                                <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Danh sách thành viên -->
                    <div class="tab-pane fade" id="content-thanhvien" role="tabpanel">
                        @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DanhSachThanhVienPartial.cshtml")
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveData">
                    <i class="fas fa-save"></i> Lưu thông tin
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Areas/QuanLyNhaTro/Views/Shared/_DangKyDichVuPartial.cshtml")

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/vn.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.full.min.js"></script>

    <script>
        // Hàm hiển thị thông báo thay cho alert() mặc định
        function showToastr(message, type = 'info') {
            // Chuẩn bị tích hợp Toastr/SweetAlert2 sau này
            // Hiện tạm dùng alert, nhưng đã quy về một hàm duy nhất
            alert(`[${type.toUpperCase()}] ${message}`);
        }

        window.currentHopDongId = 0;
        $(document).ready(function () {

            // Khởi tạo Partial View Thành Viên
            let allNguoiThues = [];
            @if (ViewBag.ListNguoiThue != null)
            {
                <text>
                allNguoiThues = [
                    @foreach (var nt in ViewBag.ListNguoiThue)
                    {
                        @:{ value: '@nt.Value', text: '@Html.Raw(nt.Text)' },
                    }
                ];
                </text>
            }
            if (typeof initThanhVienModule === "function") {
                initThanhVienModule(allNguoiThues);
            }

            // Hàm format tiền VNĐ
            function formatVND(n) {
                if (n === null || n === undefined) return "0 ₫";
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
            }

            // Tính toán Ngày đầu/cuối quý hiện tại bằng JS thuần (Không cần moment)
            const now = new Date();
            const quarter = Math.floor(now.getMonth() / 3);
            const startOfQuarter = new Date(now.getFullYear(), quarter * 3, 1);
            const endOfQuarter = new Date(now.getFullYear(), (quarter + 1) * 3, 0);

            // === KHỞI TẠO FLATPICKR CHO BỘ LỌC (Chọn khoảng ngày) ===
            let filterPicker = flatpickr("#filterDateRange", {
                mode: "range",
                dateFormat: "d/m/Y",
                locale: "vn",
                defaultDate: [startOfQuarter, endOfQuarter]
            });

            // === KHỞI TẠO FLATPICKR CHO MODAL (Chọn ngày đơn) ===
            let batDauPicker = flatpickr("#ThoiDiemBatDau", { dateFormat: "d/m/Y", locale: "vn" });
            let ketThucPicker = flatpickr("#ThoiDiemKetThuc", { dateFormat: "d/m/Y", locale: "vn" });

            // Khởi tạo Select2
            if ($('.select2').length > 0) {
                $('.select2').select2({ theme: 'bootstrap4' });
            }

            // Mảng dữ liệu phòng trọ từ ViewBag
            let allPhongTros = @jsonPhongTros || [];

            // Logic Chọn Chi Nhánh -> Lọc Phòng Trọ
            $('#ChiNhanhId').on('change', function () {
                let chiNhanhId = $(this).val();
                let $phongTroSelect = $('#PhongTroId');
                $phongTroSelect.empty();
                if (!chiNhanhId) {
                    $phongTroSelect.append('<option value="">-- Vui lòng chọn chi nhánh trước --</option>');
                    return;
                }
                $phongTroSelect.append('<option value="">-- Chọn phòng trọ --</option>');
                let phongsFilter = allPhongTros.filter(p => p.chiNhanhId == parseInt(chiNhanhId));
                if(currentHopDongId == 0){
                    phongsFilter = phongsFilter.filter(p => p.trangThai == @((int)TrangThaiPhong.Trong));
                }
                phongsFilter.forEach(p => {
                    $phongTroSelect.append(`<option value="${p.phongTroId}" data-gia-thue="${p.giaThue || 0}">${p.soPhong}</option>`);
                });
            });

            // Logic Chọn Phòng Trọ -> Tải dịch vụ đăng ký
            $('#PhongTroId').on('change', function () {
                let phongTroId = $(this).val();
                
                // Tránh ghi đè tiền thuê/dịch vụ liên tục khi đang load chi tiết cập nhật
                if (window.isBindingData) return;

                // Lấy giá thuê phòng mặc định gán vào ô Tiền thuê từ thuộc tính data
                if (phongTroId) {
                    let giaThue = $(this).find(':selected').data('gia-thue');
                    if (giaThue !== undefined && giaThue !== null) {
                        $('#TienThuePhong').val(giaThue);
                    }
                } else {
                    $('#TienThuePhong').val('');
                }

                if (!phongTroId) {
                    $('#hopDongDichVuContainer').html(`
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-hand-point-up fa-2x mb-2"></i>
                            <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                        </div>
                    `);
                    return;
                }
                // Hiện loading
                $('#hopDongDichVuContainer').html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');

                $.get(`/DangKyDichVu/GetByPhong?phongTroId=${phongTroId}`, function (data) {
                    let isNew = currentHopDongId === 0;
                    renderDangKyDichVu('hopDongDichVuContainer', data, isNew);
                }).fail(function () {
                    $('#hopDongDichVuContainer').html('<div class="alert alert-danger">Không thể tải dịch vụ.</div>');
                });
            });

            // KHỞI TẠO DATATABLE SERVER-SIDE
            var table = $('#hopDongTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/HopDong/DanhSachHopDongSideAsync",
                    "type": "POST",
                    "data": function (d) {
                        d.chiNhanhId = $('#filterChiNhanh').val();
                        d.nguoiThueId = $('#filterNguoiThue').val();
                        d.trangThai = $('#filterTrangThai').val();

                        // Lấy khoảng ngày từ Flatpickr gửi lên Server
                        let selectedDates = filterPicker.selectedDates;
                        if (selectedDates.length === 2) {
                            d.startDate = flatpickr.formatDate(selectedDates[0], "Y-m-d");
                            d.endDate = flatpickr.formatDate(selectedDates[1], "Y-m-d");
                        }
                    }
                },
                "columns": [
                    {
                        "data": null,
                        "className": "text-center align-middle",
                        "orderable": false,
                        "searchable": false,
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { "data": "maHopDong", "name": "maHopDong", "className": "font-weight-bold text-primary" },
                    { "data": "soPhong", "name": "SoPhong", "orderable": true },
                    { "data": "tenNguoiThue", "orderable": false },
                    {
                        "data": "thoiDiemBatDau",
                        "name": "thoiDiemBatDau",
                        "render": function(data) {
                            if(!data) return '';
                            // Dùng hàm định dạng ngày tháng mặc định cực nhẹ của trình duyệt thay vì moment
                            return new Date(data).toLocaleDateString('vi-VN');
                        }
                    },
                    {
                        "data": "tienThuePhong",
                        "name": "tienThuePhong",
                        "render": function(data) { return formatVND(data); }
                    },
                    {
                        "data": "trangThaiHopDong",
                        "orderable": false,
                        "className": "text-center align-middle",
                        "render": function (data) {
                            if (data === 1) return '<span class="badge badge-success">Đang hoạt động</span>';
                            if (data === 2) return '<span class="badge badge-secondary">Đã kết thúc</span>';
                            return '<span class="badge badge-danger">Đã hủy</span>';
                        }
                    },
                    {
                        "data": "hopDongId",
                        "orderable": false,
                        "className": "text-center align-middle",
                        "render": function (data) {
                            return `
                                <button class="btn btn-warning btn-sm btn-edit" data-id="${data}" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-sm btn-delete" data-id="${data}" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                "order": [[4, 'desc']]
            });

            // Nút tìm kiếm / Lọc danh sách
            $('#btnFilter').on('click', function () {
                table.ajax.reload();
            });

            // Nút mở Modal Thêm mới
            $('#btnOpenAddModal').on('click', function() {
                currentHopDongId = 0;
                $('#MaHopDong').val('');
                $('#TienCocPhong').val('0');
                $('#TienThuePhong').val('');

                // Clear ngày tháng bằng hàm của Flatpickr
                batDauPicker.clear();
                ketThucPicker.clear();

                $('#ChiNhanhId').val('').trigger('change').prop('disabled', false);
                $('#NguoiThueId').val('').trigger('change').prop('disabled', false);
                $('#PhongTroId').prop('disabled', false);

                $('#groupTrangThaiHopDong').hide();
                $('#TrangThaiHopDong').val(1);
                $('#groupNguoiDungCoO').show(); // Cho phép chọn khi thêm mới
                $('#NguoiDungCoOPhongKhong').prop('checked', true);

                // Ẩn tab thành viên khi thêm mới
                $('#nav-item-thanhvien').hide();

                // Reset tab dịch vụ
                $('#hopDongDichVuContainer').html(`
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-hand-point-up fa-2x mb-2"></i>
                        <p>Vui lòng chọn <strong>Phòng Trọ</strong> ở tab "Thông tin hợp đồng" trước.</p>
                    </div>
                `);
                // Chuyển về tab thông tin
                $('#tab-thongtin').tab('show');

                $('#modalTitle').text('Thêm Hợp Đồng Mới');
                $('#hopDongModal').modal('show');
            });

            // ================== LOGIC THÀNH VIÊN Ở GHÉP ==================
            // Khởi tạo Select2 và Flatpickr cho Modal Thêm Thành Viên
            // Khởi tạo Select2 Autocomplete và Flatpickr cho Modal Thêm Thành Viên
            $('#addMember_SearchNguoiThue').select2({
                dropdownParent: $('#addMemberModal'),
                theme: 'bootstrap4',
                placeholder: 'Gõ Tên, SĐT hoặc CCCD...',
                allowClear: true,
                minimumInputLength: 1,
                ajax: {
                    url: '/NguoiThue/SearchAutocomplete',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            searchTerm: params.term // Gửi từ khóa lên server
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.hoVaTen} - ${item.soDienThoai || ''} (CCCD: ${item.cccd || ''})`,
                                    hoVaTen: item.hoVaTen,
                                    soDienThoai: item.soDienThoai,
                                    cccd: item.cccd
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            let memberNgayVaoPicker = flatpickr("#addMember_NgayVao", { dateFormat: "d/m/Y", locale: "vn", defaultDate: new Date() });

            // Khi chọn một khách thuê có sẵn từ danh sách tìm kiếm
            $('#addMember_SearchNguoiThue').on('select2:select', function (e) {
                let data = e.params.data;
                $('#addMember_NguoiThueId').val(data.id);
                $('#addMember_HoVaTen').val(data.hoVaTen).prop('disabled', true);
                $('#addMember_SoDienThoai').val(data.soDienThoai).prop('disabled', true);
                $('#addMember_CCCD').val(data.cccd).prop('disabled', true);
            });

            // Khi người dùng click nút clear trong select2
            $('#addMember_SearchNguoiThue').on('select2:clear', function () {
                resetAddMemberForm();
            });

            // Khi người dùng bấm nút Nhập mới hoàn toàn
            $('#btnToggleNewMember').on('click', function () {
                // Reset select2
                $('#addMember_SearchNguoiThue').val(null).trigger('change');
                
                // Mở khóa các trường nhập liệu và đặt NguoiThueId = rỗng (để tạo mới)
                $('#addMember_NguoiThueId').val('');
                $('#addMember_HoVaTen').val('').prop('disabled', false).focus();
                $('#addMember_SoDienThoai').val('').prop('disabled', false);
                $('#addMember_CCCD').val('').prop('disabled', false);
            });

            // Hàm reset dữ liệu form modal
            function resetAddMemberForm() {
                $('#addMember_SearchNguoiThue').val(null).trigger('change');
                $('#addMember_NguoiThueId').val('');
                $('#addMember_HoVaTen').val('').prop('disabled', true);
                $('#addMember_SoDienThoai').val('').prop('disabled', true);
                $('#addMember_CCCD').val('').prop('disabled', true);
                memberNgayVaoPicker.setDate(new Date());
            }

            // Hàm load danh sách thành viên (Dùng chung)
            window.loadDanhSachThanhVien = function(hopDongId) {
                $('#thanhVienTbody').html('<tr><td colspan="8" class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>');
                $.ajax({
                    url: `/ThanhVienHopDong/GetDanhSach/${hopDongId}`,
                    type: 'GET',
                    success: function (res) {
                        let html = '';
                        if (res && res.length > 0) {
                            res.forEach(function (tv, index) {
                                let ngayVao = tv.ngayVao ? new Date(tv.ngayVao).toLocaleDateString('vi-VN') : '-';
                                let ngayRoi = tv.ngayChuyenDi ? new Date(tv.ngayChuyenDi).toLocaleDateString('vi-VN') : '-';
                                let isChuHopDong = tv.isChuHopDong ? '<span class="badge badge-primary"><i class="fas fa-crown"></i> Đại diện</span>' : '';
                                let trangThai = tv.ngayChuyenDi ? '<span class="badge badge-secondary">Đã chuyển đi</span>' : '<span class="badge badge-success">Đang ở</span>';
                                
                                let buttons = '';
                                if (!tv.ngayChuyenDi) {
                                    buttons += `<button type="button" class="btn btn-sm btn-warning btn-checkout" data-id="${tv.chiTietThanhVienHopDongId}" title="Báo chuyển đi"><i class="fas fa-sign-out-alt"></i></button> `;
                                }
                                if (!tv.isChuHopDong) {
                                    buttons += `<button type="button" class="btn btn-sm btn-danger btn-delete-member" data-id="${tv.chiTietThanhVienHopDongId}" title="Xoá thành viên (nhập sai)"><i class="fas fa-trash"></i></button>`;
                                }

                                html += `
                                    <tr>
                                        <td class="text-center align-middle">${index + 1}</td>
                                        <td class="align-middle"><strong>${tv.hoVaTen}</strong> ${isChuHopDong}</td>
                                        <td class="align-middle">${tv.soDienThoai || '-'}</td>
                                        <td class="align-middle">${tv.cccd || '-'}</td>
                                        <td class="align-middle">${ngayVao}</td>
                                        <td class="align-middle">${ngayRoi}</td>
                                        <td class="text-center align-middle">${trangThai}</td>
                                        <td class="text-center align-middle">${buttons}</td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="8" class="text-center text-muted">Chưa có thành viên nào.</td></tr>';
                        }
                        $('#thanhVienTbody').html(html);
                    },
                    error: function () {
                        $('#thanhVienTbody').html('<tr><td colspan="8" class="text-center text-danger">Lỗi khi tải dữ liệu!</td></tr>');
                    }
                });
            };

            // Nút mở modal thêm thành viên
            $(document).on('click', '#btnOpenAddMemberModal', function () {
                if (!currentHopDongId || currentHopDongId === 0) {
                    showToastr("Hợp đồng chưa được lưu. Vui lòng tạo hợp đồng trước khi thêm thành viên.", "warning");
                    return;
                }

                resetAddMemberForm();
                $('#addMemberModal').modal('show');
            });

            // Nút lưu thành viên mới
            $(document).on('click', '#btnSaveMember', function () {
                let hopDongId = currentHopDongId;
                let nguoiThueId = $('#addMember_NguoiThueId').val();
                let hoVaTen = $('#addMember_HoVaTen').val().trim();
                let soDienThoai = $('#addMember_SoDienThoai').val().trim();
                let cccd = $('#addMember_CCCD').val().trim();
                let ngayVaoDate = memberNgayVaoPicker.selectedDates[0];

                if (!ngayVaoDate) {
                    showToastr("Vui lòng chọn ngày vào.", "warning");
                    return;
                }

                if (!nguoiThueId) {
                    if (!hoVaTen || !soDienThoai || !cccd) {
                        showToastr("Vui lòng nhập đủ Họ tên, Số ĐT và CCCD cho khách mới.", "warning");
                        return;
                    }
                }

                let requestData = {
                    hopDongId: hopDongId,
                    nguoiThueId: nguoiThueId ? parseInt(nguoiThueId) : null,
                    hoVaTen: hoVaTen,
                    soDienThoai: soDienThoai,
                    cccd: cccd,
                    ngayVao: flatpickr.formatDate(ngayVaoDate, "Y-m-d")
                };

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                $.ajax({
                    url: '/ThanhVienHopDong/AddThanhVien',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (res) {
                        showToastr(res.message, "success");
                        $('#addMemberModal').modal('hide');
                        window.loadDanhSachThanhVien(hopDongId);
                    },
                    error: function (xhr) {
                        let msg = "Đã xảy ra lỗi!";
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        showToastr(msg, "error");
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thành viên');
                    }
                });
            });

            // Báo chuyển đi
            $(document).on('click', '.btn-checkout', function () {
                let id = $(this).data('id');
                if (confirm("Xác nhận thành viên này đã chuyển đi? (Ngày rời phòng sẽ cập nhật hôm nay)")) {
                    $.post(`/ThanhVienHopDong/BaoRoiPhong/${id}`, function (res) {
                        showToastr(res.message, "success");
                        window.loadDanhSachThanhVien(currentHopDongId);
                    }).fail(function (xhr) {
                        showToastr(xhr.responseJSON ? xhr.responseJSON.message : "Lỗi!", "error");
                    });
                }
            });

            // Xoá nhầm
            $(document).on('click', '.btn-delete-member', function () {
                let id = $(this).data('id');
                if (confirm("Bạn có chắc muốn xoá hoàn toàn bản ghi này?")) {
                    $.ajax({
                        url: `/ThanhVienHopDong/XoaThanhVien/${id}`,
                        type: 'DELETE',
                        success: function (res) {
                            showToastr(res.message, "success");
                            window.loadDanhSachThanhVien(currentHopDongId);
                        },
                        error: function (xhr) {
                            showToastr(xhr.responseJSON ? xhr.responseJSON.message : "Lỗi!", "error");
                        }
                    });
                }
            });
            // =============================================================

            // SỰ KIỆN LƯU DỮ LIỆU (Hợp đồng + Dịch vụ)
            $('#btnSaveData').on('click', function () {
                let maHopDong = $('#MaHopDong').val().trim();
                let phongTroId = $('#PhongTroId').val();
                let nguoiThueId = $('#NguoiThueId').val();

                // Lấy đối tượng Date thực tế từ Flatpickr
                let dateBatDau = batDauPicker.selectedDates[0];
                let dateKetThuc = ketThucPicker.selectedDates[0];

                let tienCocPhong = parseFloat($('#TienCocPhong').val() || 0);
                let tienThuePhong = parseFloat($('#TienThuePhong').val() || 0);

                if (!maHopDong || !phongTroId || !nguoiThueId || !dateBatDau) {
                    showToastr("Vui lòng nhập đầy đủ các trường bắt buộc (*).", "warning");
                    return;
                }

                if (tienThuePhong <= 0) {
                    showToastr("Vui lòng nhập Tiền Thuê Phòng (phải lớn hơn 0).", "warning");
                    return;
                }
                let requestData = {
                    hopDongId: currentHopDongId,
                    maHopDong: maHopDong,
                    phongTroId: parseInt(phongTroId),
                    nguoiThueId: parseInt(nguoiThueId),
                    // Format sang ISO string gửi lên cho backend .NET nhận diện đúng kiểu dữ liệu
                    thoiDiemBatDau: flatpickr.formatDate(dateBatDau, "Y-m-d"),
                    thoiDiemKetThuc: dateKetThuc ? flatpickr.formatDate(dateKetThuc, "Y-m-d") : null,
                    tienCocPhong: tienCocPhong,
                    tienThuePhong: tienThuePhong,
                    trangThaiHopDong: parseInt($('#TrangThaiHopDong').val() || 1),
                    nguoiDungCoOPhongKhong: $('#NguoiDungCoOPhongKhong').is(':checked')
                };

                let isUpdate = currentHopDongId > 0;
                let apiUrl = isUpdate ? `/HopDong/Update/${currentHopDongId}` : `/HopDong/Create`;
                let httpMethod = isUpdate ? 'PUT' : 'POST';

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                // Bước 1: Lưu hợp đồng
                $.ajax({
                    url: apiUrl,
                    type: httpMethod,
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (res) {
                        // Bước 2: Lưu dịch vụ đăng ký (nếu có dịch vụ nào được render)
                        let hasDichVu = $('#hopDongDichVuContainer .dkdv-checkbox').length > 0;
                        if (hasDichVu) {
                            saveDangKyDichVu(
                                parseInt(phongTroId),
                                'hopDongDichVuContainer',
                                function () {
                                    // Thành công cả 2
                                    showToastr(res.message || "Thao tác thành công!", "success");
                                    $('#hopDongModal').modal('hide');
                                    table.ajax.reload(null, false);
                                },
                                function (errMsg) {
                                    showToastr("Hợp đồng đã lưu, nhưng lỗi khi lưu dịch vụ: " + errMsg, "warning");
                                    $('#hopDongModal').modal('hide');
                                    table.ajax.reload(null, false);
                                }
                            );
                        } else {
                            showToastr(res.message || "Thao tác thành công!", "success");
                            $('#hopDongModal').modal('hide');
                            table.ajax.reload(null, false);
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = "Đã xảy ra lỗi!";
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.message) {
                                errorMessage = xhr.responseJSON.message;
                            } else if (xhr.responseJSON.errors) {
                                // Lấy tất cả thông báo lỗi từ ModelState (ASP.NET Core validation)
                                errorMessage = Object.values(xhr.responseJSON.errors).flat().join('\n');
                            }
                        }
                        showToastr(errorMessage, "error");
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thông tin');
                    }
                });
            });

            // SỰ KIỆN NÚT SỬA (ĐỔ DỮ LIỆU)
            $('#hopDongTable tbody').on('click', '.btn-edit', function () {
                let id = $(this).data('id');
                currentHopDongId = id;

                let $btn = $(this);
                let originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: `/HopDong/GetById/${id}`,
                    type: 'GET',
                    success: function (res) {
                        $('#MaHopDong').val(res.maHopDong);
                        if(res.phongTroId) {
                            window.isBindingData = true; // Tránh trigger đổi giá phòng/dịch vụ
                            // DTO đã flatten: dùng res.chiNhanhId thay vì res.phongTro.chiNhanhId
                            $('#ChiNhanhId').val(res.chiNhanhId || '').trigger('change');
                            setTimeout(() => {
                                // Nếu phòng đang thuê ko nằm trong danh sách phòng trống, phải tự thêm option
                                if ($('#PhongTroId option[value="'+res.phongTroId+'"]').length === 0) {
                                    // DTO đã flatten: dùng res.soPhong trực tiếp
                                    let soPhongName = res.soPhong || res.phongTroId;
                                    $('#PhongTroId').append(`<option value="${res.phongTroId}" data-gia-thue="${res.tienThuePhong}">${soPhongName}</option>`);
                                }
                                $('#PhongTroId').val(res.phongTroId).change();
                                window.isBindingData = false;

                                // Load dịch vụ đã đăng ký cho phòng này
                                setTimeout(() => {
                                    $.get(`/DangKyDichVu/GetByPhong?phongTroId=${res.phongTroId}`, function (dvData) {
                                        renderDangKyDichVu('hopDongDichVuContainer', dvData, false);
                                    });
                                }, 100);
                            }, 150);
                        }

                        // Nếu danh sách không chứa người thuê hiện tại, thêm tạm vào
                        if ($('#NguoiThueId option[value="'+res.nguoiThueId+'"]').length === 0) {
                            $('#NguoiThueId').append(`<option value="${res.nguoiThueId}">${res.tenNguoiThue || "Khách thuê (ID: " + res.nguoiThueId + ")"}</option>`);
                        }
                        $('#NguoiThueId').val(res.nguoiThueId).trigger('change');

                        // Khóa các select vì không cho phép đổi chi nhánh, phòng, hoặc người thuê
                        $('#ChiNhanhId').prop('disabled', true);
                        $('#PhongTroId').prop('disabled', true);
                        $('#NguoiThueId').prop('disabled', true);
                        
                        // Khi cập nhật thì ẩn checkbox này đi
                        $('#groupNguoiDungCoO').hide();

                        // Mở dropdown Trạng Thái
                        $('#groupTrangThaiHopDong').show();
                        $('#TrangThaiHopDong').val(res.trangThaiHopDong);

                        // Set ngày tháng thông qua hàm setDate của Flatpickr
                        if(res.thoiDiemBatDau) batDauPicker.setDate(new Date(res.thoiDiemBatDau));
                        if(res.thoiDiemKetThuc) ketThucPicker.setDate(new Date(res.thoiDiemKetThuc));
                        else ketThucPicker.clear();

                        $('#TienCocPhong').val(res.tienCocPhong);
                        $('#TienThuePhong').val(res.tienThuePhong);

                        // Hiển thị tab thành viên và load dữ liệu
                        $('#nav-item-thanhvien').show();
                        if (typeof window.loadDanhSachThanhVien === "function") {
                            window.loadDanhSachThanhVien(id);
                        }

                        // Chuyển về tab thông tin
                        $('#tab-thongtin').tab('show');

                        $('#modalTitle').text('Cập nhật Hợp Đồng');
                        $('#hopDongModal').modal('show');
                    },
                    error: function () { showToastr("Không thể tải thông tin.", "error"); },
                    complete: function() { $btn.prop('disabled', false).html(originalHtml); }
                });
            });

            // SỰ KIỆN NÚT XÓA
            $('#hopDongTable tbody').on('click', '.btn-delete', function () {
                let id = $(this).data('id');
                if (confirm('Bạn có chắc chắn muốn xóa hợp đồng này?')) {
                    let $btn = $(this);
                    let originalHtml = $btn.html();
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                    $.ajax({
                        url: `/HopDong/Delete/${id}`,
                        type: 'DELETE',
                        success: function (res) {
                            showToastr(res.message || "Đã xóa.", "success");
                            table.ajax.reload(null, false);
                        },
                        error: function (xhr) {
                            let msg = "Lỗi khi xóa!";
                            if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                            showToastr(msg, "error");
                            $btn.prop('disabled', false).html(originalHtml);
                        }
                    });
                }
            });
        });
    </script>
}
