@model IEnumerable<QuanLyChoThuePhongTroWeb.Models.YeuCauSuCo>
@using QuanLyChoThuePhongTroWeb.Models

@{
    ViewData["Title"] = "Quản lý Yêu cầu sự cố";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold d-flex align-items-center">
                    <i class="ti ti-tools me-2"></i> Quản lý Sự cố & Sửa chữa
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card shadow-sm border-0">
            <!-- Filter Section -->
            <div class="card-body border-bottom py-3 bg-light">
                <form method="get" class="row g-3 align-items-center m-0">
                    <div class="col-auto d-flex align-items-center text-muted font-weight-medium ps-0">
                        <i class="ti ti-filter me-2 text-secondary"></i> <span>Lọc kết quả:</span>
                    </div>
                    <div class="col-auto">
                        <select name="chiNhanhId" class="form-select form-select-sm shadow-none border-secondary" asp-items="ViewBag.ChiNhanhId" onchange="this.form.submit()">
                            <option value="">-- Tất cả chi nhánh --</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <select name="trangThai" class="form-select form-select-sm shadow-none border-secondary" onchange="this.form.submit()">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="0" selected="@(ViewBag.CurrentTrangThai == TrangThaiSuCo.ChoTiepNhan)">Chờ tiếp nhận</option>
                            <option value="1" selected="@(ViewBag.CurrentTrangThai == TrangThaiSuCo.DangXuLy)">Đang xử lý</option>
                            <option value="2" selected="@(ViewBag.CurrentTrangThai == TrangThaiSuCo.DaHoanThanh)">Đã hoàn thành</option>
                            <option value="3" selected="@(ViewBag.CurrentTrangThai == TrangThaiSuCo.DaHuy)">Đã từ chối/hủy</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <select name="soThang" class="form-select form-select-sm shadow-none border-secondary" onchange="this.form.submit()">
                            <option value="1" selected="@(ViewBag.CurrentSoThang == 1)">1 tháng gần đây</option>
                            <option value="3" selected="@(ViewBag.CurrentSoThang == 3)">3 tháng gần đây</option>
                            <option value="6" selected="@(ViewBag.CurrentSoThang == 6)">6 tháng gần đây</option>
                            <option value="12" selected="@(ViewBag.CurrentSoThang == 12)">1 năm gần đây</option>
                            <option value="0" selected="@(ViewBag.CurrentSoThang == 0)">Tất cả thời gian</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="suCoTable" class="table table-vcenter card-table table-striped table-hover w-100">
                        <thead>
                            <tr>
                                <th>Ngày báo cáo</th>
                                <th>Phòng / Chi nhánh</th>
                                <th>Người báo cáo</th>
                                <th>Sự cố</th>
                                <th>Trạng thái</th>
                                <th>Chi phí</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NgayGui.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <strong>@item.PhongTro.SoPhong</strong><br />
                                        <small class="text-muted">@item.PhongTro.ChiNhanh.TenChiNhanh</small>
                                    </td>
                                    <td>
                                        @item.NguoiThue.HoVaTen<br />
                                        <small class="text-muted">@item.NguoiThue.SoDienThoai</small>
                                    </td>
                                    <td>
                                        <strong>@item.TieuDe</strong>
                                        <div class="text-muted mt-1 text-truncate" style="max-width: 200px;" title="@item.MoTa">@item.MoTa</div>
                                        @if (!string.IsNullOrEmpty(item.HinhAnhUrl))
                                        {
                                            var urls = item.HinhAnhUrl.Split(',');
                                            <div class="mt-1">
                                                @foreach (var url in urls)
                                                {
                                                    <a href="@url" target="_blank" class="badge bg-blue-lt me-1 mb-1"><i class="ti ti-image me-1"></i>Xem ảnh</a>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TrangThai == TrangThaiSuCo.ChoTiepNhan)
                                        {
                                            <span class="badge bg-yellow-lt">Chờ tiếp nhận</span>
                                        }
                                        else if (item.TrangThai == TrangThaiSuCo.DangXuLy)
                                        {
                                            <span class="badge bg-blue-lt">Đang xử lý</span>
                                        }
                                        else if (item.TrangThai == TrangThaiSuCo.DaHoanThanh)
                                        {
                                            <span class="badge bg-green-lt">Đã hoàn thành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-red-lt">Đã hủy/Từ chối</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ChiPhiSuaChua > 0)
                                        {
                                            <strong class="text-danger">@item.ChiPhiSuaChua.ToString("N0") đ</strong>
                                            @if (item.CongVaoHoaDon)
                                            {
                                                <br />
                                    
                                                <small class="text-muted">(Đã cộng hóa đơn)</small>
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-list flex-nowrap justify-content-center">
                                            <button class="btn btn-icon btn-ghost-warning btn-sm btn-update-suco" title="Cập nhật"
                                                    data-id="@item.Id"
                                                    data-trangthai="@((int)item.TrangThai)"
                                                    data-chiphi="@item.ChiPhiSuaChua"
                                                    data-conghoadon="@item.CongVaoHoaDon.ToString().ToLower()"
                                                    data-lydo="@(item.LyDoTuChoi ?? "")"
                                                    data-ghichu="@(item.GhiChuAdmin ?? "")">
                                                <i class="ti ti-edit"></i>
                                            </button>
                                            <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete-suco" data-id="@item.Id" title="Xóa">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Modal Cập nhật trạng thái -->
<div class="modal modal-blur fade" id="updateModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật Trạng thái Sự cố</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="frmUpdate">
                    <input type="hidden" id="suCoId" name="Id" />
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label">Trạng thái xử lý</label>
                        <select id="selTrangThai" name="TrangThai" class="form-select">
                            <option value="0">Chờ tiếp nhận</option>
                            <option value="1">Đang xử lý</option>
                            <option value="2">Đã hoàn thành</option>
                            <option value="3">Đã từ chối/hủy</option>
                        </select>
                    </div>
                    
                    <div id="divLyDoTuChoi" class="mb-3" style="display:none;">
                        <label class="form-label required text-danger">Lý do từ chối/hủy</label>
                        <textarea id="txtLyDoTuChoi" name="LyDoTuChoi" class="form-control" rows="2" placeholder="Bắt buộc nhập lý do nếu từ chối..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Chi phí sửa chữa (VNĐ)</label>
                        <input type="number" id="txtChiPhi" name="ChiPhiSuaChua" class="form-control" value="0" min="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" id="chkCongHoaDon" name="CongVaoHoaDon" value="true" class="form-check-input"/>
                            <span class="form-check-label text-danger font-weight-bold">
                                Cộng số tiền này vào hóa đơn tháng tới của phòng
                            </span>
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ghi chú nội bộ (Admin)</label>
                        <textarea id="txtGhiChu" name="GhiChuAdmin" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold shadow-sm" onclick="saveUpdate()"><i class="ti ti-device-floppy me-1"></i> Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Khởi tạo DataTable
            $('#suCoTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "order": [], // Không tự động sort, giữ nguyên thứ tự Backend trả về
                "columnDefs": [
                    { "orderable": false, "targets": [6] } // Cột thao tác không cho sort
                ]
            });

            $('#selTrangThai').change(function() {
                if ($(this).val() == '3') {
                    $('#divLyDoTuChoi').slideDown();
                } else {
                    $('#divLyDoTuChoi').slideUp();
                }
            });

            $(document).on('click', '.btn-update-suco', function() {
                var $btn = $(this);
                $('#suCoId').val($btn.data('id'));
                $('#selTrangThai').val($btn.data('trangthai')).trigger('change');
                $('#txtChiPhi').val($btn.data('chiphi'));
                $('#chkCongHoaDon').prop('checked', $btn.data('conghoadon'));
                $('#txtLyDoTuChoi').val($btn.data('lydo'));
                $('#txtGhiChu').val($btn.data('ghichu'));
                
                var modal = new bootstrap.Modal(document.getElementById('updateModal'));
                modal.show();
            });

            $(document).on('click', '.btn-delete-suco', function() {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Xóa báo cáo sự cố?',
                    text: 'Bạn có chắc chắn muốn xóa báo cáo này? Hành động này không thể hoàn tác.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var token = $('input[name="__RequestVerificationToken"]').val();
                        $.post('/QuanLyNhaTro/YeuCauSuCo/Delete', { id: id, __RequestVerificationToken: token }, function(res) {
                            if (res.success) {
                                showSuccess('Đã xóa thành công!').then(() => location.reload());
                            } else {
                                showError(res.message);
                            }
                        });
                    }
                });
            });
        });

        function saveUpdate() {
            if ($('#selTrangThai').val() == '3' && $.trim($('#txtLyDoTuChoi').val()) === '') {
                showError("Bạn phải nhập lý do từ chối!");
                $('#txtLyDoTuChoi').focus();
                return;
            }

            var formData = $('#frmUpdate').serialize();
            $.ajax({
                url: '/QuanLyNhaTro/YeuCauSuCo/UpdateStatus',
                type: 'POST',
                data: formData,
                success: function(res) {
                    if (res.success) {
                        showSuccess(res.message).then(() => location.reload());
                    } else {
                        showError(res.message);
                    }
                },
                error: function() {
                    showError('Đã xảy ra lỗi hệ thống.');
                }
            });
        }
    </script>
}
