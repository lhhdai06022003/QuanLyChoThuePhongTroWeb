@model IEnumerable<QuanLyChoThuePhongTroWeb.Models.NguoiDung>
@{
    ViewData["Title"] = "Quản lý Tài Khoản Đăng Nhập";
}



<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold d-flex align-items-center">
                    <i class="ti ti-user-cog me-2"></i> Quản lý Tài Khoản Đăng Nhập
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button type="button" class="btn btn-success font-weight-bold shadow-sm d-none d-sm-inline-block" id="btnOpenAddModal">
                        <i class="ti ti-circle-plus me-1"></i> Thêm Tài Khoản
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <table id="nguoiDungTable" class="table table-bordered table-striped table-hover w-100">
                    <thead class="thead-light">
                        <tr>
                            <th width="5%" class="text-center">STT</th>
                            <th width="20%">Tên Đăng Nhập</th>
                            <th width="15%">Quyền Hạn (Role)</th>
                            <th width="15%">Trạng Thái</th>
                            <th width="15%">Ngày Tạo</th>
                            <th width="15%">Đăng Nhập Cuối</th>
                            <th width="15%" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nguoiDungModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modalTitle">Thêm Tài Khoản Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="frmNguoiDung">
                    <div class="form-group">
                        <label>Quyền Hạn (Role) <span class="text-danger">*</span></label>
                        <select class="form-control" id="Role">
                            <option value="0">Admin</option>
                            <option value="1">Nhân Viên</option>
                            <option value="2">Khách Thuê</option>
                        </select>
                    </div>

                    <div class="form-group d-none" id="divNguoiThue">
                        <label>Người Thuê (Khách có hợp đồng) <span class="text-danger">*</span></label>
                        <select class="form-control select2" id="NguoiThueId" style="width: 100%;">
                            <option value="">-- Chọn khách thuê --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Tên Đăng Nhập <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="TenDangNhap" required placeholder="Nhập tên đăng nhập...">
                    </div>

                    <div class="form-group" id="divMatKhau">
                        <label>Mật Khẩu <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="MatKhau" placeholder="Nhập mật khẩu...">
                        <small class="text-muted class-edit-note d-none">Để trống nếu không muốn thay đổi mật khẩu</small>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="IsActive" checked>
                            <label class="custom-control-input-label" for="IsActive">Kích hoạt tài khoản</label>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold shadow-sm" id="btnSaveData">
                    <i class="ti ti-plus me-1"></i> Thêm dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentNguoiDungId = 0;

            function formatDateTime(dateString) {
                if (!dateString) return `<span class="text-muted font-italic">Chưa từng</span>`;
                var date = new Date(dateString);
                return date.toLocaleString('vi-VN');
            }

            function loadNguoiThueDropdown() {
                $.ajax({
                    url: '/NguoiThue/GetCoHopDong',
                    type: 'GET',
                    success: function (res) {
                        let html = '<option value="">-- Chọn khách thuê --</option>';
                        res.forEach(function (item) {
                            html += `<option value="${item.value}">${item.text}</option>`;
                        });
                        $('#NguoiThueId').html(html);
                    }
                });
            }
            loadNguoiThueDropdown();

            if ($.fn.select2) {
                $('#NguoiThueId').select2({ dropdownParent: $('#nguoiDungModal') });
            }

            $('#Role').on('change', function () {
                if ($(this).val() == "2") {
                    $('#divNguoiThue').removeClass('d-none');
                    if (currentNguoiDungId === 0) {
                        $('#TenDangNhap').prop('disabled', true).val('');
                    }
                } else {
                    $('#divNguoiThue').addClass('d-none');
                    $('#NguoiThueId').val('').trigger('change.select2');
                    if (currentNguoiDungId === 0) {
                        $('#TenDangNhap').prop('disabled', false).val('');
                    }
                }
            });

            $('#NguoiThueId').on('change', function () {
                if ($('#Role').val() != "2") return;
                
                let id = $(this).val();
                if (id && currentNguoiDungId === 0) {
                    $.ajax({
                        url: '/NguoiThue/GetById/' + id,
                        type: 'GET',
                        success: function (res) {
                            if (res && res.email) {
                                $('#TenDangNhap').val(res.email);
                            } else {
                                showWarning("Người thuê này chưa có Email, vui lòng nhập tay tên đăng nhập!");
                                $('#TenDangNhap').val('').prop('disabled', false);
                            }
                        }
                    });
                }
            });

            // Khởi tạo Datatable gọi về cấu trúc chuẩn của NguoiDungController
            var table = $('#nguoiDungTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "ajax": {
                    "url": "/QuanLyNhaTro/NguoiDung/GetAllApi", // Đường dẫn lấy dữ liệu API danh sách
                    "type": "GET",
                    "dataSrc": ""
                },
                "columns": [
                    {
                        "data": null,
                        "className": "text-center align-middle",
                        "orderable": false,
                        "searchable": false,
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    {
                        "data": "tenDangNhap",
                        "render": function(data) {
                            return `<span class="font-weight-bold text-primary">${data}</span>`;
                        }
                    },
                    {
                        "data": "role",
                        "render": function(data) {
                            if (data === 0) return `<span class="badge bg-danger-lt text-danger">Admin</span>`;
                            if (data === 1) return `<span class="badge bg-primary-lt text-primary">Nhân Viên</span>`;
                            if (data === 2) return `<span class="badge bg-info-lt text-info">Khách Thuê</span>`;
                            return `<span class="badge bg-secondary-lt text-secondary">N/A</span>`;
                        }
                    },
                    {
                        "data": "isActive",
                        "className": "text-center align-middle",
                        "render": function(data) {
                            return data
                                ? `<span class="badge bg-success-lt text-success"><i class="ti ti-circle-check me-1"></i> Hoạt động</span>`
                                : `<span class="badge bg-secondary-lt text-secondary"><i class="ti ti-ban me-1"></i> Khóa</span>`;
                        }
                    },
                    {
                        "data": "ngayTao",
                        "render": function(data) { return formatDateTime(data); }
                    },
                    {
                        "data": "lanDangNhapCuoi",
                        "render": function(data) { return formatDateTime(data); }
                    },
                    {
                        "data": "nguoiDungId",
                        "className": "text-center align-middle",
                        "orderable": false,
                        "render": function (data, type, row) {
                            let resetBtn = '';
                            if (row.role === 2) {
                                resetBtn = `
                                    <button class="btn btn-icon btn-ghost-info btn-sm btn-reset" data-id="${data}" title="Đặt lại mật khẩu">
                                        <i class="ti ti-key"></i>
                                    </button>
                                `;
                            }
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    ${resetBtn}
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit" data-id="${data}" title="Sửa">
                                        <i class="ti ti-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete" data-id="${data}" title="Xóa">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                "order": []
            });

            // --- SỰ KIỆN LƯU DỮ LIỆU (ADD / UPDATE) ---
            $('#btnSaveData').on('click', function () {
                let tenDangNhap = $('#TenDangNhap').val().trim();
                let matKhau = $('#MatKhau').val();
                let role = parseInt($('#Role').val(), 10);
                let isActive = $('#IsActive').is(':checked');
                let nguoiThueId = $('#NguoiThueId').val();

                if (!tenDangNhap) {
                    showWarning("Vui lòng điền Tên đăng nhập!");
                    return;
                }

                if (role === 2 && !nguoiThueId) {
                    showWarning("Vui lòng chọn người thuê khi chọn quyền là Khách Thuê!");
                    return;
                }

                let isUpdate = currentNguoiDungId > 0;

                if (!isUpdate && !matKhau) {
                    showWarning("Vui lòng nhập mật khẩu cho tài khoản mới!");
                    return;
                }

                let requestData = {
                    tenDangNhap: tenDangNhap,
                    role: role,
                    isActive: isActive,
                    matKhauHash: matKhau,
                    nguoiThueId: nguoiThueId ? parseInt(nguoiThueId, 10) : null
                };

                let apiUrl = isUpdate ? `/QuanLyNhaTro/NguoiDung/EditApi/${currentNguoiDungId}` : `/QuanLyNhaTro/NguoiDung/CreateApi`;
                let httpMethod = 'POST'; // Dùng POST đồng bộ cấu trúc MVC Route của bạn

                if (isUpdate) {
                    requestData.nguoiDungId = parseInt(currentNguoiDungId, 10);
                }

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật tài khoản này?' : 'Bạn có chắc chắn muốn tạo tài khoản mới này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="ti ti-spinner fa-spin"></i> Đang xử lý...');

                        $.ajax({
                            url: apiUrl,
                            type: httpMethod,
                            contentType: 'application/json',
                            data: JSON.stringify(requestData),
                            success: function (res) {
                                if(res.success) {
                                    showSuccess(res.message || "Lưu thành công!");
                                    $('#nguoiDungModal').modal('hide');
                                    table.ajax.reload(null, false);
                                } else {
                                    showError(res.message || "Đã xảy ra lỗi khi lưu dữ liệu.");
                                }
                            },
                            error: function () {
                                showError("Lỗi hệ thống máy chủ hoặc dữ liệu không hợp lệ!");
                            },
                            complete: function () {
                                if (isUpdate) {
                                    $btn.prop('disabled', false).html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                                } else {
                                    $btn.prop('disabled', false).html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                                }
                            }
                        });
                    }
                });
            });

            // --- BẮT SỰ KIỆN NÚT SỬA (EDIT) ---
            $('#nguoiDungTable tbody').on('click', '.btn-edit', function () {
                currentNguoiDungId = $(this).data('id');

                $.ajax({
                    url: '/QuanLyNhaTro/NguoiDung/GetByIdApi/' + currentNguoiDungId,
                    type: 'GET',
                    success: function (res) {
                        if (res) {
                            $('#TenDangNhap').val(res.tenDangNhap).prop('disabled', true); // Khóa không cho sửa username
                            $('#MatKhau').val(''); // Không đổ lại mật khẩu cũ vì đã băm
                            $('#Role').val(res.role).trigger('change');
                            $('#IsActive').prop('checked', res.isActive);

                            if (res.role === 2 && res.nguoiThueId) {
                                $('#NguoiThueId').val(res.nguoiThueId).trigger('change');
                            } else {
                                $('#NguoiThueId').val('').trigger('change');
                            }

                            $('.class-edit-note').removeClass('d-none');
                            $('#modalTitle').text('Cập nhật Tài Khoản');
                            $('#btnSaveData').removeClass('btn-primary').addClass('btn-success').addClass('font-weight-bold').addClass('shadow-sm').html('<i class="ti ti-device-floppy me-1"></i> Lưu dữ liệu');
                            $('#nguoiDungModal').modal('show');
                        }
                    },
                    error: function() {
                        showError("Không thể tải thông tin tài khoản này.");
                    }
                });
            });

            // --- BẮT SỰ KIỆN NÚT XÓA (DELETE MỀM) ---
            $('#nguoiDungTable tbody').on('click', '.btn-delete', function () {
                let id = $(this).data('id');
                let $btn = $(this);

                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa tài khoản người dùng này? (Tài khoản sẽ bị hủy kích hoạt và ẩn khỏi danh sách)',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="ti ti-spinner fa-spin"></i>');

                        $.ajax({
                            url: '/QuanLyNhaTro/NguoiDung/DeleteApi/' + id,
                            type: 'POST',
                            success: function (res) {
                                if (res.success) {
                                    showSuccess(res.message || "Xóa thành công!");
                                    table.ajax.reload(null, false);
                                } else {
                                    showError(res.message || "Không thể xóa!");
                                    $btn.prop('disabled', false).html(originalHtml);
                                }
                            },
                            error: function () {
                                showError("Lỗi kết nối máy chủ khi thực hiện xóa!");
                                $btn.prop('disabled', false).html(originalHtml);
                            }
                        });
                    }
                });
            });

            // --- MỞ MODAL THÊM MỚI ---
            $('#btnOpenAddModal').on('click', function () {
                currentNguoiDungId = 0;
                $('#frmNguoiDung')[0].reset();
                $('#NguoiThueId').val('').trigger('change.select2');
                $('#Role').val(1).trigger('change');
                $('#TenDangNhap').prop('disabled', false);
                $('.class-edit-note').addClass('d-none');
                $('#modalTitle').text('Thêm Tài Khoản Mới');
                $('#btnSaveData').removeClass('btn-success').addClass('btn-primary').addClass('font-weight-bold').addClass('shadow-sm').html('<i class="ti ti-plus me-1"></i> Thêm dữ liệu');
                $('#nguoiDungModal').modal('show');
            });

            // --- ĐẶT LẠI MẬT KHẨU CHO KHÁCH THUÊ ---
            $('#nguoiDungTable tbody').on('click', '.btn-reset', function () {
                let id = $(this).data('id');
                let $btn = $(this);

                Swal.fire({
                    title: 'Đặt lại mật khẩu?',
                    text: 'Mật khẩu sẽ được đặt lại thành số điện thoại của người thuê. Bạn có chắc chắn?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="ti ti-spinner fa-spin"></i>');

                        $.ajax({
                            url: '/QuanLyNhaTro/NguoiDung/ResetPasswordToPhoneApi/' + id,
                            type: 'POST',
                            success: function (res) {
                                if (res.success) {
                                    showSuccess(res.message);
                                } else {
                                    showError(res.message);
                                }
                            },
                            error: function () {
                                showError("Lỗi kết nối máy chủ!");
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html(originalHtml);
                            }
                        });
                    }
                });
            });
        });
    </script>
}
@section Styles {
    <style>
    /* CSS hỗ trợ Select2 tương thích với Dark Mode của Tabler */
    .select2-container--default .select2-selection--single {
        background-color: var(--tblr-bg-surface);
        border-color: var(--tblr-border-color);
        color: var(--tblr-color);
        height: 38px;
        padding-top: 4px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: var(--tblr-color);
    }
    .select2-dropdown {
        background-color: var(--tblr-bg-surface);
        border-color: var(--tblr-border-color);
        color: var(--tblr-color);
    }
    .select2-search--dropdown .select2-search__field {
        background-color: var(--tblr-bg-surface);
        border-color: var(--tblr-border-color);
        color: var(--tblr-color);
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: var(--tblr-primary);
        color: #ffffff;
    }
    .select2-container--default .select2-results__option[aria-selected=true] {
        background-color: var(--tblr-bg-surface-secondary);
        color: var(--tblr-color);
    }
</style>
}
