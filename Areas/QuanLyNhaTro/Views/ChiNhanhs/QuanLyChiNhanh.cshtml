@model IEnumerable<QuanLyChoThuePhongTroWeb.Models.ChiNhanh>
@{
    ViewData["Title"] = "Quản lý Chi Nhánh";
    // Đảm bảo Layout được gọi đúng đường dẫn của bạn
     Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="fas fa-list"></i> Danh sách Chi nhánh</h3>
                <button type="button" class="btn btn-success btn-sm ml-auto" id="btnOpenAddModal">
                    <i class="fas fa-plus"></i> Thêm Chi Nhánh
                </button>
            </div>

            <div class="card-body">
                <!-- DataTables tự động chiếm 100% chiều rộng bằng class w-100 -->
                <table id="chiNhanhTable" class="table table-bordered table-striped table-hover w-100">
                    <thead class="thead-light">
                        <tr>
                            <th width="5%">STT</th>
                            <th width="10%">Mã CN</th>
                            <th width="20%">Tên Chi Nhánh</th>
                            <th width="25%">Địa Chỉ</th>
                            <th width="15%">Số Điện Thoại</th>
                            <th width="10%">Ngày Tạo</th>
                            <th width="15%" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <!-- ĐỂ TRỐNG TBODY -->
                </table>
            </div>
        </div>
    </div>
</section>

<!-- MODAL THÊM / SỬA -->
<div class="modal fade" id="chiNhanhModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modalTitle">Thêm Chi Nhánh Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <div class="form-group row mb-3">
                    <label for="MaChiNhanh" class="col-sm-3 col-form-label">Mã Chi Nhánh <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="MaChiNhanh" name="MaChiNhanh" required placeholder="Ví dụ: Q1, BT, TD..." maxlength="10">
                        <small class="form-text text-muted">Mã viết tắt viết liền không dấu, dùng để tự động sinh mã hợp đồng.</small>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="TenChiNhanh" class="col-sm-3 col-form-label">Tên Chi Nhánh <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="TenChiNhanh" name="TenChiNhanh" required placeholder="Nhập tên chi nhánh...">
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="SoDienThoai" class="col-sm-3 col-form-label">Số Điện Thoại</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="SoDienThoai" name="SoDienThoai" placeholder="Nhập SĐT liên hệ...">
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="DiaChi" class="col-sm-3 col-form-label">Địa Chỉ <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="DiaChi" name="DiaChi" required placeholder="Nhập địa chỉ đầy đủ...">
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="MoTa" class="col-sm-3 col-form-label">Mô Tả Thêm</label>
                    <div class="col-sm-9">
                        <textarea class="form-control" id="MoTa" name="MoTa" rows="3" placeholder="Ví dụ: Gần trường ĐH Sư Phạm Kỹ Thuật..."></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="submit" class="btn btn-primary" id="btnSaveData">
                    <i class="fas fa-save"></i> Lưu thông tin
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Biến toàn cục để lưu DataTables

        $(document).ready(function () {
            let currentChiNhanhId = 0;
            // 1. KHỞI TẠO DATATABLES BẰNG AJAX
            var table = $('#chiNhanhTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "ajax": {
                    "url": "/ChiNhanhs/DanhSachChiNhanh",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": null,
                        "className": "text-center align-middle",
                        "orderable": false,
                        "searchable": false,
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    {
                        "data": "maChiNhanh",
                        "render": function(data) {
                            return `<span class="font-weight-bold text-success">${data || ""}</span>`;
                        }
                    },
                    {
                        "data": "tenChiNhanh",
                        "render": function(data) {
                            return `<span class="font-weight-bold text-primary">${data}</span>`;
                        }
                    },
                    { "data": "diaChi" },
                    { "data": "soDienThoai" },
                    {
                        "data": "ngayTao",
                        "render": function(data) {
                            if(!data) return "";
                            // Chuyển đổi định dạng ngày tháng từ JSON sang DD/MM/YYYY
                            var date = new Date(data);
                            return date.toLocaleDateString('vi-VN');
                        }
                    },
                    {
                        "data": "chiNhanhId",
                        "className": "text-center align-middle",
                        "render": function (data) {
                            // Vẽ 2 nút Sửa và Xóa cho mỗi dòng bằng Ghost Buttons hiện đại
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit" data-id="${data}" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete" data-id="${data}" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                "order": [[ 0, "desc" ]] // Sắp xếp ID giảm dần (mới nhất lên trên)
            });

                // --- SỰ KIỆN LƯU DỮ LIỆU ---
            $('#btnSaveData').on('click', function () {
                let ma = $('#MaChiNhanh').val() || "";
                let ten = $('#TenChiNhanh').val() || "";
                let sdt = $('#SoDienThoai').val() || "";
                let diaChi = $('#DiaChi').val() || "";
                let moTa = $('#MoTa').val() || "";

                if (ma.trim() === "") {
                    showWarning('Vui lòng nhập mã chi nhánh!');
                    return;
                }
                if (ten.trim() === "") {
                    showWarning('Vui lòng nhập tên chi nhánh!');
                    return;
                }
                if (diaChi.trim() === "") {
                    showWarning('Vui lòng nhập địa chỉ!');
                    return;
                }

                let isUpdate = currentChiNhanhId > 0;
                let actionUrl = isUpdate ? '/ChiNhanhs/CapNhatChiNhanh' : '/ChiNhanhs/ThemChiNhanhMoi';

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật chi nhánh này?' : 'Bạn có chắc chắn muốn thêm chi nhánh này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                        $.ajax({
                            url: actionUrl,
                            type: 'POST',
                            data: {
                                ChiNhanhId: currentChiNhanhId,
                                MaChiNhanh: ma,
                                TenChiNhanh: ten,
                                SoDienThoai: sdt,
                                DiaChi: diaChi,
                                MoTa: moTa
                            },
                            success: function (res) {
                                if (res.success) {
                                    showSuccess(res.message);
                                    $('#chiNhanhModal').modal('hide');
                                    table.ajax.reload(null, false);
                                } else {
                                    showError('Lỗi: ' + res.message);
                                }
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thông tin');
                            }
                        });
                    }
                });
            });
                    // Bắt sự kiện cho nút SỬA (Edit)
            $('#chiNhanhTable tbody').on('click', '.btn-edit', function () {
                // Gán ID của dòng đang được click vào biến
                currentChiNhanhId = $(this).data('id');

                $.ajax({
                    url: '/ChiNhanhs/GetChiNhanh?id=' + currentChiNhanhId,
                    type: 'GET',
                    success: function (res) {
                        if (res.success && res.data) {
                            $('#MaChiNhanh').val(res.data.maChiNhanh);
                            $('#TenChiNhanh').val(res.data.tenChiNhanh);
                            $('#SoDienThoai').val(res.data.soDienThoai);
                            $('#DiaChi').val(res.data.diaChi);
                            $('#MoTa').val(res.data.moTa);

                            $('#modalTitle').text('Cập nhật Chi Nhánh');
                            $('#chiNhanhModal').modal('show');
                        }
                    }
                });
            });
            // Bắt sự kiện cho nút XÓA (Delete)
            $('#chiNhanhTable tbody').on('click', '.btn-delete', function () {
                let id = $(this).data('id');
                let $btn = $(this);

                // 1. KIỂM TRA FRONTEND TRƯỚC KHI GỬI
                if (!id || isNaN(id) || parseInt(id) <= 0) {
                    Swal.fire('Lỗi', 'Dữ liệu không hợp lệ. Vui lòng tải lại trang!', 'error');
                    return;
                }

                // 2. XÁC NHẬN HÀNH ĐỘNG NGUY HIỂM (Confirm)
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa chi nhánh này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // 3. NGĂN CHẶN SPAM CLICK
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                        // 4. GỬI REQUEST XÓA
                        $.ajax({
                            url: '/ChiNhanhs/XoaChiNhanh', 
                            type: 'POST',
                            data: { id: id },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Thành công', res.message || 'Xóa thành công!', 'success');
                                    if (typeof table !== 'undefined') {
                                        table.ajax.reload(null, false);
                                    }
                                } else {
                                    Swal.fire('Lỗi', 'Không thể xóa: ' + (res.message || 'Chi nhánh đang được sử dụng.'), 'error');
                                    $btn.prop('disabled', false).html(originalHtml);
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error("Chi tiết lỗi:", error);
                                Swal.fire('Lỗi', 'Lỗi kết nối máy chủ khi thực hiện xóa!', 'error');
                                $btn.prop('disabled', false).html(originalHtml);
                            }
                        });
                    }
                });
            });
            $('#btnOpenAddModal').on('click', function () {
                currentChiNhanhId = 0; // Đặt lại về 0

                // Reset trắng các ô nhập liệu
                $('#MaChiNhanh').val('');
                $('#TenChiNhanh').val('');
                $('#SoDienThoai').val('');
                $('#DiaChi').val('');
                $('#MoTa').val('');

                $('#modalTitle').text('Thêm Chi Nhánh Mới');
                $('#chiNhanhModal').modal('show');
            });
        });
    </script>
}
No newline at end of file
