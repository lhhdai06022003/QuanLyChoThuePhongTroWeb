@{
    ViewData["Title"] = "Quản lý Dịch vụ";
}
<style>
    /* Custom Badges for Light & Dark Modes using opacity */
    .badge-service-required {
        background-color: rgba(13, 110, 253, 0.15) !important;
        color: #0d6efd !important;
        border: 1px solid rgba(13, 110, 253, 0.25) !important;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.85rem;
    }

    .badge-service-optional {
        background-color: rgba(108, 117, 125, 0.15) !important;
        color: #6c757d !important;
        border: 1px solid rgba(108, 117, 125, 0.25) !important;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.85rem;
    }
    
    [data-bs-theme="dark"] .badge-service-required {
        background-color: rgba(110, 168, 254, 0.2) !important;
        color: #6ea8fe !important;
        border-color: rgba(110, 168, 254, 0.3) !important;
    }
    [data-bs-theme="dark"] .badge-service-optional {
        background-color: rgba(173, 181, 189, 0.2) !important;
        color: #adb5bd !important;
        border-color: rgba(173, 181, 189, 0.3) !important;
    }

    /* Standardized SweetAlert2 custom popup */
    .swal2-popup.swal2-custom-popup {
        border-radius: 12px !important;
        font-family: inherit !important;
    }
    .swal2-custom-popup .swal2-title {
        font-weight: 600 !important;
    }
    .swal2-custom-popup .swal2-actions button {
        border-radius: 6px !important;
        font-weight: 500 !important;
        padding: 8px 20px !important;
    }
</style>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline card-outline-tabs">
                    <div class="card-header p-0 border-bottom-0">
                        <ul class="nav nav-tabs" id="custom-tabs-four-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="tab-danh-muc-dich-vu" data-bs-toggle="tab" href="#content-danh-muc-dich-vu" role="tab" aria-controls="content-danh-muc-dich-vu" aria-selected="true">Danh mục Dịch vụ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="tab-bang-gia" data-bs-toggle="tab" href="#content-bang-gia" role="tab" aria-controls="content-bang-gia" aria-selected="false">Bảng giá theo Chi nhánh</a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-four-tabContent">
                            <!-- TAB DANH MỤC DỊCH VỤ -->
                            <div class="tab-pane fade show active" id="content-danh-muc-dich-vu" role="tabpanel" aria-labelledby="tab-danh-muc-dich-vu">
                                <div class="mb-3 d-flex justify-content-between">
                                    <h4 class="m-0"><i class="fas fa-list"></i> Danh sách Dịch vụ Chung</h4>
                                    <button class="btn btn-success" id="btnOpenAddDichVu"><i class="fas fa-plus"></i> Thêm Dịch vụ</button>
                                </div>
                                 <table id="dichVuTable" class="table table-bordered table-striped w-100">
                                    <thead>
                                        <tr>
                                            <th class="text-center" width="5%">STT</th>
                                            <th>Tên Dịch Vụ</th>
                                            <th>Đơn Vị Tính</th>
                                            <th>Ghi Chú</th>
                                            <th class="text-center" width="15%">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <!-- TAB BẢNG GIÁ THEO CHI NHÁNH -->
                            <div class="tab-pane fade" id="content-bang-gia" role="tabpanel" aria-labelledby="tab-bang-gia">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label>Lọc theo Chi Nhánh</label>
                                        <select class="form-control" id="filterChiNhanh">
                                            <option value="0">-- Tất cả chi nhánh --</option>
                                            @if (ViewBag.ListChiNhanh != null)
                                            {
                                                foreach (var cn in ViewBag.ListChiNhanh)
                                                {
                                                    <option value="@cn.Value">@cn.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-8 d-flex align-items-end justify-content-end">
                                        <button class="btn btn-success" id="btnOpenAddGia"><i class="fas fa-plus"></i> Cài đặt Giá mới</button>
                                    </div>
                                </div>
                                <table id="bangGiaTable" class="table table-bordered table-striped w-100">
                                    <thead>
                                        <tr>
                                            <th class="text-center" width="5%">STT</th>
                                            <th>Chi Nhánh</th>
                                            <th>Tên Dịch Vụ</th>
                                            <th>Giá Dịch Vụ (VNĐ)</th>
                                            <th class="text-center" width="12%">Mặc Định</th>
                                            <th class="text-center" width="15%">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Thêm/Sửa Dịch Vụ -->
<div class="modal fade" id="dichVuModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="dichVuModalTitle">Thêm Dịch Vụ Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DichVuId" value="0" />
                <div class="form-group mb-3">
                    <label for="TenDichVu">Tên Dịch Vụ <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="TenDichVu" placeholder="VD: Điện, Nước, Rác...">
                </div>
                <div class="form-group mb-3">
                    <label for="DonVi">Đơn Vị Tính <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="DonVi" placeholder="VD: kWh, m3, Tháng...">
                </div>
                <div class="form-group mb-3">
                    <label for="GhiChuDichVu">Ghi Chú</label>
                    <textarea class="form-control" id="GhiChuDichVu" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveDichVu">Lưu Dịch Vụ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Bảng Giá -->
<div class="modal fade" id="bangGiaModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="bangGiaModalTitle">Cài đặt Giá Dịch Vụ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DichVuChiNhanhId" value="0" />
                <div class="form-group mb-3">
                    <label for="BgChiNhanhId">Chi Nhánh <span class="text-danger">*</span></label>
                    <select class="form-control" id="BgChiNhanhId">
                        <option value="">-- Chọn chi nhánh --</option>
                        @if (ViewBag.ListChiNhanh != null)
                        {
                            foreach (var cn in ViewBag.ListChiNhanh)
                            {
                                <option value="@cn.Value">@cn.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label for="BgDichVuId">Dịch Vụ <span class="text-danger">*</span></label>
                    <select class="form-control" id="BgDichVuId">
                        <option value="">-- Chọn dịch vụ --</option>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label for="GiaDichVu">Giá Dịch Vụ (VNĐ) <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="GiaDichVu" value="0" min="0">
                </div>
                <div class="form-group mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="MacDinhBangGia" role="switch">
                        <label class="form-check-label" for="MacDinhBangGia">
                            <strong>Bắt buộc sử dụng</strong>
                            <span class="text-muted" style="font-size:0.85rem;"> — Dịch vụ mặc định bắt buộc đăng ký ở chi nhánh này</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Đóng</button>
                <button type="button" class="btn btn-success" id="btnSaveBangGia">Lưu Bảng Giá</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hàm format tiền
            function formatVND(n) {
                if (n === null || n === undefined) return "0 ₫";
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
            }

            // Hàm helper hiển thị thông báo đồng bộ SweetAlert2
            function showSuccess(msg) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: msg,
                    confirmButtonColor: '#3085d6',
                    customClass: { popup: 'swal2-custom-popup' }
                });
            }

            function showError(msg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: msg,
                    confirmButtonColor: '#3085d6',
                    customClass: { popup: 'swal2-custom-popup' }
                });
            }

            function showWarning(msg) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thông báo',
                    text: msg,
                    confirmButtonColor: '#3085d6',
                    customClass: { popup: 'swal2-custom-popup' }
                });
            }

            // ================== TAB 1: DỊCH VỤ ==================
            var tableDichVu = $('#dichVuTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/DichVu/GetList",
                    "type": "POST"
                },
                "columns": [
                    { "data": null, "className": "text-center", "orderable": false, "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "tenDichVu", "name": "tenDichVu" },
                    { "data": "donVi" },
                    { "data": "ghiChu", "orderable": false },
                    {
                        "data": "dichVuId", "orderable": false, "className": "text-center align-middle",
                        "render": function(data) {
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit-dv" data-id="${data}" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete-dv" data-id="${data}" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            $('#btnOpenAddDichVu').click(function() {
                $('#DichVuId').val(0);
                $('#TenDichVu').val('');
                $('#DonVi').val('');
                $('#GhiChuDichVu').val('');
                $('#dichVuModalTitle').text('Thêm Dịch Vụ Mới');
                $('#dichVuModal').modal('show');
            });

            $('#btnSaveDichVu').click(function() {
                let id = $('#DichVuId').val();
                let ten = $('#TenDichVu').val().trim();
                let dvi = $('#DonVi').val().trim();
                let ghiChu = $('#GhiChuDichVu').val().trim();

                if(!ten || !dvi) { showWarning('Vui lòng nhập tên và đơn vị!'); return; }

                let req = { dichVuId: parseInt(id), tenDichVu: ten, donVi: dvi, ghiChu: ghiChu };
                let isUpdate = id > 0;

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật dịch vụ này?' : 'Bạn có chắc chắn muốn thêm dịch vụ này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: { popup: 'swal2-custom-popup' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                        $.ajax({
                            url: isUpdate ? `/DichVu/Update/${id}` : '/DichVu/Create',
                            type: isUpdate ? 'PUT' : 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message);
                                $('#dichVuModal').modal('hide');
                                tableDichVu.ajax.reload(null, false);
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra'); },
                            complete: function() { $btn.prop('disabled', false).text('Lưu Dịch Vụ'); }
                        });
                    }
                });
            });

            $('#dichVuTable').on('click', '.btn-edit-dv', function() {
                let id = $(this).data('id');
                $.get(`/DichVu/GetById/${id}`, function(res) {
                    $('#DichVuId').val(res.dichVuId);
                    $('#TenDichVu').val(res.tenDichVu);
                    $('#DonVi').val(res.donVi);
                    $('#GhiChuDichVu').val(res.ghiChu);
                    $('#dichVuModalTitle').text('Cập nhật Dịch Vụ');
                    $('#dichVuModal').modal('show');
                });
            });

            $('#dichVuTable').on('click', '.btn-delete-dv', function() {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa dịch vụ này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: { popup: 'swal2-custom-popup' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/DichVu/Delete/${id}`, type: 'DELETE',
                            success: function(res) {
                                showSuccess(res.message);
                                tableDichVu.ajax.reload(null, false);
                            },
                            error: function(xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra');
                            }
                        });
                    }
                });
            });

            // ================== TAB 2: BẢNG GIÁ CHI NHÁNH ==================
            var tableBangGia = $('#bangGiaTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "serverSide": true,
                "processing": true,
                "ajax": {
                    "url": "/DichVuChiNhanh/GetList",
                    "type": "POST",
                    "data": function(d) {
                        d.chiNhanhId = $('#filterChiNhanh').val() || 0;
                    }
                },
                "columns": [
                    { "data": null, "className": "text-center", "orderable": false, "render": (d,t,r,m) => m.row + m.settings._iDisplayStart + 1 },
                    { "data": "tenChiNhanh", "orderable": false },
                    { "data": "tenDichVu", "orderable": false },
                    { "data": "giaDichVu", "orderable": false, "render": function(d) { return formatVND(d); } },
                    {
                        "data": "macDinh", "orderable": false, "className": "text-center",
                        "render": function(data) {
                            return data
                                ? `<span class="badge-service-required"><i class="fas fa-lock"></i> Bắt buộc</span>`
                                : `<span class="badge-service-optional"><i class="fas fa-hand-pointer"></i> Tùy chọn</span>`;
                        }
                    },
                    {
                        "data": "dichVuChiNhanhId", "orderable": false, "className": "text-center align-middle",
                        "render": function(data) {
                            return `
                                <div class="btn-list flex-nowrap justify-content-center">
                                    <button class="btn btn-icon btn-ghost-warning btn-sm btn-edit-bg" data-id="${data}" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-icon btn-ghost-danger btn-sm btn-delete-bg" data-id="${data}" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            $('#filterChiNhanh').change(function() { tableBangGia.ajax.reload(); });

            function loadDichVuDropdown(selectedId = 0) {
                $.get('/DichVu/GetDropdown', function(data) {
                    let html = '<option value="">-- Chọn dịch vụ --</option>';
                    data.forEach(item => {
                        let sel = item.value == selectedId ? 'selected' : '';
                        html += `<option value="${item.value}" ${sel}>${item.text}</option>`;
                    });
                    $('#BgDichVuId').html(html);
                });
            }

            $('#btnOpenAddGia').click(function() {
                $('#DichVuChiNhanhId').val(0);
                $('#BgChiNhanhId').val('');
                loadDichVuDropdown();
                $('#GiaDichVu').val(0);
                $('#MacDinhBangGia').prop('checked', false);
                $('#bangGiaModalTitle').text('Thêm Bảng Giá');
                $('#bangGiaModal').modal('show');
            });

            $('#btnSaveBangGia').click(function() {
                let id = $('#DichVuChiNhanhId').val();
                let cn = $('#BgChiNhanhId').val();
                let dv = $('#BgDichVuId').val();
                let gia = parseFloat($('#GiaDichVu').val() || 0);
                let macDinh = $('#MacDinhBangGia').is(':checked');

                if(!cn || !dv) { showWarning('Vui lòng chọn chi nhánh và dịch vụ!'); return; }
                if(gia < 0) { showWarning('Giá không được âm!'); return; }

                let req = { dichVuChiNhanhId: parseInt(id), chiNhanhId: parseInt(cn), dichVuId: parseInt(dv), giaDichVu: gia, macDinh: macDinh };
                let isUpdate = id > 0;

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Bạn có chắc chắn muốn cập nhật bảng giá này?' : 'Bạn có chắc chắn muốn cài đặt bảng giá này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: { popup: 'swal2-custom-popup' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                        $.ajax({
                            url: isUpdate ? `/DichVuChiNhanh/Update/${id}` : '/DichVuChiNhanh/Create',
                            type: isUpdate ? 'PUT' : 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message);
                                $('#bangGiaModal').modal('hide');
                                tableBangGia.ajax.reload(null, false);
                            },
                            error: function(xhr) { showError(xhr.responseJSON?.message || 'Có lỗi xảy ra'); },
                            complete: function() { $btn.prop('disabled', false).text('Lưu Bảng Giá'); }
                        });
                    }
                });
            });

            $('#bangGiaTable').on('click', '.btn-edit-bg', function() {
                let id = $(this).data('id');
                $.get(`/DichVuChiNhanh/GetById/${id}`, function(res) {
                    $('#DichVuChiNhanhId').val(res.dichVuChiNhanhId);
                    $('#BgChiNhanhId').val(res.chiNhanhId);
                    loadDichVuDropdown(res.dichVuId);
                    $('#GiaDichVu').val(res.giaDichVu);
                    $('#MacDinhBangGia').prop('checked', res.macDinh === true);
                    $('#bangGiaModalTitle').text('Cập nhật Bảng Giá');
                    $('#bangGiaModal').modal('show');
                });
            });

            // Đồng bộ xác nhận xóa bảng giá
            $('#bangGiaTable').on('click', '.btn-delete-bg', function() {
                let id = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa bảng giá này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: { popup: 'swal2-custom-popup' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/DichVuChiNhanh/Delete/${id}`, type: 'DELETE',
                            success: function(res) {
                                showSuccess(res.message);
                                tableBangGia.ajax.reload(null, false);
                            },
                            error: function(xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
