@model IEnumerable<QuanLyChoThuePhongTroWeb.Areas.QuanLyNhaTro.ViewModels.Responses.DieuKhoanMauRes>
@{
    ViewData["Title"] = "Quản lý Điều khoản Hợp đồng";
}

<div class="container-xl mt-3">
    <!-- Page Header -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary font-weight-bold">
                    <i class="fas fa-gavel me-2"></i> Quản lý Điều khoản Hợp đồng mẫu
                </h2>
                <div class="text-muted mt-1">Quản lý thư viện các điều khoản sử dụng khi ký kết hợp đồng thuê phòng</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button class="btn btn-success d-none d-sm-inline-block shadow-sm" id="btnOpenAddModal">
                        <i class="fas fa-plus me-1"></i> Thêm điều khoản mới
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="card shadow-sm border-0">
        <div class="card-header">
            <h3 class="card-title font-weight-bold"><i class="fas fa-list me-2 text-primary"></i> Danh sách các điều khoản</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped w-100 datatable" id="dieuKhoanTable">
                    <thead>
                        <tr>
                            <th class="text-center w-1">STT</th>
                            <th style="min-width: 200px;">Tiêu đề điều khoản</th>
                            <th style="min-width: 400px; white-space: normal;">Nội dung chi tiết</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int stt = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center text-muted align-middle">@(stt++)</td>
                                    <td class="font-weight-bold text-primary align-middle">@item.TieuDe</td>
                                    <td style="white-space: pre-line; max-height: 100px; overflow-y: hidden; display: block; text-overflow: ellipsis; border-bottom: none;" class="text-muted">
                                        @Html.Raw(item.NoiDung.Length > 200 ? item.NoiDung.Substring(0, 200) + "..." : item.NoiDung)
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="btn-list flex-nowrap justify-content-center">
                                            <button type="button" class="btn btn-icon btn-ghost-warning btn-sm btn-edit-dk" data-id="@item.DieuKhoanMauId" title="Chỉnh sửa">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-icon btn-ghost-danger btn-sm btn-delete-dk" data-id="@item.DieuKhoanMauId" title="Xóa">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <div class="empty">
                                        <div class="empty-icon text-muted mb-3">
                                            <i class="fas fa-folder-open fa-3x"></i>
                                        </div>
                                        <p class="empty-title h3">Chưa có dữ liệu</p>
                                        <p class="empty-subtitle text-muted">
                                            Thư viện điều khoản hiện tại đang trống. Vui lòng thêm điều khoản mới.
                                        </p>
                                        <div class="empty-action mt-3">
                                            <button class="btn btn-primary" id="btnOpenAddModalEmpty">
                                                <i class="fas fa-plus me-1"></i> Thêm ngay
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Điều Khoản -->
<div class="modal fade" id="dieuKhoanModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-primary text-white border-0 rounded-top-3">
                <h5 class="modal-title font-weight-bold" id="dieuKhoanModalTitle"><i class="fas fa-plus-circle me-2"></i>Thêm Điều khoản mẫu mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="DieuKhoanMauId" value="0" />
                
                <div class="mb-3 p-3 rounded-3 shadow-sm border">
                    <label for="TieuDe" class="form-label font-weight-bold text-primary">
                        Tiêu đề điều khoản <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control form-control-lg" id="TieuDe" placeholder="VD: Quy định về giờ giấc, an ninh...">
                    <small class="form-hint mt-2"><i class="fas fa-info-circle me-1"></i>Tiêu đề ngắn gọn, rõ ràng để dễ dàng nhận biết khi chọn.</small>
                </div>

                <div class="mb-3 p-3 rounded-3 shadow-sm border">
                    <label for="NoiDung" class="form-label font-weight-bold text-primary">
                        Nội dung chi tiết <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" id="NoiDung" rows="8" placeholder="Nhập chi tiết các quy định, nội dung pháp lý của điều khoản..."></textarea>
                    <small class="form-hint mt-2 text-warning fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>Nội dung này sẽ được in trực tiếp vào hợp đồng của người thuê.</small>
                </div>
            </div>
            <div class="modal-footer border-top-0 rounded-bottom-3 p-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4 font-weight-bold" id="btnSaveDieuKhoan"><i class="fas fa-save me-1"></i> Lưu điều khoản</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Khởi tạo datatable nếu có dữ liệu
            if ($('#dieuKhoanTable tbody tr .empty').length === 0) {
                $('#dieuKhoanTable').DataTable({
                    "language": {
                        "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json"
                    },
                    "pageLength": 10,
                    "responsive": true,
                    "order": [[0, "asc"]],
                    "columnDefs": [
                        { "orderable": false, "targets": [2, 3] }
                    ]
                });
            }

            $('#btnOpenAddModal, #btnOpenAddModalEmpty').click(function() {
                $('#DieuKhoanMauId').val(0);
                $('#TieuDe').val('');
                $('#NoiDung').val('');
                $('#dieuKhoanModalTitle').html('<i class="fas fa-plus-circle me-2"></i>Thêm Điều khoản mẫu mới');
                $('#dieuKhoanModalTitle').parent().removeClass('bg-warning').addClass('bg-primary');
                $('#btnSaveDieuKhoan').removeClass('btn-warning').addClass('btn-primary').html('<i class="fas fa-save me-1"></i> Lưu điều khoản');
                $('#dieuKhoanModal').modal('show');
            });

            $('#btnSaveDieuKhoan').click(function() {
                let id = $('#DieuKhoanMauId').val();
                let tieuDe = $('#TieuDe').val().trim();
                let noiDung = $('#NoiDung').val().trim();

                if(!tieuDe || !noiDung) { 
                    showWarning('Vui lòng nhập đầy đủ Tiêu đề và Nội dung!'); 
                    return; 
                }

                let req = { dieuKhoanMauId: parseInt(id), tieuDe: tieuDe, noiDung: noiDung };
                let isUpdate = id > 0;

                Swal.fire({
                    title: isUpdate ? 'Xác nhận cập nhật?' : 'Xác nhận thêm mới?',
                    text: isUpdate ? 'Việc chỉnh sửa sẽ không ảnh hưởng tới các Hợp đồng đã ký trước đó.' : 'Thêm điều khoản này vào thư viện?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: isUpdate ? '#f59f00' : '#3085d6',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: { popup: 'swal2-custom-popup' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        let $btn = $(this);
                        let originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                        $.ajax({
                            url: isUpdate ? `/DieuKhoanMau/Update/${id}` : '/DieuKhoanMau/Create',
                            type: isUpdate ? 'PUT' : 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(req),
                            success: function(res) {
                                showSuccess(res.message).then(() => {
                                    location.reload(); // Reload trang đơn giản nhất vì dữ liệu không quá lớn
                                });
                            },
                            error: function(xhr) { 
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra'); 
                            },
                            complete: function() { 
                                $btn.prop('disabled', false).html(originalHtml); 
                            }
                        });
                    }
                });
            });

            $('#dieuKhoanTable').on('click', '.btn-edit-dk', function() {
                let id = $(this).data('id');
                $.get(`/DieuKhoanMau/GetById/${id}`, function(res) {
                    $('#DieuKhoanMauId').val(res.dieuKhoanMauId);
                    $('#TieuDe').val(res.tieuDe);
                    $('#NoiDung').val(res.noiDung);
                    $('#dieuKhoanModalTitle').html('<i class="fas fa-edit me-2"></i>Cập nhật Điều khoản mẫu');
                    $('#dieuKhoanModalTitle').parent().removeClass('bg-primary').addClass('bg-warning');
                    $('#btnSaveDieuKhoan').removeClass('btn-primary').addClass('btn-warning').html('<i class="fas fa-save me-1"></i> Lưu thay đổi');
                    $('#dieuKhoanModal').modal('show');
                }).fail(function() {
                    showError('Không lấy được dữ liệu điều khoản');
                });
            });

            $('#dieuKhoanTable').on('click', '.btn-delete-dk', function(e) {
                e.preventDefault();
                let id = $(this).data('id');
                
                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: 'Bạn có chắc chắn muốn xóa điều khoản này khỏi thư viện? Các hợp đồng đã ký sử dụng điều khoản này sẽ không bị ảnh hưởng.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: { popup: 'swal2-custom-popup' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/DieuKhoanMau/Delete/${id}`, 
                            type: 'DELETE',
                            success: function(res) {
                                showSuccess(res.message).then(() => {
                                    location.reload();
                                });
                            },
                            error: function(xhr) {
                                showError(xhr.responseJSON?.message || 'Có lỗi xảy ra');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
