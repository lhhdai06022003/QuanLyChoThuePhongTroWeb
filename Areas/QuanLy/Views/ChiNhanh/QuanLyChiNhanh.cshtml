@model IEnumerable<QuanLyChoThuePhongTroWeb.Models.ChiNhanh>
@{
    ViewData["Title"] = "Quản lý Chi Nhánh";
    // Đảm bảo Layout được gọi đúng đường dẫn của bạn
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="fas fa-list"></i> Danh sách Chi nhánh</h3>
                <button type="button" class="btn btn-success btn-sm ml-auto" onclick="openModalAdd()">
                    <i class="fas fa-plus"></i> Thêm Chi Nhánh
                </button>
            </div>

            <div class="card-body">
                <!-- DataTables tự động chiếm 100% chiều rộng bằng class w-100 -->
                <table id="chiNhanhTable" class="table table-bordered table-striped table-hover w-100">
                    <thead class="thead-light">
                        <tr>
                            <th width="5%">ID</th>
                            <th width="20%">Tên Chi Nhánh</th>
                            <th width="30%">Địa Chỉ</th>
                            <th width="15%">Số Điện Thoại</th>
                            <th width="15%">Ngày Tạo</th>
                            <th width="15%" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <!-- ĐỂ TRỐNG TBODY -->
                </table>
            </div>
        </div>
    </div>
</section>

<!-- MODAL THÊM / SỬA -->
<div class="modal fade" id="chiNhanhModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modalTitle">Thêm Chi Nhánh Mới</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="formChiNhanh">
                <div class="modal-body">
                    <!-- Trường ẩn lưu ID để phân biệt Thêm hay Sửa -->
                    <input type="hidden" id="ChiNhanhId" name="ChiNhanhId" value="0" />

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Tên Chi Nhánh <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="TenChiNhanh" name="TenChiNhanh" required placeholder="Nhập tên chi nhánh...">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Số Điện Thoại</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="SoDienThoai" name="SoDienThoai" placeholder="Nhập SĐT liên hệ...">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Địa Chỉ <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="DiaChi" name="DiaChi" required placeholder="Nhập địa chỉ đầy đủ...">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Mô Tả Thêm</label>
                        <div class="col-sm-9">
                            <textarea class="form-control" id="MoTa" name="MoTa" rows="3" placeholder="Ví dụ: Gần trường ĐH Sư Phạm Kỹ Thuật..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fas fa-save"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var dataTable; // Biến toàn cục để lưu DataTables

        $(document).ready(function () {
            // 1. KHỞI TẠO DATATABLES BẰNG AJAX
            dataTable = $('#chiNhanhTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "responsive": true,
                "autoWidth": false,
                "ajax": {
                    "url": "/ChiNhanh/DanhSachChiNhanh",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "chiNhanhId" },
                    {
                        "data": "tenChiNhanh",
                        "render": function(data) {
                            return `<span class="font-weight-bold text-primary">${data}</span>`;
                        }
                    },
                    { "data": "diaChi" },
                    { "data": "soDienThoai" },
                    {
                        "data": "ngayTao",
                        "render": function(data) {
                            if(!data) return "";
                            // Chuyển đổi định dạng ngày tháng từ JSON sang DD/MM/YYYY
                            var date = new Date(data);
                            return date.toLocaleDateString('vi-VN');
                        }
                    },
                    {
                        "data": "chiNhanhId",
                        "className": "text-center",
                        "render": function (data) {
                            // Vẽ 2 nút Sửa và Xóa cho mỗi dòng
                            return `
                                <button class="btn btn-warning btn-sm" onclick="openModalEdit(${data})" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteChiNhanh(${data})" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                "order": [[ 0, "desc" ]] // Sắp xếp ID giảm dần (mới nhất lên trên)
            });

            // 2. BẮT SỰ KIỆN SUBMIT FORM
            $('#formChiNhanh').on('submit', function (e) {
                e.preventDefault();
                let formData = $(this).serialize();
                $('#btnSave').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                $.ajax({
                    url: '/ChiNhanh/ThemChiNhanhMoi',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            $('#chiNhanhModal').modal('hide');

                            // LOAD LẠI BẢNG MÀ KHÔNG LOAD LẠI TRANG
                            // false: Giữ nguyên số trang hiện tại không bị nhảy về trang 1
                            dataTable.ajax.reload(null, false);
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    },
                    complete: function () {
                        $('#btnSave').prop('disabled', false).html('<i class="fas fa-save"></i> Lưu thông tin');
                    }
                });
            });
        });

        // CÁC HÀM MỞ MODAL VÀ XÓA
        function openModalAdd() {
            $('#formChiNhanh')[0].reset();
            $('#ChiNhanhId').val('0');
            $('#modalTitle').text('Thêm Chi Nhánh Mới');
            $('#chiNhanhModal').modal('show');
        }

        function openModalEdit(id) {
            $.get('/ChiNhanh/GetChiNhanh/' + id, function (res) {
                if (res.success) {
                    let data = res.data;
                    $('#ChiNhanhId').val(data.chiNhanhId);
                    $('#TenChiNhanh').val(data.tenChiNhanh);
                    $('#SoDienThoai').val(data.soDienThoai);
                    $('#DiaChi').val(data.diaChi);
                    $('#MoTa').val(data.moTa);

                    $('#modalTitle').text('Chỉnh sửa Chi Nhánh #' + id);
                    $('#chiNhanhModal').modal('show');
                } else {
                    alert(res.message);
                }
            });
        }

        function deleteChiNhanh(id) {
            if (confirm('Bạn có chắc chắn muốn xóa chi nhánh này?')) {
                $.post('/ChiNhanh/XoaChiNhanh/' + id, function (res) {
                    if (res.success) {
                        alert(res.message);
                        // Chỉ load lại DataTables thay vì load lại toàn bộ web
                        dataTable.ajax.reload(null, false);
                    } else {
                        alert(res.message);
                    }
                });
            }
        }
    </script>
}